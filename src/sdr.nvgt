#include"includes/includes.nvgt"

bool preglobals()
{
if (!SCREEN_READER_AVAILABLE)
{
alert("Error", "cannot load screen reader components");
}
else if (!SOUND_AVAILABLE)
{
alert("Error", "cannot load soundsystem");
}
else
{
return true;
}
return false;
}

void main()
{
// The settings load first, so the chosen sound device is set before any sound plays.
if (!directory_exists(APPDATA_DIR + "preffs")) directory_create(APPDATA_DIR + "preffs");
readpreffs();
if (!directory_exists(APPDATA_DIR + "saves")) directory_create(APPDATA_DIR + "saves");
readgame(); // the difficulty run counts, so the difficulty menu knows what's open
dummy.load("dummy"); // must load before sound_global_hrtf is set, or HRTF doesn't take effect
sound_global_hrtf = hrtf;
initialize_sound_pools();
show_window("Stride Rush, version "+version);
if(gamstence.is_already_running)
{
alert("Error", "You can only have one instance of this game running!");
exit();
}
if (!load_controls()) exit();
/* The speech buffers (dev, 2026-11-05), alphabetical after "all", which the first one creates. Each stays out of the
bracket-key rotation until its first message (buffer_visible()); achievements waits for achievements. */
string[] buffer_names = {"achievements", "doors", "items", "misc", "powerups", "status", "weapons"};
for (uint i = 0; i < buffer_names.length(); i++) create_buffer(buffer_names[i]);
// The quiet startup check (dev, 2026-11-05), from source too, so it can be tested; it only speaks up when there's an update.
if (auto_check_updates) check_for_updates(version, update_project);
while(true)
{
wait(5);
mainmenu();
}
}
