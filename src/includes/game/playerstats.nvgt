/* The player's stats, bought in the player shop's character category. They work at once rather than going into the
inventory, last through lost lives, and are gone when the run ends. Each point of attack adds 1 to a weapon's hit. Each
point of defence or shield defence takes 1 off a blow to your health or your shield, after the level and the powerups,
never below 1. Hazards and floor breaker falls never come through here. */
int player_attack = 0;
int player_defence = 0;
int player_shield_defence = 0;

// From reset_run(): every run starts with none.
void reset_player_stats()
{
player_attack = 0;
player_defence = 0;
player_shield_defence = 0;
}
bool is_player_stat(const string&in item)
{
return shop_character_ids.find(item) >= 0;
}
void add_player_stat(const string&in item, int amount)
{
if (item == "attack") player_attack += amount;
else if (item == "defence") player_defence += amount;
else if (item == "shield_defence") player_shield_defence += amount;
}
int player_stat(const string&in item)
{
if (item == "attack") return player_attack;
if (item == "defence") return player_defence;
return player_shield_defence;
}
// "1 point" or "5 points".
string points_text(int value)
{
return value == 1 ? "1 point" : value + " points";
}
// "1 attack point" or "5 attack points".
string stat_points_text(const string&in item)
{
int value = player_stat(item);
return value + " " + item_display_name(item) + (value == 1 ? " point" : " points");
}
// A blow after defence or shield defence, at least 1.
int after_defence(int damage, int points)
{
int left = damage - points;
return left < 1 ? 1 : left;
}
// What a hit from weapon w does, with your attack.
int weapon_hit_damage(int w)
{
return weapon_damage[w] * weapon_damage_multiplier + player_attack;
}
// Shield defence shows while you have a steel shield, on or off, as one on stays in the inventory.
bool has_a_shield()
{
return item_count("steel_shield") > 0;
}
