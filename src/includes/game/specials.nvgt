/* The player shop's specials: inventory items that are only ever bought, or given in a free run, never found on the belt.
The use key, repeating while held like any item's, starts a slide or a good trampoline's flight, and switches a helper on or off. A helper lasts the whole run,
through lost lives. The item helper takes every item in your lane as soon as a hand could; the door helper unlocks a real
door with your first key once it's in key reach, then opens it as soon as a hand could. With no key it tries a locked door once, as a hand would. It leaves fake doors alone. The force field helper presses a
field's switch, and the animal helper claps at an animal, as soon as a hand could. The ladder helper grabs a ladder and
the floor helper opens a floor breaker the same way, then each climbs or repairs with alternating hands at the fastest
pace the level allows, while your own hands do nothing there. The ammo pack helper opens the ammo packs you carry into
the drawn gun whenever its reserve has room, and the gold pack helper opens every gold pack you carry, as the use key
would (pack_helpers_update()). The master helper does all eight jobs while it's on, and each other helper keeps its own
setting underneath. The master helper deluxe does the same eight, but picks up items in every lane, never moving you,
and collects every powerup whichever way you reach it (powerup_check() in powerup.nvgt). */
const string[] helper_items = {"ammo_pack_helper", "animal_helper", "door_helper", "floor_helper", "force_field_helper", "gold_pack_helper", "item_helper", "ladder_helper", "master_helper", "master_helper_deluxe"};
bool[] helpers_on(10); // one per helper_items entry

bool is_helper_item(const string&in item)
{
return helper_items.find(item) >= 0;
}
bool helper_active(const string&in item)
{
int at = helper_items.find(item);
return at >= 0 and helpers_on[at];
}
// Whether a helper's job is being done: by that helper, the master helper or the master helper deluxe. helper_active() is its own setting.
bool helper_working(const string&in item)
{
return helper_active(item) or helper_active("master_helper") or helper_active("master_helper_deluxe");
}
void set_helper(const string&in item, bool on)
{
int at = helper_items.find(item);
if (at >= 0) helpers_on[at] = on;
}
void reset_helpers()
{
for (uint i = 0; i < helpers_on.length(); i++) helpers_on[i] = false;
}
// The use key on a helper: "Item helper on." with its own on or off sound.
void toggle_helper(const string&in item)
{
bool on = !helper_active(item);
set_helper(item, on);
p.play_stationary(get_pack_sound(on ? "main/misc/global/*helperon*" : "main/misc/global/*helperoff*"), false);
speak_buffer(learn_upper_first(item_display_name(item)) + (on ? " on." : " off."), "items");
}
/* A safety net works by itself: a fall into a hazard or floor breaker at x uses one up and sets you down just past it,
running on, with your health, lives and shield untouched. True if one caught you. */
bool safety_net_catch(double x)
{
if (item_count("safety_net") < 1) return false;
give_item("safety_net", -1);
cancel_movement(); // off the ground, crouched or at a floor breaker's edge, you're set down
me.x = x + 1;
update_listeners();
steptimer.restart();
p.play_stationary(get_pack_sound("main/misc/player/*move*"), false); // move1 or move2
speak_buffer("Your safety net caught you.", "items");
return true;
}
// The use key on a slide: one starts at once, as a free run's give slide does. True if it was used.
bool use_slide_item()
{
if (flying)
{
speak_buffer("You're already in the air.", "items");
return false;
}
if (!slides_available())
{
speak_buffer("This environment has no slides.", "items");
return false;
}
give_slide();
return true;
}
// The use key on a trampoline: a good pad's flight from where you are, with a random pad's sounds. True if it was used.
bool use_trampoline_item()
{
if (flying)
{
speak_buffer("You're already in the air.", "items");
return false;
}
string[] themes = get_pack_sound_folders(trap_folder(current_env, "trampolines") + "*");
if (themes.length() == 0)
{
speak_buffer("This environment has no trampolines.", "items");
return false;
}
trampoline pad;
pad.theme = themes[random(0, themes.length() - 1)];
pad.env = current_env;
launch(pad);
return true;
}
// The inventory's use key while on a slide, where nothing else can be used: a slide or trampoline says why.
void sliding_item_note()
{
if (!controls.action_pressed("item_use")) return;
string[] keys = inventory_keys();
if (keys.length() == 0) return;
string item = keys[invpos];
if (item == "slide" or item == "trampoline") speak_buffer("You're already sliding.", "items");
}
// Every frame from run_loop(): what the helpers do, while your hands are free.
void helpers_update()
{
if (door_moving or sliding) return;
if (climbing)
{
if (helper_working("ladder_helper") and runtimer.elapsed - climb_last_rung_at >= ladder_rung_min_time()) climb_hand(climb_last_hand == 1, climb_last_hand != 1);
return;
}
if (repairing)
{
if (helper_working("floor_helper") and (repair_laid == 0 or runtimer.elapsed - repair_last_at >= ladder_rung_min_time())) repair_hand(repair_last_hand == 1, repair_last_hand != 1);
return;
}
if (helper_working("item_helper"))
{
bool every_lane = helper_active("master_helper_deluxe"); // every lane, not just yours
pick_up_ammopack(every_lane);
pick_up_goldpack(every_lane);
pick_up_key(every_lane);
pick_up_shield(every_lane);
pick_up_capsule(every_lane);
pick_up_potion(every_lane);
pick_up_teleporter(every_lane);
}
pack_helpers_update(); // after the item helper, so a pack it just picked up opens at once
if (flying) return; // a flight carries you past doors, force fields and animals
if (helper_working("door_helper")) door_helper_update();
if (helper_working("force_field_helper"))
{
forcefield@ field = forcefield_in_reach();
if (@field != null) press_forcefield_switch(field);
}
if (helper_working("animal_helper") and scare_animal()) p.play_stationary(get_pack_sound("main/misc/player/*clap*"), false);
if (helper_working("ladder_helper")) grab_ladder(true, false);
if (helper_working("floor_helper")) open_floor_breaker(true, false);
}
/* The pack helpers, run where the use key would work (helpers_update() has already stopped for a door's carry, a slide,
a ladder or a floor breaker's repair). The ammo pack helper only acts with a gun drawn whose reserve has room, so it
waits quietly instead of repeating that the reserve is full; each pack that opened is used, as use_item() counts them. */
void pack_helpers_update()
{
int w = current_weapon;
if (helper_working("ammo_pack_helper") and item_count("ammo_pack") > 0 and is_gun(w) and weapon_reserve[w] < gun_max_reserve)
{
int opened = use_ammopacks(); // ammo.nvgt
for (int i = 0; i < opened; i++) item_used("ammo_pack");
}
if (helper_working("gold_pack_helper") and item_count("gold_pack") > 0)
{
int opened = use_goldpacks(); // goldpack.nvgt
for (int i = 0; i < opened; i++) item_used("gold_pack");
}
}
// The next door ahead, if it's real: unlocked with your first key once in key reach, then opened in its hand window.
void door_helper_update()
{
door@ next = null;
for (uint i = 0; i < doors.length(); i++)
{
if (@doors[i] == null or !door_standing(doors[i]) or doors[i].x - me.x < 1) continue;
if (@next == null or doors[i].x < next.x) @next = doors[i];
}
if (@next == null or !next.real) return;
bool in_hand_window = me.x >= hand_window_start(next.x, next.countdown_start);
if (next.locked)
{
string held = first_key_item();
if (held != "")
{
if (next.x - me.x <= key_reach() and use_key(held)) item_used(held);
}
// No key: it tries the door once, as a hand would, with its locked sound and line.
else if (in_hand_window and !next.helper_denied)
{
next.helper_denied = true;
open_door();
}
return;
}
if (in_hand_window) open_door();
}
// The first key in your inventory, or "".
string first_key_item()
{
string[] keys = inventory_keys();
for (uint i = 0; i < keys.length(); i++)
{
if (is_key_item(keys[i])) return keys[i];
}
return "";
}
