/* Shields: an item you wear like armor. On the belt a shield works like an ammo pack: its spawn clip, then its loop at
its tile, in its lane; either hand picks it up within hand_window_start() (get and the player's give,
centered) and it goes into the inventory as "steel_shield". Arriving on its tile on the ground, landing on it, or a
weapon hit breaks it (break) and it's lost; a clean jump over it misses it.
U switches your current shield on or off (toggle_shield()), with its wear or remove sound centered. It stays in the
inventory while on, and keeps its strength while off. Only one is current at a time: it starts at shield_hp the first
time it goes on, and spares wait until it breaks, which takes one from the stack. Every run starts with none on. M reads its strength.
Same entity pattern as ammo packs: null-slot removal, reused slots, and only destroy_all_shields() shrinks the array. */
sound_pool shieldpool;
const string shield_folder = "game/equipments/items/common/steel_shield/";
class shield
{
double x;
int lane = 1; // lane_middle until spawned, then the spawner's lane
double countdown_start;
bool spent = false; // picked up, broken or jumped past: nothing more can happen to it
int loopslot = -1;
}
shield@[] shields(0);
// The current shield: whether it's on, whether it's been put on yet, and the hp it has left out of shield_full().
bool shield_worn = false;
bool shield_in_use = false;
int shield_hp_left = 0;

// True when shield sounds exist, so the spawner can offer shields.
bool shields_available()
{
return get_pack_sound(shield_folder + "*loop*") != "";
}
// No current shield: at the start of a run, when the inventory is emptied, and when your last one is taken away.
void reset_shield()
{
shield_worn = false;
shield_in_use = false;
shield_hp_left = 0;
}
/* The shields a run starts with in its inventory, to be worn with U, since shields never spawn in these runs: a practice
run gets practice_shield_count(), and a single-type debug run of something a shield protects from gets two. Called
from reset_run(), after clear_inventory(). */
void give_debug_shield()
{
// Every practice run starts with its practice shields, none for hazards or floor breakers.
if (practice_run)
{
if (practice_shield_count() > 0) give_item("steel_shield", practice_shield_count());
return;
}
if (slides_debug or trampolines_debug)
{
give_item("steel_shield", 2); // the debug choices "slides" and "trampolines" play like "all" but get the debug shields
return;
}
string[] shielded_types = {"spikes", "mines", "force_fields", "projectiles", "walls", "animals", "animals_birds", "animals_dogs", "insects", "fake_doors", "real_doors", "real_doors_spread", "powerups", "barriers", "barriers_random", "barriers_multiple", "winds", "combinations", "combinations_reverse", "combinations_mixed", "ladders", "mixed_walls", "vehicles", "aircrafts"}; // never "all", which plays like the real game
if (shielded_types.find(spawn_only) >= 0) give_item("steel_shield", 2);
}
/* The steel shields a practice run starts with and gets back after each practice death: practice_shields, but none when
practicing hazards or floor breakers, falls that shields can't stop. */
int practice_shield_count()
{
return practice_choice == "hazards" or practice_choice == "floor_breakers" ? 0 : practice_shields;
}
// countdown comes from the spawner like a pack's; it sets the pickup window and the spacing.
void spawn_shield(double sx, int countdown, int lane = -1)
{
shield s;
s.x = sx;
s.countdown_start = sx - countdown;
s.lane = lane < 0 ? random(lane_left, lane_right) : lane;
shieldpool.play_2d(get_pack_sound(shield_folder + "*spawn*"), 0, me.x, lane_across(s.lane, sx), sx, false);
s.loopslot = shieldpool.play_2d(get_pack_sound(shield_folder + "*loop*"), 0, me.x, lane_across(s.lane, sx), sx, true);
place_lane_sound(shieldpool, s.loopslot, s.lane, s.x);
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] == null)
{
@shields[i] = s;
return;
}
}
shields.insert_last(s);
}
// Called from hand_check() when nothing else took the press. Picks up the nearest shield in its window. True if one was.
bool pick_up_shield()
{
shield@ target = null;
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] == null) continue;
shield@ s = shields[i];
if (s.spent or s.lane != current_lane or me.x < hand_window_start(s.x, s.countdown_start) or s.x - me.x < 1) continue;
if (@target == null or s.x < target.x) @target = s;
}
if (@target == null) return false;
target.spent = true;
stop_shield(target);
shieldpool.play_stationary(get_pack_sound(shield_folder + "*get*"), false);
p.play_stationary(get_pack_sound("main/misc/player/*give*"), false);
give_item("steel_shield", 1);
stat_add("steel_shields_picked_up");
speak_buffer(item_display_name("steel_shield"), "items");
return true;
}
/* Runs once per step, right after the move. Arriving on a shield's tile on the ground breaks it; once you're past its
tile still unspent, it was jumped cleanly. */
void shield_check()
{
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] == null) continue;
shield@ s = shields[i];
if (!s.spent)
{
if (me.x == s.x and is_grounded() and s.lane == current_lane and !sliding) break_shield(s); // not on a slide: there it's caught or passes (slide.nvgt)
else if (me.x > s.x) s.spent = true; // jumped clean over: its loop carries on and fades behind you
}
if (me.x > s.x + spawn_distance()) remove_shield(i);
}
}
// Called from player_land(): landing on a shield's tile by mistake breaks it.
void shield_landing()
{
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] == null) continue;
if (!shields[i].spent and me.x == shields[i].x and shields[i].lane == current_lane) break_shield(shields[i]);
}
}
// Weapons break shields on the belt like packs and keys: a bullet on its tile, or a swing when it's the nearest target.
shield@ shield_at(double x)
{
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] != null and !shields[i].spent and shields[i].x == x and shields[i].lane == current_lane) return shields[i];
}
return null;
}
shield@ shield_in_reach(int reach)
{
shield@ target = null;
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] == null or shields[i].spent or shields[i].lane != current_lane) continue;
double ahead = shields[i].x - me.x;
if (ahead < 1 or ahead > reach) continue;
if (@target == null or shields[i].x < target.x) @target = shields[i];
}
return target;
}
// A weapon hit on a shield on the belt: it breaks and is lost. Returns its x, so the weapon's hit plays there.
double strike_shield(shield@ s)
{
break_shield(s);
return s.x;
}
void break_shield(shield@ s)
{
stat_add("steel_shields_broken");
s.spent = true;
stop_shield(s);
shieldpool.play_stationary(get_pack_sound(shield_folder + "*break*"), false); // stationary, so the pitch never drops behind you
}
void stop_shield(shield@ s)
{
if (s.loopslot > -1) shieldpool.destroy_sound(s.loopslot);
s.loopslot = -1;
}
void remove_shield(uint i)
{
if (i >= shields.length() or @shields[i] == null) return;
stop_shield(shields[i]);
@shields[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_shields()
{
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] == null) continue;
stop_shield(shields[i]);
}
shields.resize(0);
}
// U on a shield: switches the current one on or off. The first time it goes on, it starts at full hp and counts as used.
void toggle_shield()
{
if (shield_worn)
{
shield_worn = false;
p.play_stationary(get_pack_sound(shield_folder + "*remove*"), false);
speak_buffer("Shield off.", "items");
return;
}
if (!shield_in_use)
{
shield_in_use = true;
free_shield_full = shield_hp; // a new shield is at the normal strength (freerun.nvgt)
shield_hp_left = shield_full(); // with any max shield strength (playerstats.nvgt)
stat_add("steel_shields_used");
}
shield_worn = true;
p.play_stationary(get_pack_sound(shield_folder + "*wear*"), false);
speak_buffer("Shield on.", "items");
}
/* A blow from anything but a hazard. With a shield worn it takes the damage instead and this returns true, so the caller
plays only the obstacle's own hit, layered with the shield's, and your health is untouched. The blow that empties it is
absorbed in full: death plays, with no speech, and it leaves the inventory, any spare waiting, off. */
bool shield_absorb(int damage)
{
if (!shield_worn) return false;
shield_hp_left -= after_defence(powerup_damage(damage, "Sturdy Shield", "Brittle Shield"), player_shield_defence); // halved or doubled by the shield powerups, then your shield defence
if (shield_hp_left <= 0)
{
reset_shield();
end_shield_powerup(); // a Sturdy or Brittle Shield ends with it
p.play_stationary(get_pack_sound(shield_folder + "*death*"), false); // the sound alone, no speech
give_item("steel_shield", -1);
}
else p.play_stationary(get_pack_sound(shield_folder + "*hit*"), false);
return true;
}
/* M: the worn shield's strength as the Game tab's shield format says (format_readout() in lives.nvgt): "Shield strength,
80 percent.", "Shield strength, 320 of 400 endurance remaining.", or both. A shield you've taken off says so, with its
strength: "Your shield is off, with 80 percent strength." */
void speak_shield_strength()
{
if (!shield_in_use)
{
speak_buffer("You're not wearing a shield.", "status");
return;
}
string amount = format_readout(shield_format, shield_hp_left, shield_full());
if (!shield_worn)
{
speak_buffer("Your shield is off, with " + amount + " strength.", "status");
return;
}
speak_buffer("Shield strength, " + amount + (shield_format == 0 ? "." : " endurance remaining."), "status");
}
// Runs every frame from item_lane_sounds() (lane.nvgt): keeps each one in its lane as you move and as it nears.
void shield_lane_sounds()
{
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] == null or shields[i].loopslot < 0) continue;
place_lane_sound(shieldpool, shields[i].loopslot, shields[i].lane, shields[i].x);
}
}
