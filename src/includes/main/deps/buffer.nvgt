/* Speech buffers. Adapted for Stride Rush: no networking, logs go to
tsatria03/StrideRush/logs, sounds come through get_pack_sound from ui/buffer and ui/other, keys are the [buffer]
actions in data/config/keyboard.ini, and the menu uses item ids. */
buffer@[]buffers(0);
int bufferpos=0;
class buffer_item
{
string name;
buffer_item(string n)
{
name=n;
}
}class buffer
{
string name;
bool interrupt=true; // a category speaks over current speech unless set false (speak_buffer reads this)
bool muted=false;
buffer_item@[]items;
int bpos;
buffer(string n)
{
name=n;
}
void toggle_mute()
{
if(name=="alerts" or name=="all")
{
speak("This buffer can not be muted.",true);
}
else
{
muted = !muted;
spool.play_stationary(get_pack_sound(muted ? "ui/other/*toggleoff*" : "ui/other/*toggleon*"), false);
speak(name + " " + (muted ? "muted" : "unmuted"), true);
writepreffs();
}
}
}
int get_buffer_index(string name)
{
for(uint i=0; i<buffers.length(); i++)
{
if(buffers[i].name==name) return i;
}
return -1;
}
void create_buffer(string name)
{
if(get_buffer_index("all")<=-1)
{
buffer allbuffer("all");
buffers.insert_last(allbuffer);
}
buffer buffer1(name);
buffers.insert_last(buffer1);
}
void add_buffer_item(string buffername, string itemname, bool speakMessage = true)
{
int b = get_buffer_index(buffername);
if (b <= -1) return;
buffer_item item(itemname);
buffers[b].items.insert_last(item);
if (!buffers[0].muted && buffername != "all") {
buffers[0].items.insert_last(item);
}
if (!buffers[b].muted && speakMessage) {
speak(itemname, true);
}
}
string buffer_log_dir()
{
return APPDATA_DIR + "logs";
}
bool export_current_buffer()
{
if (bufferpos < 0 || bufferpos >= int(buffers.length()))
return false;
buffer@ b = buffers[bufferpos];
if (b.items.length() == 0)
{
speak("There's nothing to export in this buffer.");
return false;
}
string bufferdir = buffer_log_dir();
if (!directory_exists(bufferdir)) directory_create(bufferdir);
logfile.open(bufferdir + "/" + b.name + ".log", "ab");
logfile.write("Exported on " + DATE_MONTH + "/" + DATE_DAY + "/" + DATE_YEAR + "\r\n\r\n");
string bdata = "";
for (uint i2 = 0; i2 < b.items.length(); i2++)
{
bdata += b.items[i2].name + "\r\n";
}
logfile.write(bdata);
logfile.close();
speak(b.name + " exported");
return true;
}
bool export_all_buffers()
{
string bufferdir = buffer_log_dir();
if (!directory_exists(bufferdir)) directory_create(bufferdir);
bool exported = false;
for (uint i = 0; i < buffers.length(); i++)
{
if (buffers[i].items.length() > 0)
{
exported = true;
logfile.open(bufferdir + "/" + buffers[i].name + ".log", "ab");
logfile.write("Exported on " + DATE_MONTH + "/" + DATE_DAY + "/" + DATE_YEAR + "\r\n\r\n");
string bdata = "";
for (uint i2 = 0; i2 < buffers[i].items.length(); i2++)
{
bdata += buffers[i].items[i2].name + "\r\n";
}
logfile.write(bdata);
logfile.close();
}
}
if (exported)
{
speak("All buffers exported");
return true;
}
else
{
speak("There's nothing to export in these buffers.");
return false;
}
}
void toggle_buffer()
{
if(bufferpos<0 or bufferpos>=int(buffers.length())) // cast before -1 so an empty array can't underflow the uint
{
return;
}
else{
buffers[bufferpos].toggle_mute();
}
}
/* A buffer only shows up in the category rotation once it has something in it, EXCEPT "all" and "alerts", which
always show (they're the two buffers that can't be muted). So an empty category is skipped over rather than stopped
on with an "empty" readout, and it appears the instant its first message lands. New messages still speak live and
still land in "all" regardless, so nothing is missed while a category is hidden. */
bool buffer_visible(int i)
{
if(i < 0 or i >= int(buffers.length())) return false;
return buffers[i].name=="all" or buffers[i].name=="alerts" or buffers[i].items.length()>0;
}
// How many categories are currently visible (drives the switch cue's spatial pan/pitch, so it reflects the shortened list).
int visible_buffer_count()
{
int n=0;
for(uint i=0; i<buffers.length(); i++) if(buffer_visible(int(i))) n++;
return n;
}
// The 0-based position of the focused category among the visible ones (for the same pan/pitch).
int visible_buffer_position()
{
int n=0;
for(int i=0; i<bufferpos and i<int(buffers.length()); i++) if(buffer_visible(i)) n++;
return n;
}
// The shared "moved to this category" cue + readout, positioned within the VISIBLE list. Used by all four category-nav keys.
void announce_buffer()
{
if(bufferpos<0 or bufferpos>=int(buffers.length())) return;
int vc=visible_buffer_count(), vp=visible_buffer_position();
spool.play_stationary_extended(get_pack_sound("ui/buffer/*switch*"),false,0,convert_to_pan(vc+1,vp,-50,50),0,max(20,convert_to_pitch(vc+1,vp,20,200)),false);
string binfo = buffers[bufferpos].name + (buffers[bufferpos].muted ? ", muted, " : ", ") + (buffers[bufferpos].items.length() > 0 ? "" + (buffers[bufferpos].bpos + 1) + " of " + buffers[bufferpos].items.length() : "empty") + ".";
if (buffers[bufferpos].items.length() > 0) binfo += " " + buffers[bufferpos].items[buffers[bufferpos].bpos].name;
speak(binfo, true);
}
// The shared "moved to this item" cue + readout, positioned within the focused category. Used by all four item-nav keys.
void announce_buffer_item()
{
spool.play_stationary_extended(get_pack_sound("ui/buffer/*choose*"),false,0,convert_to_pan(buffers[bufferpos].items.length()+1,buffers[bufferpos].bpos,-50,50),0,max(20,convert_to_pitch(buffers[bufferpos].items.length()+1,buffers[bufferpos].bpos,20,200)),false);
speak(buffers[bufferpos].items[buffers[bufferpos].bpos].name);
}
void next_buffer()
{
if(buffers.length()==0) return;
int target=-1;
for(int i=bufferpos+1; i<int(buffers.length()); i++) if(buffer_visible(i)) { target=i; break; } // next visible category, skipping empties
if(target!=-1) { bufferpos=target; announce_buffer(); return; }
if(visible_buffer_count()>1) return; // already at the last visible category: hard stop
announce_buffer(); // a lone visible category just re-announces itself
}
void previous_buffer()
{
if(buffers.length()==0) return;
int target=-1;
for(int i=bufferpos-1; i>=0; i--) if(buffer_visible(i)) { target=i; break; } // previous visible category, skipping empties
if(target!=-1) { bufferpos=target; announce_buffer(); return; }
if(visible_buffer_count()>1) return; // already at the first visible category: hard stop
announce_buffer();
}
void top_buffer()
{
if(buffers.length()==0) return;
int target=-1;
for(int i=0; i<int(buffers.length()); i++) if(buffer_visible(i)) { target=i; break; } // the first visible category (always "all")
if(target<0) return;
bool moved=(bufferpos!=target);
bufferpos=target;
if(!moved and visible_buffer_count()>1) return; // already at the top of several visible: hard stop
announce_buffer();
}
void bottom_buffer()
{
if(buffers.length()==0) return;
int target=-1;
for(int i=int(buffers.length())-1; i>=0; i--) if(buffer_visible(i)) { target=i; break; } // the last visible category
if(target<0) return;
bool moved=(bufferpos!=target);
bufferpos=target;
if(!moved and visible_buffer_count()>1) return; // already at the bottom of several visible: hard stop
announce_buffer();
}
void next_buffer_item()
{
if(bufferpos < 0 || bufferpos >= int(buffers.length())) return;
if(buffers[bufferpos].items.length()<=0)
{
speak("Empty.");
return;
}
/* Hard stop at the last item (no sound, no re-speak), EXCEPT a single-item buffer, where the key just re-announces it
(there's no other item to be blocked from). Same "hard stop" feel as the category keys. */
bool moved=false;
if(buffers[bufferpos].bpos < int(buffers[bufferpos].items.length()-1)) { buffers[bufferpos].bpos++; moved=true; }
if(!moved and buffers[bufferpos].items.length()>1) return;
announce_buffer_item();
}
void previous_buffer_item()
{
if(bufferpos < 0 || bufferpos >= int(buffers.length())) return;
if(buffers[bufferpos].items.length()<=0)
{
speak("Empty.");
return;
}
// Hard stop at the first item, except a single-item buffer, which just re-announces it.
bool moved=false;
if(buffers[bufferpos].bpos > 0) { buffers[bufferpos].bpos--; moved=true; }
if(!moved and buffers[bufferpos].items.length()>1) return;
announce_buffer_item();
}
void top_buffer_item()
{
if(bufferpos < 0 || bufferpos >= int(buffers.length())) return;
if(buffers[bufferpos].items.length()==0)
{
speak("Empty.");
return;
}
bool moved=(buffers[bufferpos].bpos!=0);
buffers[bufferpos].bpos=0;
if(!moved and buffers[bufferpos].items.length()>1) return; // already at the top of several: hard stop; a lone item re-announces
announce_buffer_item();
}
void bottom_buffer_item()
{
if(bufferpos < 0 || bufferpos >= int(buffers.length())) return;
if(buffers[bufferpos].items.length()==0)
{
speak("Empty.");
return;
}
bool moved=(buffers[bufferpos].bpos!=int(buffers[bufferpos].items.length()-1));
buffers[bufferpos].bpos=int(buffers[bufferpos].items.length()-1);
if(!moved and buffers[bufferpos].items.length()>1) return; // already at the bottom of several: hard stop; a lone item re-announces
announce_buffer_item();
}
void copy_buffer_item()
{
if(bufferpos < 0 || bufferpos >= int(buffers.length()) || buffers[bufferpos].items.length()<=0)
{
speak("There's nothing to copy in this buffer.");
return;
}
clipboard_copy_text(buffers[bufferpos].items[buffers[bufferpos].bpos].name);
speak("Message copied",true);
}
// Open the current buffer item in a read-only, arrow-navigable box (vd.info_box) with a Close button. Single item only.
void review_buffer_item()
{
if(bufferpos < 0 || bufferpos >= int(buffers.length()) || buffers[bufferpos].items.length()<=0)
{
speak("There's nothing to review in this buffer.");
return;
}
string label = buffers[bufferpos].name + ", " + (buffers[bufferpos].bpos + 1) + " of " + buffers[bufferpos].items.length();
vd.info_box("Buffer review", label, buffers[bufferpos].items[buffers[bufferpos].bpos].name);
}
// Copy the WHOLE current buffer to the clipboard, one message per line, oldest first (same order export uses).
void copy_current_buffer()
{
if(bufferpos < 0 || bufferpos >= int(buffers.length()) || buffers[bufferpos].items.length()<=0)
{
speak("There's nothing to copy in this buffer.");
return;
}
string data = "";
for(uint i=0; i<buffers[bufferpos].items.length(); i++) data += (i>0 ? "\r\n" : "") + buffers[bufferpos].items[i].name;
clipboard_copy_text(data);
speak("Buffer copied",true);
}
// Export just the CURRENT item to this buffer's log file (appends, like export_current_buffer, but one line).
bool export_current_item()
{
if(bufferpos < 0 || bufferpos >= int(buffers.length())) return false;
buffer@ b = buffers[bufferpos];
if(b.items.length() == 0)
{
speak("There's nothing to export in this buffer.");
return false;
}
string bufferdir = buffer_log_dir();
if(!directory_exists(bufferdir)) directory_create(bufferdir);
logfile.open(bufferdir + "/" + b.name + ".log", "ab");
logfile.write("Exported on " + DATE_MONTH + "/" + DATE_DAY + "/" + DATE_YEAR + "\r\n\r\n");
logfile.write(b.items[b.bpos].name + "\r\n");
logfile.close();
speak(b.name + " item exported");
return true;
}
// Review the WHOLE current buffer in one read-only, arrow-navigable box, one message per line, oldest first.
void review_current_buffer()
{
if(bufferpos < 0 || bufferpos >= int(buffers.length()) || buffers[bufferpos].items.length()<=0)
{
speak("There's nothing to review in this buffer.");
return;
}
string data = "";
for(uint i=0; i<buffers[bufferpos].items.length(); i++) data += (i>0 ? "\r\n" : "") + buffers[bufferpos].items[i].name;
int count = int(buffers[bufferpos].items.length());
string label = buffers[bufferpos].name + ", " + count + (count==1 ? " message" : " messages");
vd.info_box("Buffer review", label, data);
}
/* A "Buffer menu" front-end over the buffer actions, so they're discoverable without the hotkeys. Every option always
shows; empty or unmuteable cases just speak the same refusal the hotkeys do. Export buffer exports THEN clears (like the
export hotkey), so re-exporting can't append duplicate entries to the log. Export buffer item exports only. */
void buffer_menu()
{
if(bufferpos < 0 or bufferpos >= int(buffers.length())) return;
setupmenu();
m.intro_text = buffers[bufferpos].name + ", buffer menu"; // lead with the focused category
m.add_item("Copy buffer", "copy");
m.add_item("Copy buffer item", "copyitem");
m.add_item("Export buffer", "export");
m.add_item("Export buffer item", "exportitem");
m.add_item(buffers[bufferpos].muted ? "Unmute buffer" : "Mute buffer", "mute"); // label reflects current state
m.add_item("Review buffer", "review");
m.add_item("Review buffer item", "reviewitem");
int mres = m.run();
string choice = mres<0 ? "" : m.selected_item_id;
if(choice == "copy") copy_current_buffer();
else if(choice == "copyitem") copy_buffer_item();
else if(choice == "export") { if(export_current_buffer()) clear_current_buffer(); } // export then clear, so a re-export can't duplicate what's already logged
else if(choice == "exportitem") export_current_item(); // single item: export only
else if(choice == "mute") toggle_buffer();
else if(choice == "review") review_current_buffer();
else if(choice == "reviewitem") review_buffer_item();
else speak("canceled"); // escaped or cancelled
}
void clear_current_buffer()
{
if (bufferpos < 0 || bufferpos >= int(buffers.length()))
return;
buffers[bufferpos].items.resize(0);
buffers[bufferpos].bpos = 0;
if(!buffer_visible(bufferpos)) bufferpos = 0; // the cleared category is now empty and hidden (not all/alerts); fall back to the always-present all buffer
}
void clear_all_buffers()
{
for (uint i = 0; i < buffers.length(); i++)
{
buffers[i].items.resize(0);
buffers[i].bpos = 0;
}
bufferpos = 0; // every category but all/alerts is now hidden; focus the always-present all buffer
}

/* Buffer keys come from the [buffer] actions in keyboard.ini. key_config's consumed-key rule stops a plain key (comma,
the brackets, or C for the right hand) from firing while its Shift combo does. That rule only protects single-key
bindings, so review (Alt+Shift+C) is checked before copy (Shift+C), which would otherwise match too. action_triggered
uses each binding's own trigger from the ini (press, or :repeat), so the file decides how a key behaves. */
void buffercheck()
{
if (controls.action_triggered("buffer_item_first")) top_buffer_item();
else if (controls.action_triggered("buffer_item_previous")) previous_buffer_item();
if (controls.action_triggered("buffer_item_last")) bottom_buffer_item();
else if (controls.action_triggered("buffer_item_next")) next_buffer_item();
if (controls.action_triggered("buffer_first")) top_buffer();
else if (controls.action_triggered("buffer_previous")) previous_buffer();
if (controls.action_triggered("buffer_last")) bottom_buffer();
else if (controls.action_triggered("buffer_next")) next_buffer();
if (controls.action_triggered("buffer_mute")) toggle_buffer();
if (controls.action_triggered("buffer_review_item")) review_buffer_item();
else if (controls.action_triggered("buffer_copy_item")) copy_buffer_item();
if (controls.action_triggered("buffer_menu")) buffer_menu();
if (controls.action_triggered("buffer_export")) { if (export_current_buffer()) clear_current_buffer(); }
}
