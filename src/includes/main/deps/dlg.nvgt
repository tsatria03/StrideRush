bool dlg(string message, bool dlgcoppy=true, bool dlgsound=false, int timeout=-1)
{
timer timeouter;
if(dlgsound==true) temp.play_stationary(get_pack_sound("ui/dialog/*error*"),false);
speak(message);
while(true)
{
wait(5);
if (timeout>-1 and timeouter.elapsed>=timeout)
return false;
if (key_repeating(KEY_C) and dlgcoppy==true)
{
temp.destroy_all();
temp.play_stationary(get_pack_sound("ui/dialog/*copy*"),false);
speak("Text copied");
clipboard_copy_text(string_replace(message, " Press enter or space to continue.", "", true)); // copies without dlgmessage_return's prompt, like CookieCraze
}
if (key_repeating(KEY_LEFT) or key_repeating(KEY_RIGHT) or key_repeating(KEY_UP) or key_repeating(KEY_DOWN))
{
speak(message);
}
if (key_repeating(KEY_ESCAPE))
{
temp.destroy_all();
return true;
}
if(key_repeating(KEY_RETURN) or key_repeating(KEY_SPACE) or key_down(KEY_A)) // space too, as dlgmessage_return's prompt says
{
temp.destroy_all();
break;
}
}
return false;
}
void dlgmessage(string messages)
{
temp.play_stationary(get_pack_sound("ui/dialog/*open*"),false);
string[] d = string_split(messages, "--", true);
bool escaped = dlg(d[0], dlgsound:false);
if (escaped)
{
temp.play_stationary(get_pack_sound("ui/dialog/*close*"),false);
return;
}
for (uint i = 1; i < d.length(); i++)
{
temp.play_stationary(get_pack_sound("ui/dialog/*scroll*"),false);
escaped = dlg(d[i], dlgsound:false);
if (escaped)
{
temp.play_stationary(get_pack_sound("ui/dialog/*close*"),false);
return;
}
}
temp.play_stationary(get_pack_sound("ui/dialog/*close*"),false);
}
// CookieCraze's: a dlgmessage() with the continue prompt added (dev, 2026-11-04, first used by Preview voice).
void dlgmessage_return(string msg)
{
dlgmessage(msg + " Press enter or space to continue.");
}
