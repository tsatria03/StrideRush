/* True while a dlg() message is open, so a game's joystick can give it a copy button (C) that it gives no other menu,
where C would jump to items starting with c. */
bool dlg_open = false;
bool dlg_translated = false; // true while dlgmessage_return() shows a message it has already translated
// The ending dlgmessage_return() adds, in the chosen language (translation.nvgt), so a copy can take it off again.
string dlg_enter_ending()
{
return " " + translate("Press enter to continue.");
}
/* The message is translated once here and then spoken as it is, so a copy (C) holds what you heard. A message from
dlgmessage_return() arrives already translated, its ending too. */
bool dlg(string message, bool dlgcoppy=true, bool dlgsound=false, int timeout=-1)
{
timer timeouter;
if (!dlg_translated) message = translate(message); // never twice, so the untranslated lines log never gets a joined one
if(dlgsound==true) temp.play_stationary(get_pack_sound("main/ui/dialog/*error*"),false);
speak(message, tts_default_interrupt, tts_default_text_processing_callback, true, true);
dlg_open = dlgcoppy;
while(true)
{
wait(5);
if (@form_frame_hook != null) form_frame_hook(); // the game's per-frame checks, as every form gets them (form.nvgt)
if (timeout>-1 and timeouter.elapsed>=timeout)
{
dlg_open = false;
return false;
}
if (key_repeating(KEY_C) and dlgcoppy==true)
{
temp.destroy_all();
temp.play_stationary(get_pack_sound("main/ui/dialog/*copy*"),false);
speak("Text copied");
clipboard_copy_text(string_replace(message, dlg_enter_ending(), "", true));
}
if (key_repeating(KEY_LEFT) or key_repeating(KEY_RIGHT) or key_repeating(KEY_UP) or key_repeating(KEY_DOWN))
{
speak(message, tts_default_interrupt, tts_default_text_processing_callback, true, true);
}
if (key_repeating(KEY_ESCAPE))
{
temp.destroy_all();
dlg_open = false;
return true;
}
if(key_repeating(KEY_RETURN))
{
temp.destroy_all();
break;
}
}
dlg_open = false;
return false;
}
void dlgmessage(string messages)
{
temp.play_stationary(get_pack_sound("main/ui/dialog/*open*"),false);
string[] d = string_split(messages, "--", true);
bool escaped = dlg(d[0], dlgsound:false);
if (escaped)
{
temp.play_stationary(get_pack_sound("main/ui/dialog/*close*"),false);
return;
}
for (uint i = 1; i < d.length(); i++)
{
temp.play_stationary(get_pack_sound("main/ui/dialog/*scroll*"),false);
escaped = dlg(d[i], dlgsound:false);
if (escaped)
{
temp.play_stationary(get_pack_sound("main/ui/dialog/*close*"),false);
return;
}
}
temp.play_stationary(get_pack_sound("main/ui/dialog/*close*"),false);
}
void dlgmessage_return(string msg)
{
string shown = translate(msg) + dlg_enter_ending(); // each half translated apart, then joined
dlg_translated = true;
dlgmessage(shown);
dlg_translated = false;
}
