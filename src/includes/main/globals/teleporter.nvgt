/* Player teleporters (dev, 2026-11-03, for 1.2): a risky item that moves you a random way along the belt. On the belt
it works like an ammo pack: its spawn clip, then its loop at its tile; either hand picks it up within
hand_window_start() (get and the player's give, centered) and it goes into the inventory as "player_teleporter".
Arriving on its tile on the ground, landing on it, or a weapon hit breaks it (break) and it's lost; a clean jump over
it misses it. U uses it (use_teleporter()).
Same entity pattern as ammo packs: null-slot removal, reused slots, and only destroy_all_teleporters() shrinks the array. */
sound_pool teleporterpool;
const string teleporter_folder = "equipments/items/common/player_teleporter/";
class teleporter
{
double x;
int lane = 1; // lane_middle until spawned; a random lane since the lanes plan's Section 4 (dev, 2026-11-05)
double countdown_start;
bool spent = false; // picked up, broken or jumped past: nothing more can happen to it
int loopslot = -1;
}
teleporter@[] teleporters(0);

// True when teleporter sounds exist, so the spawner can offer them.
bool teleporters_available()
{
return get_pack_sound(teleporter_folder + "*loop*") != "";
}
// countdown comes from the spawner like a pack's; it sets the pickup window and the spacing.
void spawn_teleporter(double tx, int countdown, int lane = -1)
{
teleporter t;
t.x = tx;
t.countdown_start = tx - countdown;
t.lane = lane < 0 ? random(lane_left, lane_right) : lane;
teleporterpool.play_2d(get_pack_sound(teleporter_folder + "*spawn*"), 0, me.x, lane_across(t.lane, tx), tx, false);
t.loopslot = teleporterpool.play_2d(get_pack_sound(teleporter_folder + "*loop*"), 0, me.x, lane_across(t.lane, tx), tx, true);
place_lane_sound(teleporterpool, t.loopslot, t.lane, t.x);
for (uint i = 0; i < teleporters.length(); i++)
{
if (@teleporters[i] == null)
{
@teleporters[i] = t;
return;
}
}
teleporters.insert_last(t);
}
// Called from hand_check() when nothing else took the press. Picks up the nearest teleporter in its window. True if one was.
bool pick_up_teleporter()
{
teleporter@ target = null;
for (uint i = 0; i < teleporters.length(); i++)
{
if (@teleporters[i] == null) continue;
teleporter@ t = teleporters[i];
if (t.spent or t.lane != current_lane or me.x < hand_window_start(t.x, t.countdown_start) or t.x - me.x < 1) continue;
if (@target == null or t.x < target.x) @target = t;
}
if (@target == null) return false;
target.spent = true;
stop_teleporter(target);
teleporterpool.play_stationary(get_pack_sound(teleporter_folder + "*get*"), false);
p.play_stationary(get_pack_sound("misc/player/*give*"), false);
give_item("player_teleporter", 1);
speak_buffer(item_display_name("player_teleporter"));
return true;
}
/* Runs once per step, right after the move. Arriving on a teleporter's tile on the ground breaks it; once you're past
its tile still unspent, it was jumped cleanly. */
void teleporter_check()
{
for (uint i = 0; i < teleporters.length(); i++)
{
if (@teleporters[i] == null) continue;
teleporter@ t = teleporters[i];
if (!t.spent)
{
if (me.x == t.x and is_grounded() and t.lane == current_lane) break_teleporter(t);
else if (me.x > t.x) t.spent = true; // jumped clean over: its loop carries on and fades behind you
}
if (me.x > t.x + spawn_distance()) remove_teleporter(i);
}
}
// Called from player_land(): landing on a teleporter's tile by mistake breaks it.
void teleporter_landing()
{
for (uint i = 0; i < teleporters.length(); i++)
{
if (@teleporters[i] == null) continue;
if (!teleporters[i].spent and me.x == teleporters[i].x and teleporters[i].lane == current_lane) break_teleporter(teleporters[i]);
}
}
// Weapons break teleporters like packs: a bullet on its tile, or a swing when it's the nearest target.
teleporter@ teleporter_at(double x)
{
for (uint i = 0; i < teleporters.length(); i++)
{
if (@teleporters[i] != null and !teleporters[i].spent and teleporters[i].x == x and teleporters[i].lane == current_lane) return teleporters[i];
}
return null;
}
teleporter@ teleporter_in_reach(int reach)
{
teleporter@ target = null;
for (uint i = 0; i < teleporters.length(); i++)
{
if (@teleporters[i] == null or teleporters[i].spent or teleporters[i].lane != current_lane) continue;
double ahead = teleporters[i].x - me.x;
if (ahead < 1 or ahead > reach) continue;
if (@target == null or teleporters[i].x < target.x) @target = teleporters[i];
}
return target;
}
// A weapon hit on a teleporter: it breaks and is lost. Returns its x, so the weapon's hit plays there.
double strike_teleporter(teleporter@ t)
{
break_teleporter(t);
return t.x;
}
void break_teleporter(teleporter@ t)
{
t.spent = true;
stop_teleporter(t);
teleporterpool.play_stationary(get_pack_sound(teleporter_folder + "*break*"), false); // stationary, so the pitch never drops behind you (dev, 2026-11-05)
}
void stop_teleporter(teleporter@ t)
{
if (t.loopslot > -1) teleporterpool.destroy_sound(t.loopslot);
t.loopslot = -1;
}
void remove_teleporter(uint i)
{
if (i >= teleporters.length() or @teleporters[i] == null) return;
stop_teleporter(teleporters[i]);
@teleporters[i] = null;
}
/* True if a standing obstacle sits exactly on tile x, so a teleport can't land there (dev, 2026-11-03: "It can never
land you exactly on the obstacle, like on top of a hazard."). Things already dealt with (a passed mine, a broken or
crashed wall, an opened or crashed door, a reached force field) don't count; a projectile counts at its meeting tile. */
bool obstacle_on_tile(double x)
{
for (uint i = 0; i < hazards.length(); i++)
{
if (@hazards[i] != null and hazards[i].x == x) return true;
}
for (uint i = 0; i < spikes.length(); i++)
{
if (@spikes[i] != null and spikes[i].x == x) return true;
}
for (uint i = 0; i < mines.length(); i++)
{
if (@mines[i] != null and !mines[i].spent and mines[i].x == x) return true;
}
for (uint i = 0; i < forcefields.length(); i++)
{
if (@forcefields[i] != null and !forcefields[i].spent and forcefields[i].x == x) return true;
}
for (uint i = 0; i < projectiles.length(); i++)
{
if (@projectiles[i] != null and !projectiles[i].spent and projectiles[i].meet_x == x) return true;
}
if (@wall_at(x) != null) return true;
if (@barrier_in_my_lane_at(x) != null) return true; // only one in your lane blocks you
if (@animal_at(x) != null) return true;
for (uint i = 0; i < doors.length(); i++)
{
if (@doors[i] != null and doors[i].x == x and door_standing(doors[i])) return true;
}
return false;
}
/* U on a teleporter (dev, 2026-11-03): moves you a random teleport_min_time to teleport_max_time of belt, in tiles at the
current speed, forward or back half and half, never before tile 0. It's risky by design, so it can drop you right in
front of danger, but a tile holding an obstacle moves on a step the same way until it's clear. Going back, anything
still waiting behind you counts again. Always used, so returns true. */
bool use_teleporter()
{
int steps = int(max(1, round(double(random(teleport_min_time, teleport_max_time)) / current_step_time(), 0)));
int dir = random(0, 1) == 0 ? -1 : 1;
// Never back past the start of the run; with no room behind you at all, it goes forward instead.
if (dir < 0 and me.x < 1) dir = 1;
else if (dir < 0 and me.x - steps < 0) steps = int(me.x);
double target = me.x + dir * steps;
while (obstacle_on_tile(target))
{
target += dir;
if (target < 0)
{
// Backed into the start with no clear tile: go forward from where you are instead.
dir = 1;
target = me.x + 1;
}
}
int moved = int(abs(target - me.x));
p.play_stationary(get_pack_sound(teleporter_folder + "*use*"), false);
cancel_movement();
me.x = target;
update_listeners();
if (dir > 0) spawner_catch_up(); // so what comes next still arrives with its full warning
play_landing(false); // the tile's landing only, like a force field's throw (dev, 2026-11-03)
string where = dir > 0 ? "forward" : "back";
speak_buffer(moved == 1 ? "You were moved " + where + " 1 step." : "You were moved " + where + " " + moved + " steps.");
return true;
}
// The only place allowed to shrink the array.
void destroy_all_teleporters()
{
for (uint i = 0; i < teleporters.length(); i++)
{
if (@teleporters[i] == null) continue;
stop_teleporter(teleporters[i]);
}
teleporters.resize(0);
}
// Runs every frame from item_lane_sounds() (lane.nvgt): keeps each one in its lane as you move and as it nears.
void teleporter_lane_sounds()
{
for (uint i = 0; i < teleporters.length(); i++)
{
if (@teleporters[i] == null or teleporters[i].loopslot < 0) continue;
place_lane_sound(teleporterpool, teleporters[i].loopslot, teleporters[i].lane, teleporters[i].x);
}
}
