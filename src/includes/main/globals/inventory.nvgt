/* The inventory: item counts with a cursor, the previous and next keys to cycle and the use key for the focused item.
There's no inventory menu. It starts empty every run. The cursor is corrected whenever an item runs out, names are
spoken with spaces, and each item's use goes to that item's own function instead of one long branch. */
dictionary inventory;
int invpos = 0;

void clear_inventory()
{
inventory.delete_all();
invpos = 0;
reset_helpers(); // specials.nvgt
reset_shield(); // the current shield goes with the rest (shield.nvgt)
}
// Adds amount of an item (negative to remove); an item at 0 or below leaves the inventory.
void give_item(string item, int amount)
{
int count = 0;
if (inventory.exists(item)) inventory.get(item, count);
count += amount;
if (count <= 0)
{
inventory.delete(item);
if (is_helper_item(item)) set_helper(item, false);
if (item == "steel_shield") reset_shield(); // your last one, so nothing is left on
}
else inventory.set(item, count);
string[] keys = inventory_keys();
if (invpos >= int(keys.length())) invpos = int(max(0, int(keys.length()) - 1));
}
// Moves the cursor onto an item you have, silently: a lane pickup's, whether by hand, the item helper or a slide.
void focus_item(const string&in item)
{
int at = inventory_keys().find(item);
if (at >= 0) invpos = at;
}
int item_count(string item)
{
int count = 0;
if (inventory.exists(item)) inventory.get(item, count);
return count;
}
// The cursor indexes this alphabetically sorted list, so every lookup sorts the same way.
string[] inventory_keys()
{
string[] keys = inventory.get_keys();
keys.sort_ascending();
return keys;
}
// "ammo_pack" is spoken "ammo pack".
string item_display_name(string item)
{
return item.replace("_", " ", true);
}
// Runs every frame from run_input(): the inventory keys, silent like hands and weapons while a door carries you, on a slide, a ladder or a floor breaker's edge.
void inventory_input()
{
if (door_moving or climbing or repairing) return;
if (sliding)
{
sliding_item_note(); // specials.nvgt
return;
}
if (controls.action_triggered("inventory_previous")) cycle_inventory(-1);
else if (controls.action_triggered("inventory_next")) cycle_inventory(1);
if (controls.action_triggered("item_use")) use_item();
}
/* Moves the cursor, wrapping, with the inv sound panned by position across the list, and speaks the item:
"ammo pack. Item 1 of 2", or "ammo packs, 3. Item 1 of 2" when there's more than one. */
void cycle_inventory(int dir)
{
string[] keys = inventory_keys();
if (keys.length() == 0)
{
speak_buffer("Your inventory is empty.", "items");
return;
}
invpos += dir;
if (invpos >= int(keys.length())) invpos = 0;
else if (invpos < 0) invpos = int(keys.length()) - 1;
double pan = keys.length() > 1 ? convert_to_pan(keys.length(), invpos, -25, 25) : 0;
p.play_stationary_extended(get_pack_sound("main/misc/player/*inv*"), false, 0, pan, 0, 100, false);
string item = keys[invpos];
int count = item_count(item);
string name = item_display_name(item);
string position = "Item " + (invpos + 1) + " of " + keys.length() + ".";
string line = count == 1 ? name : name + "s, " + count;
if (is_helper_item(item)) line += helper_active(item) ? ", on" : ", off"; // "item helper, on. Item 1 of 2."
else if (item == "steel_shield") line += shield_worn ? ", on" : ", off"; // "steel shields, 3, on."
speak_buffer(line + ". " + position, "items");
}
// The use key: uses the focused item through that item's own function, which removes it only if it was used.
void use_item()
{
string[] keys = inventory_keys();
if (keys.length() == 0)
{
speak_buffer("You don't have anything to use.", "items");
return;
}
string item = keys[invpos];
// Specials repeat while the use key is held, as every other item does.
if (item == "slide" or item == "trampoline" or item == "power_crystal" or item == "safety_net" or is_helper_item(item))
{
if (is_helper_item(item)) toggle_helper(item);
else if (item == "power_crystal")
{
if (use_power_crystal()) give_item(item, -1);
}
else if (item == "safety_net") speak_buffer("Your safety net will save you from a hazard or floor breaker.", "items"); // it works by itself
else if (item == "slide" ? use_slide_item() : use_trampoline_item()) give_item(item, -1);
return;
}
if (item == "ammo_pack" or item == "gold_pack")
{
// every pack you carry opens at once (ammo.nvgt, goldpack.nvgt), each one counted as used
int opened = item == "ammo_pack" ? use_ammopacks() : use_goldpacks();
for (int i = 0; i < opened; i++) item_used(item);
}
else if (is_key_item(item))
{
if (use_key(item)) item_used(item);
}
else if (item == "steel_shield") toggle_shield(); // it stays in the inventory until it breaks
else if (item == "life_capsule")
{
if (use_capsule()) item_used(item);
}
else if (item == "health_potion")
{
if (use_potion()) item_used(item); // refused at full health, so the potion is kept
}
else if (item == "player_teleporter")
{
if (use_teleporter()) item_used(item);
}
}
// A used item leaves the inventory and counts toward the statistics, keys all as "keys".
void item_used(const string&in item)
{
give_item(item, -1);
stat_add((is_key_item(item) ? "keys" : item + "s") + "_used");
}
// Keys are stored under their color folder's name, such as "red_key", so any item ending in "_key" is a key.
bool is_key_item(string item)
{
return item.length() > 4 and item.substr(item.length() - 4) == "_key";
}
