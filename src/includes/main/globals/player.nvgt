/* The player's jump and crouch. me.y is the height above the belt (0 is the ground). A jump rises to jump_height and
falls back, one height per jump_tick, so it lasts about the same time at any speed. Crouching is held: it ends on
release, or by itself after duck_time. Overlaps: Up while crouched cancels the crouch and jumps at once (no unduck
sound); Down in the air is ignored, but a Down still held on landing starts a crouch. After standing up (or a crouch
cancelled by a jump), crouching is blocked for duck_cooldown so Down can't be spammed. */
int jump_state = 0; // 0 on the ground, 1 rising, 2 falling
bool ducked = false;
timer jumptimer, ducktimer, duckcooldowntimer;

void reset_player()
{
me.y = 0;
jump_state = 0;
ducked = false;
jumptimer.restart();
ducktimer.restart();
duckcooldowntimer.force(duck_cooldown); // a new run can crouch straight away
woosh_pending_side = 0; // no woosh left waiting from the last run
}
bool can_duck()
{
return is_grounded() and !ducked and duckcooldowntimer.elapsed >= duck_cooldown and !door_moving; // not while a door carries you
}
bool is_grounded()
{
return jump_state == 0;
}
bool is_ducked()
{
return ducked;
}
void jump_check()
{
if (controls.action_triggered("jump") and is_grounded() and !door_moving) start_jump(); // no jumping while a door carries you
if (jump_state == 0 or jumptimer.elapsed < current_jump_tick()) return; // Moon Jump and Short Hop change this
jumptimer.restart();
if (jump_state == 1)
{
me.y++;
if (me.y >= jump_height) jump_state = 2;
}
else
{
me.y--;
if (me.y <= 0) player_land();
}
}
void start_jump()
{
if (ducked)
{
ducked = false; // Up while crouched jumps straight away, without the unduck sound
duckcooldowntimer.restart();
}
jump_state = 1;
jumptimer.restart();
p.play_stationary(get_pack_sound("misc/player/*jump*"), false);
p.play_stationary(get_pack_sound("misc/player/*rise*"), false);
}
// Landing from a jump: the landing sounds, and a Down still held starts a crouch.
void player_land()
{
me.y = 0;
jump_state = 0;
play_landing();
ammopack_landing(); // landing on an ammo pack by mistake breaks it
key_landing(); // and so does landing on a key or a shield
shield_landing();
capsule_landing();
potion_landing();
teleporter_landing();
if (controls.action_triggered("duck_held") and can_duck()) start_duck();
}
/* The player's own land sound together with the land clip of the tile under them. A force field's throw and a teleport
pass false, so only the tile is heard (dev, 2026-11-03: it "should not play your character's land sound"). */
void play_landing(bool with_player_sound = true)
{
if (with_player_sound) p.play_stationary(get_pack_sound("misc/player/*land*"), false);
string tile = tile_at(me.x);
if (tile != "") p.play_stationary(get_pack_sound("environments/default/platforms/" + tile + "/*land*"), false);
}
/* Thrown by a force field: any jump or crouch ends silently (no unduck sound) and the player is put on the ground.
The caller moves me.x, then play_landing() runs once the new tile is known. A crouch cut short still starts the
crouch cooldown. */
void cancel_movement()
{
me.y = 0;
jump_state = 0;
if (ducked)
{
ducked = false;
duckcooldowntimer.restart();
}
}
void duck_check()
{
if (ducked and (controls.action_triggered("duck_release") or ducktimer.elapsed >= current_duck_time())) // Long Crouch and Stiff Knees change this
{
stop_duck();
return;
}
if (controls.action_triggered("duck") and can_duck()) start_duck();
}
// "duck*" rather than "*duck*", which would also match unduck.ogg.
void start_duck()
{
ducked = true;
ducktimer.restart();
p.play_stationary(get_pack_sound("misc/player/duck*"), false);
}
void stop_duck()
{
ducked = false;
duckcooldowntimer.restart();
p.play_stationary(get_pack_sound("misc/player/unduck*"), false);
}
