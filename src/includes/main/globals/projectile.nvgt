/* Projectiles: duck-under obstacles that fly toward you (dev, 2026-11-02). Each is timed to a meeting tile, meet_x,
picked by the spawner like any obstacle's tile. Its loop starts as far beyond meet_x as you are before it and flies
toward you at (projectile_speed_factor - 1) times the belt's speed, so it closes in projectile_speed_factor times as
fast as a still obstacle and reaches meet_x on the same step you do; the countdown stays as reliable as anyone's.
On that step, crouched is safe and it flies on behind you; standing or in the air is a hit that costs
projectile_damage (20) through take_damage() and stops its loop. On the last life: its hit, the player's death, then the tile's fall.
Same entity pattern as hazards: null-slot removal, reused slots, and only destroy_all_projectiles() shrinks the array. */
sound_pool projectilepool;
class projectile
{
double meet_x;
string theme;
bool spent = false; // reached meet_x: it can never hit again
int loopslot = -1; // -1 once it has hit you
double countdown_start;
}
projectile@[] projectiles(0);

// countdown comes from the spawner, the same countdown_steps() a hazard's ledge uses.
void spawn_projectile(double mx, string theme, int countdown)
{
projectile pr;
pr.meet_x = mx;
pr.theme = theme;
pr.countdown_start = mx - countdown;
pr.loopslot = projectilepool.play_2d(get_pack_sound("objects/traps/projectiles/" + theme + "/*loop*"), 0, me.x, 0, projectile_x(pr), true);
for (uint i = 0; i < projectiles.length(); i++)
{
if (@projectiles[i] == null)
{
@projectiles[i] = pr;
return;
}
}
projectiles.insert_last(pr);
}
/* Where a projectile is right now. The player's position runs smoothly between steps (me.x plus how far through the
current step they are), so the flight is smooth too, and it passes meet_x exactly as the player arrives there. Past
meet_x the distance goes negative and it carries on behind the player. */
double projectile_x(projectile@ pr)
{
double player_pos = me.x + min(1, double(steptimer.elapsed) / current_step_time());
return pr.meet_x + (projectile_speed_factor - 1) * (pr.meet_x - player_pos);
}
/* Runs every frame: moves each flying loop to its current position. sound_pool's update_sound_2d() rounds to whole
tiles, which would make the flight hop, so the item's x is set directly and re-panned against the pool's listener. */
void projectile_flight()
{
for (uint i = 0; i < projectiles.length(); i++)
{
if (@projectiles[i] == null or projectiles[i].loopslot < 0) continue;
int slot = projectiles[i].loopslot;
if (!projectilepool.verify_slot(slot)) continue;
projectilepool.items[slot].y = float(projectile_x(projectiles[i]));
projectilepool.items[slot].update(projectilepool.last_listener_x, projectilepool.last_listener_y, projectilepool.last_listener_z, projectilepool.last_listener_rotation, projectilepool.max_distance);
}
}
// Runs once per step, right after the move: arriving at meet_x while not crouched is a hit.
void projectile_check()
{
for (uint i = 0; i < projectiles.length(); i++)
{
if (@projectiles[i] == null) continue;
projectile@ pr = projectiles[i];
if (me.x == pr.meet_x and !pr.spent)
{
pr.spent = true;
if (is_ducked()) stat_add("projectiles_ducked"); // crouched as it reaches you: it flies over
if (!is_ducked())
{
string hit_clip = get_pack_sound("objects/traps/projectiles/" + pr.theme + "/*hit*");
stop_projectile(pr); // it hit you: the loop ends at once
/* A fatal hit plays the projectile's hit through p (silence_run() would otherwise cut it off) and no player hit,
since end_run_hit() plays the player's death instead. */
stat_caught("projectiles"); // the statistics: what caught you, and what ended the run if it's fatal
int blow = take_damage(projectile_damage); // a worn shield, else your health
if (blow == blow_fatal)
{
p.play_stationary(hit_clip, false);
end_run_hit();
return;
}
projectilepool.play_2d(hit_clip, 0, me.x, 0, pr.meet_x, false);
if (blow != blow_shielded) p.play_stationary(get_pack_sound("misc/player/*hit*"), false);
}
}
// Ducked under, it flies on behind you until it's as far behind as obstacles appear ahead; then dropped.
if (me.x > pr.meet_x + spawn_distance()) remove_projectile(i);
}
}
// The countdown: one misc/trap/projectiles warn cue per step before each meeting tile (see play_countdown()). Runs once per step.
void projectile_countdown()
{
for (uint i = 0; i < projectiles.length(); i++)
{
if (@projectiles[i] == null) continue;
play_countdown(projectilepool, "projectiles", projectiles[i].meet_x, projectiles[i].countdown_start);
}
}
void stop_projectile(projectile@ pr)
{
if (pr.loopslot > -1) projectilepool.destroy_sound(pr.loopslot);
pr.loopslot = -1;
}
void remove_projectile(uint i)
{
if (i >= projectiles.length() or @projectiles[i] == null) return;
stop_projectile(projectiles[i]);
@projectiles[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_projectiles()
{
for (uint i = 0; i < projectiles.length(); i++)
{
if (@projectiles[i] == null) continue;
stop_projectile(projectiles[i]);
}
projectiles.resize(0);
}
