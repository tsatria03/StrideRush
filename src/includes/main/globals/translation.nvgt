/* Translations, at the speech layer: speak() and speak_buffer() (speech.nvgt) pass every line through translate(), so
nothing in the code is wrapped. A language is a .lng file of English=Translated lines, split at the first "=", with
// comments and blank lines skipped. A line whose English has a * is a wildcard, matched against the whole sentence,
each * taking a value that $1, $2 and on place in the translation. An exact line is looked up first, then the
wildcards in file order; anything with no line stays in English. Languages are read from the player's own lang folder
first, then the game's, so a player's file replaces a shipped one of the same name; template.lng and a file with no
lines are never listed. "fallback" loads no file and speaks the code's own English.
With log_untranslated on, a line no language line covers is written once to the player's lang folder as
<language>.txt, already as an English=English line to fill in, with each number turned into a * on the left and $1, $2
on the right, so a readout is logged once and not once for every value. */
string language = "fallback"; // the General tab's Language list, saved in settings.srf
bool log_untranslated = false; // the General tab's "Log untranslated lines" checkbox, saved in settings.srf
dictionary lang_logged; // the lines already in the chosen language's log, so each is written once
const string lang_dir = "data/lang/";
/* The player's own lang folder, without a trailing slash, as the game's other folders in APPDATA_DIR are made (a
function, so APPDATA_DIR is always set by the time it's read). */
string lang_user_folder()
{
return APPDATA_DIR + "lang";
}
dictionary lang_lines; // each exact English line to its translation
string[][] lang_patterns; // each wildcard line's English, cut at its stars
string[] lang_pattern_out; // and its translation, at the same index

// Every language there is, sorted, without fallback, which the setting adds in front.
string[] language_names()
{
string[] names;
string[] dirs = {lang_user_folder() + "/", lang_dir};
for (uint d = 0; d < dirs.length(); d++)
{
string[] found = find_files(dirs[d] + "*.lng");
for (uint i = 0; i < found.length(); i++)
{
string name = found[i].substr(0, found[i].length() - 4).lower();
if (name == "template" or names.find(name) >= 0) continue;
if (language_file(name) == "") continue;
names.insert_last(name);
}
}
names.sort_ascending();
return names;
}
// The file a language loads from, the player's before the game's, or "" if neither has any lines.
string language_file(const string&in name)
{
string user_path = lang_user_folder() + "/" + name + ".lng";
if (file_exists(user_path) and parse_lng(user_path, false) > 0) return user_path;
string game_path = lang_dir + name + ".lng";
if (file_exists(game_path) and parse_lng(game_path, false) > 0) return game_path;
return "";
}
// Loads a language, replacing the last one. False if it has no file with lines, and then nothing is loaded.
bool load_language(const string&in name)
{
lang_lines.delete_all();
lang_patterns.resize(0);
lang_pattern_out.resize(0);
lang_logged.delete_all();
if (name == "fallback") return true;
string path = language_file(name);
if (path == "") return false;
parse_lng(path, true);
read_lang_log(name);
return true;
}
// Where a language's log of untranslated lines goes.
string lang_log_path(const string&in name)
{
return lang_user_folder() + "/" + name + ".txt";
}
// Remembers the lines a language's log already holds, from earlier sessions.
void read_lang_log(const string&in name)
{
file f;
if (!f.open(lang_log_path(name), "rb")) return;
string[]@ rows = f.read().split("\n");
f.close();
for (uint i = 0; i < rows.length(); i++)
{
string row = rows[i].trim_whitespace();
int eq = row.find_first("=");
if (eq > 0) lang_logged.set(row.substr(0, eq), true);
}
}
/* Writes an untranslated line to the log, numbers as wildcards, once. A single character (typing) and a line with an
"=" or a line break, which can't be written as a line, are skipped. */
void log_missing(const string&in text)
{
if (text.length() < 2 or text.find_first("=") >= 0 or text.find_first("\n") >= 0 or text.find_first("*") >= 0) return;
string english = "", translated = "";
int values = 0;
bool in_number = false;
for (uint i = 0; i < text.length(); i++)
{
string c = text.substr(i, 1);
if (c >= "0" and c <= "9")
{
if (!in_number)
{
values++;
english += "*";
translated += "$" + values;
in_number = true;
}
continue;
}
in_number = false;
english += c;
translated += c;
}
if (lang_logged.exists(english)) return;
lang_logged.set(english, true);
if (!directory_exists(lang_user_folder())) directory_create(lang_user_folder());
file f;
if (!f.open(lang_log_path(language), "ab")) return;
f.write(english + "=" + translated + "\r\n");
f.close();
}
// Counts a .lng file's lines; with keep, also loads them into the lookups.
int parse_lng(const string&in path, bool keep)
{
file f;
if (!f.open(path, "rb")) return 0;
string content = f.read();
f.close();
string bom = ascii_to_character(0xEF) + ascii_to_character(0xBB) + ascii_to_character(0xBF);
if (content.substr(0, 3) == bom) content = content.substr(3); // a UTF-8 byte order mark
string[]@ rows = content.split("\n");
int count = 0;
for (uint i = 0; i < rows.length(); i++)
{
string row = rows[i].trim_whitespace();
if (row.empty() or row.substr(0, 2) == "//") continue;
int eq = row.find_first("=");
if (eq < 1) continue;
string english = row.substr(0, eq).trim_whitespace();
string translated = row.substr(eq + 1).trim_whitespace();
if (english.empty() or translated.empty()) continue;
count++;
if (!keep) continue;
if (english.find_first("*") < 0)
{
lang_lines.set(english, translated);
continue;
}
string[] parts = english.split("*");
lang_patterns.insert_last(parts);
lang_pattern_out.insert_last(translated);
}
return count;
}
// A line in the chosen language: its exact line, else the first wildcard that fits, else the English as it is.
string translate(const string&in text)
{
if (language == "fallback" or text.empty()) return text;
string result;
if (lang_lines.get(text, result)) return result;
for (uint i = 0; i < lang_patterns.length(); i++)
{
string[]@ values = wildcard_match(text, lang_patterns[i]);
if (values is null) continue;
result = lang_pattern_out[i];
for (int v = int(values.length()); v >= 1; v--) result = string_replace(result, "$" + v, values[v - 1], true);
return result;
}
if (log_untranslated) log_missing(text);
return text;
}
/* Whether text fits a wildcard line's English (cut at its stars), as a whole sentence: the first piece starts it, the
last ends it, and the pieces between come in order. Returns what each star stood for, at least a character each, or
null if it doesn't fit. */
string[]@ wildcard_match(const string&in text, const string[]&in parts)
{
uint n = parts.length();
if (n < 2) return null;
string first = parts[0], last = parts[n - 1];
if (text.length() < first.length() + last.length()) return null;
if (text.substr(0, first.length()) != first) return null;
uint stop = text.length() - last.length(); // where the last piece starts
if (text.substr(stop) != last) return null;
string[] values;
uint pos = first.length();
for (uint i = 1; i < n - 1; i++)
{
if (parts[i].empty()) return null; // two stars together
int found = text.find_first(parts[i], pos + 1);
if (found < 0 or uint(found) + parts[i].length() > stop) return null;
values.insert_last(text.substr(pos, uint(found) - pos));
pos = uint(found) + parts[i].length();
}
if (stop <= pos) return null;
values.insert_last(text.substr(pos, stop - pos));
return values;
}
