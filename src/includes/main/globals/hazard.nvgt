/* Hazards: jump-over obstacles that end the run if you're on the ground at the moment you step onto their tile (their
own fall clip is the death). Being in the air at that moment clears it; landing while still over it doesn't count. Each plays its theme's loop at its tile, fading in by distance, and marks a ledge range before and after it.
Entity pattern: removal sets the slot to null (never remove_at) and spawning reuses the first null slot, so the array
stays small in an endless run. Every loop over hazards skips null slots. */
sound_pool hazardpool;
class hazard
{
double x;
string theme;
int loopslot = -1;
double ledge_start, ledge_end;
}
hazard@[] hazards(0);

/* countdown is decided by the spawner when it sets the gap (countdown_steps()), so the floor between obstacles is
guaranteed. A hazard's ledge before covers exactly its countdown steps. */
void spawn_hazard(double hx, string theme, int countdown)
{
hazard h;
h.x = hx;
h.theme = theme;
h.ledge_start = hx - countdown;
h.ledge_end = hx + ledge_after_tiles;
h.loopslot = hazardpool.play_2d(get_pack_sound("objects/traps/hazards/" + theme + "/*loop*"), 0, me.x, 0, hx, true);
for (uint i = 0; i < hazards.length(); i++)
{
if (@hazards[i] == null)
{
@hazards[i] = h;
return;
}
}
hazards.insert_last(h);
}
// Runs once per step, right after the move: stepping onto a hazard's tile while grounded ends the run.
void hazard_check()
{
for (uint i = 0; i < hazards.length(); i++)
{
if (@hazards[i] == null) continue;
if (me.x == hazards[i].x and is_grounded())
{
string fall_clip = get_pack_sound("objects/traps/hazards/" + hazards[i].theme + "/*fall*");
if (practice_run) practice_set_down(hazards[i], fall_clip);
else
{
stat_caught("hazards"); // the statistics: times fell into hazards (dev, 2026-11-06)
end_run_hazard(fall_clip);
}
return;
}
if (me.x == hazards[i].x) stat_add("hazards_jumped"); // in the air on its tile: cleared (a grounded arrival returned above)
// Kept until it's as far behind as obstacles appear ahead, so its loop fades out behind you instead of cutting off.
if (me.x > max(hazards[i].ledge_end, hazards[i].x + spawn_distance())) remove_hazard(i);
}
}
/* A hazard fall in a practice run is a practice death (dev, 2026-11-06, then the practice deaths plan, 2026-11-09: every
practice death gives everything back): the fall plays, "You died.", and you're set down on the ledge just past the
hazard, which is always clear floor, while the hazard stays behind you. practice_death() is in endrun.nvgt. */
void practice_set_down(hazard@ h, const string&in fall_clip)
{
practice_death(h.x + 1, fall_clip);
}
// The countdown: one misc/trap/hazards warn cue per ledge step (see play_countdown() in spawner.nvgt). Runs once per step.
void hazard_countdown()
{
for (uint i = 0; i < hazards.length(); i++)
{
if (@hazards[i] == null) continue;
play_countdown(hazardpool, "hazards", hazards[i].x, hazards[i].ledge_start);
}
}
void remove_hazard(uint i)
{
if (i >= hazards.length() or @hazards[i] == null) return;
hazardpool.destroy_sound(hazards[i].loopslot);
@hazards[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_hazards()
{
for (uint i = 0; i < hazards.length(); i++)
{
if (@hazards[i] == null) continue;
hazardpool.destroy_sound(hazards[i].loopslot);
}
hazards.resize(0);
}
// True if x is on a ledge around any hazard (not the hazard tile itself); tile_at() uses this.
bool on_ledge(double x)
{
for (uint i = 0; i < hazards.length(); i++)
{
if (@hazards[i] == null) continue;
if (x != hazards[i].x and x >= hazards[i].ledge_start and x <= hazards[i].ledge_end) return true;
}
return false;
}
