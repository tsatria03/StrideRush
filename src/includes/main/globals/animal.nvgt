/* Animals (dev, 2026-11-04, for 1.4; the birds plan): a belt-wide trap that only a clap clears. The type is "animals"
(dev: "in the future, you'll be able to scare off other types of animals, such as dogs"); each theme folder in
objects/traps/animals is one animal, and so far they're all birds, bird to bird24. An animal plays its spawn clip at its
tile, then its loop (every theme has its own call), with the layered misc/trap/animals countdown. Clapping (both hands
together, with nothing else for the hands to do) inside its hand window, the same window as a force field's switch,
scares the nearest animal away: a random scare clip at its tile (dev, 2026-11-04: named scare, not flight, since "dogs cannot fly"), and its
loop stops. Reaching one you didn't scare is a blow of animal_damage (10) through take_damage(), with its hit; jumping and
ducking don't help. Belt-wide on purpose, so turning can't dodge it and the clap stays its only answer (dev: "belt wide").
Same entity pattern as the other traps: null-slot removal, reused slots, and only destroy_all_animals() shrinks the array. */
sound_pool animalpool;
const string animal_folder = "objects/traps/animals/"; // the dev's animals folder, birds its only kind so far (2026-11-04)
class animal
{
double x;
string theme;
double countdown_start;
bool spent = false; // scared off or reached: nothing more can happen to it
int loopslot = -1;
}
animal@[] animals(0);

// countdown comes from the spawner like any trap's; it sets the countdown and the clap window.
void spawn_animal(double bx, string theme, int countdown)
{
animal bd;
bd.x = bx;
bd.theme = theme;
bd.countdown_start = bx - countdown;
animalpool.play_2d(get_pack_sound(animal_folder + theme + "/*spawn*"), me_x, 0, bx, 0, false);
bd.loopslot = animalpool.play_2d(get_pack_sound(animal_folder + theme + "/*loop*"), me_x, 0, bx, 0, true);
for (uint i = 0; i < animals.length(); i++)
{
if (@animals[i] == null)
{
@animals[i] = bd;
return;
}
}
animals.insert_last(bd);
}
/* Called from a clap (empty_hand_sound() in forcefield.nvgt): scares away the nearest unspent animal whose hand window
you're in. True if one was scared off. */
bool scare_animal()
{
animal@ target = null;
for (uint i = 0; i < animals.length(); i++)
{
if (@animals[i] == null) continue;
animal@ bd = animals[i];
if (bd.spent or me_x < hand_window_start(bd.x, bd.countdown_start) or bd.x - me_x < 1) continue;
if (@target == null or bd.x < target.x) @target = bd;
}
if (@target == null) return false;
target.spent = true;
stop_animal(target);
animalpool.play_2d(get_pack_sound(animal_folder + target.theme + "/*scare*"), me_x, 0, target.x, 0, false);
return true;
}
// Runs once per step, right after the move: reaching an animal you didn't scare is a blow, in the air or on the ground.
void animal_check()
{
for (uint i = 0; i < animals.length(); i++)
{
if (@animals[i] == null) continue;
animal@ bd = animals[i];
if (me_x == bd.x and !bd.spent)
{
bd.spent = true;
string hit_clip = get_pack_sound(animal_folder + bd.theme + "/*hit*");
stop_animal(bd); // it ran into you: its call ends
int blow = take_damage(animal_damage); // a worn shield, else your health
if (blow == blow_fatal)
{
p.play_stationary(hit_clip, false);
end_run_hit();
return;
}
animalpool.play_2d(hit_clip, me_x, 0, bd.x, 0, false);
if (blow != blow_shielded) p.play_stationary(get_pack_sound("misc/player/*hit*"), false);
}
if (me_x > bd.x + spawn_distance()) remove_animal(i);
}
}
// The countdown: the layered misc/trap/animals cues before each animal still there (see play_countdown()). Runs once per step.
void animal_countdown()
{
for (uint i = 0; i < animals.length(); i++)
{
if (@animals[i] == null or animals[i].spent) continue;
play_countdown(animalpool, "animals", animals[i].x, animals[i].countdown_start);
}
}
// The animal still on tile x, for a teleport's landing check, or null.
animal@ animal_at(double x)
{
for (uint i = 0; i < animals.length(); i++)
{
if (@animals[i] != null and !animals[i].spent and animals[i].x == x) return animals[i];
}
return null;
}
void stop_animal(animal@ bd)
{
if (bd.loopslot > -1) animalpool.destroy_sound(bd.loopslot);
bd.loopslot = -1;
}
void remove_animal(uint i)
{
if (i >= animals.length() or @animals[i] == null) return;
stop_animal(animals[i]);
@animals[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_animals()
{
for (uint i = 0; i < animals.length(); i++)
{
if (@animals[i] == null) continue;
stop_animal(animals[i]);
}
animals.resize(0);
}
