/* The run: the belt carries the player one tile per step, the step interval shrinks over time, and the run ends when
running goes false (quitting from the pause menu now; dying in later sections). start_run() always returns to its
caller, so main()'s loop reopens the main menu without stacking menu calls. */
/* The player (dev, 2026-11-04, the lanes plan's Section 3, "vector me"): me.x is the
distance along the belt in tiles and me.y the jump height (0 is the ground), the meanings me_x and me_y had; the lane
stays in current_lane (lane.nvgt). The engine's vector holds floats. */
vector me;
int step_time = start_step_time;
int lives = starting_lives;
bool running = false;
/* A practice run (the game menu refactor plan's Section 3, dev, 2026-11-05): one obstacle at a fixed speed, and you
can't lose. Set by start_run() before reset_run(), so give_debug_shield() and the spawner see it. */
bool practice_run = false;
timer steptimer, speeduptimer, runtimer;
sound_pool muspool, ambpool;
int musslot = -1, ambslot = -1;
int music_volume = music_start_volume, ambience_volume = ambience_start_volume;

void reset_run(int starting_step_time = start_step_time, int starting_life_count = starting_lives)
{
me.x = 0;
step_time = starting_step_time;
lives = starting_life_count;
reset_health();
steptimer.restart();
speeduptimer.restart();
runtimer.restart();
clear_run_objects();
reset_surface();
reset_player();
reset_weapons();
clear_inventory();
reset_shield();
reset_powerups();
reset_lane();
give_debug_shield(); // after clear_inventory(), so the debug shield isn't wiped
reset_spawner();
reset_heartbeat(); // the heartbeat plan: a fresh heart, its first beat on the run's first frame
update_listeners();
}
/* Normally start_step_time, starting_lives, every obstacle type, and a run that ends when lives run out; the source-only
debug options can start faster, with more lives, with only one obstacle type, or with lives that never run out; a
practice run is a single type at a fixed speed with lives that never run out. difficulty is the endless run's level
(an index into difficulty_names), or -1 for debug and practice runs. */
void start_run(int starting_step_time = start_step_time, int starting_life_count = starting_lives, string only_type = "all", bool can_run_out = true, bool practice = false, int difficulty = -1)
{
practice_run = practice;
set_run_difficulty(difficulty); // before reset_run(), whose reset_spawner() places the first obstacle with the level's floor
set_spawn_only(only_type); // before reset_run(), whose reset_spawner() picks the first obstacle; splits an item's debug lane choice off
lives_can_end = can_run_out;
reset_run(starting_step_time, starting_life_count);
start_run_stats(); // an endless run starts a fresh session (stats.nvgt)
start_run_audio();
running = true;
run_loop();
end_run_stats(); // the session into the lifetime and saved, however the run ended (stats.nvgt)
// Also covers quitting from the pause menu; after a death these were already done and repeating them is harmless.
stop_run_audio();
clear_run_objects();
p.destroy_all();
}
/* The run's music and ambience (the music and ambience plan, dev, 2026-11-06), from objects/audio/tracks and
objects/audio/ambiences (repointed that day from the old, empty musics and sources folders); an empty folder just stays
silent. Every run, restarts and replays included, starts a fresh shuffle and a new random ambience.
- Music is a shuffle (dev: "a playlist behavior that shuffles a track, then plays another one when it ends"): every
  track once, not looping, in a random order, then a fresh order that never opens with the track just played.
- The ambience loops, and every random ambience_min_time to ambience_max_time on runtimer (so pausing freezes it) it
  crossfades over ambience_fade_time to another random one, never the same twice in a row.
musslot and ambslot always hold what's playing now, so the volume keys reach it; a fading-out ambience is amb_old_slot. */
const string tracks_folder = "objects/audio/tracks/";
const string ambiences_folder = "objects/audio/ambiences/";
string[] track_order; // the shuffle: full paths, played from track_pos on
int track_pos = 0;
string current_track = "", current_ambience = "";
int amb_old_slot = -1;
double ambience_change_at = 0, ambience_fade_start = -1; // on runtimer; -1 means no crossfade under way

void start_run_audio()
{
track_order.resize(0);
track_pos = 0;
current_track = "";
play_next_track();
current_ambience = "";
string ambience = pick_ambience();
if (ambience != "") ambslot = ambpool.play_stationary_extended(ambience, true, 0, 0, ambience_volume, 100, false);
current_ambience = ambience;
amb_old_slot = -1;
ambience_fade_start = -1;
ambience_change_at = runtimer.elapsed + random(ambience_min_time, ambience_max_time);
}
void stop_run_audio()
{
muspool.destroy_all();
ambpool.destroy_all();
musslot = -1;
ambslot = -1;
amb_old_slot = -1;
ambience_fade_start = -1;
}
// Runs every frame from run_loop(): the next track when one ends, and the ambience's timer and crossfade.
void run_audio_check()
{
// The run loop doesn't run while the pause menu, F1 or F2 has the music paused, so a paused track never counts as ended.
if (track_order.length() > 0 and !muspool.sound_is_playing(musslot)) play_next_track();
ambience_check();
}
// The next track in the shuffle, shuffling a fresh order when the last one has played.
void play_next_track()
{
if (track_pos >= int(track_order.length())) shuffle_tracks();
if (track_order.length() == 0) return;
current_track = track_order[track_pos];
track_pos += 1;
if (musslot > -1) muspool.destroy_sound(musslot);
musslot = muspool.play_stationary_extended(current_track, false, 0, 0, music_volume, 100, false);
if (musslot < 0) track_order.resize(0); // a track that won't play stops the music for this run, rather than retrying every frame
}
/* Every track in a random order (Fisher-Yates). With more than one track, an order that would open with the track that
just played swaps it with another, so no track plays twice in a row. */
void shuffle_tracks()
{
track_order.resize(0);
track_pos = 0;
string[] names = find_files("sounds/" + tracks_folder + "*");
for (uint i = 0; i < names.length(); i++) track_order.insert_last("sounds/" + tracks_folder + names[i]);
for (int i = int(track_order.length()) - 1; i > 0; i--)
{
int j = random(0, i);
string held = track_order[i];
track_order[i] = track_order[j];
track_order[j] = held;
}
if (track_order.length() > 1 and track_order[0] == current_track)
{
int j = random(1, track_order.length() - 1);
track_order[0] = track_order[j];
track_order[j] = current_track;
}
}
// A random ambience, never the one playing now when there's another to choose.
string pick_ambience()
{
string[] names = find_files("sounds/" + ambiences_folder + "*");
if (names.length() == 0) return "";
string choice = "sounds/" + ambiences_folder + names[random(0, names.length() - 1)];
while (names.length() > 1 and choice == current_ambience) choice = "sounds/" + ambiences_folder + names[random(0, names.length() - 1)];
return choice;
}
// The ambience's timer, then its crossfade: the old one falls ambience_fade_floor decibels while the new one rises to your volume.
void ambience_check()
{
if (current_ambience == "") return;
if (ambience_fade_start < 0)
{
if (runtimer.elapsed < ambience_change_at) return;
string next = pick_ambience();
if (next == "" or next == current_ambience)
{
ambience_change_at = runtimer.elapsed + random(ambience_min_time, ambience_max_time);
return;
}
amb_old_slot = ambslot;
ambslot = ambpool.play_stationary_extended(next, true, 0, 0, ambience_volume - ambience_fade_floor, 100, false);
current_ambience = next;
ambience_fade_start = runtimer.elapsed;
return;
}
double progress = min(1.0, (runtimer.elapsed - ambience_fade_start) / double(ambience_fade_time));
ambpool.update_sound_start_values(ambslot, 0, ambience_volume - ambience_fade_floor * (1 - progress), 100);
if (amb_old_slot > -1) ambpool.update_sound_start_values(amb_old_slot, 0, ambience_volume - ambience_fade_floor * progress, 100);
if (progress < 1) return;
if (amb_old_slot > -1) ambpool.destroy_sound(amb_old_slot);
amb_old_slot = -1;
ambience_fade_start = -1;
ambience_change_at = runtimer.elapsed + random(ambience_min_time, ambience_max_time);
}
void run_loop()
{
while (running)
{
wait(5);
// Jump and crouch first, so a jump pressed on the same frame as a step counts before that step's hazard check.
jump_check();
duck_check();
hand_check(); // also before step_check(), so a switch press on the step's frame counts on the warn5 step
step_check();
if (!running) break; // an obstacle hit on this step ended the run; skip the rest of the frame
spike_swing();
projectile_flight(); // every frame, so a flying projectile moves smoothly between steps
bullet_flight(); // every frame: bullets move on their own 30 ms timing, not the step's
barrier_sounds(); // every frame: a barrier follows your lane and its distance
item_lane_sounds(); // every frame: items in their lanes (the lanes plan's Section 4)
speedup_check();
powerup_timers(); // every frame, so a timed powerup ends on time
powerup_sounds(); // every frame: powerups on the belt replay their sound on a timer
run_audio_check(); // every frame: the next track when one ends, and the ambience's switch and crossfade
heartbeat_check(); // every frame: the heartbeat, faster as you speed up (heartbeat.nvgt)
run_input();
}
}
void step_check()
{
if (steptimer.elapsed < current_step_time()) return; // Slow Motion and Rush Hour shift the normal step_time
steptimer.restart();
me.x += 1;
check_achievements(); // once a step: anything reached so far, steps and time included (achievements.nvgt)
update_listeners();
spawn_check();
// Obstacle contact only on arriving at a tile: in the air at that moment means the obstacle is cleared.
hazard_check();
if (!running) return;
spike_check();
if (!running) return;
mine_check();
if (!running) return;
bool thrown = forcefield_check(); // true if a force field threw the player forward this step
if (!running) return;
projectile_check();
if (!running) return;
wall_check();
if (!running) return;
barrier_check();
if (!running) return;
animal_check();
if (!running) return;
door_check();
if (!running) return;
ammopack_check();
key_check();
shield_check();
capsule_check();
potion_check();
teleporter_check();
powerup_check();
surface_check(); // before the footstep, so a new surface is heard on its first step
// A throw lands with the tile's landing sound instead of a footstep, without the player's own land sound (dev).
if (thrown) play_landing(false);
else play_step();
hazard_countdown();
spike_countdown();
mine_countdown();
forcefield_countdown();
projectile_countdown();
wall_countdown();
barrier_countdown();
animal_countdown();
door_countdown();
}
void speedup_check()
{
if (practice_run) return; // a practice run stays at its chosen speed all run (dev, 2026-11-05: "keep it as is")
if (speeduptimer.elapsed < speedup_period) return;
speeduptimer.restart();
step_time = int(max(run_top_step_time(), step_time - speedup_amount)); // the level's top speed, so insane stops at 75 (difficulty.nvgt)
}
void run_input()
{
// P is the pause menu only, and Escape goes straight to the quit run question (dev, 2026-11-03).
if (controls.action_triggered("quit_run"))
{
quit_run_prompt();
return;
}
if (controls.action_triggered("pause"))
{
pause_menu();
return;
}
/* F1 views the key bindings and F2 opens the settings with only the Game, Menu and Speech tabs (dev, 2026-11-01 and
2026-11-04). Each pauses the run like the pause menu and resumes it silently when closed. */
if (controls.action_triggered("view_bindings"))
{
pause_game();
view_keyboard_bindings();
resume_game();
return;
}
if (controls.action_triggered("settings"))
{
pause_game();
settingsmenu(true);
resume_game();
return;
}
if (controls.action_triggered("info_lives")) speak_health(); // H: health percent and lives
if (controls.action_triggered("info_shield")) speak_shield_strength(); // key_config keeps a plain M quiet during Shift+M (buffer mute)
if (controls.action_triggered("info_distance")) speak_buffer(distance_phrase(), "status");
if (controls.action_triggered("info_speed")) speak_buffer(speed_phrase(), "status");
if (controls.action_triggered("info_time")) speak_buffer("You have been running for " + time_phrase(runtimer.elapsed) + ".", "status");
if (controls.action_triggered("info_heart")) speak_heart_rate(); // B: your heart rate (heartbeat.nvgt)
weapon_input();
inventory_input();
lane_input();
if (controls.action_triggered("music_up")) change_music_volume(volume_change);
if (controls.action_triggered("music_down")) change_music_volume(-volume_change);
if (controls.action_triggered("ambience_up")) change_ambience_volume(volume_change);
if (controls.action_triggered("ambience_down")) change_ambience_volume(-volume_change);
if (controls.action_triggered("heartbeat_up")) change_heartbeat_volume(volume_change);
if (controls.action_triggered("heartbeat_down")) change_heartbeat_volume(-volume_change);
buffercheck();
}
/* C: the speed in steps a second, to one decimal place (dev, 2026-11-06: steps a second instead of "Your speed is 470 ms.",
first rounded down to whole steps, then "I meant switch it to 1 dessimal place, so it says 2.1, 2.2, etc.", since whole
steps read 2 all the way from 500 to 334 ms). current_step_time() keeps it between 500 and 50 ms, so it reads 2.0 to 20.0,
and the speed powerups count. Built from tenths; a whole number reads without its ".0" (dev, 2026-11-06: "I want it to
say 2, unless the speed increases"), so 500 ms is "2" and 470 ms "2.1". */
/* C: steps a second in endless and practice runs, but milliseconds per step in a debug run (dev, 2026-11-08: "speaking
of debug, please make the C key read in milliseconds"), the debug speed menu's own units. A debug run is the one with no
difficulty that isn't practice. */
string speed_phrase()
{
if (run_difficulty < 0 and !practice_run) return "You are running " + current_step_time() + " milliseconds per step.";
int tenths = int(round(10000.0 / current_step_time(), 0));
return "You are running " + tenths_text(tenths) + " steps a second.";
}
// A count of tenths as a number: 21 reads "2.1" and 20 reads "2" (C, and the top speed stats).
string tenths_text(int64 tenths)
{
string amount = "" + (tenths / 10);
if (tenths % 10 != 0) amount += "." + (tenths % 10);
return amount;
}
// Z: the distance in steps, one per tile the belt has carried you (dev, 2026-11-06: "say x steps, not x tiles").
string distance_phrase()
{
int steps = int(me.x);
return steps == 1 ? "You have run 1 step." : "You have run " + steps + " steps.";
}
// "1 minute and 5 seconds", "45 seconds" and so on, for the time readout.
string time_phrase(int64 ms)
{
int total = int(ms / 1000);
int minutes = total / 60;
int seconds = total % 60;
string sec_text = seconds == 1 ? "1 second" : seconds + " seconds";
if (minutes == 0) return sec_text;
string min_text = minutes == 1 ? "1 minute" : minutes + " minutes";
return min_text + " and " + sec_text;
}
// Spoken as "track" plus the music volume and "source" plus the ambience volume, in decibels (for example "track -10").
/* At either end of the range a press does nothing at all, with no speech (dev, 2026-11-06: "When you reach the top and
bottum of a value, it should stop repeating it. Example, pressing home passed 0 keeps saying source 0."). */
void change_music_volume(int delta)
{
int volume = int(max(min_volume, min(0, music_volume + delta)));
if (volume == music_volume) return;
music_volume = volume;
if (musslot > -1) muspool.update_sound_start_values(musslot, 0, music_volume, 100);
speak_buffer("track " + music_volume);
writepreffs(); // remembered for the next launch (dev, 2026-11-04)
}
void change_ambience_volume(int delta)
{
int volume = int(max(min_volume, min(0, ambience_volume + delta)));
if (volume == ambience_volume) return;
ambience_volume = volume;
if (ambslot > -1) ambpool.update_sound_start_values(ambslot, 0, ambience_volume, 100);
speak_buffer("source " + ambience_volume);
writepreffs();
}
