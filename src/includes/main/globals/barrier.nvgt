/* Barriers (dev, 2026-11-04; Section 2 of the lanes plan, first built in 1.3, undone, and brought back for 1.4 on top of
the rebuilt lanes): the one trap that fills a single lane, avoided only by moving to another lane. Jumping, crouching,
weapons and hands don't help. Each barrier is placed in the lane you're in when it appears, about 3 s ahead, and stays
in that lane. Its theme is random among the current environment's traps/barriers/general.
Sound: since Section 3 turned the belt forward (2026-11-05), a barrier's loop is placed like every belt sound, at its
tile along the belt, but across it by its lane relative to yours (barrier_side()): your lane is straight ahead, one
lane over is to that side, two lanes over further. It gets louder as it nears and falls behind you once passed,
lower in pitch. (Before, while the belt still ran to the right, it played stationary with its own pan and fade.)
Countdown: the barriers countdown layered warn set, but only on steps where you're in its lane, so the cues stop once
you've moved out and start again if you move back in.
Arriving on its tile in its lane is a blow of barrier_damage (80) through take_damage(), with its hit, and its loop
still passes through and fades behind you, like a spike's (dev, 2026-11-05); in another lane it just passes.
Barriers are in obstacle_types, an equal pick in "all" and the real game, with the "multiple lanes" rule below; the
three barrier debug choices still pick one rule each.
Same entity pattern as the other traps: null-slot removal, reused slots, and only destroy_all_barriers() shrinks the array. */
sound_pool barrierpool;
// Where an environment keeps its barriers themes (env.nvgt).
string barrier_folder(const string&in env)
{
return trap_folder(env, "barriers");
}
class barrier
{
double x;
int lane;
string theme;
string env; // the environment it spawned in, for its sounds after a switch (env.nvgt)
double countdown_start;
bool spent = false; // reached: it can never hit again
int loopslot = -1;
}
barrier@[] barriers(0);

// True when barrier sounds exist, so the spawner can offer them.
bool barriers_available()
{
return get_pack_sound_folders(barrier_folder(current_env) + "*").length() > 0;
}
/* One barrier spawn, from place_obstacle() (dev, 2026-11-04):
- "barriers" (debug): a single barrier in the lane you're in right now, for testing hits.
- "barriers, random lanes" (debug): a single barrier in any of the three lanes.
- "barriers, multiple lanes" (debug) and the real game: a random lane, and barrier_pair_percent of the time a second barrier
  beside it in a different lane, with its own random theme. Two never share a lane, so one lane is always open (dev: "I
  highly recommend making them random in the real game so it's not super predictable"; "sometimes 2 of them can
  appear, but one of them has to be on the lane you are not at"). */
void spawn_barriers(double bx, string theme, int countdown)
{
if (spawn_only == "barriers")
{
spawn_barrier(bx, theme, countdown, current_lane);
return;
}
int first = random(lane_left, lane_right);
spawn_barrier(bx, theme, countdown, first);
if (spawn_only == "barriers_random" or random(1, 100) > barrier_pair_percent) return;
int second = random(lane_left, lane_right - 1);
if (second >= first) second += 1; // any lane but the first one's
string[] themes = get_pack_sound_folders(barrier_folder(current_env) + "*");
spawn_barrier(bx, themes[random(0, themes.length() - 1)], countdown, second);
}
// countdown comes from the spawner like any trap's; lane is decided by spawn_barriers().
void spawn_barrier(double bx, string theme, int countdown, int lane)
{
barrier b;
b.x = bx;
b.lane = lane;
b.theme = theme;
b.env = current_env;
b.countdown_start = bx - countdown;
b.loopslot = barrierpool.play_2d(get_pack_sound(barrier_folder(current_env) + theme + "/*loop*"), 0, me.x, barrier_side(b), b.x, true);
place_barrier(b);
for (uint i = 0; i < barriers.length(); i++)
{
if (@barriers[i] == null)
{
@barriers[i] = b;
return;
}
}
barriers.insert_last(b);
}
/* Its place across the belt, relative to you, in lanes: 0 in your lane (straight ahead), 1 or 2 to the right, -1 or -2
to the left. barrierpool's pan_step (lane_pan_step) turns one lane into the pan of 50 the stationary version used. */
int barrier_side(barrier@ b)
{
return b.lane - current_lane;
}
/* Runs every frame from run_loop(): keeps each loop on its side as you change lanes and as it nears. */
void barrier_sounds()
{
for (uint i = 0; i < barriers.length(); i++)
{
if (@barriers[i] == null or barriers[i].loopslot < 0) continue;
place_barrier(barriers[i]);
}
}
/* Where a barrier's loop sits: by its lane relative to yours, at a fixed angle under HRTF (dev, 2026-11-05: left and
right barriers sounded "sort of in the front, but not quite"). The placement is shared with the lane items:
place_lane_sound() in lane.nvgt. */
void place_barrier(barrier@ b)
{
place_lane_sound(barrierpool, b.loopslot, b.lane, b.x);
}
// Runs once per step, right after the move: arriving on its tile in its lane is a blow; in another lane it passes.
void barrier_check()
{
for (uint i = 0; i < barriers.length(); i++)
{
if (@barriers[i] == null) continue;
barrier@ b = barriers[i];
if (me.x == b.x and !b.spent)
{
b.spent = true;
if (b.lane != current_lane) stat_add("barriers_dodged"); // it reached you in another lane
if (b.lane == current_lane)
{
string hit_clip = get_pack_sound(barrier_folder(b.env) + b.theme + "/*hit*");
// Its loop carries on through you and fades behind, like a spike's (dev, 2026-11-05); a fatal hit silences the run anyway.
stat_caught("barriers"); // the statistics: what caught you, and what ended the run if it's fatal
int blow = take_damage(barrier_damage); // a worn shield, else your health
if (blow == blow_fatal)
{
p.play_stationary(hit_clip, false);
end_run_hit();
return;
}
barrierpool.play_stationary(hit_clip, false);
if (blow != blow_shielded) p.play_stationary(get_pack_sound("misc/player/*hit*"), false);
}
}
// Kept sounding until it's as far behind as obstacles appear ahead, so a dodged one fades out behind you.
if (me.x > b.x + spawn_distance()) remove_barrier(i);
}
}
// The countdown: the layered barriers countdown cues, only on steps where you're in its lane. Runs once per step.
void barrier_countdown()
{
for (uint i = 0; i < barriers.length(); i++)
{
if (@barriers[i] == null or barriers[i].lane != current_lane) continue;
play_countdown(barrierpool, "barriers", barriers[i].x, barriers[i].countdown_start, barriers[i].env);
}
}
// The standing barrier on tile x in your lane, for a teleport's landing check, or null.
barrier@ barrier_in_my_lane_at(double x)
{
for (uint i = 0; i < barriers.length(); i++)
{
if (@barriers[i] != null and !barriers[i].spent and barriers[i].x == x and barriers[i].lane == current_lane) return barriers[i];
}
return null;
}
void stop_barrier(barrier@ b)
{
if (b.loopslot > -1) barrierpool.destroy_sound(b.loopslot);
b.loopslot = -1;
}
void remove_barrier(uint i)
{
if (i >= barriers.length() or @barriers[i] == null) return;
stop_barrier(barriers[i]);
@barriers[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_barriers()
{
for (uint i = 0; i < barriers.length(); i++)
{
if (@barriers[i] == null) continue;
stop_barrier(barriers[i]);
}
barriers.resize(0);
}
