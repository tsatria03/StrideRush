/* Barriers (dev, 2026-11-04; Section 2 of the lanes plan, first built in 1.3, undone, and brought back for 1.4 on top of
the rebuilt lanes): the one trap that fills a single lane, avoided only by moving to another lane. Jumping, crouching,
weapons and hands don't help. Each barrier is placed in the lane you're in when it appears, about 3 s ahead, and stays
in that lane. Its theme is random among objects/traps/barriers.
Sound: the belt still runs left to right until Section 3 turns it forward, so anything placed along it is heard to the
right, which would hide its lane. So a barrier's loop plays stationary instead (Section 3 replaces this): panned by its lane relative to yours
(your lane centred, one lane over to that side, two lanes over further), and louder as it nears, by how far away it
is in time (barrier_fade_ms of running per decibel), much as it would sound with the belt turned forward.
Countdown: the misc/trap/barriers layered warn set, but only on steps where you're in its lane, so the cues stop once
you've moved out and start again if you move back in.
Arriving on its tile in its lane is a blow of barrier_damage (80) through take_damage(), with its hit; in another lane
it passes and fades behind you.
For now barriers spawn only under the "barriers" debug spawn choice, not in "all" or the real game, until Section 3
turns the belt forward (dev, 2026-11-04).
Same entity pattern as the other traps: null-slot removal, reused slots, and only destroy_all_barriers() shrinks the array. */
sound_pool barrierpool;
const string barrier_folder = "objects/traps/barriers/";
class barrier
{
double x;
int lane;
string theme;
double countdown_start;
bool spent = false; // reached: it can never hit again
int loopslot = -1;
}
barrier@[] barriers(0);

// True when barrier sounds exist, so the spawner can offer them.
bool barriers_available()
{
return get_pack_sound_folders(barrier_folder + "*").length() > 0;
}
/* One barrier spawn, from place_obstacle() (dev, 2026-11-04):
- "barriers" (debug): a single barrier in the lane you're in right now, for testing hits.
- "barriers, random lanes" (debug): a single barrier in any of the three lanes.
- "barriers, multiple lanes" (debug) and the real game: a random lane, and barrier_pair_percent of the time a second barrier
  beside it in a different lane, with its own random theme. Two never share a lane, so one lane is always open (dev: "I
  highly recommend making them random in the real game so it's not super predictable"; "sometimes 2 of them can
  appear, but one of them has to be on the lane you are not at"). */
void spawn_barriers(double bx, string theme, int countdown)
{
if (spawn_only == "barriers")
{
spawn_barrier(bx, theme, countdown, current_lane);
return;
}
int first = random(lane_left, lane_right);
spawn_barrier(bx, theme, countdown, first);
if (spawn_only == "barriers_random" or random(1, 100) > barrier_pair_percent) return;
int second = random(lane_left, lane_right - 1);
if (second >= first) second += 1; // any lane but the first one's
string[] themes = get_pack_sound_folders(barrier_folder + "*");
spawn_barrier(bx, themes[random(0, themes.length() - 1)], countdown, second);
}
// countdown comes from the spawner like any trap's; lane is decided by spawn_barriers().
void spawn_barrier(double bx, string theme, int countdown, int lane)
{
barrier b;
b.x = bx;
b.lane = lane;
b.theme = theme;
b.countdown_start = bx - countdown;
b.loopslot = barrierpool.play_stationary_extended(get_pack_sound(barrier_folder + theme + "/*loop*"), true, 0, barrier_pan(b), barrier_volume(b), 100, false);
for (uint i = 0; i < barriers.length(); i++)
{
if (@barriers[i] == null)
{
@barriers[i] = b;
return;
}
}
barriers.insert_last(b);
}
// Its side, relative to your lane: centred in your lane, lane_pan_amount per lane to its side (lane_pan() in lane.nvgt).
float barrier_pan(barrier@ b)
{
return lane_pan(b.lane);
}
// Quieter the further it is, ahead or behind, counted in time at the current speed, never below min_volume.
float barrier_volume(barrier@ b)
{
double away_ms = abs(b.x - me_x) * current_step_time();
return float(max(min_volume, -away_ms / barrier_fade_ms));
}
// Runs every frame from run_loop(): each loop follows your lane and the distance, so a lane change is heard at once.
void barrier_sounds()
{
for (uint i = 0; i < barriers.length(); i++)
{
if (@barriers[i] == null or barriers[i].loopslot < 0) continue;
barrierpool.update_sound_start_values(barriers[i].loopslot, barrier_pan(barriers[i]), barrier_volume(barriers[i]), 100);
}
}
// Runs once per step, right after the move: arriving on its tile in its lane is a blow; in another lane it passes.
void barrier_check()
{
for (uint i = 0; i < barriers.length(); i++)
{
if (@barriers[i] == null) continue;
barrier@ b = barriers[i];
if (me_x == b.x and !b.spent)
{
b.spent = true;
if (b.lane == current_lane)
{
string hit_clip = get_pack_sound(barrier_folder + b.theme + "/*hit*");
stop_barrier(b); // it hit you: the loop ends at once
int blow = take_damage(barrier_damage); // a worn shield, else your health
if (blow == blow_fatal)
{
p.play_stationary(hit_clip, false);
end_run_hit();
return;
}
barrierpool.play_stationary(hit_clip, false);
if (blow != blow_shielded) p.play_stationary(get_pack_sound("misc/player/*hit*"), false);
}
}
// Kept sounding until it's as far behind as obstacles appear ahead, so a dodged one fades out behind you.
if (me_x > b.x + spawn_distance()) remove_barrier(i);
}
}
// The countdown: the layered misc/trap/barriers cues, only on steps where you're in its lane. Runs once per step.
void barrier_countdown()
{
for (uint i = 0; i < barriers.length(); i++)
{
if (@barriers[i] == null or barriers[i].lane != current_lane) continue;
play_countdown(barrierpool, "barriers", barriers[i].x, barriers[i].countdown_start);
}
}
// The standing barrier on tile x in your lane, for a teleport's landing check, or null.
barrier@ barrier_in_my_lane_at(double x)
{
for (uint i = 0; i < barriers.length(); i++)
{
if (@barriers[i] != null and !barriers[i].spent and barriers[i].x == x and barriers[i].lane == current_lane) return barriers[i];
}
return null;
}
void stop_barrier(barrier@ b)
{
if (b.loopslot > -1) barrierpool.destroy_sound(b.loopslot);
b.loopslot = -1;
}
void remove_barrier(uint i)
{
if (i >= barriers.length() or @barriers[i] == null) return;
stop_barrier(barriers[i]);
@barriers[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_barriers()
{
for (uint i = 0; i < barriers.length(); i++)
{
if (@barriers[i] == null) continue;
stop_barrier(barriers[i]);
}
barriers.resize(0);
}
