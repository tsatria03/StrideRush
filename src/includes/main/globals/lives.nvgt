/* Health and lives (dev, 2026-11-03, for 1.2). You have player_health, out of player_hp, as well as lives. Every blow
but a hazard goes through take_damage(): a worn shield takes it first; otherwise it comes off your health, and at 0 you
lose a life and start the next one at full health, or the run ends on your last life. Damage past 0 is dropped (dev:
"It should not carry into the next life"). Hazards end the run outright and never come through here. */
/* False only from the source-only debug options (dev, 2026-11-02): blows can then never end the run, and lives stop
going down at 1 (0 health on the last life just refills it). Hazards still end it. Set by start_run(). */
bool lives_can_end = true;
int player_health = player_hp;

// What a blow did, so the caller plays the right sounds.
const int blow_shielded = 0; // a worn shield took it: only the obstacle's hit (the shield's own hit or death already played)
const int blow_hurt = 1; // it came off your health: the obstacle's hit and the player's hit
const int blow_life_lost = 2; // your health ran out and a life went (the life sound already played): the obstacle's hit and the player's hit
const int blow_fatal = 3; // your health ran out on your last life: the caller plays its fatal ending

/* Called from reset_run(): every run starts at full health, except the "health potions" debug run, which starts at half
so there's something to heal (dev, 2026-11-04). spawn_only is set before reset_run(). */
void reset_health()
{
player_health = spawn_only == "health_potions" ? player_hp / 2 : player_hp;
}
/* One blow of damage from anything but a hazard. On blow_fatal, lives is 0 and the caller plays the obstacle's hit
through p and calls end_run_hit(), as a fatal hit always has. */
int take_damage(int damage)
{
if (shield_absorb(damage)) return blow_shielded;
player_health -= powerup_damage(damage, "Tough Hide", "Soft Hide"); // halved or doubled by the health powerups
if (player_health > 0) return blow_hurt;
if (lives_can_end and lives <= 1)
{
player_health = 0;
lives = 0;
return blow_fatal;
}
player_health = player_hp; // the next life starts at full health
/* A debug run with lives that can't end, on its last life: nothing is lost, so health just refills, with no life sound
(bug found by the dev, 2026-11-04: it played life.ogg anyway). */
if (lives <= 1) return blow_hurt;
lives -= 1; // a life goes whenever there's one to spare
p.play_stationary(get_pack_sound("misc/player/*life*"), false);
return blow_life_lost;
}
// H: "70 percent health remaining, 2 lives." in SimpleFighter's percent format (dev, 2026-11-03).
void speak_health()
{
int percent = int(round(100.0 * player_health / player_hp, 0));
speak_buffer(percent + " percent health remaining, " + (lives == 1 ? "1 life." : lives + " lives."), "status");
}
