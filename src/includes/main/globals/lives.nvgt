/* Health and lives. You have player_health, out of max_health(), as well as lives. Every blow but a hazard or a floor
breaker's fall goes through take_damage(): a worn shield takes it first; otherwise it comes off your health, and at 0
you lose a life and start the next one at full health, or the run ends on your last life. Damage past 0 is dropped,
never carried into the next life. */
/* False only from the source-only debug options: blows can then never end the run, and lives stop going down at 1 (0
health on the last life just refills it). Hazards still end it. Set by start_run(). */
bool lives_can_end = true;
int player_health = player_hp;

// What a blow did, so the caller plays the right sounds.
const int blow_shielded = 0; // a worn shield took it: only the obstacle's hit (the shield's own hit or death already played)
const int blow_hurt = 1; // it came off your health: the obstacle's hit and the player's hit
const int blow_life_lost = 2; // your health ran out and a life went (the life sound already played): the obstacle's hit and the player's hit
const int blow_fatal = 3; // your health ran out on your last life: the caller plays its fatal ending

/* Called from reset_run(): every run starts at full health, except the "health potions" debug run, which starts at half
so there's something to heal. spawn_only is set before reset_run(). */
void reset_health()
{
player_health = spawn_only == "health_potions" ? player_hp / 2 : max_health(); // a free run's set health (freerun.nvgt)
}
/* One blow of damage from anything but a hazard. On blow_fatal, lives is 0 and the caller plays the obstacle's hit
through p and calls end_run_hit(), as a fatal hit always has. */
int take_damage(int damage)
{
damage = level_damage(damage); // the level's share first: 60 percent on easy up to the full amount on chaos (difficulty.nvgt)
if (shield_absorb(damage))
{
joystick_rumble(rumble_shield);
return blow_shielded;
}
int dealt = powerup_damage(damage, "Tough Hide", "Soft Hide"); // halved or doubled by the health powerups
stat_add("damage_taken", dealt < player_health ? dealt : player_health); // only what your health had to lose, as damage past 0 is dropped
player_health -= dealt;
if (player_health > 0)
{
joystick_rumble(rumble_hurt);
return blow_hurt;
}
if (((lives_can_end and !free_no_deaths()) or practice_deaths()) and lives <= 1) // a free run on no deaths refills instead (freerun.nvgt); in practice, or a free run on practice deaths, this is a practice death (end_run_hit())
{
player_health = 0;
lives = 0;
stat_add("lives_lost"); // the last one
return blow_fatal;
}
player_health = max_health(); // the next life starts at full health, a free run's set amount
// Lives that can't end, on the last life: nothing is lost, so health just refills, with no life sound.
if (lives <= 1)
{
joystick_rumble(rumble_hurt);
return blow_hurt;
}
lives -= 1; // a life goes whenever there's one to spare
stat_add("lives_lost");
p.play_stationary(get_pack_sound("main/misc/player/*life*"), false);
joystick_rumble(rumble_life);
return blow_life_lost;
}
/* Health or shield as the Game tab's format says (health_format, shield_format in dec.nvgt), in every kind of run: 0
"70 percent", 1 "350 of 500", 2 "70 percent, 350 of 500". H, M, the session statuses and the potion build on it. */
string format_readout(int format, int now, int full)
{
int percent = int(round(100.0 * now / full, 0));
if (format == 1) return now + " of " + full;
if (format == 2) return percent + " percent, " + now + " of " + full;
return percent + " percent";
}
// H: "70 percent health remaining, 2 lives.", or with the amount, "350 of 500 health remaining, 2 lives."
void speak_health()
{
string life_text = lives == 1 ? "1 life." : lives + " lives.";
speak_buffer(format_readout(health_format, player_health, max_health()) + " health remaining, " + life_text, "status");
}
