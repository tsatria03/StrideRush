/* Places obstacles ahead of the player as the run goes. The type (hazards, spikes, mines, force fields, projectiles, walls or fake doors) and its theme are random, real doors come at each speed mark,
from whatever folders exist at runtime. The next obstacle's type and countdown length are decided together with the
gap to it, so the floor before its countdown is always there however the speed changes. Every type counts down; only
hazards turn their countdown steps into ledge tiles. */
double next_spawn_x = 0;
string next_type = "";
int next_countdown = 0;
// Every obstacle type the spawner knows; a new type is added here. The spawn debug option lists these too.
string[] obstacle_types = {"hazards", "spikes", "mines", "force_fields", "projectiles", "walls", "fake_doors", "animals"};
/* The next 50 ms speed mark that gets a real door (dev, 2026-11-03): the first mark below the run's starting speed,
then door_section_ms lower each time one is placed, until it passes min_step_time. Real doors come at these marks in
every normal run; a debug run limited to one type gets none (the "real doors" debug choice spawns only them). */
int next_door_mark = 0;
/* One key before each real door (dev, 2026-11-03). next_key_door is the door mark the next key belongs to, and the key
comes once step_time reaches next_key_mark, a random point in the first half of the stretch before that door. */
int next_key_door = 0;
int next_key_mark = 0;
// Debug option only: "real doors" alternates a key and a door, so every door has its key.
bool key_before_door = true;
// Items the spawner places too: ammo packs, shields, capsules, teleporters and powerups at lower chances (their _chance values), keys before each real door; listed after the obstacles in the spawn debug option.
string[] item_types = {"ammo_packs", "keys", "steel_shields", "life_capsules", "health_potions", "player_teleporters", "powerups"};
// "all", or one type from obstacle_types or item_types; set by start_run(). Only the source-only debug options pick anything but all.
string spawn_only = "all";

// The first obstacle sits a full spawn distance, its countdown and a minimum stretch of floor into the run.
void reset_spawner()
{
next_door_mark = ((step_time - 1) / door_section_ms) * door_section_ms; // 500 gives 450, 400 gives 350
next_key_door = next_door_mark;
set_key_mark();
key_before_door = true;
choose_next_obstacle();
next_spawn_x = spawn_distance() + next_countdown + floor_tiles(min_floor_time);
}
/* Picks the next obstacle's type at random among the trap folders that have themes (only spawn_only's type, unless it's
"all"), and its countdown length. */
void choose_next_obstacle()
{
// Debug option only: "real doors" in the spawn menu makes the spawns a key, then a real door, in turn, so opening one needn't wait for a mark.
if (spawn_only == "real_doors")
{
if (key_before_door and keys_available()) next_type = "keys";
else next_type = doors_available() ? "real_doors" : "";
key_before_door = next_type != "keys";
next_countdown = countdown_steps();
return;
}
// Debug option only: "keys" makes every spawn a key.
if (spawn_only == "keys")
{
next_type = keys_available() ? "keys" : "";
next_countdown = next_type == "" ? 0 : countdown_steps();
return;
}
/* Debug option only: "barriers" makes every spawn a barrier. Barriers aren't in obstacle_types, so they stay out of "all"
and the real game until the lanes plan's Section 3 turns the belt forward (dev, 2026-11-04). */
if (spawn_only == "barriers" or spawn_only == "barriers_random" or spawn_only == "barriers_multiple")
{
next_type = barriers_available() ? "barriers" : "";
next_countdown = next_type == "" ? 0 : countdown_steps();
return;
}
/* A new speed section has started: its real door comes next, ahead of anything else. Only in a normal run ("all"): a
single-type debug run spawns strictly that type (dev, 2026-11-03), except "real doors, spread", which is the marks alone. */
bool marks_on = spawn_only == "all" or spawn_only == "real_doors_spread";
// The key for the next real door comes first, so it's always on the belt before its door.
if (marks_on and key_due())
{
next_type = "keys";
next_key_door -= door_section_ms;
set_key_mark();
next_countdown = countdown_steps();
return;
}
if (marks_on and next_door_mark >= min_step_time and step_time <= next_door_mark and doors_available())
{
next_type = "real_doors";
next_door_mark -= door_section_ms;
next_countdown = countdown_steps();
return;
}
// Debug option only: "real doors, spread" spawns nothing but the real doors at the marks, so the slots in between stay empty.
if (spawn_only == "real_doors_spread")
{
next_type = "";
next_countdown = 0;
return;
}
string[] available;
for (uint i = 0; i < obstacle_types.length(); i++)
{
if (spawn_only != "all" and obstacle_types[i] != spawn_only) continue;
if (get_pack_sound_folders(type_folder(obstacle_types[i]) + "*").length() > 0) available.insert_last(obstacle_types[i]);
}
// About one spawn in ammo_pack_chance is an ammo pack instead, or every one when the debug options picked packs only.
bool packs_ok = ammopacks_available() and (spawn_only == "all" or spawn_only == "ammo_packs");
// About one in shield_chance is a steel shield, rolled first, or every one when the debug options picked shields only.
bool shields_ok = shields_available() and (spawn_only == "all" or spawn_only == "steel_shields");
// Capsules and teleporters the same way, rolled before the shield.
bool capsules_ok = capsules_available() and (spawn_only == "all" or spawn_only == "life_capsules");
bool potions_ok = potions_available() and (spawn_only == "all" or spawn_only == "health_potions");
bool teleporters_ok = teleporters_available() and (spawn_only == "all" or spawn_only == "player_teleporters");
bool powerups_ok = powerups_available() and (spawn_only == "all" or spawn_only == "powerups");
if (spawn_only == "ammo_packs") next_type = packs_ok ? "ammo_packs" : "";
else if (spawn_only == "steel_shields") next_type = shields_ok ? "steel_shields" : "";
else if (spawn_only == "life_capsules") next_type = capsules_ok ? "life_capsules" : "";
else if (spawn_only == "health_potions") next_type = potions_ok ? "health_potions" : "";
else if (spawn_only == "player_teleporters") next_type = teleporters_ok ? "player_teleporters" : "";
else if (spawn_only == "powerups") next_type = powerups_ok ? "powerups" : "";
else if (capsules_ok and random(1, life_capsule_chance) == 1) next_type = "life_capsules";
else if (potions_ok and random(1, health_potion_chance) == 1) next_type = "health_potions";
else if (teleporters_ok and random(1, teleporter_chance) == 1) next_type = "player_teleporters";
else if (powerups_ok and random(1, powerup_chance) == 1) next_type = "powerups";
else if (shields_ok and random(1, shield_chance) == 1) next_type = "steel_shields";
else if (packs_ok and random(1, ammo_pack_chance) == 1) next_type = "ammo_packs";
else next_type = available.length() > 0 ? available[random(0, available.length() - 1)] : "";
next_countdown = next_type == "" ? 0 : countdown_steps();
}
// A random point in the first half of the stretch before next_key_door: 50 ms sections give 475 to 500 before the 450 door.
void set_key_mark()
{
next_key_mark = next_key_door + door_section_ms / 2 + random(0, door_section_ms / 2);
}
// True when the next real door's key should be placed: its door is still to come and the speed has reached its mark.
bool key_due()
{
return keys_available() and next_key_door >= min_step_time and step_time <= next_key_mark;
}
// Where a type's theme folders live: doors in door_folder, everything else (animals included) in objects/traps/<type>.
string type_folder(string type)
{
if (type == "fake_doors" or type == "real_doors") return door_folder;
return "objects/traps/" + type + "/";
}
// The countdown before an obstacle (and an item's spacing and pickup window): countdown_length steps at any speed.
int countdown_steps()
{
return countdown_length;
}
// spawn_ahead_time at the current speed, in tiles.
int spawn_distance()
{
return int(ceil(double(spawn_ahead_time) / current_step_time()));
}
// A length of floor as time at the current speed, never under min_floor_tiles.
int floor_tiles(int ms)
{
return int(max(min_floor_tiles, ceil(double(ms) / current_step_time())));
}
/* The gap from one obstacle to the next: room for a hazard's ledge after (kept for every type, to be safe), a random
stretch of normal floor (min_floor_time to max_floor_time), the next one's countdown, and its tile. */
int next_gap(int countdown)
{
int floor_len = random(floor_tiles(min_floor_time), floor_tiles(max_floor_time));
return int(max(min_gap_tiles, ledge_after_tiles + floor_len + countdown + 1));
}
/* After a forward teleport: the next obstacle may now be due on or just ahead of you, with no warning. Pushes it ahead
so it's placed on the next step a full spawn distance and countdown away, as if you'd run there. */
void spawner_catch_up()
{
next_spawn_x = max(next_spawn_x, me_x + spawn_distance() + next_countdown + 1);
}
// An obstacle appears spawn_distance() before its countdown starts, so its sound comes first.
void spawn_check()
{
if (me_x + spawn_distance() + next_countdown < next_spawn_x) return;
place_obstacle(next_spawn_x, next_type, next_countdown);
string placed = next_type;
choose_next_obstacle();
next_spawn_x += next_gap(next_countdown);
// A force field's throw needs room after it, so the gap after one gets that many extra tiles.
if (placed == "force_fields") next_spawn_x += forcefield_knockback_tiles;
}
void place_obstacle(double x, string type, int countdown)
{
if (type == "") return;
if (type == "ammo_packs")
{
spawn_ammopack(x, countdown); // one sound set, no themes
return;
}
if (type == "keys")
{
spawn_key(x, countdown); // its color is picked in spawn_key()
return;
}
if (type == "steel_shields")
{
spawn_shield(x, countdown); // one sound set, no themes
return;
}
if (type == "life_capsules")
{
spawn_capsule(x, countdown);
return;
}
if (type == "health_potions")
{
spawn_potion(x, countdown);
return;
}
if (type == "player_teleporters")
{
spawn_teleporter(x, countdown);
return;
}
if (type == "powerups")
{
spawn_powerup(x, countdown); // ground or flight is picked in spawn_powerup()
return;
}
string[] themes = get_pack_sound_folders(type_folder(type) + "*");
if (themes.length() == 0) return;
string theme = themes[random(0, themes.length() - 1)];
if (type == "real_doors" or type == "fake_doors")
{
spawn_door(x, theme, type == "real_doors", countdown);
return;
}
if (type == "hazards") spawn_hazard(x, theme, countdown);
else if (type == "spikes") spawn_spike(x, theme, countdown);
else if (type == "mines") spawn_mine(x, theme, countdown);
else if (type == "force_fields") spawn_forcefield(x, theme, countdown);
else if (type == "projectiles") spawn_projectile(x, theme, countdown);
else if (type == "walls") spawn_wall(x, theme, countdown);
else if (type == "animals") spawn_animal(x, theme, countdown);
else if (type == "barriers") spawn_barriers(x, theme, countdown); // one or two, lanes per spawn_barriers()
}
/* Where a hand can first act on something at x whose countdown starts at countdown_start: the countdown start, or
switch_min_time before it at the current speed, whichever is earlier, so at top speed, where the countdown is a single
step, a hand still works for the last half second. Shared by the force field switch and item pickups (dev's items
rule, 2026-11-02). */
double hand_window_start(double x, double countdown_start)
{
return min(countdown_start, x - ceil(double(switch_min_time) / current_step_time()));
}
/* One countdown cue for an obstacle of this type at ox, whose countdown starts at countdown_start: the LAST ones of
misc/trap/<type>/warn1 to warn5, so the step before the obstacle always plays warn5 ("act now"). Five countdown steps
hear 1 to 5; three hear 3 to 5; one hears only 5. Each cue plays in 2d (never stationary) at the tile you've just
stepped onto, not at the obstacle. Each type's countdown function calls this once per step for each of its obstacles. */
void play_countdown(sound_pool@ pool, string type, double ox, double countdown_start)
{
int steps_left = int(ox - me_x);
if (steps_left < 1 or steps_left > 5 or me_x < countdown_start) return;
int note = 6 - steps_left;
string folder = "misc/trap/" + type + "/";
/* A layered set (dev, 2026-11-03) stacks octaves as warn<group>-<note>, such as the walls' warn1-3 (low) with warn2-3
(high): every group's note for this step plays at once, for as many groups as exist. A plain set has warn<note>. */
if (get_pack_sound(folder + "warn1-1*") != "")
{
int g = 1;
string layer = get_pack_sound(folder + "warn" + g + "-" + note + "*");
while (layer != "")
{
pool.play_2d(layer, me_x, 0, me_x, 0, false);
g++;
layer = get_pack_sound(folder + "warn" + g + "-" + note + "*");
}
return;
}
pool.play_2d(get_pack_sound(folder + "warn" + note + "*"), me_x, 0, me_x, 0, false);
}
