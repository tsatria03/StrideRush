/* Places obstacles ahead of the player as the run goes. Types and themes are random, from whatever folders exist at
runtime. Section 6 adds spikes and mines to the type pick. The next obstacle's ledge width is decided together with the
gap to it, so the floor between one hazard's ledge and the next one's is always there, however the speed changes. */
double next_spawn_x = 0;
int next_ledge_before = 1; // set properly by reset_spawner()

// The first hazard sits a full spawn distance, its ledge and a minimum stretch of floor into the run.
void reset_spawner()
{
next_ledge_before = ledge_before_tiles();
next_spawn_x = spawn_distance() + next_ledge_before + floor_tiles(min_floor_time);
}
// spawn_ahead_time at the current speed, in tiles.
int spawn_distance()
{
return int(ceil(double(spawn_ahead_time) / step_time));
}
// A length of floor as time at the current speed, never under min_floor_tiles.
int floor_tiles(int ms)
{
return int(max(min_floor_tiles, ceil(double(ms) / step_time)));
}
/* The gap from one hazard to the next: the previous one's ledge after, a random stretch of normal floor
(min_floor_time to max_floor_time), the next one's ledge before (ledge_before), and the hazard tile itself. */
int next_gap(int ledge_before)
{
int floor_len = random(floor_tiles(min_floor_time), floor_tiles(max_floor_time));
return int(max(min_gap_tiles, ledge_after_tiles + floor_len + ledge_before + 1));
}
// An obstacle appears spawn_distance() before its ledge starts, so its loop is heard that long before the countdown.
void spawn_check()
{
if (me_x + spawn_distance() + next_ledge_before < next_spawn_x) return;
place_obstacle(next_spawn_x, next_ledge_before);
next_ledge_before = ledge_before_tiles();
next_spawn_x += next_gap(next_ledge_before);
}
void place_obstacle(double x, int ledge_before)
{
string[] themes = get_pack_sound_folders("objects/traps/hazards/*");
if (themes.length() == 0) return;
spawn_hazard(x, themes[random(0, themes.length() - 1)], ledge_before);
}
