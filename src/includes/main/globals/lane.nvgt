/* Lanes (dev, 2026-11-04, for 1.3; Section 1 of the lanes plan): the belt has three lanes, left, middle and right, and
every run starts in the middle. Left/Q and Right/E (lane_left, lane_right) move one lane at once, at any time, even mid
jump or crouched, but not while a door carries you. The move plays misc/player/turn from the lane you move into; past
an edge it plays misc/player/bump from that side and you stay put. L reads your lane. Teleports, force field throws
and door rides keep your lane.
Lanes are heard as pan: lane_pan() gives a lane's side, so anything that sits in one lane can be placed by it, while
everything spanning all lanes stays centred. The move sounds, your footsteps and your landings use it (dev, 2026-11-04);
barriers will too (Section 2). */
const int lane_left = 0;
const int lane_middle = 1;
const int lane_right = 2;
string[] lane_names = {"Left", "Middle", "Right"};
int current_lane = lane_middle;

// Called from reset_run(): every run starts in the middle lane.
void reset_lane()
{
current_lane = lane_middle;
}
// A lane's pan: left lane_pan_amount to the left, middle centred, right to the right.
float lane_pan(int lane)
{
return (lane - lane_middle) * lane_pan_amount;
}
// Runs every frame from run_input(): Left/Q and Right/E, and L.
void lane_input()
{
if (controls.action_triggered("info_lane")) speak_buffer(lane_names[current_lane] + " lane.");
if (door_moving) return; // a door carries you straight through
if (controls.action_triggered("lane_left")) move_lane(-1);
else if (controls.action_triggered("lane_right")) move_lane(1);
}
// One lane left (-1) or right (1): turn from the new lane, or bump from that side at an edge.
void move_lane(int dir)
{
int target = current_lane + dir;
if (target < lane_left or target > lane_right)
{
p.play_stationary_extended(get_pack_sound("misc/player/*bump*"), false, 0, lane_pan(current_lane + dir), 0, 100, false);
return;
}
current_lane = target;
p.play_stationary_extended(get_pack_sound("misc/player/*turn*"), false, 0, lane_pan(current_lane), 0, 100, false);
}
