/* Lanes (dev, 2026-11-04, for 1.4; Section 1 of the lanes plan, recoded by hand after the 1.3 undo): the belt has three
lanes, left, middle and right, and every run starts in the middle. Left/Q and Right/E (lane_left, lane_right) move one
lane at once, at any time, even mid jump or crouched, but not while a door carries you. L reads your lane. Teleports,
force field throws and door rides keep your lane.
Sounds follow Section 1B's settled rules, so they won't need redoing when the belt turns forward: your own footsteps
and landings stay centred, since you're the listener (dev: "all platform sounds should stay in the center"); turn
plays from the lane you move into, across the belt (centred for the middle lane); and bump comes from beyond the edge
you hit.
Things that sit in one lane (barriers) are placed across the forward belt by their lane relative to yours
(barrier_side() in barrier.nvgt, with lane_pan_step). */
const int lane_left = 0;
const int lane_middle = 1;
const int lane_right = 2;
string[] lane_names = {"Left", "Middle", "Right"};
int current_lane = lane_middle;

// Called from reset_run(): every run starts in the middle lane.
void reset_lane()
{
current_lane = lane_middle;
}
// Runs every frame from run_input(): L, then Left/Q and Right/E.
void lane_input()
{
if (controls.action_triggered("info_lane")) speak_buffer(lane_names[current_lane] + " lane.", "status");
if (climbing)
{
// No lanes on a ladder: a lane key makes you fall off it (ladder.nvgt).
if (controls.action_triggered("lane_left") or controls.action_triggered("lane_right")) ladder_lane_slip();
return;
}
if (door_moving) return; // a door carries you straight through
if (controls.action_triggered("lane_left")) move_lane(-1);
else if (controls.action_triggered("lane_right")) move_lane(1);
}
/* One lane left (-1) or right (1). turn plays from the lane you move into, measured across the belt, so moving into the
middle is centred (dev, 2026-11-04: "If I go in the middle, it's supposed to play in the center"); past an edge, bump
plays from beyond that edge and you stay put. */
void move_lane(int dir)
{
int target = current_lane + dir;
if (target < lane_left or target > lane_right)
{
p.play_stationary_extended(get_pack_sound("misc/player/*bump*"), false, 0, belt_pan(target), 0, 100, false);
return;
}
current_lane = target;
stat_add("lane_changes"); // a bump at an edge isn't a change
p.play_stationary_extended(get_pack_sound("misc/player/*turn*"), false, 0, belt_pan(current_lane), 0, 100, false);
}
// A spot across the belt as a pan, from the middle lane: the left lane lane_pan_amount to the left, the right lane to the right.
float belt_pan(int lane)
{
return (lane - lane_middle) * lane_pan_amount;
}
/* Placing something that sits in one lane on the forward belt (barriers, and the six inventory items since the lanes
plan's Section 4). Without HRTF, one lane across is one unit and the plain pan (lane_pan_step) keeps a lane's side the
same at any distance. With HRTF the side comes from the real angle, so one unit across sounded almost straight ahead
while the thing was far off (dev, 2026-11-05), so its distance across grows with its distance along the belt, keeping
a fixed angle: one lane over at about 45 degrees (barrier_hrtf_spread 1), two lanes at about 63. */
float lane_across(int lane, double tile)
{
int side = lane - current_lane;
if (!hrtf or side == 0) return side;
return float(side * barrier_hrtf_spread * max(1.0, abs(tile - me.x)));
}
/* Keeps a lane sound in place, every frame, as you change lanes and as it nears. Its position is set on the pool item
directly, like a projectile's, since update_sound_2d() rounds to whole tiles. The extra distance of the HRTF angle would
make a side sound quieter, so its own fade per tile is scaled down to match, and it sounds as loud as one straight
ahead at the same distance. */
void place_lane_sound(sound_pool@ pool, int slot, int lane, double tile)
{
if (slot < 0 or slot >= int(pool.items.length())) return;
int side = lane - current_lane;
float fade = belt_volume_step;
if (hrtf and side != 0)
{
float spread = side * barrier_hrtf_spread;
fade = belt_volume_step / sqrt(1.0 + spread * spread);
}
pool.items[slot].x = lane_across(lane, tile);
pool.items[slot].y = tile;
if (fade > 0) pool.items[slot].volume_step = fade;
pool.items[slot].update(pool.last_listener_x, pool.last_listener_y, pool.last_listener_z, pool.last_listener_rotation, pool.max_distance);
}
// Runs every frame from run_loop(): keeps every item on the belt in its lane.
void item_lane_sounds()
{
ammopack_lane_sounds();
key_lane_sounds();
shield_lane_sounds();
capsule_lane_sounds();
potion_lane_sounds();
teleporter_lane_sounds();
}
