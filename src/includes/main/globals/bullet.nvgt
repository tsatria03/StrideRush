/* Bullets: the guns fire bullets that travel, instead of hitting at once like melee. A bullet starts at your tile and
moves one tile every bullet_tile_time, playing its gun's loop at the bullet the whole way. On each new tile it checks
for a standing wall, fake door, vehicle in your lane or item there; the first it reaches takes the gun's damage, the
gun's hit and shell play at it, and the target plays its own hurt or death. A
bullet that has gone its gun's weapon_reach() tiles from where it was fired (counted when it was fired) just vanishes,
so firing at something still out of reach wastes the round. Real doors and the other traps don't stop it. A bullet fired
while you're crouched flies low, and a flying insect it meets takes the hit first; a standing one passes under insects.
One fired while you're in the air from your own jump flies high, and an aircraft flying in down your lane takes it first.
Moves are timed off runtimer, which pauses with the game, so a pause freezes bullets in the air.
Same entity pattern as hazards: null-slot removal, reused slots, and only destroy_all_bullets() shrinks the array. */
sound_pool bulletpool;
class bullet
{
double x;
double start_x;
int range;
int damage;
int weapon; // index into weapon_names, for its loop and hit sounds
bool low = false; // fired while you were crouched: it can hit a flying insect, which a standing shot passes under (insect.nvgt)
bool high = false; // fired in the air from your own jump: it can hit an aircraft flying in (aircraft.nvgt)
int64 next_move;
int loopslot = -1;
}
bullet@[] bullets(0);

void spawn_bullet(int w, int damage)
{
bullet b;
b.x = me.x;
b.start_x = me.x;
b.range = weapon_reach(w);
b.damage = damage;
b.weapon = w;
b.low = is_ducked();
b.high = aircraft_hittable_now();
b.next_move = runtimer.elapsed + bullet_tile_time;
b.loopslot = bulletpool.play_2d(get_pack_sound(weapon_folder(w) + "*loop*"), 0, me.x, 0, b.x, true);
for (uint i = 0; i < bullets.length(); i++)
{
if (@bullets[i] == null)
{
@bullets[i] = b;
return;
}
}
bullets.insert_last(b);
}
/* Runs every frame: moves each bullet a tile per bullet_tile_time (catching up if a frame was slow), checks the new
tile for a target, and drops it at the end of its range. */
void bullet_flight()
{
for (uint i = 0; i < bullets.length(); i++)
{
if (@bullets[i] == null) continue;
bullet@ b = bullets[i];
while (@bullets[i] != null and runtimer.elapsed >= b.next_move)
{
b.next_move += bullet_tile_time;
b.x += 1;
if (b.loopslot > -1) bulletpool.update_sound_2d(b.loopslot, 0, int(b.x));
if (bullet_hits(b))
{
remove_bullet(i);
break;
}
if (b.x - b.start_x >= b.range)
{
remove_bullet(i);
break;
}
}
}
}
// Breaks the unspent item on tile x, if any, and returns its x, or -1. A new item type adds its own line here.
double strike_item_at(double x)
{
ammopack@ a = ammopack_at(x);
if (@a != null) return strike_ammopack(a);
goldpack@ gp = goldpack_at(x);
if (@gp != null) return strike_goldpack(gp);
doorkey@ k = key_at(x);
if (@k != null) return strike_key(k);
shield@ s = shield_at(x);
if (@s != null) return strike_shield(s);
lifecapsule@ lc = capsule_at(x);
if (@lc != null) return strike_capsule(lc);
healthpotion@ pot = potion_at(x);
if (@pot != null) return strike_potion(pot);
teleporter@ t = teleporter_at(x);
if (@t != null) return strike_teleporter(t);
return -1;
}
// The first standing wall, fake door, vehicle or item on the bullet's tile takes the hit. Returns true if it hit something.
bool bullet_hits(bullet@ b)
{
double target_x = -1;
insect@ ins = b.low ? insect_at_bullet(b.x) : null; // a low bullet meets a flying insect first (insect.nvgt)
aircraft@ hc = b.high ? aircraft_at_bullet(b.x) : null; // a high one, an aircraft flying in (aircraft.nvgt)
wall@ w = wall_at(b.x);
if (@ins != null) target_x = strike_insect(ins, b.damage);
else if (@hc != null) target_x = strike_aircraft(hc, b.damage);
else if (@w != null) target_x = strike_wall(w, b.damage);
else
{
door@ d = fake_door_at(b.x);
if (@d != null) target_x = strike_door(d, b.damage);
else
{
vehicle@ vh = vehicle_at_bullet(b.x); // a vehicle in your lane the bullet has reached (vehicle.nvgt)
if (@vh != null) target_x = strike_vehicle(vh, b.damage);
else target_x = strike_item_at(b.x); // an item in the bullet's path breaks
}
}
if (target_x < 0) return false;
bulletpool.play_2d(get_pack_sound(weapon_folder(b.weapon) + "*hit*"), 0, me.x, 0, target_x, false);
bulletpool.play_2d(get_pack_sound(weapon_folder(b.weapon) + "*shell*"), 0, me.x, 0, target_x, false); // at the target
return true;
}
void remove_bullet(uint i)
{
if (i >= bullets.length() or @bullets[i] == null) return;
if (bullets[i].loopslot > -1) bulletpool.destroy_sound(bullets[i].loopslot);
@bullets[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_bullets()
{
for (uint i = 0; i < bullets.length(); i++)
{
if (@bullets[i] == null) continue;
if (bullets[i].loopslot > -1) bulletpool.destroy_sound(bullets[i].loopslot);
}
bullets.resize(0);
}
