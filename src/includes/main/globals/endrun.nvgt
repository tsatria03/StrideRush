/* The two ways a run ends. Both silence the run first (music, ambience and every obstacle), play their death sounds
blocking with dlgplay (Enter skips), then stop the run so start_run() returns and the game menu reopens. There's no
results dialog in the basic build. */

/* Set when a run should start straight over with the same choices instead of returning to the game menu. Only the
source-only debug option "end the run when out of lives?" No answer sets it (dev, 2026-11-02): a hazard still kills, but
the run restarts, since hazards are the one thing that answer can't stop. play_game() reads and clears it. */
bool restart_run_requested = false;
/* Set when the run ended in a death (either ending below), not by quitting or restarting from the pause menu, so
play_game() knows to ask whether to play again (dev, 2026-11-03). play_game() clears it before each run. */
bool run_died = false;

// A hazard: its own fall clip is the whole death; no player death sound and no tile fall.
void end_run_hazard(string fall_clip)
{
silence_run();
if (fall_clip != "") dlgplay(fall_clip);
if (!lives_can_end) restart_run_requested = true;
finish_run();
}
/* A spike or mine on the last life. The caller plays the object's sounds (spike hit, or mine explode and hit) through p
just before this, which silence_run() leaves alone. Those and the player's death play together; only once ALL of them
have finished does the tile's fall play, so nothing is cut off. Enter skips, as in dlgplay. */
void end_run_hit()
{
string tile = tile_at(me_x);
silence_run();
dlgplay(get_pack_sound("misc/player/*death*"));
wait_for_pool(p);
if (tile != "") dlgplay(get_pack_sound("objects/platforms/" + tile + "/*fall*"));
finish_run();
}
// Blocks until every sound in the pool has finished, or Enter is pressed.
void wait_for_pool(sound_pool@ pool)
{
while (true)
{
bool playing = false;
for (uint i = 0; i < pool.items.length(); i++)
{
if (@pool.items[i].handle != null and pool.items[i].handle.playing)
{
playing = true;
break;
}
}
if (!playing or key_pressed(KEY_RETURN)) return;
wait(5);
}
}
// Stops the run's music, ambience and every obstacle, so only the death sounds are heard.
void silence_run()
{
stop_run_audio();
clear_run_objects();
}
// Every object type's destroy_all goes here.
void clear_run_objects()
{
destroy_all_hazards();
destroy_all_spikes();
destroy_all_mines();
destroy_all_forcefields();
destroy_all_projectiles();
destroy_all_ammopacks();
destroy_all_keys();
destroy_all_shields();
destroy_all_potions();
destroy_all_teleporters();
destroy_all_walls();
destroy_all_doors();
destroy_all_bullets();
}
// Both deaths end here; quitting or restarting from the pause menu goes through leave_paused_run() instead.
void finish_run()
{
p.destroy_all();
run_died = true;
running = false;
}
