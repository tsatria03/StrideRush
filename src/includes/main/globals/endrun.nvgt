/* The two ways a run ends. Both silence the run first (music, ambience and every obstacle), play their death sounds
blocking with dlgplay (Enter skips), then stop the run so start_run() returns and the game menu reopens. There's no
results dialog in the basic build. */

/* Set when a run should start straight over with the same choices instead of returning to the game menu. Only the
source-only debug option "end the run when out of lives?" No answer sets it (dev, 2026-11-02): a hazard still kills, but
the run restarts, since hazards are the one thing that answer can't stop. play_game() reads and clears it. */
bool restart_run_requested = false;
/* Set when the run ended in a death (either ending below), not by quitting or restarting from the pause menu, so
play_game() knows to ask whether to play again (dev, 2026-11-03). play_game() clears it before each run. */
bool run_died = false;

// A hazard: its own fall clip is the whole death; no player death sound and no tile fall.
void end_run_hazard(string fall_clip)
{
run_end_cause = "hazards"; // the statistics: what ended the run
silence_run();
if (fall_clip != "") dlgplay(fall_clip);
if (!lives_can_end) restart_run_requested = true;
finish_run();
}
/* A spike or mine on the last life. The caller plays the object's sounds (spike hit, or mine explode and hit) through p
just before this, which silence_run() leaves alone. Those and the player's death play together; only once ALL of them
have finished does the tile's fall play, so nothing is cut off. Enter skips, as in dlgplay. */
void end_run_hit()
{
// A practice run never ends: its last life lost is a practice death instead, set down just past what caught you (endrun.nvgt).
if (practice_run)
{
practice_death(me.x + 1, "");
return;
}
run_end_cause = last_caught; // the statistics: the obstacle whose blow was fatal (stat_caught())
string tile = tile_at(me.x);
silence_run();
dlgplay(get_pack_sound("misc/player/*death*"));
wait_for_pool(p);
if (tile != "") dlgplay(get_pack_sound(env_root(current_env) + "platforms/" + tile + "/*fall*"));
finish_run();
}
// Blocks until every sound in the pool has finished, or Enter is pressed.
void wait_for_pool(sound_pool@ pool)
{
while (true)
{
bool playing = false;
for (uint i = 0; i < pool.items.length(); i++)
{
if (@pool.items[i].handle != null and pool.items[i].handle.playing)
{
playing = true;
break;
}
}
if (!playing or key_pressed(KEY_RETURN)) return;
wait(5);
}
}
// Stops the run's music, ambience and every obstacle, so only the death sounds are heard.
void silence_run()
{
stop_run_audio();
clear_run_objects();
}
// Every object type's destroy_all goes here.
void clear_run_objects()
{
destroy_all_hazards();
destroy_all_spikes();
destroy_all_mines();
destroy_all_forcefields();
destroy_all_projectiles();
destroy_all_ammopacks();
destroy_all_keys();
destroy_all_shields();
destroy_all_capsules();
destroy_all_potions();
destroy_all_barriers();
destroy_all_animals();
destroy_all_teleporters();
destroy_all_powerups();
destroy_all_walls();
destroy_all_doors();
destroy_all_bullets();
destroy_all_winds();
destroy_all_trampolines();
destroy_all_ladders();
reset_slides(); // slide.nvgt: off any slide, none on the belt
heartpool.destroy_all(); // the heartbeat, so a death silences them too
}
// Both deaths end here; quitting or restarting from the pause menu goes through leave_paused_run() instead.
void finish_run()
{
p.destroy_all();
run_died = true;
count_difficulty_run(); // a death after passing a real door counts toward the level's lock (difficulty.nvgt)
running = false;
}
/* A practice death (the practice deaths plan, dev, 2026-11-09: "it will use up your 2 lives, then it will kill you like in
the real game, but let you try again."), for the last life lost to a blow (end_run_hit()) and for a hazard fall
(practice_set_down() in hazard.nvgt). The run freezes as the pause menu freezes it, with only the ambience playing on,
except that a blow's hit, already playing through p, plays out. Then the death: the hazard's fall clip, or the player's
death sound, with no tile fall. "You died." waits for Enter, then you're set down at past_x, just past what caught you,
with everything back (dev: "It gives you everything back."): full health, practice_lives and steel shields topped up to
practice_shields, keys kept. The run picks up where it froze, with a landing. Since the practice guidance plan's Section 3
(dev, 2026-11-12): the dialog says what caught you and how to get past it (practice_death_text()), then a menu asks
"What would you like to do now?": retry practice sets you down as above; return to game menu, or Escape ("canceled"),
ends the run as quit run does. */
void practice_death(double past_x, const string&in fall_clip)
{
pause_timers();
pause_pools(true);
if (fall_clip != "") dlgplay(fall_clip);
else
{
dlgplay(get_pack_sound("misc/player/*death*"));
wait_for_pool(p); // the blow's hit, if it's still going
}
dlgmessage_return(practice_death_text()); // practicehints.nvgt
while (key_down(KEY_RETURN) or key_down(KEY_SPACE) or key_down(KEY_A) or key_down(KEY_ESCAPE)) wait(5);
setupmenu();
m.intro_text = "What would you like to do now?";
m.add_item("retry practice", "retry");
m.add_item("return to game menu", "return");
int mres = m.run();
if (mres < 0 or m.selected_item_id != "retry")
{
if (mres < 0) speak("canceled");
resume_game();
leave_run(false); // as quit run does (pause_menu.nvgt): back to the game menu
return;
}
// The key that closed the menu must be let go first, or it would carry into the run as a hand, a weapon, or Escape's quit question.
while (key_down(KEY_RETURN) or key_down(KEY_SPACE) or key_down(KEY_A) or key_down(KEY_ESCAPE)) wait(5);
cancel_movement();
me.x = past_x;
update_listeners();
spawner_catch_up(); // so what comes next still arrives with its full warning
player_health = player_hp;
lives = practice_lives;
reset_shield(); // a worn shield comes off too, so you're back as a practice run starts (dev, 2026-11-10: it stayed on)
int shields = item_count("steel_shield");
if (shields < practice_shield_count()) give_item("steel_shield", practice_shield_count() - shields); // none for hazards
resume_game();
play_landing(false); // the tile's landing only, as after a teleport
}
