/* Keys (dev, 2026-11-03): the item that unlocks real doors. Built like ammo packs: a key plays its spawn clip when it
appears, then one of its loops at its tile. Either hand picks it up within the same window as a pack
(hand_window_start()): get and the player's give play centered (stationary) and the key goes into the inventory under
its color, such as "red_key". Arriving on its tile on the ground, or landing on it from a jump, breaks it, and weapons
break it when it's the nearest target. A clean jump over it misses it, and its loop fades out behind you.
The color doesn't matter (dev): any key opens any real door. Each color is a folder under key_folder, so a new key is
just a new folder. One key is due before each real door; the spawner decides when (key_due()).
Same entity pattern as ammo packs: null-slot removal, reused slots, and only destroy_all_keys() shrinks the array. */
sound_pool keypool;
const string key_folder = "equipments/items/other/";
class doorkey
{
double x;
int lane = 1; // lane_middle until spawned; a random lane since the lanes plan's Section 4 (dev, 2026-11-05)
double countdown_start;
string color; // its folder, such as "red_key", which is also its inventory name
bool spent = false; // picked up, broken or jumped past: nothing more can happen to it
int loopslot = -1;
}
doorkey@[] doorkeys(0);

// True when any key folder has sounds, so the spawner can offer keys.
bool keys_available()
{
return get_pack_sound_folders(key_folder + "*").length() > 0;
}
// countdown comes from the spawner like a pack's; it sets the pickup window and the spacing. The color is random.
void spawn_key(double kx, int countdown, int lane = -1)
{
string[] colors = get_pack_sound_folders(key_folder + "*");
if (colors.length() == 0) return;
doorkey k;
k.x = kx;
k.countdown_start = kx - countdown;
k.color = colors[random(0, colors.length() - 1)];
// The wildcards pick at random among a key's spawn and loop clips (spawn1 and spawn2, loop1 to loop4).
k.lane = lane < 0 ? random(lane_left, lane_right) : lane;
keypool.play_2d(get_pack_sound(key_sound_folder(k) + "*spawn*"), 0, me.x, lane_across(k.lane, kx), kx, false);
k.loopslot = keypool.play_2d(get_pack_sound(key_sound_folder(k) + "*loop*"), 0, me.x, lane_across(k.lane, kx), kx, true);
place_lane_sound(keypool, k.loopslot, k.lane, k.x);
for (uint i = 0; i < doorkeys.length(); i++)
{
if (@doorkeys[i] == null)
{
@doorkeys[i] = k;
return;
}
}
doorkeys.insert_last(k);
}
string key_sound_folder(doorkey@ k)
{
return key_folder + k.color + "/";
}
// Called from hand_check() when nothing else took the press. Picks up the nearest key in its window. True if one was.
bool pick_up_key()
{
doorkey@ target = null;
for (uint i = 0; i < doorkeys.length(); i++)
{
if (@doorkeys[i] == null) continue;
doorkey@ k = doorkeys[i];
if (k.spent or k.lane != current_lane or me.x < hand_window_start(k.x, k.countdown_start) or k.x - me.x < 1) continue;
if (@target == null or k.x < target.x) @target = k;
}
if (@target == null) return false;
target.spent = true;
stop_key(target);
keypool.play_stationary(get_pack_sound(key_sound_folder(target) + "*get*"), false);
p.play_stationary(get_pack_sound("misc/player/*give*"), false);
give_item(target.color, 1);
speak_buffer(item_display_name(target.color), "items"); // just its name, like a pack: "red key"
return true;
}
/* Runs once per step, right after the move. Arriving on a key's tile on the ground breaks it; once you're past its tile
still unspent, it was jumped cleanly. */
void key_check()
{
for (uint i = 0; i < doorkeys.length(); i++)
{
if (@doorkeys[i] == null) continue;
doorkey@ k = doorkeys[i];
if (!k.spent)
{
if (me.x == k.x and is_grounded() and k.lane == current_lane) break_key(k);
else if (me.x > k.x) k.spent = true; // jumped clean over: its loop carries on and fades behind you
}
if (me.x > k.x + spawn_distance()) remove_key(i);
}
}
// Called from player_land(): landing on a key's tile by mistake breaks it.
void key_landing()
{
for (uint i = 0; i < doorkeys.length(); i++)
{
if (@doorkeys[i] == null) continue;
if (!doorkeys[i].spent and me.x == doorkeys[i].x and doorkeys[i].lane == current_lane) break_key(doorkeys[i]);
}
}
// Weapons break keys like packs (dev, 2026-11-03): a bullet on its tile, or a swing when it's the nearest target.
doorkey@ key_at(double x)
{
for (uint i = 0; i < doorkeys.length(); i++)
{
if (@doorkeys[i] != null and !doorkeys[i].spent and doorkeys[i].x == x and doorkeys[i].lane == current_lane) return doorkeys[i];
}
return null;
}
doorkey@ key_in_reach(int reach)
{
doorkey@ target = null;
for (uint i = 0; i < doorkeys.length(); i++)
{
if (@doorkeys[i] == null or doorkeys[i].spent or doorkeys[i].lane != current_lane) continue;
double ahead = doorkeys[i].x - me.x;
if (ahead < 1 or ahead > reach) continue;
if (@target == null or doorkeys[i].x < target.x) @target = doorkeys[i];
}
return target;
}
// A weapon hit on a key: it breaks and is lost. Returns its x, so the weapon's hit plays there.
double strike_key(doorkey@ k)
{
break_key(k);
return k.x;
}
void break_key(doorkey@ k)
{
k.spent = true;
stop_key(k);
keypool.play_stationary(get_pack_sound(key_sound_folder(k) + "*break*"), false); // stationary, so the pitch never drops behind you (dev, 2026-11-05)
}
void stop_key(doorkey@ k)
{
if (k.loopslot > -1) keypool.destroy_sound(k.loopslot);
k.loopslot = -1;
}
void remove_key(uint i)
{
if (i >= doorkeys.length() or @doorkeys[i] == null) return;
stop_key(doorkeys[i]);
@doorkeys[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_keys()
{
for (uint i = 0; i < doorkeys.length(); i++)
{
if (@doorkeys[i] == null) continue;
stop_key(doorkeys[i]);
}
doorkeys.resize(0);
}
// Runs every frame from item_lane_sounds() (lane.nvgt): keeps each one in its lane as you move and as it nears.
void key_lane_sounds()
{
for (uint i = 0; i < doorkeys.length(); i++)
{
if (@doorkeys[i] == null or doorkeys[i].loopslot < 0) continue;
place_lane_sound(keypool, doorkeys[i].loopslot, doorkeys[i].lane, doorkeys[i].x);
}
}
