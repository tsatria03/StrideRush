/* Life potions (dev, 2026-11-03, for 1.2): an item that gives exactly 1 life. On the belt it works like an ammo pack:
its spawn clip, then its loop at its tile; either hand picks it up within hand_window_start() (get and the player's
give, centered) and it goes into the inventory as "life_potion". Arriving on its tile on the ground, landing on it, or
a weapon hit breaks it (break) and it's lost; a clean jump over it misses it. U drinks it (use_potion()).
Same entity pattern as ammo packs: null-slot removal, reused slots, and only destroy_all_potions() shrinks the array. */
sound_pool potionpool;
const string potion_folder = "equipments/items/common/life_potion/";
class lifepotion
{
double x;
double countdown_start;
bool spent = false; // picked up, broken or jumped past: nothing more can happen to it
int loopslot = -1;
}
lifepotion@[] potions(0);

// True when life potion sounds exist, so the spawner can offer them.
bool potions_available()
{
return get_pack_sound(potion_folder + "*loop*") != "";
}
// countdown comes from the spawner like a pack's; it sets the pickup window and the spacing.
void spawn_potion(double px, int countdown)
{
lifepotion lp;
lp.x = px;
lp.countdown_start = px - countdown;
potionpool.play_2d(get_pack_sound(potion_folder + "*spawn*"), me_x, 0, px, 0, false);
lp.loopslot = potionpool.play_2d(get_pack_sound(potion_folder + "*loop*"), me_x, 0, px, 0, true);
for (uint i = 0; i < potions.length(); i++)
{
if (@potions[i] == null)
{
@potions[i] = lp;
return;
}
}
potions.insert_last(lp);
}
// Called from hand_check() when nothing else took the press. Picks up the nearest potion in its window. True if one was.
bool pick_up_potion()
{
lifepotion@ target = null;
for (uint i = 0; i < potions.length(); i++)
{
if (@potions[i] == null) continue;
lifepotion@ lp = potions[i];
if (lp.spent or me_x < hand_window_start(lp.x, lp.countdown_start) or lp.x - me_x < 1) continue;
if (@target == null or lp.x < target.x) @target = lp;
}
if (@target == null) return false;
target.spent = true;
stop_potion(target);
potionpool.play_stationary(get_pack_sound(potion_folder + "*get*"), false);
p.play_stationary(get_pack_sound("misc/player/*give*"), false);
give_item("life_potion", 1);
speak_buffer(item_display_name("life_potion"));
return true;
}
/* Runs once per step, right after the move. Arriving on a potion's tile on the ground breaks it; once you're past its
tile still unspent, it was jumped cleanly. */
void potion_check()
{
for (uint i = 0; i < potions.length(); i++)
{
if (@potions[i] == null) continue;
lifepotion@ lp = potions[i];
if (!lp.spent)
{
if (me_x == lp.x and is_grounded()) break_potion(lp);
else if (me_x > lp.x) lp.spent = true; // jumped clean over: its loop carries on and fades behind you
}
if (me_x > lp.x + spawn_distance()) remove_potion(i);
}
}
// Called from player_land(): landing on a potion's tile by mistake breaks it.
void potion_landing()
{
for (uint i = 0; i < potions.length(); i++)
{
if (@potions[i] == null) continue;
if (!potions[i].spent and me_x == potions[i].x) break_potion(potions[i]);
}
}
// Weapons break potions like packs: a bullet on its tile, or a swing when it's the nearest target.
lifepotion@ potion_at(double x)
{
for (uint i = 0; i < potions.length(); i++)
{
if (@potions[i] != null and !potions[i].spent and potions[i].x == x) return potions[i];
}
return null;
}
lifepotion@ potion_in_reach(int reach)
{
lifepotion@ target = null;
for (uint i = 0; i < potions.length(); i++)
{
if (@potions[i] == null or potions[i].spent) continue;
double ahead = potions[i].x - me_x;
if (ahead < 1 or ahead > reach) continue;
if (@target == null or potions[i].x < target.x) @target = potions[i];
}
return target;
}
// A weapon hit on a potion: it breaks and is lost. Returns its x, so the weapon's hit plays there.
double strike_potion(lifepotion@ lp)
{
break_potion(lp);
return lp.x;
}
void break_potion(lifepotion@ lp)
{
lp.spent = true;
stop_potion(lp);
potionpool.play_2d(get_pack_sound(potion_folder + "*break*"), me_x, 0, lp.x, 0, false);
}
void stop_potion(lifepotion@ lp)
{
if (lp.loopslot > -1) potionpool.destroy_sound(lp.loopslot);
lp.loopslot = -1;
}
void remove_potion(uint i)
{
if (i >= potions.length() or @potions[i] == null) return;
stop_potion(potions[i]);
@potions[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_potions()
{
for (uint i = 0; i < potions.length(); i++)
{
if (@potions[i] == null) continue;
stop_potion(potions[i]);
}
potions.resize(0);
}
// U on a life potion: exactly 1 more life, with no limit (dev: "no more no less"). Always used, so returns true.
bool use_potion()
{
lives += 1;
p.play_stationary(get_pack_sound(potion_folder + "*use*"), false); // its use sound only, not the life sound (dev)
speak_buffer("You now have " + lives + " lives.");
return true;
}
