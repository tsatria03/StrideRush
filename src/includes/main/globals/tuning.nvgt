/* Every tunable number in one place, so playtesting changes are a one-line edit and a relaunch. Times are in
milliseconds and distances in tiles unless a name says otherwise. Arrays with five entries are by level, easy to chaos.
How each value came to be is in aidocks (project_tuning_history and the plans). */

// The belt: the step interval starts here and shrinks by speedup_amount every speedup_period, never below min_step_time.
const int start_step_time = 500;
const int speedup_period = 10000;
const int speedup_amount = 10;
const int min_step_time = 50; // the top speed cap

// Surfaces: the ground switches to a new random platform after a random stretch of running between these times, at any speed.
const int surface_min_time = 10000;
const int surface_max_time = 20000;

// Jumping: rise one height every jump_tick up to jump_height, then fall back the same way (about a second in the air).
const int jump_height = 5;
const int jump_tick = 100;

// Crouching: holding Down crouches, and it stands up on its own after duck_time even if Down is still held.
const int duck_time = 1500;
// After standing up, crouching is blocked for duck_cooldown, so Down can't be spammed.
const int duck_cooldown = 500;

/* Obstacle placement. An obstacle appears spawn_ahead_time before its countdown starts, at the current speed, so you
always hear it that long before its countdown begins. Spacing is built from a random stretch of normal floor between
one obstacle's ledge after and the next one's countdown (min_floor_time to max_floor_time below), never under
min_gap_tiles. */
const int spawn_ahead_time = 3000;
// Every belt sound drops a decibel for each belt_fade_ms of running away from you, at any speed.
const int belt_fade_ms = 150;
const int min_gap_tiles = 6;

/* The warning countdown before every trap: always countdown_length steps, warn1 to warn5, one cue per step, at any speed.
A jump lasts about 1 s, so at slow speeds you still jump on the last cues. A hazard's ledge before covers exactly the
countdown; the other traps count down on normal floor. A hazard's ledge after is a fixed ledge_after_tiles. */
const int countdown_length = 5;
const int ledge_after_tiles = 2;
// Normal floor between one obstacle and the next one's countdown: a random min_floor_time to max_floor_time at the current speed, never under min_floor_tiles.
const int min_floor_time = 1000;
const int max_floor_time = 4000;
const int min_floor_tiles = 2;
/* A free run's spacing (modify spacing, freerun.nvgt) replaces that floor, one entry per setting: very close (just the
min_floor_tiles), close, normal (the floor above), far and very far. */
const int[] free_spacing_min_times = {0, 500, 1000, 3000, 6000};
const int[] free_spacing_max_times = {0, 2000, 4000, 6000, 10000};
/* Difficulty, one entry per level in difficulty_names' order: the starting step time (the speed-up is the same for
everyone), and the floor between obstacles, which stays fixed all run. Chaos's floor is the min_floor_time to
max_floor_time above, which debug and practice runs keep. */
const string[] difficulty_names = {"easy", "medium", "hard", "insane", "chaos"};
const int[] difficulty_start_times = {500, 450, 400, 350, 300};
const int[] difficulty_min_floor_times = {2000, 1750, 1500, 1250, 1000};
const int[] difficulty_max_floor_times = {5000, 4750, 4500, 4250, 4000};
/* Damage by level: the percent of every obstacle's damage a blow does. Practice and debug runs, which have no level,
take 100. Every result is a whole number with today's damages (animals 6 on easy, barriers 48). */
const int[] difficulty_damage_percents = {60, 70, 80, 90, 100};
/* Survival items by level: life capsules, steel shields and health potions spawn at this percent of their _chance rates,
pairs' second items too; debug runs at 100. Below these, taking every hit costs more than the items give back. */
const int[] difficulty_item_percents = {25, 20, 15, 10, 5};
/* How many shares barriers get in the obstacle pick, where every other type has 1: half of them pass in other lanes,
where their countdown doesn't play, so they come twice as often. */
const int barrier_weight = 2;
/* Combined obstacles: a pair replaces this percent of obstacle spawns (debug runs at chaos's). The pairs, each also coming
reversed (combo.nvgt), and the gap after a pair's first part by its action, in ms: a jump, a crouch, a quick action (a
lane switch, firing or one hand), and the wider gap between a force field and an animal either way. */
const int[] difficulty_combo_percents = {5, 10, 15, 20, 25};
const string[] combo_firsts = {"projectiles", "force_fields", "force_fields", "mines", "barriers", "walls", "animals", "fake_doors", "projectiles"};
const string[] combo_seconds = {"spikes", "walls", "animals", "barriers", "projectiles", "barriers", "hazards", "mines", "insects"};
const int combo_gap_jump = 1200;
const int combo_gap_crouch = 600;
const int combo_gap_quick = 500;
const int combo_gap_hands = 1000;
/* Slides: about one spawn in slide_chance is a slide, and it must also pass the level's item_percent() (survival_roll()),
so about 1 in 24 on easy to 1 in 120 on chaos; the debug choice "slides" makes it 1 in 2 instead. A ride lasts a random
slide_min_time to slide_max_time. */
const int slide_chance = 6;
const int slide_min_time = 2000;
const int slide_max_time = 4000;
/* Winds: a wind closes in wind_speed_factor times as fast as a still obstacle (moving toward you at half the belt's
speed), moves one lane toward yours every wind_beat_time ms, and does wind_damage. */
const double wind_speed_factor = 1.5;
const int wind_beat_time = 750;
const int wind_damage = 5;
/* Ladders: each ladder has a random ladder_rungs_min to ladder_rungs_max rungs, the first taken as you step on; each must
come within ladder_rung_times of the last (practice and debug use easy's); a collapse costs ladder_break_damage and a
fall ladder_fall_damage, then the real wall's crash wall_damage. */
const int[] ladder_rungs_min = {6, 7, 8, 9, 10};
const int[] ladder_rungs_max = {8, 9, 10, 11, 12};
const double[] ladder_rung_times = {2000, 1750, 1500, 1250, 1000};
const int ladder_break_damage = 60;
const int ladder_fall_damage = 40;
// The least time between rungs: sooner is rushing it, and you fall off.
const double[] ladder_rung_min_times = {200, 250, 300, 350, 400};
const bool ladder_grab_runup = true; // true: after a grab you run on to the ladder before climbing; false: the climb starts at the grab
const int ladder_wall_gap = 5; // steps from a ladder to its real wall
// Floor breakers: a random floor_pieces_min to floor_pieces_max pieces to rebuild.
const int[] floor_pieces_min = {3, 4, 5, 6, 7};
const int[] floor_pieces_max = {4, 5, 6, 7, 8};
/* Vehicles: closing vehicle_speed_factor times as fast as a still obstacle, a lane toward yours every vehicle_beat_time;
in your lane, bursts of vehicle_burst_shots shots vehicle_shot_gap apart, then vehicle_burst_pause; each shot a tile
every vehicle_shot_tile_time, vehicle_shot_damage if it reaches you in its lane; a ram of vehicle_ram_damage; hp half a
fake wall's (wall_spawn_hp()). */
const double vehicle_speed_factor = 1.5;
const int vehicle_beat_time = 1000;
const int vehicle_burst_shots = 5;
const int vehicle_shot_gap = 50;
const int vehicle_aim_delay = 500; // lined up with you, it waits this long before a burst, so leaving its lane dodges it
const int vehicle_burst_pause = 2000; // long enough to leave room for shooting back
const int vehicle_shot_tile_time = 50;
const float vehicle_fade = 0.25; // a vehicle's shots fall off along the belt at a quarter of the belt's rate, so they carry
const float vehicle_engine_fade = 0.5; // its engine at half the belt's rate
const int vehicle_shot_damage = 5;
const int vehicle_ram_damage = 40;
const double vehicle_ram_range = 2; // within this many tiles of you a vehicle stops firing and rams
const int vehicle_min_hp = 25;
const int vehicle_max_hp = 250;
/* Aircrafts (aircraft.nvgt): flying in aircraft_speed_factor times as fast as a still obstacle, then hovering over
you for aircraft_hover_time, a lane toward yours every aircraft_hover_beat both flying in and hovering, firing in bursts like a vehicle's: the
first aircraft_first_burst into the hover, aircraft_burst_shots shots aircraft_burst_gap apart, then
aircraft_burst_pause before the next; each shot lands aircraft_shot_delay later in the lane it was fired at, for
aircraft_shot_damage. Then landing for aircraft_land_time, a lane toward yours every aircraft_land_beat, crashing
onto you in your lane. hp far tougher than a fake door's, growing with speed (wall_spawn_hp()): about 1400 where they
join at 200 ms, before the level's share. */
const double aircraft_speed_factor = 2;
const int aircraft_hover_time = 4000;
const int aircraft_hover_beat = 500; // a lane toward yours this often, flying in and hovering
const int aircraft_first_burst = 1000;
const int aircraft_burst_shots = 5;
const int aircraft_burst_gap = 100;
const int aircraft_burst_pause = 1500;
const int aircraft_shot_delay = 500;
const int aircraft_shot_damage = 5;
const int aircraft_land_time = 3000; // long enough for its ground loop to play through once
const int aircraft_land_beat = 750;
const int aircraft_crash_damage = 40;
const int aircraft_min_hp = 200;
const int aircraft_max_hp = 2000;
/* Trampolines: like slides, one spawn in trampoline_chance and survival_roll(); worn pads trampoline_worn_percent of the
time, belt-wide ones trampoline_belt_percent; a good pad's flight lasts trampoline_air_time. */
const int trampoline_chance = 6;
const int trampoline_worn_percent = 50;
const int trampoline_belt_percent = 25;
const int trampoline_air_time = 2500;
/* Top speed by level: the step time where an endless run's belt stops speeding up, 5, 6.7, 10, 13.3 and 20 steps a
second. Every obstacle and item has joined by easy's 200. Debug runs keep min_step_time, and Rush Hour can still go
speedup_amount past the cap, never past min_step_time. */
const int[] difficulty_top_step_times = {200, 150, 100, 75, 50};
/* The schedule: on easy to insane, each of these types and items joins the mix once the belt reaches its step time, in
the same order as schedule_types. Anything not listed is in from the start: hazards, spikes and mines, health potions,
life capsules and steel shields, and keys, which come before every real door outside the schedule. Chaos has everything
from the first spawn. */
const string[] schedule_types = {"projectiles", "force_fields", "animals", "walls", "ammo_packs", "fake_doors", "player_teleporters", "barriers", "powerups", "slides", "winds", "trampolines", "ladders", "floor_breakers", "vehicles", "insects", "aircrafts"};
const int[] schedule_join_times = {450, 400, 350, 300, 300, 250, 250, 200, 200, 300, 200, 300, 250, 250, 200, 250, 200};
const int chaos_level = 4; // difficulty_names' index of chaos, which ignores the schedule
// The locks: easy is always open, and each other level opens after this many counted runs on the level below.
const int difficulty_unlock_runs = 5;
/* Timed runs: the countdown's start and the finish line in seconds of running; each clean pass adds and each hit takes
away; a level opens after timed_unlock_runs completed timed runs on the one below; warnings as the countdown drops past
timed_warn_seconds, highest first, so a drop past several says only the lowest. */
const int[] timed_start_seconds = {60, 50, 40, 30, 20};
const int[] timed_finish_seconds = {300, 270, 240, 210, 180};
const int[] timed_pass_seconds = {7, 6, 5, 4, 4};
const int[] timed_hit_seconds = {5, 5, 7, 8, 10};
const int timed_unlock_runs = 3;
const int[] timed_warn_seconds = {45, 30, 15, 10, 5};
const int timed_warn_rearm_seconds = 10; // a warning plays again only after the clock climbs this far above it
// The clean passes that feed the clock: every obstacle got past the right way (combinations_cleared left out, since each part counts).
const string[] timed_pass_stats = {"hazards_jumped", "spikes_jumped", "mines_jumped", "projectiles_ducked", "force_fields_switched_off", "animals_scared", "insects_killed", "barriers_dodged", "winds_dodged", "walls_broken", "real_walls_climbed", "fake_doors_broken", "real_doors_opened", "floor_breakers_repaired", "vehicles_destroyed", "vehicles_dodged", "aircrafts_destroyed", "aircrafts_dodged"};

// Each spike swings on its own rhythm: a random swing time between these, picked when it appears.
const int spike_swing_min = 500;
const int spike_swing_max = 1000;

/* A mine arms (light, then its ticking loop) mine_arm_lead_time before its countdown starts, at the current speed, never
under mine_arm_lead_min_tiles, so light always comes first and has the same half second to finish at any speed. */
const int mine_arm_lead_time = 500;
const int mine_arm_lead_min_tiles = 1;

/* Lives and health. Every run starts with starting_lives and player_hp health. Each blow (anything but a hazard, which
ends the run) does its obstacle's damage, to a worn shield first, otherwise to your health; at 0 health you lose a life
and start the next at full health, or the run ends on your last life. Extra damage past 0 is dropped. */
const int starting_lives = 1;
const int life_capsule_min_lives = 1; // a life capsule gives a random min to max lives
const int life_capsule_max_lives = 2;
const int debug_lives = 2; // source-only debug runs of a single type start with these; "all" uses starting_lives
const int practice_unlock_count = 5; // clean passes of a practice obstacle that open the next one; hazards open endless run too
const int practice_hint_limit = 5; // hints per kind in each practice run, and the practiced choice's things before the closing line
const int practice_unlock_hold = 3000; // a hint this soon after an unlock line waits its turn instead of cutting it off (ms, on runtimer)
const int practice_hint_together = 100; // hints this close together (ms, on runtimer: placed in the same moment) queue instead of cutting each other off
const int practice_rising_period = 5000; // a rising practice run speeds up every this many ms, twice an endless run's rate
const int practice_rising_top = 100; // and stops at 10 steps a second, the fastest practice speed
const int practice_lives = 1; // every practice run starts with this, and gets it back after each practice death
const int practice_shields = 1; // and with this steel shield in the inventory, none on the belt
const int player_hp = 200;
const int spike_damage = 20;
const int mine_damage = 60;
const int forcefield_damage = 30; // the throw still happens
const int projectile_damage = 40;
const int wall_damage = 50; // crashing into a wall you didn't destroy
const int door_damage = 70; // crashing into any door, real or fake

/* Doors. A real door marks each new door_section_ms of speed (450, 400 ... 50) and plays at pitch 100. A fake door plays
at one of these pitches, never near 100, so it always sounds off. */
const int door_section_ms = 50;
int[] fake_door_pitches = {80, 90, 110, 120};
/* Wall hp scales with speed: its center runs from wall_min_hp at start_step_time (500 ms) up to wall_max_hp at
min_step_time (50 ms), and each wall rolls a random hp within wall_hp_spread percent either side of that center, never
below wall_min_hp or above wall_max_hp. So 50 to 60 at the start, about 200 to 300 at 300 ms, and 400 to 500 at top
speed. */
const int wall_min_hp = 50;
const int wall_max_hp = 500;
const int wall_hp_spread = 20;
/* Fake doors scale the same way with their own, tougher range: 100 to 120 at the start, about 400 to 600 at 300 ms, 800
to 1000 at top speed. */
const int door_min_hp = 100;
const int door_max_hp = 1000;

/* A projectile closes in this many times as fast as a still obstacle seems to, scaled with the belt's speed: at 2 it
starts as far beyond its meeting tile as you are before it, and flies at your own speed. */
const int projectile_speed_factor = 2;

/* Running into an active force field throws you this many tiles forward past it. The gap after every force field gets the
same number of extra tiles, so the throw always lands on clear floor before the next countdown. */
const int forcefield_knockback_tiles = 5;

/* A force field can always be switched off within this long before it, at the current speed, even when its countdown is
shorter, so top speed doesn't need mashing. At 50 ms that's the last 10 steps, at 100 ms the last 5, at 200 ms the last
3; above 200 ms the countdown already lasts at least this long, so this changes nothing there. */
const int switch_min_time = 500;

// Weapons: every hit's damage is the weapon's base damage (weapons.nvgt) times this, for all ten weapons at once.
const int weapon_damage_multiplier = 4;
// Each gun starts every run with this much loaded and in reserve; ammo packs refill the reserve.
const int gun_start_loaded = 50;
const int gun_start_reserve = 50;
/* Melee swings, one entry per melee weapon in weapon_names' order (bat, boot, club, dagger, fist, hammer, knife, sword):
the swing time runs from the press until the hit lands, then the recovery must pass before the next swing can start.
Each step up the keys hits harder and swings slower. The swing powerups scale both. */
const int[] melee_swing_times = {50, 100, 150, 200, 250, 300, 350, 400};
const int[] melee_recovery_times = {25, 50, 75, 100, 125, 150, 175, 200};
// The shortest gap between two pistol shots per Space press, and the machine gun's rate while Space is held.
const int pistol_fire_gap = 200;
const int machine_gun_fire_gap = 100;
/* How far ahead each weapon reaches, one entry per weapon in weapon_names' order (bat, boot, club, dagger, fist, hammer,
knife, sword, machine gun, pistol), turned into tiles at the current speed. The stronger the weapon, the further. Nothing
exists further ahead than spawn_ahead_time plus a countdown, so a longer reach only pays off at slower speeds. */
const int[] weapon_reach_times = {2000, 2200, 2400, 2600, 2800, 3000, 3200, 3500, 4500, 5500};
// How far ahead a key can unlock a real door, whatever weapon you hold.
const int key_reach_time = 2000;
// A gun's bullet moves one tile every this many ms, at any speed, fast enough to stay ahead of you at 50 ms steps; it travels its gun's weapon_reach() tiles.
const int bullet_tile_time = 30;

/* Ammo packs. About one spawn in ammo_pack_chance is a pack instead of an obstacle. Opening one adds a random
ammo_pack_min to ammo_pack_max rounds to the reserve of the gun you're holding, never above gun_max_reserve. */
const int ammo_pack_chance = 8;
const int ammo_pack_min = 5;
const int ammo_pack_max = 10;
/* Gold packs. About one spawn in gold_pack_chance is a gold pack, in endless runs from the first step. Opening one gives a
random amount of coins between these, one entry per level, easy to chaos. In an endless run it pays gold_pack_start_percent
of that at the level's start speed, rising steadily to all of it at the level's top speed. */
const int gold_pack_chance = 4;
const int[] gold_pack_min_coins = {100, 200, 300, 400, 500};
const int[] gold_pack_max_coins = {300, 600, 900, 1200, 1500};
const int gold_pack_start_percent = 10;
/* The shop (shop_menu.nvgt): what it sells and for how many gold coins, the pack sizes, and which coin sound a purchase
plays: below the first step coin1, then one more along for each step reached. */
const string[] shop_character_ids = {"attack", "defence", "max_health", "max_shield_strength", "shield_defence"};
const int[] shop_character_prices = {100, 150, 50, 25, 200}; // a point each
const string[] shop_item_ids = {"ammo_pack", "health_potion", "life_capsule", "player_teleporter", "steel_shield"};
const int[] shop_item_prices = {500, 1000, 5000, 1500, 2000};
const string[] shop_helper_ids = {"ammo_pack_helper", "animal_helper", "door_helper", "floor_helper", "force_field_helper", "gold_pack_helper", "item_helper", "ladder_helper", "master_helper", "master_helper_deluxe", "powerup_helper"};
const int[] shop_helper_prices = {2250, 3000, 3500, 5500, 2500, 2750, 4000, 4500, 15000, 20000, 3250};
const string[] shop_special_ids = {"power_crystal", "safety_net", "slide", "trampoline"};
const int[] shop_special_prices = {750, 10000, 1250, 1750};
const int[] shop_pack_sizes = {1, 5, 10, 25, 50, 100, 250, 500, 1000};
const int[] shop_coin_steps = {1000, 2500, 5000, 10000, 20000};
const string[] shop_coin_sounds = {"coin1", "coin50", "coin1000", "coin10000", "coin50000", "coin100000"};
const int gun_max_reserve = 500; // a reload still loads at most gun_start_loaded

/* Shields. About one spawn in shield_chance is a steel shield. A worn one starts at shield_hp and takes each blow's
damage (the <type>_damage values above) instead of your health; hazards ignore it. */
const int shield_chance = 16;
const int shield_hp = 400; // twice your own health

/* Powerups. About one spawn in powerup_chance is a powerup, and each lasts powerup_time. Their effects: Slow Motion and
Rush Hour shift the step by powerup_speed_ms; Moon Jump and Short Hop scale each jump height's time; Long Crouch and
Stiff Knees scale duck_time; Quick Swings and Rapid Fire scale a fire gap by powerup_fire_faster, Clumsy Swings and
Sticky Trigger by powerup_fire_slower; Sturdy Shield and Tough Hide scale damage to your shield or health by
powerup_damage_less, Brittle Shield and Soft Hide by powerup_damage_more. */
const int powerup_chance = 10;
const int powerup_time = 15000;
const int powerup_speed_ms = 50;
const double moon_jump_factor = 1.5;
const double short_hop_factor = 2.0 / 3.0;
const double long_crouch_factor = 2.0;
const double stiff_knees_factor = 0.5;
const double powerup_fire_faster = 0.5;
const double powerup_fire_slower = 2.0;
const double powerup_damage_less = 0.5;
const double powerup_damage_more = 2.0;
// A powerup on the belt replays its sound this often, not looped: ground ones every 300 ms, flight ones every 400.
const int powerup_ground_sound_time = 300;
const int powerup_flight_sound_time = 400;
// Life capsules and player teleporters: about one spawn in life_capsule_chance is a capsule and one in teleporter_chance a teleporter.
const int life_capsule_chance = 20;
const int teleporter_chance = 16;
/* Health potions. About one spawn in health_potion_chance is a health potion, which heals a random
health_potion_min_percent to health_potion_max_percent of player_hp (10 to 20 of 200), never past full. */
const int health_potion_chance = 10;
const int health_potion_min_percent = 5;
const int health_potion_max_percent = 10;
// Lanes: how far to the side the next lane over is heard, as a pan (100 is fully to one side).
const float lane_pan_amount = 50;
// The forward belt's pan per lane: the engine pans by x * pan_step / 125, so this makes one lane across lane_pan_amount.
const float lane_pan_step = lane_pan_amount * 1.25;
// With HRTF on, a barrier one lane over sits this many units across per tile ahead: 1 is about 45 degrees to the side, two lanes about 63.
const float barrier_hrtf_spread = 1.0;
// A barrier in your lane does barrier_damage, the hardest blow.
const int barrier_damage = 80;
// How often, in percent, a barrier spawn is a pair in two different lanes instead of one.
const int barrier_pair_percent = 50;
// How often, in percent, an item spawn adds a second item of a random kind in a different lane.
const int item_pair_percent = 50;
// Animals: an unscared animal that reaches you does animal_damage.
const int animal_damage = 10;
/* Insects (insect.nvgt): crouched as one reaches you, you have insect_dive_time ms to kill it before it dives, kept inside
duck_time so the insect ends the window, not your crouch; a sting does insect_damage; its health grows with the belt's
speed from insect_min_hp to insect_max_hp, as a vehicle's does. */
const int insect_dive_time = 1000;
/* An insect closes in this many times as fast as a still obstacle seems to, like projectile_speed_factor but its own: at
2, the same as a projectile, it flies toward you at the belt's speed and is heard as early in its countdown as one. A
higher factor starts it farther out, and the belt's fade (belt_fade_ms) then hides it until after its countdown begins. */
const double insect_speed_factor = 2;
const int insect_damage = 20;
const int insect_min_hp = 40;
const int insect_max_hp = 100;
// Hands: the second hand within this many ms of the first makes a clap instead of a woosh.
const int clap_window = 100;
// A teleport moves you a random teleport_min_time to teleport_max_time of belt (in tiles at the current speed), forward or back.
const int teleport_min_time = 2000;
const int teleport_max_time = 5000;

// Music and ambience volume, in decibels: min_volume is silent-ish, 0 is full. The settings sliders show it as 0 to 100 percent. Home/End and Page Up/Down move by volume_change.
const int min_volume = -100;
const int learn_min_volume = -50; // the learn sounds menu's floor
const int volume_change = 1;
const int music_start_volume = -20; // 80 percent at the start and after a settings reset
const int ambience_start_volume = -20; // 80 percent, the same
const int menu_music_start_volume = -20; // 80 percent, the same (form_menu.nvgt starts menumusvolume at it)
/* The ambience changes the way the ground does: after a random ambience_min_time to ambience_max_time on runtimer, it
crossfades over ambience_fade_time to another random one, the old fading down to ambience_fade_floor decibels below
your ambience volume as the new one rises. */
const int ambience_min_time = 60000;
const int ambience_max_time = 120000;
const int ambience_fade_time = 2000;
const int ambience_fade_floor = 40;
/* Environments: with more than one environment to go to, a run moves to a random different one every random
env_switch_min_time to env_switch_max_time of running time (runtimer, so pausing freezes it). The switch brings the new
ambience, so the ambience timer above only runs when there's nothing to switch to. */
const int env_switch_min_time = 60000;
const int env_switch_max_time = 120000;

/* The heartbeat: heart_start_bpm at start_step_time, rising in a straight line to heart_max_bpm at heart_full_speed_ms:
5 + (500 - step time) x 150 / 350, about 4.3 bpm per 10 ms, so 155 at 150 ms, held there at any faster speed. A beat
comes every heart_gap_base - heart_gap_per_bpm x bpm ms (1950 ms at 5 bpm, 450 at 155). */
const int heart_start_bpm = 5;
const int heart_max_bpm = 155; // reached at heart_full_speed_ms and held at any faster speed, powerups included
const int heart_full_speed_ms = 150; // the step time where the heart rate reaches heart_max_bpm
const int heart_gap_base = 2000;
const int heart_gap_per_bpm = 10;

/* The joystick (joystick.nvgt): the left stick counts as a d-pad press past stick_press_at from center (half its 32768
travel each way), and must come back within stick_release_at (a quarter) before it counts again. The connection is
checked every joystick_check_time ms. A run frame more than joystick_gap_time ms after the last one means a menu was
open, so presses made meanwhile are dropped rather than carried into the run. */
const int stick_press_at = 16384;
const int stick_release_at = 8192;
const int joystick_check_time = 1000;
const int joystick_gap_time = 250;
// In menus, a held d-pad or left stick taps again after joystick_repeat_delay ms, then every joystick_repeat_interval ms.
const int joystick_repeat_delay = 400;
const int joystick_repeat_interval = 100;
// Rebinding a joystick button waits this many ms for a press, then cancels.
const int joystick_capture_time = 10000;
/* Vibration (joystick.nvgt's joystick_rumble()), one strength per moment, not per obstacle: a shield taking a blow, a
blow to your health, losing a life, and a death. The low motor is the heavy rumble and the high motor the light buzz,
each 0 to 65535, for rumble_times ms. */
const int[] rumble_low = {8000, 20000, 40000, 65535};
const int[] rumble_high = {16000, 30000, 50000, 65535};
const int[] rumble_times = {120, 250, 500, 900};
