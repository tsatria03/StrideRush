/* Every tunable number in one place, so playtesting changes are a one-line edit and a relaunch. Times are in
milliseconds and distances in tiles. Later sections add their own values here (surfaces, ledges, gaps, jump, duck,
mines and life costs). */

// The belt: the step interval starts here and shrinks by speedup_amount every speedup_period, never below min_step_time.
const int start_step_time = 500;
const int speedup_period = 10000;
const int speedup_amount = 10;
const int min_step_time = 100; // the top speed cap (dev, 2026-11-02; was 50)

// Surfaces: the ground switches to a new random platform after a random stretch between these lengths.
const int surface_min_tiles = 50;
const int surface_max_tiles = 200;

// Jumping: rise one height every jump_tick up to jump_height, then fall back the same way (about a second in the air).
const int jump_height = 5;
const int jump_tick = 100;

// Crouching: holding Down crouches, and it stands up on its own after duck_time even if Down is still held.
const int duck_time = 1500;
// After standing up, crouching is blocked for duck_cooldown, about as long as a jump lasts, so Down can't be spammed.
const int duck_cooldown = 1000;

/* Obstacle placement. An obstacle appears spawn_ahead_time before its countdown starts, at the current speed, so you
always hear it that long before its countdown begins. Spacing is built from a random stretch of normal floor between
one obstacle's ledge after and the next one's countdown (min_floor_time to max_floor_time below), never under
min_gap_tiles. */
const int spawn_ahead_time = 3000;
const int min_gap_tiles = 6;

/* The warning countdown before every obstacle (dev, 2026-11-02): one step per countdown_ms of step time, rounded up: 5
at 500 ms, 4 at 400, 3 at 300, 2 at 200, 1 at 100, one cue per step, so at slow speeds you jump on its last steps. A
hazard's ledge before covers exactly its countdown; spikes and mines count down on normal floor. A hazard's ledge
after is a fixed ledge_after_tiles. */
const int countdown_ms = 100;
const int ledge_after_tiles = 2;
// Normal floor between one obstacle and the next one's countdown: a random min_floor_time to max_floor_time at the current speed, never under min_floor_tiles.
const int min_floor_time = 1000;
const int max_floor_time = 4000;
const int min_floor_tiles = 2;

// Each spike swings on its own rhythm: a random swing time between these, picked when it appears (dev, 2026-11-02).
const int spike_swing_min = 500;
const int spike_swing_max = 1000;

/* A mine arms (light, then its ticking loop) mine_arm_lead_time before its countdown starts, at the current speed, never
under mine_arm_lead_min_tiles, so light always comes first and the countdown follows (dev, 2026-11-02): 1 tile ahead of
the countdown at 500 ms, 5 at 100 ms, giving light the same half second to finish at any speed. */
const int mine_arm_lead_time = 500;
const int mine_arm_lead_min_tiles = 1;

// Lives at the start of every run, and what each obstacle costs. ends_run means the run ends however many lives are left.
const int starting_lives = 1;
const int max_test_lives = 5; // the most the source-only testing lives menu offers
const int ends_run = -1;
const int hazard_life_cost = ends_run;
const int spike_life_cost = 1;
const int mine_life_cost = 2;
const int forcefield_life_cost = 1;

/* Running into an active force field throws you this many tiles forward past it (dev, 2026-11-02). The gap after every
force field gets the same number of extra tiles, so the throw always lands on clear floor before the next countdown. */
const int forcefield_knockback_tiles = 5;

// Music and ambience volume, in decibels: min_volume is silent-ish, 0 is full. Home/End and Page Up/Down move by volume_change.
const int min_volume = -50;
const int volume_change = 1; // 1 per press, like ToyMania (dev, 2026-11-02)
const int music_start_volume = 0; // full volume at the start, like ToyMania (dev, 2026-11-02)
const int ambience_start_volume = 0;
