/* Walls (dev, 2026-11-03, for 1.1): full-height obstacles you destroy with your weapons. A wall plays its theme's loop at
its tile, so it grows louder as you near it, and spawns with an hp that climbs with your speed (wall_spawn_hp()). It counts down with
the layered walls set (both octaves at once). Jumping or crouching doesn't get you past one: arriving on a standing
wall's tile at any height is a CRASH. The wall's hit, the player's hit and the life sound play, its loop stops and you
run on, losing wall_life_cost. A crash has NO death sound (dev, 2026-11-03): death is only for a wall your weapons
destroy. A crash is not a destroy, so later scoring can tell them apart. On the
last life: its hit, the player's death, then the tile's fall.
Weapons hit the nearest standing wall within reach through strike_wall(), called by weapon_strike() in weapons.nvgt:
the wall's hurt plays on each hit, and at 0 hp its death plays, its loop stops and it counts as DESTROYED.
Same entity pattern as hazards: null-slot removal, reused slots, and only destroy_all_walls() shrinks the array. */
sound_pool wallpool;
class wall
{
double x;
string theme;
int hp;
double countdown_start;
bool destroyed = false; // broken by weapons
bool crashed = false; // run into while still standing
int loopslot = -1;
}
wall@[] walls(0);

// countdown comes from the spawner, the same countdown_steps() a hazard's ledge uses.
void spawn_wall(double wx, string theme, int countdown)
{
wall w;
w.x = wx;
w.theme = theme;
w.hp = wall_spawn_hp();
w.countdown_start = wx - countdown;
w.loopslot = wallpool.play_2d(get_pack_sound("objects/traps/walls/" + theme + "/*loop*"), me_x, 0, wx, 0, true);
for (uint i = 0; i < walls.length(); i++)
{
if (@walls[i] == null)
{
@walls[i] = w;
return;
}
}
walls.insert_last(w);
}
/* A new wall's hp: a center that climbs from wall_min_hp at start_step_time to wall_max_hp at min_step_time as the run
speeds up, then a random spread of wall_hp_spread percent either side, kept within wall_min_hp to wall_max_hp. */
int wall_spawn_hp()
{
double progress = double(start_step_time - step_time) / (start_step_time - min_step_time);
progress = max(0, min(1, progress));
double center = wall_min_hp + progress * (wall_max_hp - wall_min_hp);
int low = int(max(wall_min_hp, center * (100 - wall_hp_spread) / 100));
int high = int(min(wall_max_hp, center * (100 + wall_hp_spread) / 100));
return random(low, high);
}
// A wall still blocks the way until it's destroyed or crashed through.
bool wall_standing(wall@ w)
{
return !w.destroyed and !w.crashed;
}
// Runs once per step, right after the move: arriving on a standing wall's tile, at any height, is a crash.
void wall_check()
{
for (uint i = 0; i < walls.length(); i++)
{
if (@walls[i] == null) continue;
wall@ w = walls[i];
if (me_x == w.x and wall_standing(w))
{
w.crashed = true;
stop_wall(w);
string hit_clip = get_pack_sound("objects/traps/walls/" + w.theme + "/*hit*");
/* A fatal crash plays the wall's hit through p (silence_run() would otherwise cut it off) and no player hit,
since end_run_hit() plays the player's death instead. */
if (is_fatal(wall_life_cost))
{
p.play_stationary(hit_clip, false);
lose_lives(wall_life_cost);
end_run_hit();
return;
}
wallpool.play_2d(hit_clip, me_x, 0, w.x, 0, false); // no death sound: that's only for a wall your weapons destroy (dev)
p.play_stationary(get_pack_sound("misc/player/*hit*"), false);
lose_lives(wall_life_cost);
}
// Dropped once it's as far behind as obstacles appear ahead.
if (me_x > w.x + spawn_distance()) remove_wall(i);
}
}
/* A weapon hit: damages the nearest standing wall from 1 to reach tiles ahead and returns its x, or -1 if none is in
reach. Its hurt plays at the wall, or its death at 0 hp, which stops its loop and marks it destroyed. */
double strike_wall(int reach, int damage)
{
wall@ target = null;
for (uint i = 0; i < walls.length(); i++)
{
if (@walls[i] == null or !wall_standing(walls[i])) continue;
double ahead = walls[i].x - me_x;
if (ahead < 1 or ahead > reach) continue;
if (@target == null or walls[i].x < target.x) @target = walls[i];
}
if (@target == null) return -1;
target.hp -= damage;
if (target.hp <= 0)
{
target.destroyed = true;
stop_wall(target);
wallpool.play_2d(get_pack_sound("objects/traps/walls/" + target.theme + "/*death*"), me_x, 0, target.x, 0, false);
}
else wallpool.play_2d(get_pack_sound("objects/traps/walls/" + target.theme + "/*hurt*"), me_x, 0, target.x, 0, false);
return target.x;
}
// The countdown: the layered misc/trap/walls cues, one per step before each wall (see play_countdown()). Runs once per step.
void wall_countdown()
{
for (uint i = 0; i < walls.length(); i++)
{
// A destroyed wall's countdown stops (dev, 2026-11-03): nothing is left to warn about.
if (@walls[i] == null or !wall_standing(walls[i])) continue;
play_countdown(wallpool, "walls", walls[i].x, walls[i].countdown_start);
}
}
void stop_wall(wall@ w)
{
if (w.loopslot > -1) wallpool.destroy_sound(w.loopslot);
w.loopslot = -1;
}
void remove_wall(uint i)
{
if (i >= walls.length() or @walls[i] == null) return;
stop_wall(walls[i]);
@walls[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_walls()
{
for (uint i = 0; i < walls.length(); i++)
{
if (@walls[i] == null) continue;
stop_wall(walls[i]);
}
walls.resize(0);
}
