/* Powerups (dev, 2026-11-03, built 2026-11-04 for 1.3): passive pickups with a good or bad event, never in the inventory.
Each is a ground one (misc/game/powerground at its tile, replayed on a timer) or a flight one (powerflight), half and half. Arriving
on a ground one's tile on the ground collects it, and a jump skips it; arriving on a flight one's tile in the air
collects it, and running under it misses it. Weapons and bullets pass through them. On contact powerget plays centered
and the event is picked then, at random from what's possible right then (the shield pair only with a shield worn),
and its name is spoken. A missed one keeps sounding and fades out behind you.
Every event lasts powerup_time on runtimer (so pausing freezes it), one per kind: a new one of the same kind, or its
opposite, replaces it and restarts the time (dev: "I do not want the same type of powerup to stack up"). Different
kinds run together. Their effects come through the current_ helpers and powerup_damage() below.
Same entity pattern as the items: null-slot removal, reused slots, and only destroy_all_powerups() shrinks the array. */
sound_pool poweruppool;
const string powerup_folder = "misc/game/";
/* Not looped (dev, 2026-11-04): like SimpleFighter's non-looping checkpoints and items, a powerup replays its sound as a
one-shot every powerup_ground_sound_time or powerup_flight_sound_time, on runtimer so pausing stops it. soundslot is the latest one-shot. */
class powerup
{
double x;
bool flight = false; // in the air (collected by a jump) rather than on the belt
bool spent = false; // collected, or passed without collecting
bool collected = false; // collected: its sound stops; a missed one keeps sounding as it fades behind you
double next_sound = 0; // when, on runtimer, its next one-shot plays
int soundslot = -1;
}
powerup@[] powerups(0);

// The kinds of timed powerup, one slot each.
const int powerup_kind_speed = 0;
const int powerup_kind_jumps = 1;
const int powerup_kind_crouches = 2;
const int powerup_kind_melee = 3;
const int powerup_kind_guns = 4;
const int powerup_kind_shield = 5;
const int powerup_kind_health = 6;
const int powerup_kinds = 7;
/* The 14, in 7 pairs with the good one first, by their friendly names, which are spoken as they are (dev, 2026-11-04:
the shield pair was Shield Boost and Shield Crack, made timed and renamed; Tough Hide and Soft Hide added; Muffled
Steps dropped). All of them last powerup_time. */
string[] powerup_names = {"Slow Motion", "Rush Hour", "Moon Jump", "Short Hop", "Long Crouch", "Stiff Knees", "Quick Swings", "Clumsy Swings", "Rapid Fire", "Sticky Trigger", "Sturdy Shield", "Brittle Shield", "Tough Hide", "Soft Hide"};
int[] powerup_name_kinds = {powerup_kind_speed, powerup_kind_speed, powerup_kind_jumps, powerup_kind_jumps, powerup_kind_crouches, powerup_kind_crouches, powerup_kind_melee, powerup_kind_melee, powerup_kind_guns, powerup_kind_guns, powerup_kind_shield, powerup_kind_shield, powerup_kind_health, powerup_kind_health};
// The running timed powerup of each kind ("" for none), and when it ends on runtimer.
string[] active_powerups(powerup_kinds);
double[] powerup_ends(powerup_kinds);

// True when the powerup sounds exist, so the spawner can offer powerups.
bool powerups_available()
{
return get_pack_sound(powerup_folder + "*powerground*") != "" and get_pack_sound(powerup_folder + "*powerflight*") != "";
}
// Called from reset_run(): every run starts with no powerup running.
void reset_powerups()
{
for (int k = 0; k < powerup_kinds; k++)
{
active_powerups[k] = "";
powerup_ends[k] = 0;
}
}
// True while the named timed powerup is running.
bool powerup_active(string name)
{
for (int k = 0; k < powerup_kinds; k++)
{
if (active_powerups[k] == name) return true;
}
return false;
}
/* The effects (dev, 2026-11-03 and 4). Each helper turns a normal value into the one the running powerups give.
The step interval you actually run at: Slow Motion and Rush Hour shift the normal speed (step_time, which keeps speeding
up underneath and still sets the door marks) by powerup_speed_ms, never slower than start_step_time or faster than
min_step_time. */
int current_step_time()
{
int t = step_time;
if (powerup_active("Slow Motion")) t += powerup_speed_ms;
else if (powerup_active("Rush Hour")) t -= powerup_speed_ms;
return int(max(min_step_time, min(start_step_time, t)));
}
// A jump's time per height: Moon Jump makes jumps longer, Short Hop shorter.
double current_jump_tick()
{
if (powerup_active("Moon Jump")) return jump_tick * moon_jump_factor;
if (powerup_active("Short Hop")) return jump_tick * short_hop_factor;
return jump_tick;
}
// How long a crouch lasts: Long Crouch makes it longer, Stiff Knees shorter.
double current_duck_time()
{
if (powerup_active("Long Crouch")) return duck_time * long_crouch_factor;
if (powerup_active("Stiff Knees")) return duck_time * stiff_knees_factor;
return duck_time;
}
// The gap between swings or shots: Quick Swings and Clumsy Swings for melee, Rapid Fire and Sticky Trigger for guns.
double current_fire_gap(int gap)
{
string faster = is_gun(current_weapon) ? "Rapid Fire" : "Quick Swings";
string slower = is_gun(current_weapon) ? "Sticky Trigger" : "Clumsy Swings";
if (powerup_active(faster)) return gap * powerup_fire_faster;
if (powerup_active(slower)) return gap * powerup_fire_slower;
return gap;
}
// Damage to a worn shield (Sturdy Shield, Brittle Shield) or to your health (Tough Hide, Soft Hide), at least 1.
int powerup_damage(int damage, string tougher, string weaker)
{
double d = damage;
if (powerup_active(tougher)) d *= powerup_damage_less;
else if (powerup_active(weaker)) d *= powerup_damage_more;
return int(max(1, round(d, 0)));
}
// A shield that breaks takes its shield powerup with it, quietly (you've just heard it break).
void end_shield_powerup()
{
active_powerups[powerup_kind_shield] = "";
}
// countdown comes from the spawner like an item's; it only sets the spacing, since powerups need no hand.
void spawn_powerup(double px, int countdown)
{
powerup pu;
pu.x = px;
pu.flight = random(0, 1) == 1;
play_powerup_sound(pu); // the first one-shot at once, then on its kind's timer
for (uint i = 0; i < powerups.length(); i++)
{
if (@powerups[i] == null)
{
@powerups[i] = pu;
return;
}
}
powerups.insert_last(pu);
}
// One one-shot of a powerup's sound at its tile, and when the next is due.
void play_powerup_sound(powerup@ pu)
{
pu.soundslot = poweruppool.play_2d(get_pack_sound(powerup_folder + (pu.flight ? "*powerflight*" : "*powerground*")), 0, me.x, 0, pu.x, false);
pu.next_sound = runtimer.elapsed + (pu.flight ? powerup_flight_sound_time : powerup_ground_sound_time);
}
// Runs every frame from run_loop(): each uncollected powerup replays its sound when its time comes round.
void powerup_sounds()
{
for (uint i = 0; i < powerups.length(); i++)
{
if (@powerups[i] == null or powerups[i].collected) continue;
if (runtimer.elapsed >= powerups[i].next_sound) play_powerup_sound(powerups[i]);
}
}
/* Runs once per step, right after the move. Arriving on a powerup's tile the right way collects it: on the ground for a
ground one, in the air for a flight one. Arriving the wrong way, or being past it, means it's missed. */
void powerup_check()
{
for (uint i = 0; i < powerups.length(); i++)
{
if (@powerups[i] == null) continue;
powerup@ pu = powerups[i];
if (!pu.spent)
{
if (me.x == pu.x)
{
if (pu.flight != is_grounded()) collect_powerup(pu);
else pu.spent = true; // jumped over a ground one, or ran under a flight one
}
else if (me.x > pu.x) pu.spent = true;
}
if (me.x > pu.x + spawn_distance()) remove_powerup(i);
}
}
void collect_powerup(powerup@ pu)
{
stat_add(pu.flight ? "air_powerups_collected" : "ground_powerups_collected"); // run onto, or jumped into
pu.spent = true;
pu.collected = true;
stop_powerup(pu);
p.play_stationary(get_pack_sound(powerup_folder + "*powerget*"), false);
apply_powerup(pick_powerup_event());
}
// One of the 14 at random, leaving out the shield pair with no shield worn.
int pick_powerup_event()
{
int[] choices;
for (uint i = 0; i < powerup_names.length(); i++)
{
if (!shield_worn and powerup_name_kinds[i] == powerup_kind_shield) continue;
choices.insert_last(i);
}
return choices[random(0, choices.length() - 1)];
}
// Speaks the name and starts it in its kind's slot, replacing whatever was there, for powerup_time.
void apply_powerup(int index)
{
string name = powerup_names[index];
speak_buffer(name + ".", "powerups");
int kind = powerup_name_kinds[index];
active_powerups[kind] = name;
powerup_ends[kind] = runtimer.elapsed + powerup_time;
}
// Runs every frame from run_loop(): a timed powerup whose time is up ends, and says so.
void powerup_timers()
{
for (int k = 0; k < powerup_kinds; k++)
{
if (active_powerups[k] == "" or runtimer.elapsed < powerup_ends[k]) continue;
speak_buffer(active_powerups[k] + " wore off.", "powerups");
active_powerups[k] = "";
}
}
void stop_powerup(powerup@ pu)
{
if (pu.soundslot > -1) poweruppool.destroy_sound(pu.soundslot);
pu.soundslot = -1;
}
void remove_powerup(uint i)
{
if (i >= powerups.length() or @powerups[i] == null) return;
stop_powerup(powerups[i]);
@powerups[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_powerups()
{
for (uint i = 0; i < powerups.length(); i++)
{
if (@powerups[i] == null) continue;
stop_powerup(powerups[i]);
}
powerups.resize(0);
}
