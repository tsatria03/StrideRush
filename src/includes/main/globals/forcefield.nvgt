/* Force fields: full-height obstacles (dev, 2026-11-02). A field plays its theme's on loop at its tile while active
and its off loop while inactive. Jumping or crouching doesn't get you past one: stepping onto an active field hits you
at any height, does forcefield_damage (20) through take_damage(), cancels any jump or crouch, and throws you forcefield_knockback_tiles
forward past it, landing with the landing sounds. On the last life there's no throw: its hit, the player's death,
then the tile's fall. A field counts down like the other obstacles, with its own warn cues and no ledges. Passed, it
keeps its loop and fades out behind you until it's dropped a spawn distance behind.
The switch: either hand turns a field off on any step of its countdown (dev, 2026-11-02), and always within the last
switch_min_time before it, even where the countdown is shorter. The press plays centered
(not panned to the hand; dev, 2026-11-02), and the field swaps its on loop for its off loop, so you pass it safely. With no field counting down, a
hand press does nothing.
Same entity pattern as hazards: null-slot removal, reused slots, and only destroy_all_forcefields() shrinks the array. */
sound_pool forcefieldpool;
class forcefield
{
double x;
string theme;
string env; // the environment it spawned in, for its sounds after a switch (env.nvgt)
int pair = 0; // the combination it belongs to, or 0 (combo.nvgt)
bool active = true; // on loop while true, off loop while false
bool spent = false; // reached: it can never hit again
int loopslot = -1;
double countdown_start;
}
forcefield@[] forcefields(0);

// countdown comes from the spawner, the same countdown_steps() a hazard's ledge uses.
void spawn_forcefield(double fx, string theme, int countdown)
{
forcefield f;
f.x = fx;
f.theme = theme;
f.env = current_env;
f.pair = placing_pair;
f.countdown_start = fx - countdown;
f.loopslot = forcefieldpool.play_2d(get_pack_sound(trap_folder(current_env, "force_fields") + theme + "/*on*"), 0, me.x, 0, fx, true);
for (uint i = 0; i < forcefields.length(); i++)
{
if (@forcefields[i] == null)
{
@forcefields[i] = f;
return;
}
}
forcefields.insert_last(f);
}
/* Runs once per step, right after the move. Returns true if a field threw the player this step, so step_check() plays
the landing instead of a footstep. A fatal hit ends the run (running goes false) and returns false. */
bool forcefield_check()
{
for (uint i = 0; i < forcefields.length(); i++)
{
if (@forcefields[i] == null) continue;
forcefield@ f = forcefields[i];
if (carried() and me.x == f.x and !f.spent)
{
f.spent = true; // passed through on a slide (slide.nvgt)
continue;
}
if (me.x == f.x and !f.spent)
{
f.spent = true;
if (f.active)
{
// Stationary through p, not positioned at the field, since the throw moves the player away from it at once.
string hit_clip = get_pack_sound(trap_folder(f.env, "force_fields") + f.theme + "/*hit*");
/* A fatal hit plays no player hit and no throw, since end_run_hit() plays the player's death and then the fall of
the field's tile. */
stat_caught("force_fields");
pair_part_hit(f.pair); // the statistics: what caught you, and what ended the run if it's fatal
int blow = take_damage(forcefield_damage); // a worn shield, else your health
if (blow == blow_fatal)
{
p.play_stationary(hit_clip, false);
end_run_hit();
return false;
}
// Shielded or not, the field still throws you past it (dev, 2026-11-03).
p.play_stationary(hit_clip, false);
if (blow != blow_shielded) p.play_stationary(get_pack_sound("misc/player/*hit*"), false);
cancel_movement();
me.x += forcefield_knockback_tiles;
update_listeners();
return true;
}
}
// Kept looping until it's as far behind as obstacles appear ahead, so it fades out behind you.
if (me.x > f.x + spawn_distance()) remove_forcefield(i);
}
return false;
}
/* Runs every frame, before step_check(), so a press on the same frame as the step onto the field still counts on the
warn5 step. Either hand works the same, and every hand sound that acts on something plays centered (dev, 2026-11-02: panning sounded too far
to the side). It switches off the nearest active field that's counting down. */
/* A hand held down after switching off a field (dev, 2026-11-11, in the combined obstacles plan's testing: one clap
cleared a force field and an animal at once). That press was used on the field, so while it stays held it can't make
the other hand's press a clap; let go, and it's free again. */
bool left_used_on_field = false, right_used_on_field = false;
// The switch press from the field's environment, a random switches theme (the transitions plan, dev, 2026-11-13).
string switch_press_sound(const string&in env)
{
string[] themes = get_pack_sound_folders(trap_folder(env, "switches") + "*");
if (themes.length() == 0) return "";
return get_pack_sound(trap_folder(env, "switches") + themes[random(0, themes.length() - 1)] + "/*press*");
}
void hand_check()
{
if (left_used_on_field and !controls.action_down("hand_left")) left_used_on_field = false;
if (right_used_on_field and !controls.action_down("hand_right")) right_used_on_field = false;
// A lone empty hand's woosh waits clap_window ms for the other hand (see empty_hand_sound()); no clap came, so play it.
if (woosh_pending_side != 0 and wooshtimer.elapsed >= clap_window) play_pending_woosh();
if (door_moving or sliding) return; // no hands while a door carries you or on a slide
bool left = controls.action_triggered("hand_left"), right = controls.action_triggered("hand_right");
if (!left and !right) return;
// On a ladder your hands climb; a press in a ladder's window grabs it (ladder.nvgt).
if (climbing)
{
climb_hand(left, right);
return;
}
if (grab_ladder(left, right)) return;
forcefield@ target = null;
int target_steps = 0;
for (uint i = 0; i < forcefields.length(); i++)
{
if (@forcefields[i] == null) continue;
forcefield@ f = forcefields[i];
if (!f.active or f.spent or me.x < switch_window_start(f)) continue;
int steps_left = int(f.x - me.x);
if (steps_left < 1) continue;
if (@target == null or steps_left < target_steps)
{
@target = f;
target_steps = steps_left;
}
}
// No field counting down: the same press can act on a door, or else pick up an ammo pack, a key, a shield, a capsule, a potion or a teleporter, or does nothing.
if (@target == null)
{
if (!open_door() and !pick_up_ammopack() and !pick_up_key() and !pick_up_shield() and !pick_up_capsule() and !pick_up_potion() and !pick_up_teleporter()) empty_hand_sound(left, right);
return;
}
forcefieldpool.play_stationary(switch_press_sound(target.env), false);
switch_off_forcefield(target);
if (left) left_used_on_field = true;
if (right) right_used_on_field = true;
}
/* A hand press that grabbed, opened or switched nothing (dev, 2026-11-04): both hands together clap (misc/player
clap1-3, centred); one hand alone plays woosh, centred too (dev, 2026-11-04; at first the left hand panned 50 left and
the right 50 right). A clap also scares away the nearest animal in reach (animal.nvgt, the dev's use for claps, 2026-11-04).
"Together" is the same frame, one pressed while the other is held, or the other hand within clap_window ms. A lone
press's woosh waits that long first, so a clap never comes with a woosh in front of it (dev: "I don't like how it plays
the clap and woosh at the same time"). */
int woosh_pending_side = 0; // -1 a left-hand woosh is waiting, 1 a right-hand one, 0 none
timer wooshtimer;
void empty_hand_sound(bool left, bool right)
{
int side = left ? -1 : 1;
// A held hand that just switched off a field doesn't count (left_used_on_field, right_used_on_field).
bool both = (left and right) or (left and controls.action_down("hand_right") and !right_used_on_field) or (right and controls.action_down("hand_left") and !left_used_on_field) or (woosh_pending_side == -side);
if (both)
{
woosh_pending_side = 0; // the waiting woosh becomes this clap
p.play_stationary(get_pack_sound("misc/player/*clap*"), false);
scare_animal(); // a clap scares off the nearest animal in reach, if there is one (the birds plan)
return;
}
if (woosh_pending_side == side) play_pending_woosh(); // the same hand twice: the first woosh plays now
woosh_pending_side = side;
wooshtimer.restart();
}
void play_pending_woosh()
{
p.play_stationary(get_pack_sound("misc/player/*woosh*"), false); // centred (dev, 2026-11-04; it was panned 50 to the hand's side)
woosh_pending_side = 0;
}
// Where a field's switch can first be pressed: the shared hand window (hand_window_start() in spawner.nvgt).
double switch_window_start(forcefield@ f)
{
return hand_window_start(f.x, f.countdown_start);
}
// Turns a field off: its on loop stops and its off loop starts at the same tile, so you pass it on the off loop.
void switch_off_forcefield(forcefield@ f)
{
f.active = false;
stat_add("force_fields_switched_off");
pair_part_cleared(f.pair);
forcefieldpool.destroy_sound(f.loopslot);
f.loopslot = forcefieldpool.play_2d(get_pack_sound(trap_folder(f.env, "force_fields") + f.theme + "/*off*"), 0, me.x, 0, f.x, true);
}
// The countdown: one force_fields countdown warn cue per step before each field (see play_countdown()). Runs once per step.
void forcefield_countdown()
{
for (uint i = 0; i < forcefields.length(); i++)
{
// A switched-off field's countdown stops (dev, 2026-11-03): it's no danger any more.
if (@forcefields[i] == null or !forcefields[i].active) continue;
play_countdown(forcefieldpool, "force_fields", forcefields[i].x, forcefields[i].countdown_start, forcefields[i].env);
}
}
void remove_forcefield(uint i)
{
if (i >= forcefields.length() or @forcefields[i] == null) return;
forcefieldpool.destroy_sound(forcefields[i].loopslot);
@forcefields[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_forcefields()
{
for (uint i = 0; i < forcefields.length(); i++)
{
if (@forcefields[i] == null) continue;
forcefieldpool.destroy_sound(forcefields[i].loopslot);
}
forcefields.resize(0);
}
