/* Force fields: full-height obstacles (dev, 2026-11-02). A field plays its theme's on loop at its tile while active
and its off loop while inactive. Jumping or crouching doesn't get you past one: stepping onto an active field hits you
at any height, costs forcefield_life_cost (1), cancels any jump or crouch, and throws you forcefield_knockback_tiles
forward past it, landing with the landing sounds. On the last life there's no throw: its hit, the player's death,
then the tile's fall. A field counts down like the other obstacles, with its own warn cues and no ledges. Passed, it
keeps its loop and fades out behind you until it's dropped a spawn distance behind.
The switch: either hand turns a field off on any step of its countdown (dev, 2026-11-02), and always within the last
switch_min_time before it, even where the countdown is shorter. The press plays centered
(not panned to the hand; dev, 2026-11-02), and the field swaps its on loop for its off loop, so you pass it safely. With no field counting down, a
hand press does nothing.
Same entity pattern as hazards: null-slot removal, reused slots, and only destroy_all_forcefields() shrinks the array. */
sound_pool forcefieldpool;
class forcefield
{
double x;
string theme;
bool active = true; // on loop while true, off loop while false
bool spent = false; // reached: it can never hit again
int loopslot = -1;
double countdown_start;
}
forcefield@[] forcefields(0);

// countdown comes from the spawner, the same countdown_steps() a hazard's ledge uses.
void spawn_forcefield(double fx, string theme, int countdown)
{
forcefield f;
f.x = fx;
f.theme = theme;
f.countdown_start = fx - countdown;
f.loopslot = forcefieldpool.play_2d(get_pack_sound("objects/traps/force_fields/" + theme + "/*on*"), me_x, 0, fx, 0, true);
for (uint i = 0; i < forcefields.length(); i++)
{
if (@forcefields[i] == null)
{
@forcefields[i] = f;
return;
}
}
forcefields.insert_last(f);
}
/* Runs once per step, right after the move. Returns true if a field threw the player this step, so step_check() plays
the landing instead of a footstep. A fatal hit ends the run (running goes false) and returns false. */
bool forcefield_check()
{
for (uint i = 0; i < forcefields.length(); i++)
{
if (@forcefields[i] == null) continue;
forcefield@ f = forcefields[i];
if (me_x == f.x and !f.spent)
{
f.spent = true;
if (f.active)
{
// Stationary through p, not positioned at the field, since the throw moves the player away from it at once.
string hit_clip = get_pack_sound("objects/traps/force_fields/" + f.theme + "/*hit*");
/* A fatal hit plays no player hit and no throw, since end_run_hit() plays the player's death and then the fall of
the field's tile. */
// A worn shield takes it, but the field still throws you past it (dev, 2026-11-03).
if (shield_absorb(forcefield_shield_damage))
{
p.play_stationary(hit_clip, false);
cancel_movement();
me_x += forcefield_knockback_tiles;
update_listeners();
return true;
}
if (is_fatal(forcefield_life_cost))
{
p.play_stationary(hit_clip, false);
lose_lives(forcefield_life_cost);
end_run_hit();
return false;
}
p.play_stationary(hit_clip, false);
p.play_stationary(get_pack_sound("misc/player/*hit*"), false);
lose_lives(forcefield_life_cost);
cancel_movement();
me_x += forcefield_knockback_tiles;
update_listeners();
return true;
}
}
// Kept looping until it's as far behind as obstacles appear ahead, so it fades out behind you.
if (me_x > f.x + spawn_distance()) remove_forcefield(i);
}
return false;
}
/* Runs every frame, before step_check(), so a press on the same frame as the step onto the field still counts on the
warn5 step. Either hand works the same, and every hand sound plays centered (dev, 2026-11-02: panning sounded too far
to the side). It switches off the nearest active field that's counting down. */
void hand_check()
{
if (door_moving) return; // no hands while a door carries you
if (!controls.action_triggered("hand_left") and !controls.action_triggered("hand_right")) return;
forcefield@ target = null;
int target_steps = 0;
for (uint i = 0; i < forcefields.length(); i++)
{
if (@forcefields[i] == null) continue;
forcefield@ f = forcefields[i];
if (!f.active or f.spent or me_x < switch_window_start(f)) continue;
int steps_left = int(f.x - me_x);
if (steps_left < 1) continue;
if (@target == null or steps_left < target_steps)
{
@target = f;
target_steps = steps_left;
}
}
// No field counting down: the same press can act on a door, or else pick up an ammo pack, a key or a shield, or does nothing.
if (@target == null)
{
if (!open_door() and !pick_up_ammopack() and !pick_up_key()) pick_up_shield();
return;
}
forcefieldpool.play_stationary(get_pack_sound("objects/interaction/switches/switch/*press*"), false);
switch_off_forcefield(target);
}
// Where a field's switch can first be pressed: the shared hand window (hand_window_start() in spawner.nvgt).
double switch_window_start(forcefield@ f)
{
return hand_window_start(f.x, f.countdown_start);
}
// Turns a field off: its on loop stops and its off loop starts at the same tile, so you pass it on the off loop.
void switch_off_forcefield(forcefield@ f)
{
f.active = false;
forcefieldpool.destroy_sound(f.loopslot);
f.loopslot = forcefieldpool.play_2d(get_pack_sound("objects/traps/force_fields/" + f.theme + "/*off*"), me_x, 0, f.x, 0, true);
}
// The countdown: one misc/trap/force_fields warn cue per step before each field (see play_countdown()). Runs once per step.
void forcefield_countdown()
{
for (uint i = 0; i < forcefields.length(); i++)
{
// A switched-off field's countdown stops (dev, 2026-11-03): it's no danger any more.
if (@forcefields[i] == null or !forcefields[i].active) continue;
play_countdown(forcefieldpool, "force_fields", forcefields[i].x, forcefields[i].countdown_start);
}
}
void remove_forcefield(uint i)
{
if (i >= forcefields.length() or @forcefields[i] == null) return;
forcefieldpool.destroy_sound(forcefields[i].loopslot);
@forcefields[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_forcefields()
{
for (uint i = 0; i < forcefields.length(); i++)
{
if (@forcefields[i] == null) continue;
forcefieldpool.destroy_sound(forcefields[i].loopslot);
}
forcefields.resize(0);
}
