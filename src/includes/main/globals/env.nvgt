/* Environments (the environments plan, dev, 2026-11-10; Section 1). Each folder in sounds/environments is a place with its
own audio (tracks, ambiences), platforms (surfaces, its ledge) and traps (<type>/countdown and <type>/general/<theme>);
equipments, misc and ui stay shared. A run plays in current_env, picked at random when it starts (Section 2 adds the
switch every 1 to 2 minutes). Every obstacle remembers the environment it spawned in (its env field), so one still on the
belt after a switch keeps its own sounds. Nothing ever falls back to another environment: a type with no folder there
doesn't spawn there, and a missing clip just doesn't play. */
string current_env = "default";
/* The debug option's choice (source only): "" is "random", the normal random pick; otherwise the one environment a
debug run stays in. Cleared for endless and practice runs by play_game(). */
string debug_env = "";

// "environments/default/", the root of one environment's sounds.
string env_root(const string&in env)
{
return "environments/" + env + "/";
}
// Where one environment keeps a type's themes: "environments/default/traps/hazards/general/".
string trap_folder(const string&in env, const string&in type)
{
return env_root(env) + "traps/" + type + "/general/";
}
// Every environment, naturally sorted, from the folders.
string[] env_names()
{
return get_pack_sound_folders("environments/*");
}
// True when an environment has at least one theme for a type, so the type can spawn there.
bool env_has_type(const string&in env, const string&in type)
{
return get_pack_sound_folders(trap_folder(env, type) + "*").length() > 0;
}
// A practice choice's trap folder: the three door choices all live in doors, everything else in its own name.
string practice_trap_type(const string&in choice)
{
if (choice == "fake_doors" or choice == "real_doors" or choice == "mixed_doors") return "doors";
return choice;
}
/* The environment a run starts in (dev, 2026-11-10: random order, automatic only): a debug run's chosen one if the debug
option picked one; otherwise a random one, and for a practice run only among those that have the practiced obstacle. If
nothing qualifies, the run stays where it was (default at first). */
void pick_start_env()
{
string[] names = env_names();
if (run_difficulty < 0 and !practice_run and debug_env != "" and names.find(debug_env) >= 0)
{
current_env = debug_env;
return;
}
string[] candidates;
for (uint i = 0; i < names.length(); i++)
{
if (practice_run and !env_has_type(names[i], practice_trap_type(practice_choice))) continue;
candidates.insert_last(names[i]);
}
if (candidates.length() > 0) current_env = candidates[random(0, candidates.length() - 1)];
}
