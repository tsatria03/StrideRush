/* Timed runs (the timed run plan, dev, 2026-11-13; Section 1). A mode after endless run in the mode menu: an endless run
on one of the five levels (its speed, schedule, spacing, items, doors, damage, 200 health and 1 life), plus two clocks
on runtimer, so pausing freezes both.
- The countdown starts at timed_start_seconds for the level; each clean pass (a stat in timed_pass_stats, so a
  combination's parts each, not the pair) adds timed_pass_seconds, each hit (stat_caught(), a ladder's blow, a vehicle's
  burst once however many of its shots land) takes timed_hit_seconds. At zero: "Time's up."
- The finish line is timed_finish_seconds of running; reached with time left: "You crossed the finish line."
- T says both clocks; the countdown warns at timed_warn_seconds (45, 30, 15, 10, 5) in the status buffer, once each as it drops
  past, again only after it climbs timed_warn_rearm_seconds (10) above it.
- A death ends it as in endless. A win, a time-out or a death counts toward the level's timed_level_runs (saved as
  timed_runs_<level>); quitting and restarting don't. Each level after easy opens after timed_unlock_runs (3) on the one
  below, apart from endless's difficulty_runs. The mode itself opens once easy endless has its difficulty_unlock_runs.
- Timed runs keep out of the endless statistics and achievements (start_run_stats()); Section 2 gives them their own
  records, results after each run, and five achievements of scope timed in achievements.ini.
- Optional sounds in misc/game, played if they're ever added: timewin (the finish line), timelost (time's up), timewarn
  (each warning). */
bool timed_run = false; // the mode's runs, set by play_game() and kept through restarts and replays
int[] timed_level_runs = {0, 0, 0, 0, 0}; // completed timed runs per level, as difficulty_runs is for endless
double timed_bank = 0; // the countdown is timed_bank minus runtimer.elapsed, in ms
string timed_outcome = ""; // "win", "timeout" or "death" once a timed run ends, "" while it runs or after a quit
bool[] timed_warned = {false, false, false, false, false}; // one per timed_warn_seconds entry

// The mode opens with medium in endless: once easy has its difficulty_unlock_runs counted runs.
bool timed_mode_unlocked()
{
return difficulty_runs[0] >= difficulty_unlock_runs;
}
// "after completing 5 easy endless runs.", or "after completing 2 more easy endless runs." once started ("run" for 1).
string timed_mode_lock_reason()
{
int left = difficulty_unlock_runs - difficulty_runs[0];
bool started = difficulty_runs[0] > 0;
return "after completing " + left + (started ? " more " : " ") + "easy endless " + (left == 1 ? "run." : "runs.");
}
// From start_run(), after reset_run() has restarted runtimer: the clocks for this level, nothing warned.
void reset_timed()
{
timed_outcome = "";
if (!timed_run or run_difficulty < 0) return;
timed_bank = timed_start_seconds[run_difficulty] * 1000.0;
// A level that starts at or under a warning has it marked until the countdown climbs clear of it; one just above still warns.
for (uint i = 0; i < timed_warn_seconds.length(); i++) timed_warned[i] = timed_start_seconds[run_difficulty] <= timed_warn_seconds[i];
}
double timed_left_ms()
{
return timed_bank - runtimer.elapsed;
}
double timed_finish_ms()
{
return timed_finish_seconds[run_difficulty] * 1000.0;
}
// From stat_add(): a clean pass adds the level's time.
void timed_pass(const string&in key)
{
if (!timed_run or !running or run_difficulty < 0) return;
if (timed_pass_stats.find(key) < 0) return;
timed_bank += timed_pass_seconds[run_difficulty] * 1000.0;
}
// From stat_caught(), ladder_fail() and a vehicle's burst: a hit takes the level's time.
void timed_hit()
{
if (!timed_run or !running or run_difficulty < 0) return;
timed_bank -= timed_hit_seconds[run_difficulty] * 1000.0;
}
// Every frame from run_loop(): time's up, the finish line, or a warning.
void timed_update()
{
if (!timed_run or !running or run_difficulty < 0) return;
double left = timed_left_ms();
if (left <= 0)
{
end_run_timed(false);
return;
}
if (runtimer.elapsed >= timed_finish_ms())
{
end_run_timed(true);
return;
}
// Only the lowest newly crossed warning is said, so a big hit from above 30 says "5 seconds left." alone.
int say = -1;
for (uint i = 0; i < timed_warn_seconds.length(); i++)
{
if (left <= timed_warn_seconds[i] * 1000.0)
{
if (!timed_warned[i])
{
timed_warned[i] = true;
say = timed_warn_seconds[i];
}
}
else if (left > (timed_warn_seconds[i] + timed_warn_rearm_seconds) * 1000.0) timed_warned[i] = false; // re-armed only well clear of it, so hovering near it stays quiet (dev, 2026-11-13)
}
if (say < 0) return;
string clip = get_pack_sound("misc/game/*timewarn*");
if (clip != "") p.play_stationary(clip, false);
speak_buffer(say + " seconds left.", "status");
}
/* The finish line (won) or time's up: the run goes quiet, the optional sound plays, and the run ends through finish_run(),
which counts it toward the level. after_death_menu() says which it was. */
void end_run_timed(bool won)
{
timed_outcome = won ? "win" : "timeout";
silence_run();
string clip = get_pack_sound("misc/game/*" + (won ? "timewin" : "timelost") + "*");
if (clip != "") dlgplay(clip);
finish_run();
}
/* From finish_run(): a timed run's ending counts toward its level, whatever it was, and goes into its records (Section 2),
with the timed run achievements checked. A death sets its outcome here. */
void count_timed_run()
{
if (timed_outcome == "") timed_outcome = "death";
int level = run_difficulty;
timed_level_runs[level] += 1;
timed_played[level] += 1;
timed_end_time = runtimer.elapsed;
timed_end_left = timed_left_ms() < 0 ? 0 : timed_left_ms();
timed_new_best = false;
if (timed_outcome == "win")
{
timed_wins[level] += 1;
if (int(timed_end_left) > timed_best[level])
{
timed_best[level] = int(timed_end_left);
timed_new_best = true;
}
}
else if (timed_outcome == "timeout") timed_timeouts[level] += 1;
else timed_deaths[level] += 1;
check_timed_achievements();
writegame();
}
// What after_death_menu() opens with for a timed run.
string timed_end_line()
{
if (timed_outcome == "win") return "You crossed the finish line.";
if (timed_outcome == "timeout") return "Time's up.";
return "You have died.";
}
// "45 seconds", "1 minute 5 seconds", "2 minutes": T's wording, with no "and" (dev, 2026-11-13).
string timed_clock_phrase(double ms)
{
int total = ms <= 0 ? 0 : int(ms / 1000);
int minutes = total / 60;
int seconds = total % 60;
string sec_text = seconds == 1 ? "1 second" : seconds + " seconds";
if (minutes == 0) return sec_text;
string min_text = minutes == 1 ? "1 minute" : minutes + " minutes";
return seconds == 0 ? min_text : min_text + " " + sec_text;
}
/* T in a timed run: "You have 45 seconds left on the clock, and 2 minutes 10 seconds until you reach the finish line." (dev,
2026-11-13, after "to the finish line" sounded like a deadline: "on the clock" marks the one you can run out of). */
string timed_status_line()
{
return "You have " + timed_clock_phrase(timed_left_ms()) + " left on the clock, and " + timed_clock_phrase(timed_finish_ms() - runtimer.elapsed) + " until you reach the finish line.";
}
/* Section 2: the timed run records, per level, apart from the endless statistics (the timed run plan, dev, 2026-11-13: "I
want them seprat if possible"): runs that ended (a win, a time-out or a death), wins, time-outs, deaths, and the best
finish, the most clock left at the finish line in ms (0 for none yet). Saved as timed_<record>_<level>; cleared with game
progress (clear_timed_records()), which never touches timed_level_runs, the unlocks. */
int[] timed_played = {0, 0, 0, 0, 0};
int[] timed_wins = {0, 0, 0, 0, 0};
int[] timed_timeouts = {0, 0, 0, 0, 0};
int[] timed_deaths = {0, 0, 0, 0, 0};
int[] timed_best = {0, 0, 0, 0, 0};
double timed_end_left = 0; // the clock left as the run ended, for its results
double timed_end_time = 0; // how long it ran
bool timed_new_best = false; // this win beat the level's best finish
void clear_timed_records()
{
for (uint i = 0; i < timed_played.length(); i++)
{
timed_played[i] = 0;
timed_wins[i] = 0;
timed_timeouts[i] = 0;
timed_deaths[i] = 0;
timed_best[i] = 0;
}
}
// An achievement's stat in a timed run's records: "timed_wins_easy" is easy's wins (achievements.nvgt).
int64 timed_stat_value(const string&in stat)
{
if (stat.length() <= 11 or stat.substr(0, 11) != "timed_wins_") return 0;
int level = difficulty_names.find(stat.substr(11));
return level < 0 ? 0 : timed_wins[level];
}
// From count_timed_run(): the timed run achievements (scope timed), each earned by its level's first win.
void check_timed_achievements()
{
for (uint i = 0; i < achievements.length(); i++)
{
achievement@ a = achievements[i];
if (a.scope != "timed" or achievement_earned(a)) continue;
if (timed_stat_value(a.stat) >= a.threshold) earn_achievement(a);
}
}
string timed_outcome_text()
{
if (timed_outcome == "win") return "crossed the finish line";
if (timed_outcome == "timeout") return "time's up";
return "died";
}
// A level's best finish as a line's value: "1 minute 5 seconds left", or "none yet" before its first win.
string timed_best_text(int level)
{
return timed_best[level] > 0 ? timed_clock_phrase(timed_best[level]) + " left" : "none yet";
}
/* The results after a timed run (Section 2), in the results menu's "label, value" lines: the level, the outcome, the clock
left (a win) or the time survived, and the level's best finish, marked when this run set it. */
string[] timed_result_lines()
{
string[] lines;
int level = run_difficulty;
lines.insert_last(stat_line("difficulty", difficulty_names[level]));
lines.insert_last(stat_line("outcome", timed_outcome_text()));
if (timed_outcome == "win") lines.insert_last(stat_line("time left on the clock", timed_clock_phrase(timed_end_left)));
else lines.insert_last(stat_line("time survived", timed_clock_phrase(timed_end_time)));
lines.insert_last(stat_line("best finish", timed_best_text(level) + (timed_new_best ? ", a new record" : "")));
return lines;
}
// The statistics menu's timed run records: five lines for each level, easy to chaos.
string[] timed_record_lines()
{
string[] lines;
for (uint i = 0; i < difficulty_names.length(); i++)
{
string lv = difficulty_names[i];
lines.insert_last(stat_line(lv + " timed runs played", thousands_text(timed_played[i])));
lines.insert_last(stat_line(lv + " wins", thousands_text(timed_wins[i])));
lines.insert_last(stat_line(lv + " time-outs", thousands_text(timed_timeouts[i])));
lines.insert_last(stat_line(lv + " deaths", thousands_text(timed_deaths[i])));
lines.insert_last(stat_line(lv + " best finish", timed_best_text(i)));
}
return lines;
}
