/* The joystick: one, handed to controls at startup, its buttons set in data/config/main/joystick.ini. A run reads it through
controls like the keys, with the left stick counting as the d-pad; menus get fixed buttons turned into keys. Plugging in and out is noticed once a second, in
menus and runs, and each change is said once; unplugging it during a run pauses the run. If joystick.ini is missing or
can't be read, no joystick is opened and the game plays with the keyboard only. */
const string joystick_ini_path = "data/config/main/joystick.ini";
joystick@ joy = null;
bool joy_announced = false; // the connection last spoken
timer joy_check_timer;
uint64 joy_last_frame = 0;
// The left stick as the d-pad: 0 up, 1 down, 2 left, 3 right, read as SDL's d-pad buttons 11 to 14.
bool[] stick_down(4, false);
bool[] stick_pressed(4, false);
bool[] stick_released(4, false);

/* From load_controls(), after keyboard.ini: the bindings, then the joystick. Whatever is plugged in at launch is taken
silently; only changes after that are spoken. */
void start_joystick()
{
string jpath = joystick_ini_path;
if (!file_exists(jpath))
{
alert("Warning", "Missing joystick.ini at " + jpath + ", so the game will run with the keyboard only.");
return;
}
if (!controls.load_joystick_file(jpath))
{
alert("Warning", "Failed to load " + jpath + ", so the game will run with the keyboard only until you reinstall the game.");
return;
}
sdl_set_hint("SDL_JOYSTICK_HIDAPI_PS5_RUMBLE", "1"); // a PlayStation 5 controller over Bluetooth rumbles only with this, read as the joystick opens
@joy = joystick();
controls.set_joystick(joy);
@controls.extra_button = stick_button;
@form_frame_hook = joystick_menu_frame;
joy_announced = joy.active;
joy_check_timer.restart();
}
/* Once a second: opens a joystick that was plugged in, and says "Joystick connected." or "Joystick disconnected." once
per change. In a run, a disconnect opens the pause menu with the news in its intro, and this returns true. */
bool joystick_check(bool in_run)
{
if (@joy == null or joy_check_timer.elapsed < joystick_check_time) return false;
joy_check_timer.restart();
if (!joy.active and joystick_count() > 0) joy.set(0);
bool connected = joy.active;
if (connected == joy_announced) return false;
joy_announced = connected;
if (connected)
{
speak_buffer("Joystick connected.", "misc");
return false;
}
if (!in_run)
{
speak_buffer("Joystick disconnected.", "misc");
return false;
}
add_buffer_item("misc", "Joystick disconnected.", false);
pause_menu("Joystick disconnected.");
return true;
}
/* The menus' fixed buttons, not rebindable, turned into the keys every menu already knows: the d-pad (and left stick) as
the arrows, A as Enter, B as Escape, the right shoulder as Tab and the left as Shift+Tab. */
const int[] menu_buttons = {11, 12, 13, 14, 0, 1, 10, 9};
const uint[] menu_keys = {KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT, KEY_RETURN, KEY_ESCAPE, KEY_TAB, KEY_TAB};
uint64 joy_menu_last = 0;
uint64[] menu_repeat_at(4, 0); // when each held direction taps again; 0 while not held
int menu_shift_frames = 0; // frames left before the left shoulder's Shift is let go
/* Every menu frame, through form.nvgt's form_frame_hook (dlg() and dlgplay() call it too). Each button is a key tap; a
held d-pad or stick taps again after joystick_repeat_delay, then every joystick_repeat_interval. A frame long after the
last menu frame means a run or a wait came between, so waiting presses are dropped. */
void joystick_menu_frame()
{
if (@joy == null) return;
uint64 now = ticks();
if (now == joy_menu_last) return; // a subform's monitor() in the same frame
bool gap = now - joy_menu_last > uint64(joystick_gap_time);
joy_menu_last = now;
if (menu_shift_frames > 0)
{
menu_shift_frames--;
if (menu_shift_frames == 0) reset_forced_key(KEY_LSHIFT);
}
joystick_check(false);
int[]@ pressed = joy.buttons_pressed();
joy.buttons_released();
update_stick(gap);
if (gap)
{
for (uint d = 0; d < 4; d++) menu_repeat_at[d] = 0;
return;
}
bool[] tapped(4, false);
for (uint i = 0; i < pressed.length(); i++)
{
if (pressed[i] == 3 and dlg_open) menu_tap(KEY_C); // Y copies a dlg() message (dlg.nvgt), and nothing in other menus
int slot = menu_buttons.find(pressed[i]);
if (slot < 0) continue;
if (slot < 4)
{
tapped[slot] = true;
continue;
}
/* Shift is held through the next frame too, since the Tab is only read once it arrives there. */
if (pressed[i] == 9)
{
force_key_down(KEY_LSHIFT);
menu_shift_frames = 2;
}
menu_tap(menu_keys[slot]);
}
for (uint d = 0; d < 4; d++)
{
if (stick_pressed[d]) tapped[d] = true;
bool held = joy.button_down(11 + d) or stick_down[d];
if (tapped[d])
{
menu_tap(menu_keys[d]);
menu_repeat_at[d] = now + uint64(joystick_repeat_delay);
}
else if (!held) menu_repeat_at[d] = 0;
else if (menu_repeat_at[d] > 0 and now >= menu_repeat_at[d])
{
menu_tap(menu_keys[d]);
menu_repeat_at[d] = now + uint64(joystick_repeat_interval);
}
}
}
/* One key press for the menus. Its held flag is cleared straight away, so the menu sees a press but never a key left
down: loops that wait for Enter to lift would otherwise wait for a key-up nothing sends. */
void menu_tap(uint key)
{
simulate_key_down(key);
reset_forced_key(key);
}
/* Every run frame, before any input is read: the stick's presses for this frame. A frame long after the last one means a
menu was open, so the pad's waiting presses are dropped and the stick only counts again once moved. */
void joystick_run_frame()
{
if (@joy == null) return;
uint64 now = ticks();
bool gap = now - joy_last_frame > uint64(joystick_gap_time);
joy_last_frame = now;
if (menu_shift_frames > 0)
{
menu_shift_frames = 0;
reset_forced_key(KEY_LSHIFT); // a menu closed on Shift+Tab, so nothing in the run sees Shift held
}
if (gap)
{
joy.buttons_pressed();
joy.buttons_released();
}
update_stick(gap);
}
// The left stick's held, pressed and released states for this frame; with gap, nothing is pressed or released.
void update_stick(bool gap)
{
int dx = int(joy.x) - 32768;
int dy = int(joy.y) - 32768;
for (int d = 0; d < 4; d++)
{
int along = d == 0 ? -dy : (d == 1 ? dy : (d == 2 ? -dx : dx));
int across = d < 2 ? (dx < 0 ? -dx : dx) : (dy < 0 ? -dy : dy);
bool was = stick_down[d];
// A new push must lean mostly this way, so a slightly diagonal jump doesn't change lanes too.
bool now_down = was ? along > stick_release_at : (along > stick_press_at and along > across);
stick_pressed[d] = now_down and !was and !gap;
stick_released[d] = was and !now_down and !gap;
stick_down[d] = now_down;
}
}
// The vibration moments, indexes into tuning.nvgt's rumble_low, rumble_high and rumble_times.
const int rumble_shield = 0;
const int rumble_hurt = 1;
const int rumble_life = 2;
const int rumble_death = 3;
// One rumble, replacing any still going; nothing without a connected joystick, or with the Joystick tab's setting off.
void joystick_rumble(int kind)
{
if (!joystick_vibration or @joy == null or !joy.active) return;
joy.vibrate(uint16(rumble_low[kind]), uint16(rumble_high[kind]), rumble_times[kind]);
}
// The buttons as the bindings screens say them, by SDL's numbers; any past these is "button 15" and so on.
const string[] button_names = {"A button", "B button", "X button", "Y button", "back", "guide", "start", "left stick click", "right stick click", "left shoulder", "right shoulder", "d-pad up", "d-pad down", "d-pad left", "d-pad right"};
string button_name(int b)
{
if (b >= 0 and b < int(button_names.length())) return button_names[b];
return "button " + b;
}
// An action's joystick.ini value in the spoken names, "DPAD_DOWN:down,DPAD_UP" as "d-pad down:down, d-pad up"; empty if none.
string joystick_names(const string&in value)
{
string result = "";
string[] entries = value.split(",", true);
for (uint i = 0; i < entries.length(); i++)
{
string e = entries[i].trim_whitespace();
if (e == "") continue;
int colon = e.find_first(":");
string num = colon < 0 ? e : e.substr(0, colon);
string trig = colon < 0 ? "" : e.substr(colon);
result += (result == "" ? "" : ", ") + button_name(kc_button_from_name(num)) + trig; // joystick.ini's name, or an older number (key_config.nvgt)
}
return result;
}
// controls' extra_button: the stick for d-pad buttons 11 to 14. Repeat counts as press, as it does for the pad's buttons.
bool stick_button(int button, kc_trigger trigger)
{
int d = button - 11;
if (d < 0 or d > 3) return false;
if (trigger == KC_DOWN) return stick_down[d];
if (trigger == KC_RELEASE) return stick_released[d];
return stick_pressed[d];
}
