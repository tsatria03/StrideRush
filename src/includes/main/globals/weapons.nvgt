/* The weapons: one damage table, separate ammo per gun, reloading any time a gun isn't full, and one generic target hook
instead of a copy of the firing code per target type. All ten are available from the start of every run on 1 to 0, in
this order, and a run starts with the fist drawn. Space swings or fires; the machine gun keeps firing while Space is
held. A melee weapon swings: the swing plays on the press, the hit lands after the weapon's melee_swing_times, then its
melee_recovery_times must pass before the next swing; a gun fires a bullet that travels (bullet.nvgt). A gun with
nothing loaded, or mid-reload, plays empty instead. R reloads, timed by the length of the gun's reload sound, and ping
plays when it's done. X speaks the ammo. weapon_strike() is the target hook: walls, fake doors, vehicles in your lane
and items. Each weapon reaches its own weapon_reach_times ahead, so weapons differ by damage, reach and, for melee, swing
speed. */
// Alphabetical, the guns last on 9 and 0; weapon_damage follows the same order.
string[] weapon_names = {"bat", "boot", "club", "dagger", "fist", "hammer", "knife", "sword", "machine_gun", "pistol"};
// Base damage by key: the bat (1) 3 up to the pistol (0) 30; every hit is this times weapon_damage_multiplier.
int[] weapon_damage = {3, 6, 9, 12, 15, 18, 21, 24, 27, 30};
// Ammo for each weapon; only the guns use it.
int[] weapon_loaded(10);
int[] weapon_reserve(10);

int current_weapon = -1;
sound draw_sound; // its own sound, so drawing another weapon cuts the last draw off, with no pool slot to go stale
bool reloading = false;
int reload_length = 0;
int reload_slot = -1; // the reload sound while it plays, so a weapon switch can cut it off
/* firetimer paces every weapon. For melee it measures the swing's windup while swinging, and the recovery since the
last hit while not; the pause menu pauses it, so a paused swing waits too. */
timer firetimer, reloadtimer;
bool swinging = false;
int swing_weapon = -1; // the melee weapon the pending swing started with
int swing_windup = 0; // this swing's time until its hit lands, after the swing powerups
int swing_recovery = 0; // the time after the last hit before the next swing can start, after the swing powerups

// The guns are the artillery: the last two in the table.
bool is_gun(int w)
{
if (w < 0) return false; // no weapon drawn, in a practice run without weapons (practice_weapons_off())
return weapon_names[w] == "machine_gun" or weapon_names[w] == "pistol";
}
string weapon_folder(int w)
{
return "game/equipments/weapons/" + (is_gun(w) ? "artillery" : "melee") + "/" + weapon_names[w] + "/";
}
// "machine_gun" is spoken as "machine gun".
string weapon_display_name(int w)
{
return weapon_names[w].replace("_", " ", true);
}
/* Every run starts fresh: the guns full, nothing reloading, and the fist drawn the normal way, with its draw sound and
"fist equipped." The fist is found by name, so a reordered lineup still starts with it. current_weapon is cleared first
so draw_weapon() doesn't skip it as already held. */
void reset_weapons()
{
for (int w = 0; w < int(weapon_names.length()); w++)
{
weapon_loaded[w] = is_gun(w) ? gun_start_loaded : 0;
weapon_reserve[w] = is_gun(w) ? gun_start_reserve : 0;
if (free_run and !free_reserve_unlimited[w]) weapon_reserve[w] = free_reserve_set[w]; // a free run's set reserve, kept through replays (freerun.nvgt)
}
reloading = false;
reload_slot = -1;
swinging = false;
swing_recovery = 0;
firetimer.restart();
reloadtimer.restart();
current_weapon = -1;
if (practice_weapons_off()) return; // a practice run that needs no weapons: none drawn (practice.nvgt)
draw_weapon(weapon_names.find("fist"));
}
// Runs every frame from run_input(): the reload finishing, the number keys, a swing landing, Space, R and X.
void weapon_input()
{
if (practice_weapons_off()) return; // silent: no weapons in this practice run (practice.nvgt)
reload_check(); // a reload already under way still finishes
/* No drawing, firing, reloading or ammo checks while a door carries you, on a slide, on a ladder or at a floor breaker's
edge, and a swing winding up as one begins is canceled silently. */
if (door_moving or sliding or climbing or repairing)
{
cancel_swing();
return;
}
for (int k = 1; k <= 10; k++)
{
if (controls.action_triggered("weapon_" + k)) draw_weapon(k - 1);
}
swing_check();
// The gun fire gaps and both parts of a swing go through current_fire_gap(), so the weapon powerups can speed them up or slow them down.
if (weapon_names[current_weapon] == "machine_gun")
{
if (controls.action_down("fire") and firetimer.elapsed >= current_fire_gap(machine_gun_fire_gap)) fire_weapon(); // held, for as long as the key is down
}
else if (is_gun(current_weapon))
{
if (controls.action_pressed("fire") and firetimer.elapsed >= current_fire_gap(pistol_fire_gap)) fire_weapon();
}
// A press during a swing, or before its recovery has passed, does nothing.
else if (controls.action_pressed("fire") and !swinging and firetimer.elapsed >= swing_recovery) start_swing();
if (controls.action_triggered("reload")) start_reload();
if (controls.action_triggered("ammo_check")) speak_ammo();
}
/* Drawing the weapon already held does nothing. Drawing another silently cancels a swing still winding up, and any
reload, cutting its sound off so it never sounds finished on a gun that didn't load. */
void draw_weapon(int w)
{
if (w == current_weapon) return;
cancel_swing();
if (reloading and reload_slot > -1) p.destroy_sound(reload_slot);
reload_slot = -1;
current_weapon = w;
reloading = false;
// A new draw cuts off the one still playing, so quick swaps never stack.
draw_sound.close();
if (draw_sound.load(get_pack_sound(weapon_folder(w) + "*draw*"))) draw_sound.play();
speak_buffer(weapon_display_name(w) + " equipped.", "weapons");
}
// A gun's shot: a bullet that travels (bullet.nvgt), or empty with nothing loaded or mid-reload.
void fire_weapon()
{
firetimer.restart();
int w = current_weapon;
if (reloading or weapon_loaded[w] <= 0)
{
p.play_stationary(get_pack_sound(weapon_folder(w) + "*empty*"), false);
return;
}
weapon_loaded[w]--;
// Fire plays at you, and the bullet carries the damage to whatever it reaches, playing the gun's hit and shell there.
p.play_stationary(get_pack_sound(weapon_folder(w) + "*fire*"), false);
stat_add("shots_fired");
/* An insect hovering at you, while you're crouched, is hit at once: a bullet only checks from the next tile on, so it
would fly through it (insect.nvgt). */
insect@ ins = insect_hovering();
if (@ins != null)
{
double ix = strike_insect(ins, weapon_damage[w] * weapon_damage_multiplier);
p.play_2d(get_pack_sound(weapon_folder(w) + "*hit*"), 0, me.x, 0, ix, false);
return;
}
// So is an aircraft hovering over you in your lane, while you're in the air (aircraft.nvgt).
aircraft@ hc = aircraft_overhead();
if (@hc != null)
{
double hx = strike_aircraft(hc, weapon_damage[w] * weapon_damage_multiplier);
p.play_2d(get_pack_sound(weapon_folder(w) + "*hit*"), 0, me.x, 0, hx, false);
return;
}
spawn_bullet(w, weapon_damage[w] * weapon_damage_multiplier);
}
// A melee press: the swing plays at once, and its hit waits for the windup (swing_check()).
void start_swing()
{
int w = current_weapon;
swinging = true;
swing_weapon = w;
swing_windup = int(current_fire_gap(melee_swing_times[w]));
firetimer.restart();
p.play_stationary(get_pack_sound(weapon_folder(w) + "*fire*"), false);
stat_add("melee_swings");
}
/* Every frame: once a swing's windup has passed, its hit lands on the nearest target in reach at that moment, so
something already behind you is missed, and the recovery starts. Nothing in reach whiffs silently. */
void swing_check()
{
if (!swinging or firetimer.elapsed < swing_windup) return;
swinging = false;
int w = swing_weapon;
swing_recovery = int(current_fire_gap(melee_recovery_times[w]));
firetimer.restart();
double target_x = weapon_strike(w, weapon_damage[w] * weapon_damage_multiplier);
if (target_x < 0) return;
// A hit: the weapon's hit at the target (the target plays its own hurt or death).
p.play_2d(get_pack_sound(weapon_folder(w) + "*hit*"), 0, me.x, 0, target_x, false);
}
// A swing still winding up ends with no hit and no sound, and the next one can start straight away.
void cancel_swing()
{
if (!swinging) return;
swinging = false;
swing_recovery = 0;
}
// A time ahead as tiles at the current speed, at least 1.
int reach_tiles(int ms)
{
return int(max(1, ceil(double(ms) / current_step_time())));
}
// How far ahead weapon w reaches: its weapon_reach_times entry at the current speed, in tiles.
int weapon_reach(int w)
{
return reach_tiles(weapon_reach_times[w]);
}
// How far ahead a key can unlock a real door (door.nvgt), the same for every weapon.
int key_reach()
{
return reach_tiles(key_reach_time);
}
/* The target hook. Damages the nearest target within weapon wpn's reach and returns its x, or -1 if there was nothing to
hit. The targets are walls, fake doors, vehicles in your lane, items, insects while you're crouched, and an aircraft
hovering in your lane while you're in the air; a new target type adds its own search here. */
double weapon_strike(int wpn, int damage)
{
int reach = weapon_reach(wpn);
// An insect, only while you're crouched: hovering at you, or flying in within reach (insect.nvgt). Nearest still wins.
insect@ ins = insect_in_reach(reach);
double insx = @ins != null ? me.x + insect_distance(ins) : -1;
wall@ w = wall_in_reach(reach);
door@ d = fake_door_in_reach(reach);
vehicle@ vh = vehicle_in_reach(reach); // only one in your lane (vehicle.nvgt)
double vhx = @vh != null ? vehicle_x(vh) : -1;
aircraft@ hc = aircraft_in_reach(reach); // over you, or flying in within reach, only while you're in the air (aircraft.nvgt)
double hcx = @hc != null ? aircraft_x(hc) : -1;
ammopack@ a = ammopack_in_reach(reach);
goldpack@ gp = goldpack_in_reach(reach);
doorkey@ k = key_in_reach(reach);
shield@ s = shield_in_reach(reach);
lifecapsule@ lc = capsule_in_reach(reach);
healthpotion@ pot = potion_in_reach(reach);
teleporter@ t = teleporter_in_reach(reach);
// Whichever target is nearest takes the hit: a wall, a fake door (real doors can't be hit), a vehicle or an item, which breaks.
double best = -1;
if (@w != null) best = w.x;
if (@d != null and (best < 0 or d.x < best)) best = d.x;
if (@vh != null and (best < 0 or vhx < best)) best = vhx;
if (@a != null and (best < 0 or a.x < best)) best = a.x;
if (@gp != null and (best < 0 or gp.x < best)) best = gp.x;
if (@k != null and (best < 0 or k.x < best)) best = k.x;
if (@s != null and (best < 0 or s.x < best)) best = s.x;
if (@lc != null and (best < 0 or lc.x < best)) best = lc.x;
if (@pot != null and (best < 0 or pot.x < best)) best = pot.x;
if (@t != null and (best < 0 or t.x < best)) best = t.x;
if (@ins != null and (best < 0 or insx <= best)) best = insx; // a tie goes to the insect, at your head height
if (@hc != null and (best < 0 or hcx <= best)) best = hcx; // a tie goes to the aircraft, overhead
if (best < 0) return -1;
if (@hc != null and hcx == best) return strike_aircraft(hc, damage);
if (@ins != null and insx == best) return strike_insect(ins, damage);
if (@w != null and w.x == best) return strike_wall(w, damage);
if (@d != null and d.x == best) return strike_door(d, damage);
if (@vh != null and vhx == best) return strike_vehicle(vh, damage);
if (@a != null and a.x == best) return strike_ammopack(a);
if (@gp != null and gp.x == best) return strike_goldpack(gp);
if (@k != null and k.x == best) return strike_key(k);
if (@s != null and s.x == best) return strike_shield(s);
if (@lc != null and lc.x == best) return strike_capsule(lc);
if (@pot != null and pot.x == best) return strike_potion(pot);
return strike_teleporter(t);
}
// R: tops a gun up from its reserve any time it isn't full. The reload lasts as long as its reload sound.
void start_reload()
{
int w = current_weapon;
if (reloading)
{
speak_buffer("This weapon is still reloading.", "weapons");
return;
}
if (!is_gun(w))
{
speak_buffer("This weapon doesn't take any ammo.", "weapons");
return;
}
if (weapon_loaded[w] >= gun_start_loaded)
{
speak_buffer("This weapon is already fully loaded.", "weapons");
return;
}
if (weapon_reserve[w] <= 0)
{
p.play_stationary(get_pack_sound(weapon_folder(w) + "*empty*"), false);
speak_buffer("This weapon has no more reserved ammo to reload.", "weapons");
return;
}
reload_slot = p.play_stationary(get_pack_sound(weapon_folder(w) + "*reload*"), false);
reload_length = int(p.get_sound_length(reload_slot));
reloading = true;
reloadtimer.restart();
}
// Once the reload sound has had its full length, the ammo goes in and ping plays.
void reload_check()
{
if (!reloading or reloadtimer.elapsed < reload_length) return;
reloading = false;
reload_slot = -1; // its sound has played out
stat_add("reloads"); // counted when the reload finishes
int w = current_weapon;
int amount = int(min(gun_start_loaded - weapon_loaded[w], weapon_reserve[w]));
weapon_loaded[w] += amount;
if (!reserve_unlimited(w)) weapon_reserve[w] -= amount; // a practice run's reserve never runs out, nor an unlimited free run reserve (freerun.nvgt)
p.play_stationary(get_pack_sound(weapon_folder(w) + "*ping*"), false);
}
// X: one sentence about the current weapon's ammo.
void speak_ammo()
{
int w = current_weapon;
if (!is_gun(w))
{
speak_buffer("This weapon doesn't take any ammo.", "weapons");
return;
}
if (reserve_unlimited(w)) speak_buffer("You have " + weapon_loaded[w] + " out of " + gun_start_loaded + " rounds loaded, and unlimited rounds in reserve.", "weapons");
else speak_buffer("You have " + weapon_loaded[w] + " out of " + gun_start_loaded + " rounds loaded, and " + weapon_reserve[w] + " rounds in reserve.", "weapons");
}
