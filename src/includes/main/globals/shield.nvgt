/* Shields (dev, 2026-11-03, for 1.2): an item you wear like armor. On the belt a shield works like an ammo pack: its
spawn clip, then its loop at its tile; either hand picks it up within hand_window_start() (get and the player's give,
centered) and it goes into the inventory as "steel_shield". Arriving on its tile on the ground, landing on it, or a
weapon hit breaks it (break) and it's lost; a clean jump over it misses it.
U wears one (use_shield()): its use plays centered and it's on, with shield_hp hp. Only one can be worn at a time, so
spares wait in the inventory until the worn one breaks. Every run starts with none worn. M reads its strength.
Same entity pattern as ammo packs: null-slot removal, reused slots, and only destroy_all_shields() shrinks the array. */
sound_pool shieldpool;
const string shield_folder = "equipments/items/common/steel_shield/";
class shield
{
double x;
double countdown_start;
bool spent = false; // picked up, broken or jumped past: nothing more can happen to it
int loopslot = -1;
}
shield@[] shields(0);
// The worn shield: whether one is on, and the hp it has left out of shield_hp.
bool shield_worn = false;
int shield_hp_left = 0;

// True when shield sounds exist, so the spawner can offer shields.
bool shields_available()
{
return get_pack_sound(shield_folder + "*loop*") != "";
}
// Called from reset_run(): no shield is worn at the start of a run.
void reset_shield()
{
shield_worn = false;
shield_hp_left = 0;
}
/* Debug options only (dev, 2026-11-03): a single-type debug run of something a shield protects from starts with one steel
shield in the inventory, to be worn with U, since shields never spawn in those runs. Called from reset_run(). */
void give_debug_shield()
{
string[] shielded_types = {"spikes", "mines", "force_fields", "projectiles", "walls", "fake_doors", "real_doors", "real_doors_spread", "powerups"}; // never "all", which plays like the real game (dev)
if (shielded_types.find(spawn_only) >= 0) give_item("steel_shield", 1);
}
// countdown comes from the spawner like a pack's; it sets the pickup window and the spacing.
void spawn_shield(double sx, int countdown)
{
shield s;
s.x = sx;
s.countdown_start = sx - countdown;
shieldpool.play_2d(get_pack_sound(shield_folder + "*spawn*"), me_x, 0, sx, 0, false);
s.loopslot = shieldpool.play_2d(get_pack_sound(shield_folder + "*loop*"), me_x, 0, sx, 0, true);
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] == null)
{
@shields[i] = s;
return;
}
}
shields.insert_last(s);
}
// Called from hand_check() when nothing else took the press. Picks up the nearest shield in its window. True if one was.
bool pick_up_shield()
{
shield@ target = null;
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] == null) continue;
shield@ s = shields[i];
if (s.spent or me_x < hand_window_start(s.x, s.countdown_start) or s.x - me_x < 1) continue;
if (@target == null or s.x < target.x) @target = s;
}
if (@target == null) return false;
target.spent = true;
stop_shield(target);
shieldpool.play_stationary(get_pack_sound(shield_folder + "*get*"), false);
p.play_stationary(get_pack_sound("misc/player/*give*"), false);
give_item("steel_shield", 1);
speak_buffer(item_display_name("steel_shield"));
return true;
}
/* Runs once per step, right after the move. Arriving on a shield's tile on the ground breaks it; once you're past its
tile still unspent, it was jumped cleanly. */
void shield_check()
{
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] == null) continue;
shield@ s = shields[i];
if (!s.spent)
{
if (me_x == s.x and is_grounded()) break_shield(s);
else if (me_x > s.x) s.spent = true; // jumped clean over: its loop carries on and fades behind you
}
if (me_x > s.x + spawn_distance()) remove_shield(i);
}
}
// Called from player_land(): landing on a shield's tile by mistake breaks it.
void shield_landing()
{
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] == null) continue;
if (!shields[i].spent and me_x == shields[i].x) break_shield(shields[i]);
}
}
// Weapons break shields on the belt like packs and keys: a bullet on its tile, or a swing when it's the nearest target.
shield@ shield_at(double x)
{
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] != null and !shields[i].spent and shields[i].x == x) return shields[i];
}
return null;
}
shield@ shield_in_reach(int reach)
{
shield@ target = null;
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] == null or shields[i].spent) continue;
double ahead = shields[i].x - me_x;
if (ahead < 1 or ahead > reach) continue;
if (@target == null or shields[i].x < target.x) @target = shields[i];
}
return target;
}
// A weapon hit on a shield on the belt: it breaks and is lost. Returns its x, so the weapon's hit plays there.
double strike_shield(shield@ s)
{
break_shield(s);
return s.x;
}
void break_shield(shield@ s)
{
s.spent = true;
stop_shield(s);
shieldpool.play_2d(get_pack_sound(shield_folder + "*break*"), me_x, 0, s.x, 0, false);
}
void stop_shield(shield@ s)
{
if (s.loopslot > -1) shieldpool.destroy_sound(s.loopslot);
s.loopslot = -1;
}
void remove_shield(uint i)
{
if (i >= shields.length() or @shields[i] == null) return;
stop_shield(shields[i]);
@shields[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_shields()
{
for (uint i = 0; i < shields.length(); i++)
{
if (@shields[i] == null) continue;
stop_shield(shields[i]);
}
shields.resize(0);
}
// U on a shield: puts it on at full hp. Refused, keeping it, while one is already worn. Returns true if it was worn.
bool use_shield()
{
if (shield_worn)
{
speak_buffer("You're already wearing a shield.");
return false;
}
shield_worn = true;
shield_hp_left = shield_hp;
p.play_stationary(get_pack_sound(shield_folder + "*use*"), false);
speak_buffer("You put on the steel shield.");
return true;
}
/* A blow that would cost lives, from anything but a hazard. With a shield worn it takes damage instead and this
returns true, so the caller plays only the obstacle's own hit, layered with the shield's (dev, 2026-11-03), and no
player hit, life sound or life loss. The blow that empties it is absorbed in full: death plays, with no speech, and it's gone. */
bool shield_absorb(int damage)
{
if (!shield_worn) return false;
shield_hp_left -= powerup_damage(damage, "Sturdy Shield", "Brittle Shield"); // halved or doubled by the shield powerups
if (shield_hp_left <= 0)
{
shield_worn = false;
shield_hp_left = 0;
end_shield_powerup(); // a Sturdy or Brittle Shield ends with it
p.play_stationary(get_pack_sound(shield_folder + "*death*"), false); // the sound alone, no speech (dev, 2026-11-03)
}
else p.play_stationary(get_pack_sound(shield_folder + "*hit*"), false);
return true;
}
// M: the worn shield's strength as a percent of shield_hp.
void speak_shield_strength()
{
if (!shield_worn)
{
speak_buffer("You're not wearing a shield.");
return;
}
speak_buffer("Shield strength, " + int(round(100.0 * shield_hp_left / shield_hp, 0)) + " percent.");
}
