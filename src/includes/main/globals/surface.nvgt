/* The ground under the belt. Surfaces are whatever folders exist in sounds/objects/construction/platforms, found at
runtime, so adding or removing a folder changes the pool with no code change. "ledge" is reserved for the edges
around hazards and is never picked as a normal surface. */
string current_surface = "";
int64 surface_end_time = 0; // on runtimer, which pauses with the game, so a pause doesn't use up a stretch

void reset_surface()
{
current_surface = "";
pick_surface();
}
// Picks a random surface other than ledge and other than the current one, so the change is always audible.
void pick_surface()
{
string[] tiles = get_pack_sound_folders("objects/construction/platforms/*");
string[] choices;
for (uint i = 0; i < tiles.length(); i++)
{
if (tiles[i] == "ledge" or tiles[i] == current_surface) continue;
choices.insert_last(tiles[i]);
}
// With only one usable surface, keep it; with none at all, footsteps stay silent.
if (choices.length() > 0) current_surface = choices[random(0, choices.length() - 1)];
surface_end_time = runtimer.elapsed + random(surface_min_time, surface_max_time);
}
void surface_check()
{
if (runtimer.elapsed >= surface_end_time) pick_surface(); // checked each step, so the change lands on a footstep
}
// The tile under a position: "ledge" just before and after a hazard, otherwise the current surface.
string tile_at(double x)
{
if (on_ledge(x)) return "ledge";
return current_surface;
}
// A oneshot footstep on every step, never thinned, at any speed. Silent in the air and while crouched.
void play_step()
{
if (!is_grounded() or is_ducked()) return;
string tile = tile_at(me_x);
if (tile == "") return;
p.play_stationary(get_pack_sound("objects/construction/platforms/" + tile + "/*step*"), false);
}
