/* Free run's belt: what you add from the console, in three groups: obstacles, items (what goes in your inventory) and
specials (powerups and slides, which are neither). spawn_only "free" sends the spawner here (free_next_type(), from
choose_free_run()) at each spawn: a real door's key's door first, then the queue's front
batch, then a weighted pick among the continuous rules, else nothing. Batches arrive in the order added, at the usual
spacing for your speed; a continuous kind keeps coming, its count its share against the other continuous kinds. "all" is
a random kind of its group each time. Fake walls, fake doors, insects, vehicles and aircrafts can carry a set health (free_hp_next, read by
their spawn functions), or 0 for the normal health for your speed; barriers, items, vehicles, aircrafts and trampolines a chosen
lane (free_lane_next, read through free_placed_lane()); combinations a chosen pair (free_pair_next, read by
choose_free_run()), waiting until the environment can make it. A real door comes as its key, then the door. Clearing
a kind takes its batches and rule, and its things on the belt; clear belt takes everything (free_clear_belt()). */
class free_entry
{
string type; // a kind's id, or "all"
string group; // "obstacle", "item" or "special"
int count; // a batch: how many are left; a continuous rule: its share
int full = 0; // a batch's count as added, for a replay
int hp = 0; // a set health for breakable kinds, or 0
int lane = free_lane_random; // a lane kind's lane: random, your lane, or lane_left to lane_right
int pair = -1; // combinations: a chosen pair's number (combo_pair_first(), combo.nvgt), or -1 for random pairs
}
// The chosen pair of the combinations being placed, or -1 for a random one; set beside free_hp_next.
int free_pair_next = -1;
// A pair's spoken name from the obstacle singulars, first part first, such as "force field, fake wall".
string free_pair_name(int pair)
{
string first = free_kind_name(combo_pair_first(pair), "obstacle", 1);
string second = free_kind_name(combo_pair_second(pair), "obstacle", 1);
return first + ", " + second;
}
// An entry's kind as said in confirmations and view current setup, its pair first when one was chosen.
string free_entry_name(const string&in type, const string&in group, int pair, int amount = 2)
{
string name = free_kind_name(type, group, amount);
return pair >= 0 ? free_pair_name(pair) + " " + name : name;
}
/* The lane an entry's barriers, items, vehicles, aircrafts and trampolines come in (free_lane_kinds): random as usual, your lane
(the one you're in as each appears), or a set lane. It rides to the spawner in free_lane_next, as the health does. */
const int free_lane_random = -1;
const int free_lane_own = -2;
const string[] free_lane_kinds = {"barriers", "vehicles", "aircrafts", "trampolines", "ammo_packs", "gold_packs", "health_potions", "keys", "life_capsules", "player_teleporters", "steel_shields"};
int free_lane_next = free_lane_random;
// The lane for the thing being placed now: lane_left to lane_right, or -1 for its usual random lane.
int free_placed_lane()
{
if (!free_run or free_lane_next == free_lane_random) return -1;
if (free_lane_next == free_lane_own) return current_lane;
return free_lane_next;
}
// How a chosen lane is named in confirmations and view current setup, such as "your lane" or "the left lane".
string free_lane_text(int lane)
{
if (lane == free_lane_own) return "your lane";
if (lane == lane_left) return "the left lane";
if (lane == lane_middle) return "the middle lane";
return "the right lane";
}
// A view current setup line's lane, such as ", in your lane"; nothing for random lanes.
string free_lane_line(int lane)
{
return lane == free_lane_random ? "" : ", in " + free_lane_text(lane);
}
// Does an add of this kind (or all of a group) bring something that sits in a lane?
bool free_has_lane(const string&in type, const string&in group)
{
if (type != "all") return free_lane_kinds.find(type) >= 0;
return group == "obstacle" or group == "item";
}
free_entry@[] free_queue; // the batches, front first
free_entry@[] free_batches; // every batch added since the belt was last cleared, at its full count, for a replay
free_entry@[] free_rules; // the continuous rules
bool free_door_next = false; // a real door's key was just placed, so the door comes next
int free_door_hp = 0;
int free_hp_next = 0; // the next placed breakable obstacle's set health, or 0
// Each group's kinds, alphabetical by their spoken names, with their singulars.
const string[] free_obstacle_ids = {"aircrafts", "animals", "barriers", "combinations", "fake_doors", "walls", "floor_breakers", "force_fields", "hazards", "insects", "mines", "projectiles", "real_doors", "ladders", "spikes", "trampolines", "vehicles", "winds"};
const string[] free_obstacle_names = {"aircrafts", "animals", "barriers", "combinations", "fake doors", "fake walls", "floor breakers", "force fields", "hazards", "insects", "mines", "projectiles", "real doors", "real walls", "spikes", "trampolines", "vehicles", "winds"};
const string[] free_obstacle_singulars = {"aircraft", "animal", "barrier", "combination", "fake door", "fake wall", "floor breaker", "force field", "hazard", "insect", "mine", "projectile", "real door", "real wall", "spike", "trampoline", "vehicle", "wind"};
const string[] free_item_ids = {"ammo_packs", "gold_packs", "health_potions", "keys", "life_capsules", "player_teleporters", "steel_shields"};
const string[] free_item_names = {"ammo packs", "gold packs", "health potions", "keys", "life capsules", "player teleporters", "steel shields"};
const string[] free_item_singulars = {"ammo pack", "gold pack", "health potion", "key", "life capsule", "player teleporter", "steel shield"};
// The player shop's specials, which give, set and take items list but add items doesn't, since they never come on the belt.
const string[] free_bought_ids = {"animal_helpers", "door_helpers", "floor_helpers", "force_field_helpers", "item_helpers", "ladder_helpers", "master_helpers", "power_crystals", "safety_nets", "slides", "trampolines"};
const string[] free_bought_names = {"animal helpers", "door helpers", "floor helpers", "force field helpers", "item helpers", "ladder helpers", "master helpers", "power crystals", "safety nets", "slides", "trampolines"};
const string[] free_bought_singulars = {"animal helper", "door helper", "floor helper", "force field helper", "item helper", "ladder helper", "master helper", "power crystal", "safety net", "slide", "trampoline"};
const string[] free_special_ids = {"powerups", "slides"};
const string[] free_special_names = {"powerups", "slides"};
const string[] free_special_singulars = {"powerup", "slide"};

// Copies of a group's ids, plural names and singulars.
string[] free_ids(const string&in group)
{
if (group == "item") return free_item_ids;
if (group == "special") return free_special_ids;
return free_obstacle_ids;
}
string[] free_names(const string&in group, bool one)
{
if (group == "item")
{
if (one) return free_item_singulars;
return free_item_names;
}
if (group == "special")
{
if (one) return free_special_singulars;
return free_special_names;
}
if (one) return free_obstacle_singulars;
return free_obstacle_names;
}
// What give and set items list: every item and bought special, alphabetical.
string[] free_inventory_ids()
{
string[] ids = free_item_ids;
for (uint i = 0; i < free_bought_ids.length(); i++) ids.insert_last(free_bought_ids[i]);
ids.sort_ascending();
return ids;
}
// Their spoken name, for that many.
string free_inventory_name(const string&in type, int amount = 2)
{
int at = free_bought_ids.find(type);
if (at < 0) return free_kind_name(type, "item", amount);
return amount == 1 ? free_bought_singulars[at] : free_bought_names[at];
}
// "obstacles", "items", "specials".
string free_group_name(const string&in group)
{
return group + "s";
}
bool free_breakable(const string&in type)
{
return type == "walls" or type == "fake_doors" or type == "vehicles" or type == "insects" or type == "aircrafts";
}
string free_kind_name(const string&in type, const string&in group, int amount = 2)
{
if (type == "all") return amount == 1 ? group : free_group_name(group);
int i = free_ids(group).find(type);
if (i < 0) return type.replace("_", " ", true);
return free_names(group, amount == 1)[i];
}
// Can this environment bring this kind now?
bool free_kind_available(const string&in type, const string&in group)
{
if (group == "item") return item_kind_available(type);
if (type == "powerups") return powerups_available();
if (type == "slides") return slides_available();
if (type == "combinations") return practice_env_ok(current_env, "combinations"); // some pair with both kinds here (practice.nvgt)
if (type == "ladders") return ladders_ready();
if (type == "real_doors") return doors_available() and keys_available();
if (type == "fake_doors") return doors_available();
return get_pack_sound_folders(type_folder(type) + "*").length() > 0;
}
// "all": a random kind of the group this environment has.
string free_pick_all(const string&in group)
{
string[] kinds;
string[] ids = free_ids(group);
for (uint i = 0; i < ids.length(); i++)
{
if (free_kind_available(ids[i], group)) kinds.insert_last(ids[i]);
}
return kinds.length() > 0 ? kinds[random(0, kinds.length() - 1)] : "";
}
/* One entry's next thing: its kind (a random one for all), with its set health; "" when this environment can't bring it
now, so it waits rather than spending a turn on nothing. */
string free_entry_type(free_entry@ e)
{
free_hp_next = e.hp;
free_lane_next = e.lane;
free_pair_next = e.pair;
string type = e.type == "all" ? free_pick_all(e.group) : e.type;
if (type != "" and !free_kind_available(type, e.group)) type = "";
if (type == "combinations" and e.pair >= 0 and !combo_pair_ready(e.pair)) type = ""; // a chosen pair waits for an environment that can make it
return type;
}
/* From choose_free_run() in spawner.nvgt: what the next spawn is, or "" for nothing yet. A real door comes as its key,
then the door. */
string free_next_type()
{
free_hp_next = 0;
free_lane_next = free_lane_random;
free_pair_next = -1;
if (free_door_next)
{
free_door_next = false;
free_hp_next = free_door_hp;
return "real_doors";
}
/* The front-most batch this environment can bring now; a batch only counts down when one of it comes, so in an
environment without its kind it waits. With no batch able to come, the continuous rules this environment can bring. */
string type = "";
for (uint i = 0; i < free_queue.length() and type == ""; i++)
{
free_entry@ e = free_queue[i];
type = free_entry_type(e);
if (type == "") continue;
e.count -= 1;
if (e.count <= 0) free_queue.remove_at(i);
}
if (type == "")
{
string[] picks; // each rule's kind for this turn, "" when it can't come here now
int total = 0;
for (uint i = 0; i < free_rules.length(); i++)
{
picks.insert_last(free_entry_type(free_rules[i]));
if (picks[i] != "") total += free_rules[i].count;
}
if (total > 0)
{
int r = random(1, total);
for (uint i = 0; i < free_rules.length(); i++)
{
if (picks[i] == "") continue;
r -= free_rules[i].count;
if (r > 0) continue;
type = picks[i];
free_hp_next = free_rules[i].hp;
free_lane_next = free_rules[i].lane;
free_pair_next = free_rules[i].pair;
break;
}
}
}
if (type == "")
{
free_hp_next = 0;
free_lane_next = free_lane_random;
free_pair_next = -1;
}
if (type == "real_doors")
{
free_door_next = true;
free_door_hp = free_hp_next;
free_hp_next = 0;
free_lane_next = free_lane_random; // a real door's key keeps its random lane
return "keys"; // its key first, in a random lane
}
return type;
}
/* A replay or restart: every batch added since the last clear, refilled to its full
count, in its order; the continuous rules and every setting stay as they were. */
void free_refill_queue()
{
free_queue.resize(0);
for (uint i = 0; i < free_batches.length(); i++)
{
free_entry e = free_batches[i];
e.count = e.full;
free_queue.insert_last(e);
}
free_door_next = false;
}
// A breakable obstacle's health as it's placed: the set health, or the normal one.
int free_obstacle_hp(int normal)
{
return free_run and free_hp_next > 0 ? free_hp_next : normal;
}
// Clear belt: every batch and rule gone, and the spawner's pick waiting for the next.
void free_clear_queue()
{
free_queue.resize(0);
free_batches.resize(0);
free_rules.resize(0);
free_door_next = false;
next_type = "";
next_countdown = 0;
}
// A kind's things on the belt, gone.
void free_destroy_kind(const string&in type)
{
if (type == "hazards") destroy_all_hazards();
else if (type == "spikes") destroy_all_spikes();
else if (type == "mines") destroy_all_mines();
else if (type == "projectiles") destroy_all_projectiles();
else if (type == "force_fields") destroy_all_forcefields();
else if (type == "animals") destroy_all_animals();
else if (type == "insects") destroy_all_insects();
else if (type == "walls") destroy_all_walls();
else if (type == "ladders") destroy_all_ladders();
else if (type == "fake_doors" or type == "real_doors") destroy_all_doors(); // one list holds both kinds of door
else if (type == "floor_breakers") destroy_all_floor_breakers();
else if (type == "barriers") destroy_all_barriers();
else if (type == "winds") destroy_all_winds();
else if (type == "vehicles") destroy_all_vehicles();
else if (type == "aircrafts") destroy_all_aircrafts();
else if (type == "trampolines") destroy_all_trampolines();
else if (type == "ammo_packs") destroy_all_ammopacks();
else if (type == "gold_packs") destroy_all_goldpacks();
else if (type == "keys") destroy_all_keys();
else if (type == "steel_shields") destroy_all_shields();
else if (type == "life_capsules") destroy_all_capsules();
else if (type == "health_potions") destroy_all_potions();
else if (type == "player_teleporters") destroy_all_teleporters();
else if (type == "powerups") destroy_all_powerups();
else if (type == "slides") reset_slides();
}
// Clears one kind (or "all") of a group: its batches, its rule, and its things on the belt.
void free_clear_kind(const string&in type, const string&in group)
{
for (int i = int(free_queue.length()) - 1; i >= 0; i--)
{
if (free_queue[i].group == group and (type == "all" or free_queue[i].type == type)) free_queue.remove_at(i);
}
for (int i = int(free_batches.length()) - 1; i >= 0; i--)
{
if (free_batches[i].group == group and (type == "all" or free_batches[i].type == type)) free_batches.remove_at(i);
}
for (int i = int(free_rules.length()) - 1; i >= 0; i--)
{
if (free_rules[i].group == group and (type == "all" or free_rules[i].type == type)) free_rules.remove_at(i);
}
string[] ids = free_ids(group);
for (uint i = 0; i < ids.length(); i++)
{
if (type == "all" or ids[i] == type) free_destroy_kind(ids[i]);
}
if (group == "obstacle" and (type == "all" or type == "real_doors")) free_door_next = false;
next_type = ""; // the waiting pick might have been one of them
next_countdown = 0;
}
/* A number from an input box, digits only: from low to high, or with allow_empty, -2 for an empty answer. -1 if canceled
(escape). Out of range says so and asks again. */
int free_ask_number(const string&in title, const string&in prompt, int low, int high, bool allow_empty = false)
{
while (true)
{
vd.set_disallowed_chars("0123456789", true, "This character is not allowed.");
string answer = string_trim_sides(vd.input_box(title, prompt, ""));
vd.set_disallowed_chars("");
if (answer == "") return allow_empty ? -2 : -1;
int value = answer.length() > 7 ? high + 1 : int(parse_int(answer)); // 7 digits, for modify player gold's 1,000,000
if (value >= low and value <= high) return value;
dlgmessage_return("Please type a number from " + low + " to " + high + ".");
}
return -1;
}
/* A group's kind menu: every kind this environment has, alphabetical, then all of the group, then back. "" if backed out,
or with "This environment has no obstacles." (or items, specials) when it has none. Each group's list remembers the kind
you last picked, by name, for the run, since the lists are long and change with the environment. */
dictionary free_kind_focus; // group -> the id last picked in its add list
string free_choose_kind(const string&in group)
{
string[] ids;
string[] all_ids = free_ids(group);
for (uint i = 0; i < all_ids.length(); i++)
{
if (free_kind_available(all_ids[i], group)) ids.insert_last(all_ids[i]);
}
if (ids.length() == 0)
{
free_console_note = "This environment has no " + free_group_name(group) + "."; // said with the console's intro, which would cut it off (freerun.nvgt)
return "";
}
setupmenu();
m.intro_text = "Choose the " + group + " you'd like to add.";
for (uint i = 0; i < ids.length(); i++) m.add_item(free_kind_name(ids[i], group), ids[i]);
m.add_item("all " + free_group_name(group), "all");
m.add_item("back", "back");
string last = "";
free_kind_focus.get(group, last);
int focus = last == "all" ? int(ids.length()) : ids.find(last);
int mres = m.run(focus, false, focus >= 0);
if (mres < 0 or m.selected_item_id == "back") return "";
free_kind_focus.set(group, m.selected_item_id);
return m.selected_item_id;
}
/* Add obstacles, add items or add specials: the kind, "How many?", for a breakable obstacle its health, for a lane kind
(or all obstacles or items) its lane, then whether they spawn continuously. True once added, with a line in the misc buffer; false if backed out or canceled. */
bool free_add(const string&in group)
{
string what = free_group_name(group);
string type = free_choose_kind(group);
if (type == "") return false;
int pair = -1;
if (type == "combinations")
{
/* Which pair: those this environment can make, each then its reverse, then random combinations, then back. Back
and escape both cancel, as the add flow's other questions do. */
setupmenu();
m.intro_text = "Choose the combination.";
for (int i = 0; i < combo_pair_count(); i++)
{
if (combo_pair_ready(i)) m.add_item(free_pair_name(i), "" + i);
}
m.add_item("random combinations", "-1");
m.add_item("back", "back");
if (m.run() < 0 or m.selected_item_id == "back")
{
speak("canceled");
return false;
}
pair = int(parse_int(m.selected_item_id));
}
int count = free_ask_number("Add " + what, "How many?", 1, 1000);
if (count < 0)
{
speak("canceled");
return false;
}
int hp = 0;
if (group == "obstacle" and free_breakable(type))
{
hp = free_ask_number("Add " + what, "How much health should each one have? Leave it empty for the normal health for your speed.", 1, 2000, true); // 2000, an aircraft's top health
if (hp < 0) hp = 0; // an empty answer and escape both mean the normal health
}
int lane = free_lane_random;
if (free_has_lane(type, group))
{
setupmenu();
m.intro_text = "Choose the lane for these " + what + ".";
m.add_item("left lane", "" + lane_left);
m.add_item("middle lane", "" + lane_middle);
m.add_item("right lane", "" + lane_right);
m.add_item("your lane", "" + free_lane_own);
m.add_item("random lanes", "" + free_lane_random);
if (m.run() < 0)
{
speak("canceled");
return false;
}
lane = int(parse_int(m.selected_item_id));
}
setupmenu();
m.intro_text = "Do you want these " + what + " to spawn continuously?";
m.add_item("Yes", "yes");
m.add_item("No", "no");
int mres = m.run();
if (mres < 0)
{
speak("canceled");
return false;
}
free_entry e;
e.type = type;
e.group = group;
e.count = count;
e.hp = hp;
e.lane = lane;
e.pair = pair;
string health = hp > 0 ? ", with " + hp + " health each" : "";
string where = lane == free_lane_random ? "" : "in " + free_lane_text(lane); // a random lane says nothing extra
if (m.selected_item_id == "yes")
{
free_rules.insert_last(e);
string kept_lane = where == "" ? "" : (hp > 0 ? ", " : " ") + where; // "keep coming in your lane", or after the health
if (type == "all") speak_buffer("Every kind of " + group + " will now keep coming" + health + kept_lane + ".", "misc");
else speak_buffer(learn_upper_first(free_entry_name(type, group, pair)) + " will now keep coming" + health + kept_lane + ".", "misc");
return true;
}
e.full = count;
free_queue.insert_last(e);
free_entry kept = e; // a copy at its full count, for a replay
free_batches.insert_last(kept);
speak_buffer(count + " " + free_entry_name(type, group, pair, count) + " added" + health + (where == "" ? "" : ", " + where) + ".", "misc");
return true;
}
// A group's kinds coming, queued or continuous, each once, in the kind list's order.
string[] free_kinds_coming(const string&in group)
{
string[] kinds;
string[] ids = free_ids(group);
for (uint i = 0; i < ids.length(); i++)
{
bool found = false;
for (uint q = 0; q < free_queue.length() and !found; q++) found = free_queue[q].group == group and free_queue[q].type == ids[i];
for (uint q = 0; q < free_rules.length() and !found; q++) found = free_rules[q].group == group and free_rules[q].type == ids[i];
if (found) kinds.insert_last(ids[i]);
}
return kinds;
}
/* How much of a kind is coming, for the clear lists, as take items gives counts: "7 left" in its batches, "continuous", or "7 left, plus continuous"; for "all", the whole group
together, or "" when nothing of it is coming. */
string free_coming_text(const string&in type, const string&in group)
{
int left = 0;
bool continuous = false;
for (uint i = 0; i < free_queue.length(); i++)
{
if (free_queue[i].group == group and (type == "all" or free_queue[i].type == type)) left += free_queue[i].count;
}
for (uint i = 0; i < free_rules.length(); i++)
{
if (free_rules[i].group == group and (type == "all" or free_rules[i].type == type)) continuous = true;
}
if (left > 0 and continuous) return left + " left, plus continuous";
if (continuous) return "continuous";
if (left > 0) return left + " left";
return "";
}
/* Clear obstacles, clear items or clear specials: each kind coming, then all of the group, then back. True once cleared,
with a line in the misc buffer. */
bool free_clear(const string&in group)
{
setupmenu();
m.intro_text = "Choose the " + free_group_name(group) + " you'd like to clear.";
string[] kinds = free_kinds_coming(group);
for (uint i = 0; i < kinds.length(); i++) m.add_item(free_kind_name(kinds[i], group) + ", " + free_coming_text(kinds[i], group), kinds[i]); // "barriers, 7 left"
string all_text = free_coming_text("all", group);
m.add_item("all " + free_group_name(group) + (all_text == "" ? "" : ", " + all_text), "all"); // the whole group's count too
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return false;
string type = m.selected_item_id;
free_clear_kind(type, group);
if (type == "all") speak_buffer("All " + free_group_name(group) + " have been cleared.", "misc");
else speak_buffer("The " + free_kind_name(type, group) + " have been cleared.", "misc");
return true;
}
/* View current setup's lines for the belt: what's left in the batches, one line per kind however many batches it has, in
the order they come, a set health and a chosen lane kept apart; then each continuous kind's share of the mix. */
void free_add_belt_lines(string[]@ lines)
{
string[] keys; // type, group, health and lane of each line
int[] counts;
for (uint i = 0; i < free_queue.length(); i++)
{
free_entry@ e = free_queue[i];
string key = e.type + "|" + e.group + "|" + e.hp + "|" + e.lane + "|" + e.pair;
int at = keys.find(key);
if (at < 0)
{
keys.insert_last(key);
counts.insert_last(e.count);
}
else counts[at] += e.count;
}
for (uint i = 0; i < keys.length(); i++)
{
string[]@ part = keys[i].split("|");
int hp = int(parse_int(part[2]));
int lane = int(parse_int(part[3]));
int pair = int(parse_int(part[4]));
lines.insert_last(stat_line("coming", counts[i] + " " + free_entry_name(part[0], part[1], pair, counts[i]) + (hp > 0 ? ", " + hp + " health each" : "") + free_lane_line(lane)));
}
int total = 0;
for (uint i = 0; i < free_rules.length(); i++) total += free_rules[i].count;
for (uint i = 0; i < free_rules.length(); i++)
{
free_entry@ e = free_rules[i];
int percent = int(round(100.0 * e.count / total, 0));
string name = e.type == "all" ? "every kind of " + e.group : free_entry_name(e.type, e.group, e.pair);
lines.insert_last(stat_line("continuous", name + ", " + percent + " percent of the mix" + (e.hp > 0 ? ", " + e.hp + " health each" : "") + free_lane_line(e.lane)));
}
if (free_queue.length() == 0 and free_rules.length() == 0) lines.insert_last(stat_line("coming", "nothing"));
}
/* No deaths: the hazard or floor breaker that caught you comes again. A continuous kind (or a
continuous all obstacles) keeps coming anyway; otherwise one more of it goes to the front of the queue, next to come.
It isn't added to free_batches, so a replay brings back only what you added. */
void free_requeue(const string&in type)
{
for (uint i = 0; i < free_rules.length(); i++)
{
if (free_rules[i].type == type or (free_rules[i].type == "all" and free_rules[i].group == "obstacle")) return;
}
free_entry e;
e.type = type;
e.group = "obstacle";
e.count = 1;
free_queue.insert_at(0, e);
}
