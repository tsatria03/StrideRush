bool hrtf=true; // the Sound tab's HRTF checkbox, saved in settings.srf and applied at startup
bool behind_pitch=true; // the Game tab's checkbox: anything behind you is lowered by 5 in pitch
// The learn sounds menu's two settings, both on by default and saved in settings.srf.
bool loop_previews=true; // the Sound tab: a previewed sound (or countdown) repeats until you move to another or leave
bool variant_descriptions=true; // the Menu tab: a sound with numbered variants adds ". This sound has multiple variants." to its label
bool auto_check_updates=false; // the General tab: check quietly for a newer version at startup
// Everything Stride Rush keeps on the player's machine goes under here.
const string APPDATA_DIR = DIRECTORY_APPDATA + "tsatria03/StrideRush/";
/* The settings, all in one encrypted file, read by readpreffs() and written by writepreffs() in savefuncts.nvgt. The menu
options (menuwrap and the rest) live in form_menu, and the run volumes in game.nvgt. */
savedata st(APPDATA_DIR + "preffs/settings.srf", "Ki4bG6X16S7VxcjHopWbaDrN9eNhvr4noO5Jl6DHceredubleqWvkVty3s6BLiz1YZwJGwnws4AkhGK1KZN0yj7t0jIREqVFZnCNRrv38zhVBsj0CwQM4akYncoJEResiAzTZeykM0ukesXOnrCZgVFmrC7m48iQlyd4KA0MGgSdDWqldG9zlA4DbExspzAWJ6UsNwQq8SOB1dh32XUfuSaiK1cDzToZvFNTIB4dQYC6PqaTgkzklsKTel40sbeXsD8");
/* The game's progress, apart from the settings: run counts, unlocks, statistics and achievements. Read by readgame() and
written by writegame() in savefuncts.nvgt, with its own key. */
savedata gs(APPDATA_DIR + "saves/game.srf", "");
int fademode = 1; // how leaving a run fades every pool: 1 the volume fade (the default), 0 the pitch wind-down
bool ask_quit_on_escape = true; // false: Escape leaves the run at once, without the quit run question
bool show_death_results = true; // false: a death skips the results menu
bool show_death_copy_export = true; // false: the after death menu leaves out copy and export
bool show_practice_retry = true; // false: a practice death skips its retry menu and sets you down past what caught you (practice_death())
bool joystick_vibration = true; // the Joystick tab: rumble on blows, lives and deaths (joystick.nvgt)
int health_format = 0; // the Game tab: how health is spoken, 0 a percentage, 1 an amount, 2 both (lives.nvgt's format_readout())
int shield_format = 0; // and the shield, the same way
int master_volume = 0; // the master game volume in dB, -100 to 0, through sound_master_volume
string soundcard = "Default"; // the chosen sound device by name, matched to sound_output_device when the settings load
form_menu m;
virtual_dialogs vd; // the speech buffer's review boxes use vd.info_box
instance gamstence("StrideRush");
key_config controls; // loaded from data/main/keyboard.ini by load_controls() at startup
sound dummy; // loaded at the top of main() before HRTF is set; required for HRTF to work
sound_pool p, temp, spool; // spool plays the speech-buffer cues
file logfile; // speech-buffer exports
tone_synth sy;
