/* Free run (the free run plan, dev, 2026-11-13; Section 1). A mode after practice run, open once hard endless has its
difficulty_unlock_runs counted runs (when insane opens), with no difficulty and nothing counted: no statistics,
achievements, records or unlocks (run_difficulty stays -1, so stats_counting stays off).
- The setup: a running speed (a fixed 2 to 10 steps a second, rising, or normal, which speeds up as an endless run), then
  an environment (one to stay in, or random). The run starts with you standing still on an empty belt (spawn_only
  "free", which brings only what you add: freebelt.nvgt, Section 2): music and ambience only, no footsteps or heartbeat; every key works, jump, crouch and hands too, for
  trying them in place (dev, 2026-11-13).
- The console, on the free_console action (backspace and F7), freezes the run while it's open. Standing: modify death
  mode, modify environment, modify practice hints, modify running speed, start running, view current setup, back.
  Running: add items, add obstacles, add specials, clear belt, clear items, clear obstacles, clear specials, the same
  modify items, view current setup, back. All alphabetical, back last.
- Death mode: normal deaths (the start, dev, 2026-11-13) or practice deaths (practice_death(), set down past what caught you; normal: the run ends,
  and replay or restart brings the same run back, standing, with everything as it was: free_prepare_replay()). Practice hints: off to start; on, every kind gets practice_hint()'s
  lines, independent of the death mode.
- The guns start with a normal run's reserve, 50, which modify ammo reserves can set or make unlimited (Section 3, below). */
bool free_run = false; // the mode's runs, set by play_game() and kept through replays
bool free_moving = false; // start running sets it, clear belt clears it
string free_speed_mode = "fixed"; // "fixed", "rising" or "normal"
int free_speed = start_step_time; // the fixed speed's step time
bool free_practice_deaths = false; // normal deaths to start (dev, 2026-11-13, changed from practice deaths)
bool free_hints = false;
int free_lives = starting_lives; // the lives a practice death gives back (Section 3 lets you set them)
int free_console_focus = -1;

// The mode opens with insane in endless: once hard has its difficulty_unlock_runs counted runs (dev, 2026-11-13).
bool free_mode_unlocked()
{
return difficulty_runs[2] >= difficulty_unlock_runs;
}
// "after completing 5 hard endless runs.", or "after completing 2 more hard endless runs." once started ("run" for 1).
string free_mode_lock_reason()
{
int left = difficulty_unlock_runs - difficulty_runs[2];
bool started = difficulty_runs[2] > 0;
return "after completing " + left + (started ? " more " : " ") + "hard endless " + (left == 1 ? "run." : "runs.");
}
bool free_standing()
{
return free_run and !free_moving;
}
// A practice run's deaths, or a free run's on practice deaths: the run never ends, you're set down past what caught you.
bool practice_deaths()
{
return practice_run or (free_run and free_practice_deaths);
}
// A practice run's hints, or a free run's with practice hints on (practice_hints.nvgt).
bool practice_hints_on()
{
return practice_run or (free_run and free_hints);
}
// A gun's reserve never runs out in practice, nor in a free run set to unlimited (weapons.nvgt; Section 3).
bool reserve_unlimited(int w)
{
return practice_run or (free_run and free_reserve_unlimited[w]);
}
// From play_game(), each time a free run is set up: the console's settings back to how a free run starts.
void reset_free_settings()
{
free_moving = false;
free_speed_mode = "fixed";
free_speed = start_step_time;
free_practice_deaths = false; // normal deaths to start (dev, 2026-11-13)
free_hints = false;
free_lives = starting_lives;
free_health = player_hp;
free_shield_full = shield_hp;
for (uint i = 0; i < free_reserve_unlimited.length(); i++)
{
free_reserve_unlimited[i] = false; // a normal run's 50 rounds, not practice's unlimited (dev, 2026-11-13)
free_reserve_set[i] = gun_start_reserve;
}
free_console_focus = -1;
free_clear_queue(); // a new setup starts with nothing coming (freebelt.nvgt)
free_kind_focus.delete_all(); // and the add lists start at their tops
free_give_focus = -1; // and give items' list
free_key_focus = -1;
}
/* A replay or restart (dev, 2026-11-13): the same free run again, standing still at the start, with the same speed,
environment, death mode, hints and continuous rules, and every batch back at its full count (free_refill_queue()). */
void free_prepare_replay()
{
free_moving = false;
free_console_focus = -1;
free_refill_queue(); // freebelt.nvgt
}
// The step time a free run starts at: the fixed speed, or 2 steps a second for rising and normal.
int free_start_step_time()
{
return free_speed_mode == "fixed" ? free_speed : start_step_time;
}
/* The running speed menu, at setup and in the console: the fixed speeds (as practice offers them), rising, normal, back.
True once one is chosen. */
bool choose_free_speed()
{
setupmenu();
m.intro_text = "Choose your running speed, in steps a second.";
for (int t = start_step_time; t >= 100; t -= 100)
{
m.add_item(tenths_text(int(round(10000.0 / t, 0))), "" + t);
}
m.add_item("normal", "normal"); // speeds up as an endless run does, before rising (dev, 2026-11-13)
m.add_item("rising", "rising"); // from 2 up to 10, as practice's rising
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return false;
string id = m.selected_item_id;
if (id == "rising" or id == "normal") free_speed_mode = id;
else
{
free_speed_mode = "fixed";
free_speed = int(parse_int(id));
}
return true;
}
// The environment menu, at setup and in the console: each environment to stay in, then random, then back.
bool choose_free_env()
{
setupmenu();
m.intro_text = "Choose the environment you'd like to run in.";
string[] names = env_names();
for (uint i = 0; i < names.length(); i++) m.add_item(names[i].replace("_", " ", true), names[i]);
m.add_item("random", "random");
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return false;
debug_env = m.selected_item_id == "random" ? "" : m.selected_item_id; // environments.nvgt holds a run with no difficulty in debug_env
return true;
}
// The setup: speed, then environment; back from the environment returns to the speed. False if backed out of entirely.
bool choose_free_setup()
{
reset_free_settings();
debug_env = "";
while (true)
{
if (!choose_free_speed()) return false;
if (choose_free_env()) return true;
}
return false;
}
/* A mid-run environment choice: held in one, it moves you there at once ("You've entered ..."), or says you'll stay;
random, switching resumes, and it says so (dev, 2026-11-13). */
void free_apply_env()
{
if (debug_env != "")
{
env_switch_at = -1;
if (debug_env == current_env)
{
speak_buffer("You'll stay in the " + current_env.replace("_", " ", true) + " environment.", "misc");
return;
}
current_env = debug_env;
announce_env(true);
current_surface = "";
pick_surface();
begin_ambience_fade(pick_ambience());
return;
}
env_switch_at = env_switch_choices().length() > 0 ? runtimer.elapsed + random(env_switch_min_time, env_switch_max_time) : -1;
speak_buffer("The environment will now change every 1 to 2 minutes.", "misc");
}
// A mid-run speed choice: a fixed speed at once; rising and normal carry on from the speed you're at.
void free_apply_speed()
{
if (free_speed_mode == "fixed") step_time = free_speed;
speeduptimer.restart();
// Said every time (dev, 2026-11-13): a fixed speed as C says it, or how it will rise.
if (free_speed_mode == "normal") speak_buffer("Your speed now rises as in an endless run.", "misc");
else if (free_speed_mode == "rising") speak_buffer("Your speed now rises up to 10 steps a second.", "misc");
else speak_buffer(speed_phrase(), "misc"); // "You are running 3.3 steps a second."
}
// From speedup_check(): a free run speeds up only while moving, and only on rising or normal. True if it handled it.
bool free_speedup()
{
if (!free_run) return false;
if (!free_moving or free_speed_mode == "fixed") return true;
bool rising = free_speed_mode == "rising";
if (speeduptimer.elapsed < (rising ? practice_rising_period : speedup_period)) return true;
speeduptimer.restart();
step_time = int(max(rising ? practice_rising_top : min_step_time, step_time - speedup_amount));
return true;
}
void free_start_running()
{
free_moving = true;
steptimer.restart();
speeduptimer.restart();
}
/* Clear belt: everything on the belt and on its way gone, your inventory emptied, a worn shield off and your weapons as a run starts, whatever you're in (a ladder, a repair,
a slide, a flight, a door) let go, and you stand still again. Your settings stay. */
void free_clear_belt()
{
clear_run_objects();
cancel_movement();
reset_practice_hints();
free_clear_queue(); // every batch and continuous rule (freebelt.nvgt)
clear_inventory(); // and your inventory, empty as a free run starts (dev, 2026-11-13)
reset_shield(); // and a worn shield comes off (dev, 2026-11-13)
reset_weapons(); // and the guns refilled to their start, the fist drawn, as a run starts (dev, 2026-11-13; weapons.nvgt)
free_moving = false;
}
string free_speed_text()
{
if (free_speed_mode == "rising") return "rising, now " + tenths_text(int(round(10000.0 / current_step_time(), 0))) + " steps a second";
if (free_speed_mode == "normal") return "normal, now " + tenths_text(int(round(10000.0 / current_step_time(), 0))) + " steps a second";
return tenths_text(int(round(10000.0 / free_speed, 0))) + " steps a second";
}
// View current setup's lines.
string[] free_setup_lines()
{
string[] lines;
lines.insert_last(stat_line("belt", free_moving ? "running" : "standing still"));
lines.insert_last(stat_line("running speed", free_speed_text()));
lines.insert_last(stat_line("death mode", free_practice_deaths ? "practice deaths" : "normal deaths"));
lines.insert_last(stat_line("practice hints", free_hints ? "on" : "off"));
lines.insert_last(stat_line("environment", (debug_env == "" ? "random, now " : "") + current_env.replace("_", " ", true)));
free_add_belt_lines(lines); // what's coming (freebelt.nvgt)
return lines;
}
// Modify death mode: "Choose what happens when you die." True once one is chosen, said in the misc buffer.
bool free_death_menu()
{
setupmenu();
m.intro_text = "Choose what happens when you die.";
m.add_item("normal deaths", "normal");
m.add_item("practice deaths", "practice");
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return false;
free_practice_deaths = m.selected_item_id == "practice";
speak_buffer(free_practice_deaths ? "You now have practice deaths." : "You now have normal deaths.", "misc");
return true;
}
// Modify practice hints: on or off; turning them on starts every kind's count fresh. True once one is chosen.
bool free_hints_menu()
{
setupmenu();
m.intro_text = "Choose whether practice hints are spoken.";
m.add_item("off", "off");
m.add_item("on", "on");
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return false;
bool was = free_hints;
free_hints = m.selected_item_id == "on";
if (free_hints and !was) reset_practice_hints();
speak_buffer(free_hints ? "Practice hints are now on." : "Practice hints are now off.", "misc");
return true;
}
/* The console (backspace or F7), from run_input() in a free run: the run frozen while it's open, its items in alphabetical
order with back last, standing or running. Every change closes it with a line in the misc buffer; view current setup and backing out of a menu return to it. Escape or back
closes it silently, as a nested menu. */
void free_console()
{
pause_game();
while (running)
{
setupmenu();
m.intro_text = free_moving ? "Free run console. You're running." : "Free run console. You're standing still.";
if (free_moving)
{
m.add_item("add items", "add_items");
m.add_item("add obstacles", "add_obstacles");
m.add_item("add specials", "add_specials"); // powerups and slides (dev, 2026-11-13)
m.add_item("clear belt", "clear_belt");
m.add_item("clear items", "clear_items");
m.add_item("clear obstacles", "clear_obstacles");
m.add_item("clear specials", "clear_specials");
if (is_gun(current_weapon)) m.add_item("modify ammo reserves", "ammo"); // only with the machine gun or pistol drawn
}
m.add_item("modify death mode", "death");
m.add_item("modify environment", "env");
if (free_moving)
{
m.add_item("modify player health", "health");
m.add_item("modify player inventory", "inventory"); // give items and take items (Section 3B; dev, 2026-11-13)
m.add_item("modify player lives", "lives");
}
m.add_item("modify practice hints", "hints");
m.add_item("modify running speed", "speed");
if (free_moving and shield_worn) m.add_item("modify shield strength", "shield"); // only while a shield is worn
if (!free_moving) m.add_item("start running", "start");
m.add_item("view current setup", "view");
m.add_item("back", "back");
int focus = free_console_focus; // where you last were, or the first item (dev, 2026-11-13: no focus on start running)
int mres = m.run(focus, false, focus >= 0);
if (mres < 0 or m.selected_item_id == "back") break;
free_console_focus = mres;
string id = m.selected_item_id;
/* Every change closes the console and says what it did in the misc buffer, as CaveDefender's console does (dev,
2026-11-13: "It should be consistent if possible"); only view current setup and backing out of a menu stay in it. */
bool done = false;
if (id == "start")
{
free_start_running();
speak_buffer("You've started running.", "misc");
done = true;
}
else if (id == "clear_belt")
{
free_clear_belt();
speak_buffer("The belt has been cleared.", "misc");
done = true;
}
else if (id == "add_items") done = free_add("item"); // freebelt.nvgt
else if (id == "add_obstacles") done = free_add("obstacle");
else if (id == "add_specials") done = free_add("special");
else if (id == "clear_items") done = free_clear("item");
else if (id == "clear_obstacles") done = free_clear("obstacle");
else if (id == "clear_specials") done = free_clear("special");
else if (id == "inventory") done = free_inventory_menu();
else if (id == "ammo") done = free_set_reserve();
else if (id == "health") done = free_set_health();
else if (id == "lives") done = free_set_lives();
else if (id == "shield") done = free_set_shield();
else if (id == "death") done = free_death_menu();
else if (id == "env")
{
done = choose_free_env();
if (done) free_apply_env();
}
else if (id == "hints") done = free_hints_menu();
else if (id == "speed")
{
done = choose_free_speed();
if (done) free_apply_speed();
}
else show_stat_lines("Free run setup. Here's how your run is set up right now.", free_setup_lines());
if (done)
{
free_console_focus = -1; // the next time, the first item
break;
}
}
resume_game();
}
/* Section 3: the player (the free run plan, dev, 2026-11-13), set from the running console. Each number box takes 1 to
1000 (a reserve 0 to 1000); escape cancels. free_health is your full health, filled at once and on a new life;
free_lives the lives you have and get back from a practice death, capsules adding up to the higher of max_lives or it;
free_shield_full the worn shield's full strength (a newly worn shield starts at shield_hp); each gun's reserve a set number
(gun_start_reserve, 50, to start, as a normal run: dev, 2026-11-13) or unlimited, kept through replays. */
int free_health = player_hp;
int free_shield_full = shield_hp;
bool[] free_reserve_unlimited = {false, false, false, false, false, false, false, false, false, false}; // one per weapon_names entry; a normal run's reserve to start (dev, 2026-11-13)
int[] free_reserve_set = {50, 50, 50, 50, 50, 50, 50, 50, 50, 50}; // gun_start_reserve, as a normal run starts
// Your full health: a free run's set amount, or player_hp.
int max_health()
{
return free_run ? free_health : player_hp;
}
// The most lives a capsule can take you to: max_lives, or in a free run the higher of it and your set lives.
int lives_cap()
{
if (free_run and free_lives > max_lives) return free_lives;
return max_lives;
}
// The worn shield's full strength, for its percent (M).
int shield_full()
{
return free_run ? free_shield_full : shield_hp;
}
// Modify player health: "How much health do you want?" True once set.
bool free_set_health()
{
int n = free_ask_number("Modify player health", "How much health do you want?", 1, 1000);
if (n < 0)
{
speak("canceled");
return false;
}
free_health = n;
player_health = n;
speak_buffer("You now have " + n + " health.", "misc");
return true;
}
// Modify player lives: "How many lives do you want?" True once set.
bool free_set_lives()
{
int n = free_ask_number("Modify player lives", "How many lives do you want?", 1, 1000); // up to 1000 (dev, 2026-11-13)
if (n < 0)
{
speak("canceled");
return false;
}
free_lives = n;
lives = n;
speak_buffer("You now have " + (n == 1 ? "1 life." : n + " lives."), "misc");
return true;
}
// Modify shield strength, while one is worn: "How strong should your shield be?" True once set.
bool free_set_shield()
{
int n = free_ask_number("Modify shield strength", "How strong should your shield be?", 1, 1000);
if (n < 0)
{
speak("canceled");
return false;
}
free_shield_full = n;
shield_hp_left = n;
speak_buffer("Your shield's strength is now " + n + ".", "misc");
return true;
}
// Modify ammo reserves, with a gun drawn: unlimited, or a set number from 0 to 1000. True once set.
bool free_set_reserve()
{
int w = current_weapon;
string gun = weapon_display_name(w);
setupmenu();
m.intro_text = "Choose your " + gun + "'s reserve.";
m.add_item("unlimited", "unlimited");
m.add_item("set a number", "number");
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return false;
if (m.selected_item_id == "unlimited")
{
free_reserve_unlimited[w] = true;
speak_buffer("Your " + gun + " now has unlimited rounds in reserve.", "misc");
return true;
}
int n = free_ask_number("Modify ammo reserves", "How many rounds do you want in reserve?", 0, 1000);
if (n < 0)
{
speak("canceled");
return false;
}
free_reserve_unlimited[w] = false;
free_reserve_set[w] = n;
weapon_reserve[w] = n;
speak_buffer("Your " + gun + " now has " + (n == 1 ? "1 round" : n + " rounds") + " in reserve.", "misc");
return true;
}
/* Section 3B: give items (the free run plan, dev, 2026-11-13): any number of an item kind, or of each with all items,
straight into your inventory, to try what it does without picking it up. A key comes in a random color each, as one on
the belt would. The list remembers its place for the run. */
int free_give_focus = -1;
// One item kind (an add items id) into the inventory, amount of them.
void free_give_kind(const string&in type, int amount)
{
if (type == "keys")
{
// All keys: that many of every color (dev, 2026-11-13: the color menu).
string[] colors = get_pack_sound_folders(key_folder + "*");
for (uint i = 0; i < colors.length(); i++) give_item(colors[i], amount);
return;
}
give_item(type.substr(0, type.length() - 1), amount); // "health_potions" is the inventory's "health_potion"
}
int free_key_focus = -1;
/* Keys' color menu (dev, 2026-11-13: "I like the menu better."): each color, then all keys, then back. The color's
folder ("red_key"), "keys" for all of them, or "" if backed out. */
string free_choose_key()
{
setupmenu();
m.intro_text = "Choose the key you'd like to be given.";
string[] colors = get_pack_sound_folders(key_folder + "*");
for (uint i = 0; i < colors.length(); i++) m.add_item(item_display_name(colors[i]), colors[i]);
m.add_item("all keys", "keys");
m.add_item("back", "back");
int mres = m.run(free_key_focus, false, free_key_focus >= 0);
if (mres < 0 or m.selected_item_id == "back") return "";
free_key_focus = mres;
return m.selected_item_id;
}
/* Give items: the kind (or all items; for keys a color or all keys), "How many?", then into your inventory. True once
given, with a line in misc. All items and all keys give that many of every key color. */
bool free_give_items()
{
setupmenu();
m.intro_text = "Choose the item you'd like to be given.";
string[] ids = free_ids("item");
for (uint i = 0; i < ids.length(); i++) m.add_item(free_kind_name(ids[i], "item"), ids[i]);
m.add_item("all items", "all");
m.add_item("back", "back");
int mres = m.run(free_give_focus, false, free_give_focus >= 0);
if (mres < 0 or m.selected_item_id == "back") return false;
free_give_focus = mres;
string type = m.selected_item_id;
string key = "";
if (type == "keys")
{
key = free_choose_key();
if (key == "") return false; // back out of the colors to the console
}
int n = free_ask_number("Give items", "How many?", 1, 1000);
if (n < 0)
{
speak("canceled");
return false;
}
if (type == "all")
{
for (uint i = 0; i < ids.length(); i++) free_give_kind(ids[i], n);
speak_buffer(n + " of each item given.", "misc");
return true;
}
if (key != "" and key != "keys")
{
give_item(key, n);
string name = item_display_name(key); // "red key"
speak_buffer(n + " " + (n == 1 ? name : name + "s") + " given.", "misc");
return true;
}
free_give_kind(type, n);
if (type == "keys") speak_buffer(n + " of each key given.", "misc");
else speak_buffer(n + " " + free_kind_name(type, "item", n) + " given.", "misc");
return true;
}
/* Take items (dev, 2026-11-13, part of Section 3B): only what's in your inventory, each with its count ("health potion,
3"), then all items, then back; "How many?" 1 to 1000, more than you have taking them all; all items empties the
inventory. True once taken, with a line in misc. An empty inventory just says so. */
bool free_take_items()
{
string[] keys = inventory_keys();
if (keys.length() == 0)
{
dlgmessage_return("Your inventory is empty."); // a dialog, so the inventory menu reopening doesn't cut it off (dev, 2026-11-13)
return false;
}
setupmenu();
m.intro_text = "Choose the item you'd like to take.";
for (uint i = 0; i < keys.length(); i++) m.add_item(item_display_name(keys[i]) + ", " + item_count(keys[i]), keys[i]);
m.add_item("all items", "all");
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return false;
string item = m.selected_item_id;
if (item == "all")
{
clear_inventory();
speak_buffer("All items taken.", "misc");
return true;
}
int n = free_ask_number("Take items", "How many?", 1, 1000);
if (n < 0)
{
speak("canceled");
return false;
}
int have = item_count(item);
int taken = n > have ? have : n;
give_item(item, -taken);
string name = item_display_name(item); // "health potion"
speak_buffer(taken + " " + (taken == 1 ? name : name + "s") + " taken.", "misc");
return true;
}
/* Modify player inventory (dev, 2026-11-13: "What about putting them in a menu called modify player inventory?"): give
items and take items, then back, which steps back to the console silently. True once something was given or taken. */
bool free_inventory_menu()
{
while (true)
{
setupmenu();
m.intro_text = "Choose what you'd like to do with your inventory.";
m.add_item("give items", "give");
m.add_item("take items", "take");
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return false;
if (m.selected_item_id == "give" ? free_give_items() : free_take_items()) return true;
}
return false;
}
