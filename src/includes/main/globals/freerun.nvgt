/* Free run: a mode in play game, open once hard endless has its difficulty_unlock_runs counted runs (when insane opens),
with no difficulty and nothing counted: no statistics, achievements, records or unlocks (run_difficulty stays -1, so
stats_counting stays off).
- The setup: a running speed (a fixed 2 to 10 steps a second, rising, or normal, which speeds up as an endless run), then
  an environment (one to stay in, or random). The run starts with you standing still on an empty belt (spawn_only
  "free", which brings only what you add: freebelt.nvgt): music and ambience only, no footsteps or heartbeat; every key
  works, jump, crouch and hands too, for trying them in place.
- The console, on the free_console action (backspace and F7), freezes the run while it's open. Its items, alphabetical
  with back last, depend on whether you're standing or running (free_console()).
- Death mode: no deaths (your last life is never lost), normal deaths (the run ends, and replay or restart brings the
  same run back, standing, with everything as it was: free_prepare_replay()) or practice deaths (practice_death(), set
  down past what caught you). Practice hints: off to start; on, every kind gets practice_hint()'s lines, whatever the
  death mode.
- The guns start with a normal run's reserve, gun_start_reserve, which modify ammo reserves can change and modify ammo
  limits can make unlimited. */
bool free_run = false; // the mode's runs, set by play_game() and kept through replays
bool free_moving = false; // start running sets it, clear belt clears it
string free_speed_mode = "fixed"; // "fixed", "rising" or "normal"
int free_speed = start_step_time; // the fixed speed's step time
string free_death_mode = "normal"; // "normal", "no" or "practice" deaths; normal to start
bool free_hints = false;
bool free_heartbeat_on = true; // modify heartbeat: heard or silent (heartbeat_check(), heartbeat.nvgt)
int free_lives = starting_lives; // the lives a practice death gives back (modify player lives sets them)
int free_console_focus = -1;

// The mode opens with insane in endless: once hard has its difficulty_unlock_runs counted runs.
bool free_mode_unlocked()
{
return difficulty_runs[2] >= difficulty_unlock_runs;
}
// "after completing 5 hard endless runs.", or "after completing 2 more hard endless runs." once started ("run" for 1).
string free_mode_lock_reason()
{
int left = difficulty_unlock_runs - difficulty_runs[2];
bool started = difficulty_runs[2] > 0;
return "after completing " + left + (started ? " more " : " ") + "hard endless " + (left == 1 ? "run." : "runs.");
}
bool free_standing()
{
return free_run and !free_moving;
}
// A practice run's deaths, or a free run's on practice deaths: the run never ends, you're set down past what caught you.
bool practice_deaths()
{
return practice_run or (free_run and free_death_mode == "practice");
}
// A free run on no deaths: your last life is never lost (lives.nvgt).
bool free_no_deaths()
{
return free_run and free_death_mode == "no";
}
/* Hazards and floor breakers, which no refill can survive: a practice death sets you down past them, in a practice run,
on practice deaths, and on no deaths. */
bool set_down_deaths()
{
return practice_deaths() or free_no_deaths();
}
// A practice run's hints, or a free run's with practice hints on (practice_hints.nvgt).
bool practice_hints_on()
{
return practice_run or (free_run and free_hints);
}
// A gun's reserve never runs out in practice, nor in a free run set to unlimited (weapons.nvgt).
bool reserve_unlimited(int w)
{
return practice_run or (free_run and free_reserve_unlimited[w]);
}
// From play_game(), each time a free run is set up: the console's settings back to how a free run starts.
void reset_free_settings()
{
free_moving = false;
free_speed_mode = "fixed";
free_speed = start_step_time;
free_death_mode = "normal";
free_hints = false;
free_heartbeat_on = true;
free_lives = starting_lives;
free_health = player_hp;
free_shield_full = shield_hp;
for (uint i = 0; i < free_reserve_unlimited.length(); i++)
{
free_reserve_unlimited[i] = false; // a normal run's reserve, not practice's unlimited
free_reserve_set[i] = gun_start_reserve;
}
free_console_focus = -1;
free_clear_queue(); // a new setup starts with nothing coming (freebelt.nvgt)
free_kind_focus.delete_all(); // and the add lists start at their tops
free_give_focus = -1; // and give items' list
free_key_focus = -1;
free_set_focus = -1; // and set items' list
}
/* A replay or restart: the same free run again, standing still at the start, with the same speed,
environment, death mode, hints and continuous rules, and every batch back at its full count (free_refill_queue()). */
void free_prepare_replay()
{
free_moving = false;
free_console_focus = -1;
free_refill_queue(); // freebelt.nvgt
}
// The step time a free run starts at: the fixed speed, or 2 steps a second for rising and normal.
int free_start_step_time()
{
return free_speed_mode == "fixed" ? free_speed : start_step_time;
}
/* The running speed menu, at setup and in the console: the fixed speeds (as practice offers them), normal, rising, back.
From the console it says what it's currently set to and opens on it. True once one is chosen. */
bool choose_free_speed(bool console = false)
{
setupmenu();
m.intro_text = "Choose your running speed, in steps a second.";
if (console) m.intro_text += " Currently set to " + (free_speed_mode == "fixed" ? tenths_text(int(round(10000.0 / free_speed, 0))) + " steps a second" : free_speed_mode) + ".";
int current = -1;
int index = 0;
for (int t = start_step_time; t >= 100; t -= 100)
{
m.add_item(tenths_text(int(round(10000.0 / t, 0))), "" + t);
if (free_speed_mode == "fixed" and t == free_speed) current = index;
index++;
}
if (free_speed_mode == "normal") current = index;
m.add_item("normal", "normal"); // speeds up as an endless run does
if (free_speed_mode == "rising") current = index + 1;
m.add_item("rising", "rising"); // from 2 up to 10, as practice's rising
m.add_item("back", "back");
int mres = console ? m.run(current, false, current >= 0) : m.run();
if (mres < 0 or m.selected_item_id == "back") return false;
string id = m.selected_item_id;
if (id == "rising" or id == "normal") free_speed_mode = id;
else
{
free_speed_mode = "fixed";
free_speed = int(parse_int(id));
}
return true;
}
/* The environment menu, at setup and in the console: each environment to stay in, then random, then back. From the
console it says what it's currently set to and opens on it. */
bool choose_free_env(bool console = false)
{
setupmenu();
m.intro_text = "Choose the environment you'd like to run in.";
if (console) m.intro_text += " Currently set to " + (debug_env == "" ? "random" : debug_env.replace("_", " ", true)) + ".";
string[] names = env_names();
for (uint i = 0; i < names.length(); i++) m.add_item(names[i].replace("_", " ", true), names[i]);
m.add_item("random", "random");
m.add_item("back", "back");
int current = debug_env == "" ? int(names.length()) : names.find(debug_env);
int mres = console ? m.run(current, false, current >= 0) : m.run();
if (mres < 0 or m.selected_item_id == "back") return false;
debug_env = m.selected_item_id == "random" ? "" : m.selected_item_id; // environments.nvgt holds a run with no difficulty in debug_env
return true;
}
// The setup: speed, then environment; back from the environment returns to the speed. False if backed out of entirely.
bool choose_free_setup()
{
reset_free_settings();
debug_env = "";
while (true)
{
if (!choose_free_speed()) return false;
if (choose_free_env()) return true;
}
return false;
}
/* A mid-run environment choice: held in one, it moves you there at once ("You've entered ..."), or says you'll stay;
random, switching resumes, and it says so. */
void free_apply_env()
{
if (debug_env != "")
{
env_switch_at = -1;
if (debug_env == current_env)
{
speak_buffer("You'll stay in the " + current_env.replace("_", " ", true) + " environment.", "misc");
return;
}
current_env = debug_env;
announce_env(true);
current_surface = "";
pick_surface();
begin_ambience_fade(pick_ambience());
return;
}
env_switch_at = env_switch_choices().length() > 0 ? runtimer.elapsed + random(env_switch_min_time, env_switch_max_time) : -1;
speak_buffer("The environment will now change every 1 to 2 minutes.", "misc");
}
// A mid-run speed choice: a fixed speed at once; rising and normal carry on from the speed you're at.
void free_apply_speed()
{
if (free_speed_mode == "fixed") step_time = free_speed;
speeduptimer.restart();
// Said every time: a fixed speed as C says it, or how it will rise.
if (free_speed_mode == "normal") speak_buffer("Your speed now rises as in an endless run.", "misc");
else if (free_speed_mode == "rising") speak_buffer("Your speed now rises up to 10 steps a second.", "misc");
else speak_buffer(speed_phrase(), "misc"); // "You are running 3.3 steps a second."
}
// From speedup_check(): a free run speeds up only while moving, and only on rising or normal. True if it handled it.
bool free_speedup()
{
if (!free_run) return false;
if (!free_moving or free_speed_mode == "fixed") return true;
bool rising = free_speed_mode == "rising";
if (speeduptimer.elapsed < (rising ? practice_rising_period : speedup_period)) return true;
speeduptimer.restart();
step_time = int(max(rising ? practice_rising_top : min_step_time, step_time - speedup_amount));
return true;
}
void free_start_running()
{
free_moving = true;
steptimer.restart();
speeduptimer.restart();
}
/* Clear belt: everything on the belt and on its way gone, your inventory emptied, a worn shield off and your weapons as
a run starts, whatever you're in (a ladder, a repair, a slide, a flight, a door) let go, and you stand still again.
Your settings stay. */
void free_clear_belt()
{
clear_run_objects();
cancel_movement();
reset_practice_hints();
free_clear_queue(); // every batch and continuous rule (freebelt.nvgt)
clear_inventory();
reset_shield();
reset_weapons(); // the guns refilled to their start, the fist drawn (weapons.nvgt)
free_moving = false;
}
string free_speed_text()
{
if (free_speed_mode == "rising") return "rising, now " + tenths_text(int(round(10000.0 / current_step_time(), 0))) + " steps a second";
if (free_speed_mode == "normal") return "normal, now " + tenths_text(int(round(10000.0 / current_step_time(), 0))) + " steps a second";
return tenths_text(int(round(10000.0 / free_speed, 0))) + " steps a second";
}
// View current setup's lines.
string[] free_setup_lines()
{
string[] lines;
lines.insert_last(stat_line("belt", free_moving ? "running" : "standing still"));
lines.insert_last(stat_line("running speed", free_speed_text()));
lines.insert_last(stat_line("death mode", free_death_mode + " deaths"));
lines.insert_last(stat_line("footsteps", footsteps_on ? "heard" : "silent"));
lines.insert_last(stat_line("heartbeat", free_heartbeat_on ? "heard" : "silent"));
lines.insert_last(stat_line("practice hints", free_hints ? "spoken" : "silent")); // as the menu names them
lines.insert_last(stat_line("environment", (debug_env == "" ? "random, now " : "") + current_env.replace("_", " ", true)));
free_add_belt_lines(lines); // what's coming (freebelt.nvgt)
return lines;
}
// Modify death mode: "Choose what happens when you die." True once one is chosen, said in the misc buffer.
bool free_death_menu()
{
setupmenu();
m.intro_text = "Choose what happens when you die. Currently set to " + free_death_mode + " deaths.";
m.add_item("no deaths", "no");
m.add_item("normal deaths", "normal");
m.add_item("practice deaths", "practice");
m.add_item("back", "back");
int current = free_death_mode == "no" ? 0 : (free_death_mode == "normal" ? 1 : 2);
int mres = m.run(current, false, true);
if (mres < 0 or m.selected_item_id == "back") return false;
free_death_mode = m.selected_item_id;
speak_buffer("You now have " + free_death_mode + " deaths.", "misc");
return true;
}
/* Modify footsteps: heard or silent, as the debug footsteps question (footsteps_on, surface.nvgt; landings still play). play_game() sets footsteps_on for every new setup and every other mode, so a replay keeps your
choice and nothing else is touched. True once chosen. */
bool free_footsteps_menu()
{
setupmenu();
m.intro_text = "Choose your footsteps. Currently set to " + (footsteps_on ? "heard" : "silent") + " footsteps.";
m.add_item("heard footsteps", "heard");
m.add_item("silent footsteps", "silent");
m.add_item("back", "back");
int mres = m.run(footsteps_on ? 0 : 1, false, true);
if (mres < 0 or m.selected_item_id == "back") return false;
footsteps_on = m.selected_item_id == "heard";
speak_buffer(footsteps_on ? "Your footsteps are now heard." : "Your footsteps are now silent.", "misc");
return true;
}
/* Modify heartbeat: heard or silent, like the footsteps. Set fresh by reset_free_settings() for every new free run, so a
replay keeps your choice. True once chosen. */
bool free_heartbeat_menu()
{
setupmenu();
m.intro_text = "Choose your heartbeat. Currently set to " + (free_heartbeat_on ? "heard" : "silent") + " heartbeat.";
m.add_item("heard heartbeat", "heard");
m.add_item("silent heartbeat", "silent");
m.add_item("back", "back");
int mres = m.run(free_heartbeat_on ? 0 : 1, false, true);
if (mres < 0 or m.selected_item_id == "back") return false;
free_heartbeat_on = m.selected_item_id == "heard";
speak_buffer(free_heartbeat_on ? "Your heartbeat is now heard." : "Your heartbeat is now silent.", "misc");
return true;
}
// Modify practice hints: silent or spoken; turning them on starts every kind's count fresh. True once one is chosen.
bool free_hints_menu()
{
setupmenu();
m.intro_text = "Choose your practice hints. Currently set to " + (free_hints ? "spoken" : "silent") + " hints.";
m.add_item("silent hints", "off"); // named choices, not on and off
m.add_item("spoken hints", "on");
m.add_item("back", "back");
int mres = m.run(free_hints ? 1 : 0, false, true);
if (mres < 0 or m.selected_item_id == "back") return false;
bool was = free_hints;
free_hints = m.selected_item_id == "on";
if (free_hints and !was) reset_practice_hints();
speak_buffer(free_hints ? "Practice hints are now on." : "Practice hints are now off.", "misc");
return true;
}
/* The console (backspace or F7), from run_input() in a free run: the run frozen while it's open, its items in alphabetical
order with back last, standing or running. Escape or back closes it silently, as a nested menu. */
string free_console_note = ""; // a line to say before the console's intro the next time it opens, such as an empty add list
void free_console()
{
pause_game();
while (running)
{
setupmenu();
m.intro_text = free_moving ? "Free run console. You're running." : "Free run console. You're standing still.";
if (free_console_note != "") m.intro_text = free_console_note + " " + m.intro_text; // news from the last choice, heard before the intro
free_console_note = "";
if (free_moving)
{
m.add_item("add items", "add_items");
m.add_item("add obstacles", "add_obstacles");
m.add_item("add specials", "add_specials"); // powerups and slides
m.add_item("clear belt", "clear_belt");
m.add_item("clear items", "clear_items");
m.add_item("clear obstacles", "clear_obstacles");
m.add_item("clear specials", "clear_specials");
if (is_gun(current_weapon)) m.add_item("modify ammo limits", "unlimited"); // the drawn gun's limited or unlimited rounds
if (is_gun(current_weapon) and !free_reserve_unlimited[current_weapon]) m.add_item("modify ammo reserves", "ammo"); // only with a gun drawn, and hidden while it has unlimited rounds
}
m.add_item("modify death mode", "death");
m.add_item("modify environment", "env");
m.add_item("modify footsteps", "footsteps"); // standing or running
m.add_item("modify heartbeat", "heartbeat"); // standing or running
if (free_moving)
{
m.add_item("modify player health", "health");
m.add_item("modify player inventory", "inventory"); // give, set and take items
m.add_item("modify player lives", "lives");
}
m.add_item("modify practice hints", "hints");
m.add_item("modify running speed", "speed");
if (free_moving and shield_worn) m.add_item("modify shield strength", "shield"); // only while a shield is worn
if (!free_moving) m.add_item("start running", "start");
m.add_item("view current setup", "view");
m.add_item("back", "back");
int focus = free_console_focus; // where you last were, or the first item
int mres = m.run(focus, false, focus >= 0);
if (mres < 0 or m.selected_item_id == "back") break;
free_console_focus = mres;
string id = m.selected_item_id;
// Every change closes the console and says what it did in the misc buffer; only view current setup and backing out of a menu stay in it.
bool done = false;
if (id == "start")
{
free_start_running();
speak_buffer("You've started running.", "misc");
done = true;
}
else if (id == "clear_belt")
{
free_clear_belt();
speak_buffer("The belt has been cleared.", "misc");
done = true;
}
else if (id == "add_items") done = free_add("item"); // freebelt.nvgt
else if (id == "add_obstacles") done = free_add("obstacle");
else if (id == "add_specials") done = free_add("special");
else if (id == "clear_items") done = free_clear("item");
else if (id == "clear_obstacles") done = free_clear("obstacle");
else if (id == "clear_specials") done = free_clear("special");
else if (id == "inventory") done = free_inventory_menu();
else if (id == "ammo") done = free_set_reserve();
else if (id == "unlimited") done = free_unlimited_menu();
else if (id == "health") done = free_set_health();
else if (id == "lives") done = free_set_lives();
else if (id == "shield") done = free_set_shield();
else if (id == "death") done = free_death_menu();
else if (id == "footsteps") done = free_footsteps_menu();
else if (id == "heartbeat") done = free_heartbeat_menu();
else if (id == "env")
{
done = choose_free_env(true);
if (done) free_apply_env();
}
else if (id == "hints") done = free_hints_menu();
else if (id == "speed")
{
done = choose_free_speed(true);
if (done) free_apply_speed();
}
else show_stat_lines("Free run setup. Here's how your run is set up right now.", free_setup_lines());
if (done)
{
free_console_focus = -1; // the next time, the first item
break;
}
}
resume_game();
}
/* The player, set from the running console. Each number box takes 1 to 1000 (a reserve 0 to 1000); escape cancels.
free_health is your full health, filled at once and on a new life; free_lives the lives you have and get back from a
practice death, capsules adding up to the higher of max_lives or it; free_shield_full the worn shield's full strength (a
newly worn shield starts at shield_hp); each gun's reserve a set number (gun_start_reserve to start, as a normal run) or
unlimited, kept through replays. */
int free_health = player_hp;
int free_shield_full = shield_hp;
bool[] free_reserve_unlimited = {false, false, false, false, false, false, false, false, false, false}; // one per weapon_names entry; a normal run's reserve to start
int[] free_reserve_set = {50, 50, 50, 50, 50, 50, 50, 50, 50, 50}; // gun_start_reserve, as a normal run starts; reset_free_settings() sets them from it
// Your full health: a free run's set amount, or player_hp.
int max_health()
{
return free_run ? free_health : player_hp;
}
// The most lives a capsule can take you to: max_lives, or in a free run the higher of it and your set lives.
int lives_cap()
{
if (free_run and free_lives > max_lives) return free_lives;
return max_lives;
}
// The worn shield's full strength, for its percent (M).
int shield_full()
{
return free_run ? free_shield_full : shield_hp;
}
/* Give, set and take: each modify choice opens "Choose how you'd like to change your <what>." with give, set and take,
then back (escape or back steps out silently). Give adds to what you have now, stopping at full (lives and rounds at
1000); set is the full amount itself, filled; take removes from what you have now, stopping at 1 (rounds at 0), never
costing a life, the run or the shield. Returns "give", "set" or "take", or "" if backed out. */
string free_change_choice(const string&in intro, const string&in what)
{
setupmenu();
m.intro_text = intro;
m.add_item("give " + what, "give");
m.add_item("set " + what, "set");
m.add_item("take " + what, "take");
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return "";
return m.selected_item_id;
}
// The amount to give or take, 1 to 1000: "How much health do you want to give?" Below 0 if escaped.
int free_change_amount(const string&in title, const string&in how, const string&in what, const string&in way)
{
return free_ask_number(title, how + " " + what + " do you want to " + way + "?", 1, 1000);
}
// Modify player health: give, set or take. True once changed.
bool free_set_health()
{
string way = free_change_choice("Choose how you'd like to change your health. You currently have " + player_health + " of " + free_health + " health.", "health");
if (way == "") return false;
int n = way == "set" ? free_ask_number("Modify player health", "How much health do you want?", 1, 1000) : free_change_amount("Modify player health", "How much", "health", way);
if (n < 0)
{
speak("canceled");
return false;
}
if (way == "set")
{
free_health = n;
player_health = n;
speak_buffer("You now have " + n + " health.", "misc");
return true;
}
int now = way == "give" ? player_health + n : player_health - n;
if (now > free_health) now = free_health; // give stops at full
if (now < 1) now = 1; // take never costs a life
player_health = now;
speak_buffer("You now have " + now + " of " + free_health + " health.", "misc");
return true;
}
// Modify player lives: give, set or take. Your lives are also what a practice death gives back. True once changed.
bool free_set_lives()
{
string way = free_change_choice("Choose how you'd like to change your lives. You currently have " + (lives == 1 ? "1 life." : lives + " lives."), "lives");
if (way == "") return false;
int n = way == "set" ? free_ask_number("Modify player lives", "How many lives do you want?", 1, 1000) : free_change_amount("Modify player lives", "How many", "lives", way); // up to 1000
if (n < 0)
{
speak("canceled");
return false;
}
int now = way == "set" ? n : (way == "give" ? lives + n : lives - n);
if (now > 1000) now = 1000;
if (now < 1) now = 1; // take stops at 1 life
free_lives = now;
lives = now;
speak_buffer("You now have " + (now == 1 ? "1 life." : now + " lives."), "misc");
return true;
}
// Modify shield strength, while one is worn: give, set or take. True once changed.
bool free_set_shield()
{
string way = free_change_choice("Choose how you'd like to change your shield's strength. Your shield currently has " + shield_hp_left + " of " + free_shield_full + " strength.", "shield strength");
if (way == "") return false;
int n = way == "set" ? free_ask_number("Modify shield strength", "How strong should your shield be?", 1, 1000) : free_change_amount("Modify shield strength", "How much", "strength", way);
if (n < 0)
{
speak("canceled");
return false;
}
if (way == "set")
{
free_shield_full = n;
shield_hp_left = n;
speak_buffer("Your shield's strength is now " + n + ".", "misc");
return true;
}
int now = way == "give" ? shield_hp_left + n : shield_hp_left - n;
if (now > free_shield_full) now = free_shield_full; // give stops at full strength
if (now < 1) now = 1; // take never breaks the shield
shield_hp_left = now;
speak_buffer("Your shield's strength is now " + now + " of " + free_shield_full + ".", "misc");
return true;
}
/* Modify ammo reserves, with a gun drawn that doesn't have unlimited rounds: give, set or take rounds. Give stops at 1000
(a reserve has no full amount), take at 0. Set is the reserve a replay starts with; give and take change only what you
have now. True once changed. */
bool free_set_reserve()
{
int w = current_weapon;
string gun = weapon_display_name(w);
string way = free_change_choice("Choose your " + gun + "'s reserve. You currently have " + (weapon_reserve[w] == 1 ? "1 round" : weapon_reserve[w] + " rounds") + " in reserve.", "rounds");
if (way == "") return false;
int n = way == "set" ? free_ask_number("Modify ammo reserves", "How many rounds do you want in reserve?", 0, 1000) : free_change_amount("Modify ammo reserves", "How many", "rounds", way);
if (n < 0)
{
speak("canceled");
return false;
}
int now = way == "set" ? n : (way == "give" ? weapon_reserve[w] + n : weapon_reserve[w] - n);
if (now > 1000) now = 1000;
if (now < 0) now = 0; // take stops at an empty reserve
if (way == "set") free_reserve_set[w] = now;
weapon_reserve[w] = now;
speak_buffer("Your " + gun + " now has " + (now == 1 ? "1 round" : now + " rounds") + " in reserve.", "misc");
return true;
}
/* Give items: any number of an item kind, or of each with all items, straight into your inventory, to try what it does
without picking it up. A key comes in a random color each, as one on
the belt would. The list remembers its place for the run. */
int free_give_focus = -1;
// One item kind (an add items id) into the inventory, amount of them.
void free_give_kind(const string&in type, int amount)
{
if (type == "keys")
{
// All keys: that many of every color.
string[] colors = get_pack_sound_folders(key_folder + "*");
for (uint i = 0; i < colors.length(); i++) give_item(colors[i], amount);
return;
}
give_item(type.substr(0, type.length() - 1), amount); // "health_potions" is the inventory's "health_potion"
}
int free_key_focus = -1;
/* Keys' color menu: each color, then all keys, then back. The color's folder ("red_key"), "keys" for all of them, or ""
if backed out. */
string free_choose_key(const string&in intro = "Choose the key you'd like to be given.")
{
setupmenu();
m.intro_text = intro; // give items' wording, or set items'
string[] colors = get_pack_sound_folders(key_folder + "*");
for (uint i = 0; i < colors.length(); i++) m.add_item(item_display_name(colors[i]), colors[i]);
m.add_item("all keys", "keys");
m.add_item("back", "back");
int mres = m.run(free_key_focus, false, free_key_focus >= 0);
if (mres < 0 or m.selected_item_id == "back") return "";
free_key_focus = mres;
return m.selected_item_id;
}
/* Give items: the kind (or all items; for keys a color or all keys), "How many?", then into your inventory. True once
given, with a line in misc. All items and all keys give that many of every key color. */
bool free_give_items()
{
setupmenu();
m.intro_text = "Choose the item you'd like to be given.";
string[] ids = free_ids("item");
for (uint i = 0; i < ids.length(); i++) m.add_item(free_kind_name(ids[i], "item"), ids[i]);
m.add_item("all items", "all");
m.add_item("back", "back");
int mres = m.run(free_give_focus, false, free_give_focus >= 0);
if (mres < 0 or m.selected_item_id == "back") return false;
free_give_focus = mres;
string type = m.selected_item_id;
string key = "";
if (type == "keys")
{
key = free_choose_key();
if (key == "") return false; // back out of the colors to the console
}
int n = free_ask_number("Give items", "How many?", 1, 1000);
if (n < 0)
{
speak("canceled");
return false;
}
if (type == "all")
{
for (uint i = 0; i < ids.length(); i++) free_give_kind(ids[i], n);
speak_buffer(n + " of each item given.", "misc");
return true;
}
if (key != "" and key != "keys")
{
give_item(key, n);
string name = item_display_name(key); // "red key"
speak_buffer(n + " " + (n == 1 ? name : name + "s") + " given.", "misc");
return true;
}
free_give_kind(type, n);
if (type == "keys") speak_buffer(n + " of each key given.", "misc");
else speak_buffer(n + " " + free_kind_name(type, "item", n) + " given.", "misc");
return true;
}
/* Take items: only what's in your inventory, each with its count ("health potion,
3"), then all items, then back; "How many?" 1 to 1000, more than you have taking them all; all items empties the
inventory. True once taken, with a line in misc. An empty inventory just says so. */
bool free_take_items()
{
string[] keys = inventory_keys();
if (keys.length() == 0)
{
dlgmessage_return("Your inventory is empty."); // a dialog, so the inventory menu reopening doesn't cut it off
return false;
}
setupmenu();
m.intro_text = "Choose the item you'd like to take.";
for (uint i = 0; i < keys.length(); i++) m.add_item(item_display_name(keys[i]) + ", " + item_count(keys[i]), keys[i]);
m.add_item("all items", "all");
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return false;
string item = m.selected_item_id;
if (item == "all")
{
clear_inventory();
speak_buffer("All items taken.", "misc");
return true;
}
int n = free_ask_number("Take items", "How many?", 1, 1000);
if (n < 0)
{
speak("canceled");
return false;
}
int have = item_count(item);
int taken = n > have ? have : n;
give_item(item, -taken);
string name = item_display_name(item); // "health potion"
speak_buffer(taken + " " + (taken == 1 ? name : name + "s") + " taken.", "misc");
return true;
}
/* Modify player inventory: give items, set items and take items, then back, which steps back to the console silently.
True once something was given, set or taken. */
bool free_inventory_menu()
{
while (true)
{
setupmenu();
m.intro_text = "Choose what you'd like to do with your inventory.";
m.add_item("give items", "give");
m.add_item("set items", "set");
m.add_item("take items", "take");
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return false;
string way = m.selected_item_id;
if (way == "give" ? free_give_items() : (way == "set" ? free_set_items() : free_take_items())) return true;
}
return false;
}
/* Modify ammo limits, with a gun drawn: that gun's limited rounds or unlimited rounds, then back. While unlimited,
modify ammo reserves is hidden for it; limited again, the gun keeps the reserve it had, as an unlimited reserve never
drops. True once chosen. */
bool free_unlimited_menu()
{
int w = current_weapon;
string gun = weapon_display_name(w);
setupmenu();
m.intro_text = "Choose your " + gun + "'s ammo limits. Currently set to " + (free_reserve_unlimited[w] ? "unlimited" : "limited") + " rounds.";
m.add_item("limited rounds", "limited");
m.add_item("unlimited rounds", "unlimited");
m.add_item("back", "back");
int mres = m.run(free_reserve_unlimited[w] ? 1 : 0, false, true);
if (mres < 0 or m.selected_item_id == "back") return false;
free_reserve_unlimited[w] = m.selected_item_id == "unlimited";
speak_buffer(free_reserve_unlimited[w] ? "Your " + gun + " now has unlimited rounds." : "Your " + gun + " no longer has unlimited rounds.", "misc");
return true;
}
/* Set items: every item kind (not only what you carry), all items, back, keys through the color menu; "How many do you want?" 0 to 1000, then exactly that many, 0 removing it. All items
(and all keys) set every kind, every key color, so 0 empties the inventory. True once set, with a line in misc. */
int free_set_focus = -1;
// Exactly amount of an inventory item, by give_item()'s difference.
void free_set_item(const string&in item, int amount)
{
give_item(item, amount - item_count(item));
}
// One item kind (an add items id) to exactly amount; keys every color.
void free_set_kind(const string&in type, int amount)
{
if (type == "keys")
{
string[] colors = get_pack_sound_folders(key_folder + "*");
for (uint i = 0; i < colors.length(); i++) free_set_item(colors[i], amount);
return;
}
free_set_item(type.substr(0, type.length() - 1), amount); // "health_potions" is the inventory's "health_potion"
}
bool free_set_items()
{
setupmenu();
m.intro_text = "Choose the item you'd like to set.";
string[] ids = free_ids("item");
for (uint i = 0; i < ids.length(); i++) m.add_item(free_kind_name(ids[i], "item"), ids[i]);
m.add_item("all items", "all");
m.add_item("back", "back");
int mres = m.run(free_set_focus, false, free_set_focus >= 0);
if (mres < 0 or m.selected_item_id == "back") return false;
free_set_focus = mres;
string type = m.selected_item_id;
string key = "";
if (type == "keys")
{
key = free_choose_key("Choose the key you'd like to set.");
if (key == "") return false; // back out of the colors to the console
}
int n = free_ask_number("Set items", "How many do you want?", 0, 1000);
if (n < 0)
{
speak("canceled");
return false;
}
if (type == "all")
{
for (uint i = 0; i < ids.length(); i++) free_set_kind(ids[i], n);
speak_buffer("You now have " + n + " of each item.", "misc");
return true;
}
if (key != "" and key != "keys")
{
free_set_item(key, n);
string name = item_display_name(key); // "red key"
speak_buffer("You now have " + n + " " + (n == 1 ? name : name + "s") + ".", "misc");
return true;
}
free_set_kind(type, n);
if (type == "keys") speak_buffer("You now have " + n + " of each key.", "misc");
else speak_buffer("You now have " + n + " " + free_kind_name(type, "item", n) + ".", "misc");
return true;
}
