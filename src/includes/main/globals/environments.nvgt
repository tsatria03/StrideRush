/* Environments (the environments plan, dev, 2026-11-10; Section 1). Each folder in sounds/environments is a place with its
own audio (tracks, ambiences), platforms (surfaces, its ledge) and traps (<type>/countdown and <type>/general/<theme>);
equipments, misc and ui stay shared. A run plays in current_env, picked at random when it starts (Section 2 adds the
switch every 1 to 2 minutes). Every obstacle remembers the environment it spawned in (its env field), so one still on the
belt after a switch keeps its own sounds. Nothing ever falls back to another environment: a type with no folder there
doesn't spawn there, and a missing clip just doesn't play. */
string current_env = "default";
/* The debug option's choice (source only): "" is "random", the normal random pick; otherwise the one environment a
debug run stays in. Cleared for endless and practice runs by play_game(). */
string debug_env = "";

// "environments/default/", the root of one environment's sounds.
string env_root(const string&in env)
{
return "environments/" + env + "/";
}
/* Which of an environment's two folders a type lives in (the transitions plan, dev, 2026-11-13): doors, ladders,
trampolines, slides and switches are transitions, things that move you or that you move through; every other type is
a trap. */
string type_category(const string&in type)
{
if (type == "doors" or type == "ladders" or type == "trampolines" or type == "slides" or type == "switches") return "transitions";
return "traps";
}
/* A type's folder under an environment's root (the root as env_root() gives it): "traps/hazards/", "transitions/doors/",
or for vehicles, a category of their own beside traps and transitions, just "vehicles/" (the vehicles plan, 2026-11-13).
Its themes are in general/ below it, its warning cues in countdown/. */
string type_path(const string&in root, const string&in type)
{
if (type == "vehicles") return root + "vehicles/";
return root + type_category(type) + "/" + type + "/";
}
// Where one environment keeps a type's themes: "environments/default/traps/hazards/general/", or ".../transitions/doors/general/".
string trap_folder(const string&in env, const string&in type)
{
return type_path(env_root(env), type) + "general/";
}
// Every environment, naturally sorted, from the folders.
string[] env_names()
{
return get_pack_sound_folders("environments/*");
}
// True when an environment has at least one theme for a type, so the type can spawn there.
bool env_has_type(const string&in env, const string&in type)
{
return get_pack_sound_folders(trap_folder(env, type) + "*").length() > 0;
}
// A practice choice's trap folder: the three door choices all live in doors, everything else in its own name.
string practice_trap_type(const string&in choice)
{
if (choice == "fake_doors" or choice == "real_doors" or choice == "mixed_doors") return "doors";
return choice;
}
/* The environment a run starts in (dev, 2026-11-10: random order, automatic only): a debug run's chosen one if the debug
option picked one; otherwise a random one, and for a practice run only among those that have the practiced obstacle. If
nothing qualifies, the run stays where it was (default at first). */
void pick_start_env()
{
string[] names = env_names();
if (run_difficulty < 0 and !practice_run and debug_env != "" and names.find(debug_env) >= 0)
{
current_env = debug_env;
return;
}
string[] candidates;
for (uint i = 0; i < names.length(); i++)
{
if (practice_run and !practice_env_ok(names[i], practice_choice)) continue; // practice.nvgt: combinations need both of some pair
candidates.insert_last(names[i]);
}
if (candidates.length() > 0) current_env = candidates[random(0, candidates.length() - 1)];
}
/* Section 2: switching. A run can move between environments unless a debug run is held in one; a practice run only
among environments that have its obstacle. env_switch_at is the runtimer time of the next switch, or -1 when this run
doesn't switch (one environment to go to, or held in one). */
double env_switch_at = -1;
// Can this run be in this environment? Practice runs need their obstacle there.
bool env_eligible(const string&in env)
{
return !practice_run or practice_env_ok(env, practice_choice);
}
// The environments this run could move to from here: every eligible one but the current one.
string[] env_switch_choices()
{
string[] names = env_names();
string[] choices;
if (run_difficulty < 0 and !practice_run and debug_env != "") return choices; // a debug run held in one environment
for (uint i = 0; i < names.length(); i++)
{
if (names[i] != current_env and env_eligible(names[i])) choices.insert_last(names[i]);
}
return choices;
}
bool env_switching()
{
return env_switch_at >= 0;
}
/* From start_run_audio(): the first switch's time, if this run switches at all, and the starting announcement, which is
only made when there's more than one environment (dev, 2026-11-10). It interrupts the weapon draw's "fist equipped."
(dev, 2026-11-11: "the env switch should be interupted when you start a turn. RIght now the weapon equip speaks first"),
which is still in the weapons buffer. */
void start_env()
{
env_switch_at = env_switch_choices().length() > 0 ? runtimer.elapsed + random(env_switch_min_time, env_switch_max_time) : -1;
if (env_names().length() > 1) announce_env(true);
}
// "You've entered the custom environment." in the misc buffer, no sound (dev, 2026-11-10).
void announce_env(bool interrupt)
{
speak_buffer("You've entered the " + current_env.replace("_", " ", true) + " environment.", "misc", interrupt ? tts_default_interrupt : false);
}
/* Every frame, from run_audio_check(): at the switch time, a random different environment. Footsteps change at once (a
new surface from the new platforms), new obstacles and countdowns come from it (obstacles already on the belt keep their
own env), the ambience fades into one of its ambiences (begin_ambience_fade() in game.nvgt; none there means the old one
just fades out), and the music finishes its song before taking the next from the new tracks (play_next_track()). */
void env_check()
{
if (env_switch_at < 0 or runtimer.elapsed < env_switch_at) return;
string[] choices = env_switch_choices();
if (choices.length() == 0)
{
env_switch_at = -1;
return;
}
current_env = choices[random(0, choices.length() - 1)];
announce_env(true);
current_surface = ""; // the old environment's surface may not exist here
pick_surface();
begin_ambience_fade(pick_ambience());
env_switch_at = runtimer.elapsed + random(env_switch_min_time, env_switch_max_time);
}
