/* Environments. Each folder in sounds/environments is a place with its own audio (tracks, ambiences), platforms
(surfaces, its ledge) and traps (<type>/countdown and <type>/general/<theme>); equipments, misc and ui stay shared. A
run plays in current_env, picked at random when it starts and switched every env_switch_min_time to
env_switch_max_time. Every obstacle remembers the environment it spawned in (its env field), so one still on the
belt after a switch keeps its own sounds. Nothing ever falls back to another environment: a type with no folder there
doesn't spawn there, and a missing clip just doesn't play. */
string current_env = "default";
/* The debug option's choice (source only): "" is "random", the normal random pick; otherwise the one environment a
debug run stays in. Cleared for endless and practice runs by play_game(). */
string debug_env = "";

// "game/environments/default/", the root of one environment's sounds.
string env_root(const string&in env)
{
return "game/environments/" + env + "/";
}
/* Which of an environment's folders a type lives in: doors, ladders, trampolines, slides and switches are transitions,
things that move you or that you move through; the transport_types are transports, things that travel the belt
toward you; every other type is a trap. */
const string[] transport_types = {"vehicles"};
string type_category(const string&in type)
{
if (type == "doors" or type == "ladders" or type == "trampolines" or type == "slides" or type == "switches") return "transitions";
if (transport_types.find(type) >= 0) return "transports";
return "traps";
}
/* The npc kinds the game has, each kept in an environment's traps/npc/<kind>/. Only these: a folder there the game
doesn't know is ignored, as any unknown type is. */
const string[] npc_types = {"animals", "insects"};
/* A type's folder under an environment's root (the root as env_root() gives it): "traps/hazards/", "transitions/doors/",
"transports/vehicles/", or for an npc kind "traps/npc/animals/". Its themes are in general/ below it, its warning cues
in countdown/. */
string type_path(const string&in root, const string&in type)
{
if (npc_types.find(type) >= 0) return root + "traps/npc/" + type + "/";
return root + type_category(type) + "/" + type + "/";
}
// Where one environment keeps a type's themes: "game/environments/default/traps/hazards/general/", or ".../transitions/doors/general/".
string trap_folder(const string&in env, const string&in type)
{
return type_path(env_root(env), type) + "general/";
}
// Every environment, naturally sorted, from the folders.
string[] env_names()
{
return get_pack_sound_folders("game/environments/*");
}
// True when an environment has at least one theme for a type, so the type can spawn there.
bool env_has_type(const string&in env, const string&in type)
{
return get_pack_sound_folders(trap_folder(env, type) + "*").length() > 0;
}
// A practice choice's trap folder: the three door choices all live in doors, everything else in its own name.
string practice_trap_type(const string&in choice)
{
if (choice == "fake_doors" or choice == "real_doors" or choice == "mixed_doors") return "doors";
return choice;
}
/* The environment a run starts in: a debug run's chosen one if the debug
option picked one; otherwise a random eligible one (env_eligible()). If nothing qualifies, an endless or timed run takes
any environment, and a practice run stays where it was (default at first). */
void pick_start_env()
{
string[] names = env_names();
if (run_difficulty < 0 and !practice_run and debug_env != "" and names.find(debug_env) >= 0)
{
current_env = debug_env;
return;
}
string[] candidates;
for (uint i = 0; i < names.length(); i++)
{
if (env_eligible(names[i])) candidates.insert_last(names[i]);
}
if (candidates.length() == 0 and run_difficulty >= 0) candidates = names; // a real run has to start somewhere
if (candidates.length() > 0) current_env = candidates[random(0, candidates.length() - 1)];
}
/* Switching. A run can move between environments unless a debug run is held in one; a practice run only
among environments that have its obstacle, and an endless or timed run only to one with an obstacle it could bring.
env_switch_at is the runtimer time of the next switch, or -1 when this run doesn't switch (nowhere else to go, or held
in one); an endless or timed run keeps it whenever there's more than one environment, trying again each time. */
double env_switch_at = -1;
/* Can this run be in this environment? Practice runs need their obstacle there (practice.nvgt: combinations need both of
some pair); endless and timed runs need an obstacle they could bring right now; free and debug runs go anywhere. */
bool env_eligible(const string&in env)
{
if (practice_run) return practice_env_ok(env, practice_choice);
if (run_difficulty >= 0) return env_has_obstacles(env);
return true;
}
/* The spawner's own test (available_obstacles()) for one place: an obstacle type that has joined the run on the
difficulty schedule, with a theme there. A ladder also needs a wall theme, and fake doors live in doors. Items, real
doors, slides and trampolines don't count, since they come alongside obstacles, not instead of them. */
bool env_has_obstacles(const string&in env)
{
for (uint i = 0; i < obstacle_types.length(); i++)
{
string type = obstacle_types[i];
if (!has_joined(type)) continue;
if (type == "ladders" and !env_has_type(env, "walls")) continue;
if (env_has_type(env, practice_trap_type(type))) return true;
}
return false;
}
// The environments this run could move to from here: every eligible one but the current one.
string[] env_switch_choices()
{
string[] names = env_names();
string[] choices;
if (run_difficulty < 0 and !practice_run and debug_env != "") return choices; // a debug run held in one environment
for (uint i = 0; i < names.length(); i++)
{
if (names[i] != current_env and env_eligible(names[i])) choices.insert_last(names[i]);
}
return choices;
}
bool env_switching()
{
return env_switch_at >= 0;
}
/* From start_run_audio(): the first switch's time, if this run switches at all, and the starting announcement, which is
only made when there's more than one environment. It interrupts the weapon draw's "fist equipped.", which is still in
the weapons buffer, so the environment is heard first. */
void start_env()
{
// A real run keeps its switch timer whenever there's somewhere else at all, since a place may gain obstacles as more join.
bool keeps_trying = run_difficulty >= 0 and env_names().length() > 1;
env_switch_at = (keeps_trying or env_switch_choices().length() > 0) ? runtimer.elapsed + random(env_switch_min_time, env_switch_max_time) : -1;
if (env_names().length() > 1) announce_env(true);
}
// "You've entered the custom environment." in the misc buffer, no sound.
void announce_env(bool interrupt)
{
speak_buffer("You've entered the " + current_env.replace("_", " ", true) + " environment.", "misc", interrupt ? tts_default_interrupt : false);
}
/* Every frame, from run_audio_check(): at the switch time, a random different environment. Footsteps change at once (a
new surface from the new platforms), new obstacles and countdowns come from it (obstacles already on the belt keep their
own env), the ambience fades into one of its ambiences (begin_ambience_fade() in game.nvgt; none there means the old one
just fades out), and the music finishes its song before taking the next from the new tracks (play_next_track()). */
void env_check()
{
if (env_switch_at < 0 or runtimer.elapsed < env_switch_at) return;
string[] choices = env_switch_choices();
if (choices.length() == 0)
{
if (run_difficulty < 0)
{
env_switch_at = -1; // practice and free runs: what's eligible never changes
return;
}
/* A real run with nowhere to go yet stays, tries again next time, and still moves the ambience on, since its own
ambience timer is off while switching is (game.nvgt). */
begin_ambience_fade(pick_ambience());
env_switch_at = runtimer.elapsed + random(env_switch_min_time, env_switch_max_time);
return;
}
current_env = choices[random(0, choices.length() - 1)];
announce_env(true);
current_surface = ""; // the old environment's surface may not exist here
pick_surface();
begin_ambience_fade(pick_ambience());
env_switch_at = runtimer.elapsed + random(env_switch_min_time, env_switch_max_time);
}
