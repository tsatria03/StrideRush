/* Game statistics (the statistics plan, dev, 2026-11-05, built from 2026-11-06). Every stat is kept twice:
the session (the current run, then kept as your last run) and the lifetime (every run added up). Only
endless runs count (run_difficulty 0 or more): practice and debug runs never touch them. The session is cleared when an
endless run starts, counted through it, and at the run's end, however it ends (a death, quit run, restart run, the
Escape question), it's added to the lifetime and both are saved to saves/game.srf with the last played date and
time (writegame()). There's no autosave. One set covers every difficulty (dev, 2026-11-06); the session remembers its
difficulty, and the lifetime counts runs per difficulty. The difficulty_runs unlock counts are separate (difficulty.nvgt).
A new stat is one more name in stat_keys plus a stat_add() where it happens; readgame() and writegame() pick it up. */
const string[] stat_keys = {"steps", "time_running", "top_speed", "lane_changes",
"hazards_jumped", "spikes_jumped", "mines_jumped", "projectiles_ducked", "force_fields_switched_off", "animals_scared", "barriers_dodged", "winds_dodged", "walls_broken", "real_walls_climbed", "ladders_broken", "ladder_falls", "fake_doors_broken", "real_doors_opened", "floor_breakers_repaired", "vehicles_destroyed", "vehicles_dodged", "combinations_cleared", "slides_ridden", "slide_items_caught", "trampoline_flights", "worn_bounces",
"damage_taken", "lives_lost", "caught_hazards", "caught_spikes", "caught_mines", "caught_projectiles", "caught_force_fields", "caught_animals", "caught_barriers", "caught_winds", "caught_walls", "caught_real_walls", "caught_doors", "caught_floor_breakers", "caught_vehicles", "vehicle_shots_taken",
"ammo_packs_picked_up", "ammo_packs_broken", "ammo_packs_used", "keys_picked_up", "keys_broken", "keys_used", "steel_shields_picked_up", "steel_shields_broken", "steel_shields_used",
"life_capsules_picked_up", "life_capsules_broken", "life_capsules_used", "health_potions_picked_up", "health_potions_broken", "health_potions_used", "player_teleporters_picked_up", "player_teleporters_broken", "player_teleporters_used",
"ground_powerups_collected", "air_powerups_collected", "melee_swings", "shots_fired", "reloads"};
// The lifetime also has runs_played and runs_<level> for each difficulty_names entry, which a session doesn't need.
dictionary session_stats, lifetime_stats;
bool stats_counting = false; // true only during an endless run
bool has_session = false; // false until the first endless run, so session statistics can say there's none yet
string last_run_difficulty = ""; // the session's difficulty, such as "easy"
string last_played_date = "", last_played_time = ""; // when the last endless run ended (get_date() and get_time())
/* What ended the run (Section 3): last_caught is the obstacle whose blow came last (stat_caught()), run_end_cause what
ended this run ("hazards", an obstacle type, or "" for a quit or restart), and session_end_cause the last run's, saved. */
string last_caught = "", run_end_cause = "", session_end_cause = "";
// Which kind caught you, where a type has kinds: "real" or "fake" for doors, "bird" or "dog" for animals (the practice guidance plan's Section 3).
string last_caught_kind = "";

int64 stat_value(dictionary@ stats, const string&in key)
{
int64 value = 0;
stats.get(key, value);
return value;
}
/* Adds to a session stat, only during an endless run. A practice run's clean passes go to practice_pass() first (the
practice locks plan, 2026-11-10), which counts them toward the next practice obstacle and never touches the stats. */
void stat_add(const string&in key, int64 amount = 1)
{
practice_pass(key);
if (!stats_counting) return;
session_stats.set(key, stat_value(session_stats, key) + amount);
}
/* Called just before an obstacle's blow (its take_damage()): counts caught_<type>, and remembers the type in case the blow
is fatal, for end_run_hit(). */
void stat_caught(const string&in type)
{
stat_add("caught_" + type);
last_caught = type;
last_caught_kind = ""; // a door or an animal sets its kind just after
if (type != "hazards") practice_hints_restart(); // a practice run's hints start over after a hit (practice_hints.nvgt)
}
// top_speed keeps its highest value in the lifetime instead of a total; every other stat adds up.
bool stat_is_highest(const string&in key)
{
return key == "top_speed";
}
// Every lifetime key: the stats, then runs played and the runs on each difficulty.
string[] lifetime_stat_keys()
{
string[] keys = stat_keys;
keys.insert_last("runs_played");
for (uint i = 0; i < difficulty_names.length(); i++) keys.insert_last("runs_" + difficulty_names[i]);
return keys;
}
// From start_run(), once the run's difficulty is set: an endless run starts a fresh session.
void start_run_stats()
{
stats_counting = run_difficulty >= 0;
if (!stats_counting) return;
session_stats.delete_all();
last_caught = "";
run_end_cause = "";
has_session = true;
last_run_difficulty = difficulty_names[run_difficulty];
}
/* From start_run() when the run loop returns: the stats measured at the end (steps, time
running and top speed), then the session added into the lifetime and everything saved. Does nothing outside an endless
run, or a second time for the same run. */
void end_run_stats()
{
if (!stats_counting) return;
session_stats.set("steps", int64(me.x));
session_stats.set("time_running", int64(runtimer.elapsed)); // runtimer pauses with the game, so paused time isn't counted
// The top speed in tenths of a step a second (C's measure); step_time only ever gets faster, so its last value is the top.
session_stats.set("top_speed", int64(round(10000.0 / step_time, 0)));
check_achievements(); // the run's final values, before counting stops
update_best_runs();
session_end_cause = run_end_cause;
stats_counting = false;
for (uint i = 0; i < stat_keys.length(); i++)
{
string key = stat_keys[i];
int64 value = stat_value(session_stats, key);
int64 old = stat_value(lifetime_stats, key);
// Plain int64 arithmetic, not extrafuncts' double max(), so the dictionary always holds int64 values.
if (stat_is_highest(key)) lifetime_stats.set(key, value > old ? value : old);
else lifetime_stats.set(key, old + value);
}
lifetime_stats.set("runs_played", stat_value(lifetime_stats, "runs_played") + 1);
string runs_key = "runs_" + last_run_difficulty;
lifetime_stats.set(runs_key, stat_value(lifetime_stats, runs_key) + 1);
last_played_date = get_date(true, false); // "Friday, November 6, 2026"
last_played_time = get_time(true, false); // "3:07 PM"
writegame();
}
// Clear game statistics (Section 5): the last run, as if no endless run had been played yet.
void clear_session_stats()
{
session_stats.delete_all();
has_session = false;
last_run_difficulty = "";
session_end_cause = "";
}
// Every total, the runs per difficulty and the last played date and time; the difficulty unlocks are separate.
void clear_lifetime_stats()
{
lifetime_stats.delete_all();
best_runs.delete_all(); // the best runs go with the lifetime (the achievements plan)
last_played_date = "";
last_played_time = "";
}
