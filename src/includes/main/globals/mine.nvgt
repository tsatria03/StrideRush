/* Mines: jump-over obstacles that do mine_damage (40) through take_damage(). A mine plays its spawn clip when it appears. When you reach
mine_arm_x(), a little before its countdown starts, it arms: light plays and its ticking loop starts, so light always
comes before the first warning cue. Stepping onto it while grounded plays explode, the mine's hit and the player's hit
all at once and stops its ticking, then costs lives; with none left the run ends with the player's death and the
tile's fall. Jumped over, it keeps ticking and fades out behind you like a hazard's loop (dev, 2026-11-02), until it's
dropped a spawn distance behind. No ledges, but a countdown on the normal floor before it, like a hazard's.
Same entity pattern as hazards: null-slot removal, reused slots, and only destroy_all_mines() shrinks the array. */
sound_pool minepool;
class mine
{
double x;
string theme;
string env; // the environment it spawned in, for its sounds after a switch (env.nvgt)
int pair = 0; // the combination it belongs to, or 0 (combo.nvgt)
bool armed = false;
bool spent = false; // passed or set off: it can never arm or hit again (a passed one keeps ticking until dropped)
int loopslot = -1;
double countdown_start;
}
mine@[] mines(0);

// Where a mine arms: mine_arm_lead_time before its countdown starts at the current speed, never under mine_arm_lead_min_tiles.
double mine_arm_x(mine@ mn)
{
return mn.countdown_start - int(max(mine_arm_lead_min_tiles, ceil(double(mine_arm_lead_time) / current_step_time())));
}
// countdown comes from the spawner, the same countdown_steps() a hazard's ledge uses.
void spawn_mine(double mx, string theme, int countdown)
{
mine mn;
mn.x = mx;
mn.theme = theme;
mn.env = current_env;
mn.pair = placing_pair;
mn.countdown_start = mx - countdown;
minepool.play_2d(get_pack_sound(trap_folder(current_env, "mines") + theme + "/*spawn*"), 0, me.x, 0, mx, false);
for (uint i = 0; i < mines.length(); i++)
{
if (@mines[i] == null)
{
@mines[i] = mn;
return;
}
}
mines.insert_last(mn);
}
// Runs once per step, right after the move: arms mines you're closing on, and checks contact.
void mine_check()
{
for (uint i = 0; i < mines.length(); i++)
{
if (@mines[i] == null) continue;
mine@ mn = mines[i];
if (!mn.armed and !mn.spent and me.x >= mine_arm_x(mn))
{
mn.armed = true;
minepool.play_2d(get_pack_sound(trap_folder(mn.env, "mines") + mn.theme + "/*light*"), 0, me.x, 0, mn.x, false);
mn.loopslot = minepool.play_2d(get_pack_sound(trap_folder(mn.env, "mines") + mn.theme + "/*loop*"), 0, me.x, 0, mn.x, true);
}
if (carried() and me.x == mn.x and !mn.spent)
{
mn.spent = true; // passed through on a slide, counting toward nothing (slide.nvgt)
continue;
}
if (me.x == mn.x and !mn.spent)
{
mn.spent = true;
if (!is_grounded())
{
stat_add("mines_jumped"); // in the air on its tile: cleared
pair_part_cleared(mn.pair);
}
if (is_grounded())
{
silence_mine(mn); // set off: the ticking stops at once
string explode_clip = get_pack_sound(trap_folder(mn.env, "mines") + mn.theme + "/*explode*");
string hit_clip = get_pack_sound(trap_folder(mn.env, "mines") + mn.theme + "/*hit*");
/* A fatal hit plays explode and the mine's hit through p (silence_run() would otherwise cut them off) and no player
hit, since end_run_hit() plays the player's death instead. */
stat_caught("mines");
pair_part_hit(mn.pair); // the statistics: what caught you, and what ended the run if it's fatal
int blow = take_damage(mine_damage); // a worn shield, else your health
if (blow == blow_fatal)
{
p.play_stationary(explode_clip, false);
p.play_stationary(hit_clip, false);
end_run_hit();
return;
}
// The mine goes off either way; with a shield worn its hit is layered on the shield's.
minepool.play_2d(explode_clip, 0, me.x, 0, mn.x, false);
minepool.play_2d(hit_clip, 0, me.x, 0, mn.x, false);
if (blow != blow_shielded) p.play_stationary(get_pack_sound("misc/player/*hit*"), false);
}
}
// Kept ticking until it's as far behind as obstacles appear ahead, so a jumped mine fades out behind you; then dropped.
if (me.x > mn.x + spawn_distance()) remove_mine(i);
}
}
// The countdown: one mines countdown warn cue per step before each mine (see play_countdown()). Runs once per step.
void mine_countdown()
{
for (uint i = 0; i < mines.length(); i++)
{
if (@mines[i] == null) continue;
play_countdown(minepool, "mines", mines[i].x, mines[i].countdown_start, mines[i].env);
}
}
// Stops a mine's ticking loop for good: it was set off, or it's being dropped behind you or cleared with the run.
void silence_mine(mine@ mn)
{
mn.spent = true;
mn.armed = false;
if (mn.loopslot > -1) minepool.destroy_sound(mn.loopslot);
mn.loopslot = -1;
}
void remove_mine(uint i)
{
if (i >= mines.length() or @mines[i] == null) return;
silence_mine(mines[i]);
@mines[i] = null;
}
// The only place allowed to shrink the array.
void destroy_all_mines()
{
for (uint i = 0; i < mines.length(); i++)
{
if (@mines[i] == null) continue;
silence_mine(mines[i]);
}
mines.resize(0);
}
