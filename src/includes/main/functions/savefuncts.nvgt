/* Loads the settings from settings.srf at startup: each value is read only if the file holds it, so a
setting added in a later version keeps its default for players whose file is older (dev, 2026-11-04). A missing file
loads as empty, leaving every default. */
void readpreffs()
{
st.load();
if(st.d.exists("menumusvolume"))
{
menumusvolume=st.read_int("menumusvolume");
}
if(st.d.exists("music_volume"))
{
music_volume=st.read_int("music_volume");
}
if(st.d.exists("ambience_volume"))
{
ambience_volume=st.read_int("ambience_volume");
}
if(st.d.exists("master_volume"))
{
master_volume=st.read_int("master_volume");
}
if(st.d.exists("heartbeat_volume"))
{
heartbeat_volume=st.read_int("heartbeat_volume");
}
if(st.d.exists("footstep_volume"))
{
footstep_volume=st.read_int("footstep_volume");
}
sound_master_volume = master_volume; // set at every launch
if(st.d.exists("menuwrap"))
{
menuwrap=st.read_bool("menuwrap");
}
if(st.d.exists("first_letter"))
{
first_letter=st.read_bool("first_letter");
}
if(st.d.exists("side_scrolling"))
{
side_scrolling=st.read_bool("side_scrolling");
}
if(st.d.exists("speak_menu_position"))
{
speak_menu_position=st.read_bool("speak_menu_position");
}
if(st.d.exists("hrtf"))
{
hrtf=st.read_bool("hrtf");
}
if(st.d.exists("behind_pitch"))
{
behind_pitch=st.read_bool("behind_pitch");
}
if(st.d.exists("loop_previews"))
{
loop_previews=st.read_bool("loop_previews");
}
if(st.d.exists("variant_descriptions"))
{
variant_descriptions=st.read_bool("variant_descriptions");
}
if(st.d.exists("auto_check_updates"))
{
auto_check_updates=st.read_bool("auto_check_updates");
}
if(st.d.exists("fademode"))
{
fademode=st.read_int("fademode");
}
if(st.d.exists("ask_quit_on_escape"))
{
ask_quit_on_escape=st.read_bool("ask_quit_on_escape");
}
if(st.d.exists("show_death_results"))
{
show_death_results=st.read_bool("show_death_results");
}
if(st.d.exists("show_death_copy_export"))
{
show_death_copy_export=st.read_bool("show_death_copy_export");
}
if(st.d.exists("tts_config"))
{
tts_load_config(st.read_string("tts_config"), tts);
}
/* The sound device is saved by name, since its place in the list can change as devices come and go.
One that's no longer there leaves the default device. */
if(st.d.exists("soundcard"))
{
soundcard=st.read_string("soundcard");
string[]@ devices=get_sound_output_devices();
devices.remove_at(0);
for(uint i=0; i<devices.length(); i++)
{
if(devices[i]==soundcard)
{
sound_output_device=i+1;
break;
}
}
}
}
/* Loads the game's progress from saves/game.srf at startup, the settings' way: each value only if the file holds it, so
a missing file or an older one leaves the rest at 0: a run count per difficulty level, under
"difficulty_runs_<level>" (the game menu refactor plan's Section 6), and the statistics (stats.nvgt, 2026-11-06). */
void readgame()
{
gs.load();
for (uint i = 0; i < difficulty_names.length(); i++)
{
string name = "difficulty_runs_" + difficulty_names[i];
if (gs.d.exists(name)) difficulty_runs[i] = gs.read_int(name);
}
// The statistics (stats.nvgt): lifetime stats as "stat_<key>", the last run's as "session_<key>", then the strings.
string[] keys = lifetime_stat_keys();
for (uint i = 0; i < keys.length(); i++)
{
if (gs.d.exists("stat_" + keys[i])) lifetime_stats.set(keys[i], gs.read_int64("stat_" + keys[i]));
}
for (uint i = 0; i < stat_keys.length(); i++)
{
if (gs.d.exists("session_" + stat_keys[i])) session_stats.set(stat_keys[i], gs.read_int64("session_" + stat_keys[i]));
}
if (gs.d.exists("has_session")) has_session = gs.read_bool("has_session");
if (gs.d.exists("last_run_difficulty")) last_run_difficulty = gs.read_string("last_run_difficulty");
if (gs.d.exists("last_played_date")) last_played_date = gs.read_string("last_played_date");
if (gs.d.exists("last_played_time")) last_played_time = gs.read_string("last_played_time");
if (gs.d.exists("session_end_cause")) session_end_cause = gs.read_string("session_end_cause");
// The achievements (achievements.nvgt, loaded first): each earned id as "ach_<id>", and each best run as "best_<stat>".
for (uint i = 0; i < achievements.length(); i++)
{
if (gs.d.exists("ach_" + achievements[i].id) and gs.read_bool("ach_" + achievements[i].id)) earned_achievements.set(achievements[i].id, true);
}
string[] best_stats = best_run_stats();
for (uint i = 0; i < best_stats.length(); i++)
{
if (gs.d.exists("best_" + best_stats[i])) best_runs.set(best_stats[i], gs.read_int64("best_" + best_stats[i]));
}
// The practice locks (practice.nvgt): each choice's passes as "practice_passes_<choice>", then the returning player check.
for (uint i = 0; i < practice_choices.length(); i++)
{
if (gs.d.exists("practice_passes_" + practice_choices[i])) practice_passes[i] = gs.read_int("practice_passes_" + practice_choices[i]);
}
if (gs.d.exists("practice_unlocks_checked")) practice_unlocks_checked = gs.read_bool("practice_unlocks_checked");
if (gs.d.exists("practice_combos_checked")) practice_combos_checked = gs.read_bool("practice_combos_checked");
if (gs.d.exists("practice_winds_checked")) practice_winds_checked = gs.read_bool("practice_winds_checked");
if (gs.d.exists("practice_trampolines_checked")) practice_trampolines_checked = gs.read_bool("practice_trampolines_checked");
if (gs.d.exists("practice_walls_checked")) practice_walls_checked = gs.read_bool("practice_walls_checked");
practice_returning_check(); // once per save, now that the difficulty runs and lifetime stats are read
practice_combos_check(); // once per save, after it (practice.nvgt)
practice_winds_check(); // and the winds check after that (practice.nvgt)
practice_trampolines_check(); // then the trampolines check (practice.nvgt)
practice_walls_check(); // and the real and mixed walls check (practice.nvgt)
}
// Writes the game's progress to saves/game.srf; called the moment a run count changes.
void writegame()
{
for (uint i = 0; i < difficulty_names.length(); i++)
{
gs.add("difficulty_runs_" + difficulty_names[i], difficulty_runs[i]);
}
string[] keys = lifetime_stat_keys();
for (uint i = 0; i < keys.length(); i++) gs.add("stat_" + keys[i], stat_value(lifetime_stats, keys[i]));
for (uint i = 0; i < stat_keys.length(); i++) gs.add("session_" + stat_keys[i], stat_value(session_stats, stat_keys[i]));
gs.add("has_session", has_session);
gs.add("last_run_difficulty", last_run_difficulty);
gs.add("last_played_date", last_played_date);
gs.add("last_played_time", last_played_time);
gs.add("session_end_cause", session_end_cause);
for (uint i = 0; i < achievements.length(); i++)
{
gs.add("ach_" + achievements[i].id, achievement_earned(achievements[i])); // false too, so clearing all progress takes it off the save
}
string[] best_stats = best_run_stats();
for (uint i = 0; i < best_stats.length(); i++)
{
int64 best = 0;
best_runs.get(best_stats[i], best);
gs.add("best_" + best_stats[i], best);
}
for (uint i = 0; i < practice_choices.length(); i++) gs.add("practice_passes_" + practice_choices[i], practice_passes[i]);
gs.add("practice_unlocks_checked", practice_unlocks_checked);
gs.add("practice_combos_checked", practice_combos_checked);
gs.add("practice_winds_checked", practice_winds_checked);
gs.add("practice_trampolines_checked", practice_trampolines_checked);
gs.add("practice_walls_checked", practice_walls_checked);
gs.save();
}
/* Writes every setting to settings.srf. Called whenever one changes: the menu music volume (form_menu) and the run
volumes (Home, End, Page Up and Page Down). Muting a buffer calls it too, and each buffer's mute is saved as
buffer_muted_<name> (dev, 2026-11-12, after CookieCraze's prefs; all and alerts can't be muted, so they're skipped). */
void writepreffs()
{
st.add("menumusvolume",menumusvolume);
st.add("music_volume",music_volume);
st.add("ambience_volume",ambience_volume);
st.add("master_volume",master_volume);
st.add("heartbeat_volume",heartbeat_volume);
st.add("footstep_volume",footstep_volume);
st.add("menuwrap",menuwrap);
st.add("first_letter",first_letter);
st.add("side_scrolling",side_scrolling);
st.add("speak_menu_position",speak_menu_position);
st.add("fademode",fademode);
st.add("hrtf",hrtf);
st.add("behind_pitch",behind_pitch);
st.add("loop_previews",loop_previews);
st.add("variant_descriptions",variant_descriptions);
st.add("auto_check_updates",auto_check_updates);
st.add("ask_quit_on_escape",ask_quit_on_escape);
st.add("show_death_results",show_death_results);
st.add("show_death_copy_export",show_death_copy_export);
st.add("tts_config",tts_dump_config(tts, true));
st.add("soundcard",soundcard);
for (uint i = 0; i < buffers.length(); i++)
{
if (buffers[i].name == "all" or buffers[i].name == "alerts") continue;
st.add("buffer_muted_" + buffers[i].name, buffers[i].muted);
}
st.save();
}
/* From main() in sdr.nvgt once the buffers exist (readpreffs() runs before they're made): each buffer muted last time is
muted again. A buffer with no saved mute, a new one or an older file, stays unmuted. */
void load_buffer_mutes()
{
for (uint i = 0; i < buffers.length(); i++)
{
if (buffers[i].name == "all" or buffers[i].name == "alerts") continue;
string key = "buffer_muted_" + buffers[i].name;
if (st.d.exists(key)) buffers[i].muted = st.read_bool(key);
}
}
