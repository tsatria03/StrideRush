/* Wildcard sound lookup. There are no sound packs, so sounds/ is the root and every path goes straight to its category.
A path like "main/ui/menu/*click*" matches click.ogg, click1.ogg, click2.ogg and so on, and a random match is played, so adding variations is just adding numbered files. */
string find_sound_in_disk(string soundname)
{
string[] snd=find_files(soundname);
if (snd.length()>0)
{
string[] a_path=string_split(soundname,"/",true);
string path=string_replace(soundname,a_path[a_path.length()-1],"",true);
return path+snd[random(0,snd.length()-1)];
}
else
return "";
}
string get_pack_sound(const string&in path)
{
return find_sound_in_disk("sounds/" + path);
}
// Lists the type folders under a category, e.g. get_pack_sound_folders("game/equipments/weapons/melee/*"), naturally sorted.
string[] get_pack_sound_folders(const string&in path)
{
string[] result = find_directories("sounds/" + path);
if (result.length() > 0) sort_naturally(result);
return result;
}
bool focus_muted = false; // the master volume is down for focus_mute_check()
/* Every frame, from the run loop and every menu, form and dialog (joystick_menu_frame()): with "Mute audio when the game
is not in focus" on, the master volume goes silent while another window has the focus, and back to master_volume on
return. Turning the setting off while away brings the sound back on the next frame. */
void focus_mute_check()
{
bool want = mute_audio_unfocused and !is_window_active();
if (want == focus_muted) return;
focus_muted = want;
sound_master_volume = want ? -100 : master_volume;
}
// With "Mute speech when the game is not in focus" on, true while another window has the focus, so speak() stays quiet.
bool speech_away()
{
return mute_speech_unfocused and !is_window_active();
}
