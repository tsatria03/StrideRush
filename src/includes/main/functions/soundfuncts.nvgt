/* Wildcard sound lookup. There are no sound packs, so sounds/ is the root and every path goes straight to its category.
A path like "ui/menu/*click*" matches click.ogg, click1.ogg, click2.ogg and so on, and a random match is played, so adding variations is just adding numbered files. */
string find_sound_in_disk(string soundname)
{
string[] snd=find_files(soundname);
if (snd.length()>0)
{
string[] a_path=string_split(soundname,"/",true);
string path=string_replace(soundname,a_path[a_path.length()-1],"",true);
return path+snd[random(0,snd.length()-1)];
}
else
return "";
}
string get_pack_sound(const string&in path)
{
return find_sound_in_disk("sounds/" + path);
}
// Lists the type folders under a category, e.g. get_pack_sound_folders("equipments/weapons/melee/*"), naturally sorted.
string[] get_pack_sound_folders(const string&in path)
{
string[] result = find_directories("sounds/" + path);
if (result.length() > 0) sort_naturally(result);
return result;
}
