/* The learn sounds menu (dev, 2026-11-05), in the game menu, after CaveDefender's learnsoundsmenu() and the dev's old
ToyMania one. Everything is built from the sound folders each time it opens, so a new obstacle theme, item or weapon
dropped into sdr/sounds shows up with no code change:
- items: common (equipments/items/common) and other (equipments/items/other, the keys)
- countdowns: one countdown per obstacle type (misc/trap/<type>)
- traps: one list per obstacle type (objects/traps/<type>, every theme's sounds)
- weapons: artillery and melee (equipments/weapons/<kind>)
Every menu and list is alphabetical, and every category says how many sound files it holds. Escape or back steps up a
level silently, out to the game menu too (they're all nested menus).
Labels are friendly names: the theme with underscores as spaces, then the sound's file name with its numbers dropped,
through learn_sound_name()'s swaps, and nothing about where the sound is used (dev). Numbered files are one entry that
plays one at random. Inside a list: Enter plays, moving away stops it, Space pauses or resumes, Shift+Page Up and Page
Down set the preview volume, and the menu's own sounds are silent. The last item picked in each menu is remembered until
the game closes. The two settings (dec.nvgt): loop_previews repeats a preview, variant_descriptions adds the variants
note. Countdowns play a step every start_step_time from the list's own loop, so you can keep moving while one plays. */
const int learn_countdown_gap = 1000; // a looping countdown's pause before it starts again
int learn_volume = 0; // the preview volume in decibels, 0 full; back to 0 whenever you leave a list
// Each menu's last picked item, by its path such as "learn/obstacles/barriers", until the game closes.
string[] learn_focus_paths;
int[] learn_focus_items;
int learn_get_focus(const string&in path)
{
int i = learn_focus_paths.find(path);
return i < 0 ? -1 : learn_focus_items[i];
}
void learn_set_focus(const string&in path, int item)
{
int i = learn_focus_paths.find(path);
if (i >= 0)
{
learn_focus_items[i] = item;
return;
}
learn_focus_paths.insert_last(path);
learn_focus_items.insert_last(item);
}
// One entry in a sound list: a sound and its numbered variants, or a countdown's steps.
class learn_sound
{
string label;
string theme; // its folder (or obstacle type), sorted naturally: bird, bird2 ... bird10
string sound_name; // its friendly sound name, sorted after the theme
string[] files; // Enter plays one of these at random
string[][] steps; // a countdown: each step's layers, played together
int count()
{
int total = files.length();
for (uint i = 0; i < steps.length(); i++) total += steps[i].length();
return total;
}
}
// A menu of smaller categories, or a list of sounds.
class learn_category
{
string name;
learn_category@[] subs;
learn_sound@[] sounds;
learn_category() {}
learn_category(const string&in n) { name = n; }
int count()
{
int total = 0;
for (uint i = 0; i < subs.length(); i++) total += subs[i].count();
for (uint i = 0; i < sounds.length(); i++) total += sounds[i].count();
return total;
}
}
// What's playing in a sound list: a plain preview, or a countdown stepped along by update().
class learn_preview
{
sound audio;
learn_sound@ countdown;
uint step = 0;
timer clock;
bool paused = false;
sound@[] layers;
sound@[] held; // the layers Space paused mid-cue
void start(learn_sound@ s)
{
stop();
if (s.steps.length() > 0)
{
@countdown = s;
step = 0;
clock.restart();
play_step();
return;
}
if (s.files.length() == 0) return;
audio.load(s.files[random(0, s.files.length() - 1)]);
audio.volume = learn_volume;
if (loop_previews) audio.play_looped();
else audio.play();
}
void play_step()
{
layers.resize(0);
for (uint i = 0; i < countdown.steps[step].length(); i++)
{
sound s;
s.load(countdown.steps[step][i]);
s.volume = learn_volume;
s.play();
layers.insert_last(s);
}
}
// Runs every pass of the list's loop: the next step once start_step_time has passed, and a looping countdown's restart.
void update()
{
if (@countdown == null or paused) return;
if (step + 1 < countdown.steps.length())
{
if (clock.elapsed < start_step_time) return;
step++;
clock.restart();
play_step();
return;
}
if (!loop_previews)
{
if (clock.elapsed >= start_step_time) @countdown = null; // its last cue plays out on its own
return;
}
if (clock.elapsed < start_step_time + learn_countdown_gap) return;
step = 0;
clock.restart();
play_step();
}
void toggle_pause()
{
if (@countdown != null)
{
paused = !paused;
if (paused)
{
clock.pause();
// Only the layers still sounding are paused, so resuming never replays a cue that had already finished.
held.resize(0);
for (uint i = 0; i < layers.length(); i++)
{
if (!layers[i].playing) continue;
layers[i].pause();
held.insert_last(layers[i]);
}
return;
}
clock.resume();
for (uint i = 0; i < held.length(); i++) held[i].play();
held.resize(0);
return;
}
if (!audio.active) return;
if (audio.playing)
{
audio.pause();
return;
}
if (loop_previews) audio.play_looped();
else audio.play();
}
void set_volume()
{
audio.volume = learn_volume;
for (uint i = 0; i < layers.length(); i++) layers[i].volume = learn_volume;
}
void stop()
{
audio.close();
for (uint i = 0; i < layers.length(); i++) layers[i].close();
layers.resize(0);
held.resize(0);
@countdown = null;
paused = false;
}
}
// The game menu's entry: builds every category from the folders, then browses them.
void learn_sounds_menu()
{
m.fade_music();
learn_category root("learn sounds menu");
learn_category items("items");
items.subs.insert_last(learn_folder_category("common", "equipments/items/common", ""));
items.subs.insert_last(learn_folder_category("other", "equipments/items/other", ""));
root.subs.insert_last(items);
learn_category cues("countdowns"); // "obstacle cues" until 2026-11-05 (dev: "countdowns and traps")
string[] cue_types = get_pack_sound_folders("misc/trap/*");
for (uint i = 0; i < cue_types.length(); i++) cues.sounds.insert_last(learn_countdown(cue_types[i]));
learn_sort_sounds(cues.sounds);
root.subs.insert_last(cues);
learn_category obstacles("traps"); // "obstacles" until 2026-11-05
string[] types = get_pack_sound_folders("objects/traps/*");
for (uint i = 0; i < types.length(); i++) obstacles.subs.insert_last(learn_folder_category(types[i].replace("_", " ", true), "objects/traps/" + types[i], ""));
root.subs.insert_last(obstacles);
learn_category weapons("weapons");
weapons.subs.insert_last(learn_folder_category("artillery", "equipments/weapons/artillery", "artillery"));
weapons.subs.insert_last(learn_folder_category("melee", "equipments/weapons/melee", "melee"));
root.subs.insert_last(weapons);
learn_sort_categories(root.subs);
for (uint i = 0; i < root.subs.length(); i++) learn_sort_categories(root.subs[i].subs);
learn_browse(root, "learn");
}
/* A menu of categories, each with its sound count, then back. Picking one opens it; when it returns you're back here on
it. Escape or back returns silently. */
void learn_browse(learn_category@ cat, const string&in path)
{
while (true)
{
setupmenu(false);
for (uint i = 0; i < cat.subs.length(); i++)
{
int n = cat.subs[i].count();
m.add_item(cat.subs[i].name + ": This category has a total of " + n + " sound" + (n == 1 ? "" : "s"), "" + i);
}
m.add_item("back", "back");
m.intro_text = path == "learn" ? "Learn sounds menu. Choose a category of sounds, then pick a sound to play it." : learn_upper_first(cat.name) + " menu.";
int start = learn_get_focus(path);
int mres = m.run(start, false, start >= 0);
if (mres < 0 or m.selected_item_id == "back") return;
learn_set_focus(path, mres);
learn_category@ sub = cat.subs[mres];
string sub_path = path + "/" + sub.name;
if (sub.subs.length() > 0) learn_browse(sub, sub_path);
else learn_sound_list(sub, sub_path);
}
}
// A list of sounds to play, then back, with the menu's own sounds silenced.
void learn_sound_list(learn_category@ cat, const string&in path)
{
setupmenu(false);
m.click_sound = "";
m.enter_sound = "";
m.edge_sound = "";
m.wrap_sound = "";
m.open_sound = "";
m.close_sound = "";
for (uint i = 0; i < cat.sounds.length(); i++) m.add_item(learn_list_label(cat, i), "" + i);
m.add_item("back", "back");
m.intro_text = learn_upper_first(cat.name) + " sounds. Choose a sound and press enter to play it.";
m.automatic_intro = false;
m.intro();
int start = learn_get_focus(path);
if (start >= 0 and start < m.item_count)
{
m.set_focused_item(start, false);
speak(m.get_item_id(start) == "back" ? "back" : learn_list_label(cat, start), false);
}
learn_preview preview;
while (true)
{
wait(5);
learn_preview_keys(preview);
preview.update();
/* Enter is handled here, not by the form (dev, 2026-11-05: holding Enter should keep restarting the sound, as in
ToyMania). The form waits for Enter to lift before it counts a press, so held Enter would play just once; here every
key repeat starts the sound again, the Windows keyboard's own repeat (dev, 2026-11-05: key_repeating, not key_down). A
pass with a repeat skips the form, and between repeats the form sees no repeat to act on, so it never starts its wait. */
if (key_repeating(KEY_RETURN) or key_repeating(KEY_NUMPAD_ENTER))
{
int pos = m.focused_item;
if (pos < 0) continue;
if (pos < int(cat.sounds.length()))
{
learn_set_focus(path, pos);
preview.start(cat.sounds[pos]);
continue;
}
// back: wait for Enter to lift, so it can't choose something in the menu this returns to
while (key_down(KEY_RETURN) or key_down(KEY_NUMPAD_ENTER)) wait(5);
learn_leave_list(preview, path);
return;
}
int old_pos = m.focused_item;
bool r = m.monitor();
if (m.focused_item != old_pos) preview.stop();
if (r) continue;
// A press the form caught after all (a tap too quick for the check above) still plays its sound.
if (m.selected_item >= 0 and m.selected_item < int(cat.sounds.length()))
{
learn_set_focus(path, m.selected_item);
preview.start(cat.sounds[m.selected_item]);
continue;
}
learn_leave_list(preview, path); // escape, or back
return;
}
}
// Leaving a list: the preview stops, the spot is remembered, and the preview volume goes back to full.
void learn_leave_list(learn_preview@ preview, const string&in path)
{
preview.stop();
if (m.focused_item >= 0) learn_set_focus(path, m.focused_item);
learn_volume = 0;
}
// Space pauses or resumes; Shift+Page Up and Page Down change the preview volume between -50 and 0.
void learn_preview_keys(learn_preview@ preview)
{
if (key_repeating(KEY_SPACE)) preview.toggle_pause();
if (!key_down(KEY_LSHIFT) and !key_down(KEY_RSHIFT)) return;
int change = 0;
if (key_repeating(KEY_PAGEUP) and learn_volume < 0) change = 1;
else if (key_repeating(KEY_PAGEDOWN) and learn_volume > min_volume) change = -1;
if (change == 0) return;
learn_volume += change;
preview.set_volume();
speak("Preview volume " + learn_volume + ".");
}
// The label as the list shows it, with the variants note when it applies.
string learn_list_label(learn_category@ cat, int index)
{
string label = cat.sounds[index].label;
if (variant_descriptions and cat.sounds[index].files.length() > 1) label += ". This sound has multiple variants.";
return label;
}
/* The category for the folders under path. A folder holding sound files is a theme, and its sounds join this list. A
folder holding only more folders is a group of its own, its own category: animals' birds and dogs (dev, 2026-11-05: "If
you click on the animals category, you should see birds and dogs as a category"), so a new kind of animal, or any
grouped folder later, gets its own menu. kind picks the weapon swaps ("artillery" or "melee"). */
learn_category@ learn_folder_category(const string&in name, const string&in path, const string&in kind)
{
learn_category cat(name);
string[] folders = get_pack_sound_folders(path + "/*");
for (uint i = 0; i < folders.length(); i++)
{
string folder = path + "/" + folders[i];
bool has_files = find_files("sounds/" + folder + "/*").length() > 0;
if (!has_files and get_pack_sound_folders(folder + "/*").length() > 0)
{
cat.subs.insert_last(learn_folder_category(folders[i].replace("_", " ", true), folder, kind));
continue;
}
learn_add_files(folder, folders[i], kind, cat.sounds);
learn_collect(folder, kind, cat.sounds);
}
learn_sort_sounds(cat.sounds);
learn_sort_categories(cat.subs);
return cat;
}
void learn_collect(const string&in path, const string&in kind, learn_sound@[]@ list)
{
string[] folders = get_pack_sound_folders(path + "/*");
for (uint i = 0; i < folders.length(); i++)
{
string folder = path + "/" + folders[i];
learn_add_files(folder, folders[i], kind, list);
learn_collect(folder, kind, list);
}
}
// One folder's files, grouped by name with their numbers dropped (hit1, hit2 and hit3 are one "hit" entry).
void learn_add_files(const string&in folder, const string&in theme, const string&in kind, learn_sound@[]@ list)
{
string[] names = find_files("sounds/" + folder + "/*");
for (uint i = 0; i < names.length(); i++)
{
string name = learn_sound_name(learn_base_name(names[i]), kind);
string label = learn_upper_first(theme.replace("_", " ", true) + " " + name);
learn_sound@ entry = null;
for (uint j = 0; j < list.length(); j++)
{
if (list[j].label == label)
{
@entry = list[j];
break;
}
}
if (@entry == null)
{
@entry = learn_sound();
entry.label = label;
entry.theme = theme;
entry.sound_name = name;
list.insert_last(entry);
}
entry.files.insert_last("sounds/" + folder + "/" + names[i]);
}
}
// A file name without its extension and trailing numbers: "hit2.ogg" is "hit".
string learn_base_name(const string&in filename)
{
string base = filename;
for (int i = int(base.length()) - 1; i > 0; i--)
{
if (base.substr(i, 1) != ".") continue;
base = base.substr(0, i);
break;
}
while (base.length() > 1)
{
string last = base.substr(base.length() - 1);
if (last < "0" or last > "9") break;
base = base.substr(0, base.length() - 1);
}
return base;
}
/* The friendly name for a sound's file name (dev: "I want friendly names, not internal names"). Anything not listed
reads as its file name, with underscores as spaces. */
string learn_sound_name(const string&in base, const string&in kind)
{
if (kind == "artillery" and base == "loop") return "bullet";
if (kind == "melee" and base == "fire") return "swing";
if (base == "get") return "pick up";
if (base == "ping") return "reloaded";
if (base == "spawn") return "appear";
if (base == "grant") return "unlock";
if (base == "deny") return "locked";
if (base == "jam") return "jammed";
if (base == "death") return "break";
if (base == "hurt") return "damage";
if (base == "light") return "light up";
if (base == "on") return "switched on";
if (base == "off") return "switched off";
if (base == "shell") return "shell casing";
if (base == "empty") return "empty click";
return base.replace("_", " ", true);
}
/* One obstacle type's countdown, the way play_countdown() plays it: five steps, each with every layer of a layered set
(warn<group>-<note>) or the plain warn<note>. */
learn_sound@ learn_countdown(const string&in type)
{
learn_sound s;
s.label = learn_upper_first(type.replace("_", " ", true) + " countdown");
s.theme = type;
s.sound_name = "countdown";
string folder = "misc/trap/" + type + "/";
bool layered = get_pack_sound(folder + "warn1-1*") != "";
for (int note = 1; note <= countdown_length; note++)
{
string[] notes;
if (layered)
{
int g = 1;
string layer = get_pack_sound(folder + "warn" + g + "-" + note + "*");
while (layer != "")
{
notes.insert_last(layer);
g++;
layer = get_pack_sound(folder + "warn" + g + "-" + note + "*");
}
}
else
{
string cue = get_pack_sound(folder + "warn" + note + "*");
if (cue != "") notes.insert_last(cue);
}
s.steps.insert_last(notes);
}
return s;
}
string learn_upper_first(const string&in text)
{
if (text.length() == 0) return text;
return text.substr(0, 1).upper() + text.substr(1);
}
/* Natural order, ignoring case (dev, 2026-11-05: "I saw bird and bird 10 in the animals category"): numbers count as
numbers, so bird, bird2 ... bird10 (the engine's natural_number_sort(), as sort_naturally() uses). Sounds sort by theme
first, then by sound name, since comparing whole labels would put "Bird10 loop" before "Bird loop" (a digit sorts before
the space). Insertion sorts; the lists are short. */
bool learn_sound_before(learn_sound@ a, learn_sound@ b)
{
string ta = a.theme.lower(), tb = b.theme.lower();
if (ta != tb) return natural_number_sort(ta, tb);
string sa = a.sound_name.lower(), sb = b.sound_name.lower();
if (sa == sb) return false;
return natural_number_sort(sa, sb);
}
bool learn_name_before(const string&in a, const string&in b)
{
string la = a.lower(), lb = b.lower();
if (la == lb) return false;
return natural_number_sort(la, lb);
}
void learn_sort_sounds(learn_sound@[]@ list)
{
for (uint i = 1; i < list.length(); i++)
{
learn_sound@ item = list[i];
int j = int(i) - 1;
while (j >= 0 and learn_sound_before(item, list[uint(j)]))
{
@list[uint(j + 1)] = list[uint(j)];
j--;
}
@list[uint(j + 1)] = item;
}
}
void learn_sort_categories(learn_category@[]@ list)
{
for (uint i = 1; i < list.length(); i++)
{
learn_category@ item = list[i];
int j = int(i) - 1;
while (j >= 0 and learn_name_before(item.name, list[uint(j)].name))
{
@list[uint(j + 1)] = list[uint(j)];
j--;
}
@list[uint(j + 1)] = item;
}
}
