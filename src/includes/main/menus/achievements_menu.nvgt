/* The achievements menu (the achievements plan's Section 2, dev, 2026-11-06), with
the two scopes as its only groups: view game achievements in the game menu opens achievements_menu(), session
achievements, lifetime achievements, back, each a list in achievements.ini's order (dev: "Keep them in the ini order"),
earned ones by name and the rest as "<name>, locked". Enter shows the description, or "This achievement is locked."
and its hint, then reopens on the same one. Escape or back steps back one menu silently. Progress numbers live in
achievement statistics instead (Section 3). */
void achievements_menu()
{
int focus = -1;
while (true)
{
setupmenu();
m.intro_text = "Achievements menu. " + earned_count("") + " of " + achievements.length() + " unlocked in total.";
m.add_item("session achievements", "session");
m.add_item("lifetime achievements", "lifetime");
m.add_item("back", "back");
int mres = m.run(focus, false, focus >= 0);
if (mres < 0 or m.selected_item_id == "back") return;
focus = mres;
achievement_list(m.selected_item_id);
}
}
// One scope's list: its intro counts it, enter tells you about the one you're on, and back or escape returns.
void achievement_list(const string&in scope)
{
int focus = -1;
while (true)
{
setupmenu();
achievement@[] shown;
for (uint i = 0; i < achievements.length(); i++)
{
if (achievements[i].scope != scope) continue;
shown.insert_last(achievements[i]);
m.add_item(achievement_earned(achievements[i]) ? achievements[i].name : achievements[i].name + ", locked", "" + (shown.length() - 1));
}
m.add_item("back", "back");
m.intro_text = (scope == "session" ? "Session" : "Lifetime") + " achievements. " + earned_count(scope) + " of " + shown.length() + " unlocked.";
int mres = m.run(focus, false, focus >= 0);
if (mres < 0 or m.selected_item_id == "back") return;
focus = mres;
achievement@ a = shown[int(parse_int(m.selected_item_id))];
if (achievement_earned(a)) dlgmessage_return(achievement_description(a));
else dlgmessage_return("This achievement is locked. " + a.hint);
}
}
// How many achievements of a scope ("" for both) are earned.
int earned_count(const string&in scope)
{
int count = 0;
for (uint i = 0; i < achievements.length(); i++)
{
if (scope != "" and achievements[i].scope != scope) continue;
if (achievement_earned(achievements[i])) count += 1;
}
return count;
}
/* Achievement statistics (the achievements plan's Section 3, dev, 2026-11-06), first in the statistics menu: how many are
unlocked, then every achievement in the ini's order, session ones first: "lane changer, complete", with no number, since
a cleared stat would show less than it needed (dev, 2026-11-07: "super confusing indeed. Do not add a number after it."),
or "side stepper, incomplete, 120 of 500 lane changes". An incomplete session one shows your best single run ("door to
door, incomplete, best record, 2 of 3 real doors opened"). Lowercase, like the other stat lines; time in minutes and top
speed in steps a second, as the file writes them. */
string[] achievement_stat_lines()
{
string[] lines;
lines.insert_last(stat_line("achievements unlocked", earned_count("") + " of " + achievements.length()));
string[] scopes = {"session", "lifetime"};
for (uint s = 0; s < scopes.length(); s++)
{
for (uint i = 0; i < achievements.length(); i++)
{
achievement@ a = achievements[i];
if (a.scope != scopes[s]) continue;
if (achievement_earned(a))
{
lines.insert_last(a.name.lower() + ", complete");
continue;
}
int64 value = 0;
if (a.scope == "session") best_runs.get(a.stat, value);
else value = stat_value(lifetime_stats, a.stat);
string amount = stat_amount_text(a.stat, value) + " of " + stat_threshold_text(a) + stat_unit(a.stat, a.threshold);
if (a.scope == "session") amount = "best record, " + amount; // your best single run (dev, 2026-11-07: "best run," at first, then "I like best record better")
lines.insert_last(a.name.lower() + ", incomplete, " + amount);
}
}
return lines;
}
// A stat's value as a number in the file's friendly units: minutes for time, steps a second for top speed.
string stat_amount_text(const string&in stat, int64 value)
{
if (stat == "time_running") return thousands_text(value / 60000);
if (stat == "top_speed") return tenths_text(value);
return thousands_text(value);
}
// An achievement's threshold as the file wrote it.
string stat_threshold_text(achievement@ a)
{
if (a.stat == "top_speed") return tenths_text(a.threshold);
return thousands_text(int64(a.shown));
}
// The words after a stat's number, " lane change" or " lane changes" by the amount, with its leading space.
string stat_unit(const string&in stat, int64 amount)
{
string[] keys = {"steps", "time_running", "top_speed", "lane_changes", "hazards_jumped", "spikes_jumped", "mines_jumped", "projectiles_ducked", "force_fields_switched_off", "animals_scared", "barriers_dodged", "walls_broken", "fake_doors_broken", "real_doors_opened", "damage_taken", "lives_lost", "caught_hazards", "caught_spikes", "caught_mines", "caught_projectiles", "caught_force_fields", "caught_animals", "caught_barriers", "caught_walls", "caught_doors", "ground_powerups_collected", "air_powerups_collected", "melee_swings", "shots_fired", "reloads"};
string[] one = {"step", "minute", "steps a second", "lane change", "hazard jumped", "spike jumped", "mine jumped", "projectile ducked", "force field switched off", "animal scared", "barrier dodged", "wall broken", "fake door broken", "real door opened", "damage", "life lost", "hazard fall", "spike hit", "mine hit", "projectile hit", "force field hit", "animal run-in", "barrier hit", "wall crash", "door crash", "ground powerup collected", "air powerup collected", "melee swing", "gunshot fired", "gun reload"};
string[] many = {"steps", "minutes", "steps a second", "lane changes", "hazards jumped", "spikes jumped", "mines jumped", "projectiles ducked", "force fields switched off", "animals scared", "barriers dodged", "walls broken", "fake doors broken", "real doors opened", "damage", "lives lost", "hazard falls", "spike hits", "mine hits", "projectile hits", "force field hits", "animal run-ins", "barrier hits", "wall crashes", "door crashes", "ground powerups collected", "air powerups collected", "melee swings", "gunshots fired", "gun reloads"};
int i = keys.find(stat);
if (i >= 0) return " " + (amount == 1 ? one[i] : many[i]);
// The six items, "<item>_used": "1 ammo pack used", "10 ammo packs used".
if (stat.length() > 5 and stat.substr(stat.length() - 5) == "_used")
{
string item = stat.substr(0, stat.length() - 5).replace("_", " ", true);
if (amount == 1 and item.substr(item.length() - 1) == "s") item = item.substr(0, item.length() - 1);
return " " + item + " used";
}
return " " + stat.replace("_", " ", true);
}
/* The game menu's three "all progress" items (the achievements plan's Section 4, dev, 2026-11-06: "I want them always
shown"), clear, copy and export of game progresses, for statistics and achievements together. Clearing never
touches the difficulty unlocks, and doesn't stamp the last played date. */
void clear_all_progress()
{
setupmenu();
m.intro_text = "Are you sure you want to clear all of your game progresses? This action cannot be undone.";
m.add_item("Yes", "yes");
m.add_item("No", "no");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "no")
{
speak("canceled");
return;
}
clear_session_stats();
clear_lifetime_stats(); // the best records go with it
earned_achievements.delete_all();
writegame();
m.fade_music(); // only for the dialog (dev, 2026-11-07: "It should only fade for the clear/copy/export dlg messages")
temp.play_stationary(get_pack_sound("ui/other/*complete*"), false);
dlgmessage_return("Game progresses cleared.");
m.play_music(); // and back again once the dialog closes (dev, 2026-11-07)
}
/* Everything as one text, built once from the menus' own lines: "Achievement stats:" (every
achievement, complete or incomplete with its progress), then "Session stats:" and "Lifetime stats:". */
string all_progress_text()
{
string text = "Achievement stats:\r\n";
string[] lines = achievement_stat_lines();
for (uint i = 0; i < lines.length(); i++) text += "- " + lines[i] + "\r\n";
return text + "\r\n" + all_stats_text();
}
void copy_all_progress()
{
clipboard_copy_text(all_progress_text());
m.fade_music(); // only for the dialog (dev, 2026-11-07: "It should only fade for the clear/copy/export dlg messages")
temp.play_stationary(get_pack_sound("ui/other/*copied*"), false);
dlgmessage_return("All game progresses have been copied to your clipboard.");
m.play_music(); // and back again once the dialog closes (dev, 2026-11-07)
}
// Into APPDATA_DIR's stats folder as player_progresses.txt, beside player_statistics.txt, replacing any older copy.
void export_all_progress()
{
string folder = APPDATA_DIR + "stats";
if (!directory_exists(folder)) directory_create(folder);
file f;
if (!f.open(folder + "/player_progresses.txt", "wb"))
{
m.fade_music();
dlgmessage_return("Unable to export the game progresses.");
m.play_music(); // and back again once the dialog closes (dev, 2026-11-07)
return;
}
f.write(all_progress_text());
f.close();
m.fade_music(); // only for the dialog (dev, 2026-11-07: "It should only fade for the clear/copy/export dlg messages")
temp.play_stationary(get_pack_sound("ui/other/*export*"), false);
dlgmessage_return("All game progresses have been exported to stats/player_progresses.txt.");
m.play_music(); // and back again once the dialog closes (dev, 2026-11-07)
}
