/* The shop: slash or F8 during an endless, debug or free run pauses it and opens this menu, with the open and close sounds through
dlgplay(), so enter skips either one. It lists its categories, each category its things with their prices, and each
thing a pack menu: buy 1, 5, 10, 25, 50 or 100, then buy all you can afford. An endless run spends your saved coins and a
debug or free run its own temporary ones (shown_coins()), and what you buy goes straight into your inventory, or for the character category, straight onto you. Its sounds go through temp, which keeps playing while the run is paused. */
const string shop_sounds = "main/misc/store/";

// Endless, debug and free runs have the shop; debug and free runs are the ones with no difficulty that aren't practice.
bool shop_available()
{
return stats_counting or (run_difficulty < 0 and !practice_run);
}
// The run_input() key: pauses the run, runs the shop until you leave it, and resumes.
void shop_menu()
{
pause_game();
speak("You're now entering the player shop.");
dlgplay(get_pack_sound(shop_sounds + "*open*"));
int focus = -1;
while (true)
{
setupmenu();
m.intro_text = "Welcome to the player shop. What would you like to buy?";
m.add_item("character", "character");
m.add_item("items", "items");
m.add_item("specials", "specials");
m.add_item("back", "back");
int mres = m.run(focus, false, focus >= 0);
if (mres < 0 or m.selected_item_id == "back") break;
focus = mres;
if (m.selected_item_id == "character") shop_open_character();
else if (m.selected_item_id == "specials") shop_category_menu("specials", shop_special_ids, shop_special_prices);
else shop_category_menu("items", shop_item_ids, shop_item_prices);
}
speak("You're now exiting the player shop.");
dlgplay(get_pack_sound(shop_sounds + "*close*"));
resume_game();
}
// The character category, with shield defence only while you carry or wear a shield.
void shop_open_character()
{
string[] ids;
int[] prices;
for (uint i = 0; i < shop_character_ids.length(); i++)
{
if (shop_character_ids[i] == "shield_defence" and !has_a_shield()) continue;
ids.insert_last(shop_character_ids[i]);
prices.insert_last(shop_character_prices[i]);
}
shop_category_menu("character", ids, prices);
}
// What a category's things are called in its errors.
string shop_things(const string&in word)
{
return word == "character" ? "character upgrades" : word;
}
/* A category's list, each thing with its price and how many you can afford; word is "character", "items" or "specials".
It always opens, so you can see what you're saving for, and choosing something you can't afford gives an error. */
void shop_category_menu(const string&in word, const string[]&in ids, const int[]&in prices)
{
int focus = -1;
while (true)
{
setupmenu();
m.intro_text = learn_upper_first(word) + " menu.";
for (uint i = 0; i < ids.length(); i++)
{
m.add_item(item_display_name(ids[i]) + ", costs " + coins_text(prices[i]) + ". You can buy " + thousands_text(shown_coins() / prices[i]) + ".", ids[i]);
}
m.add_item("back", "back");
int mres = m.run(focus, false, focus >= 0);
if (mres < 0 or m.selected_item_id == "back") return;
focus = mres;
int at = ids.find(m.selected_item_id);
string name = item_display_name(ids[at]);
if (shown_coins() < prices[at])
{
shop_error(shown_coins() < 1 ? "Error! You have no gold coins to buy " + shop_things(word) + " with!" : "Error! You can't afford 1 " + shop_item_words(name, 1) + "!");
continue;
}
shop_pack_menu(ids[at], prices[at]);
}
}
// One thing's packs. A purchase keeps you on its line, unless it was buy all or you can't afford another.
void shop_pack_menu(const string&in item, int price)
{
string name = item_display_name(item);
string news = ""; // the last purchase, said as the menu comes back
int focus = -1;
while (true)
{
int64 can_buy = shown_coins() / price;
setupmenu();
m.intro_text = learn_upper_first(name) + " menu. You have " + coins_text(shown_coins()) + " available to spend.";
m.first_speech = news; // a purchase is said once, and the intro stays as it is
for (uint i = 0; i < shop_pack_sizes.length(); i++)
{
int size = shop_pack_sizes[i];
m.add_item("Buy " + size + " " + shop_item_words(name, size) + " for " + coins_text(int64(size) * price), "" + size);
}
m.add_item("Buy all " + shop_item_words(name, 2) + " for " + coins_text(can_buy * price), "all");
m.add_item("back", "back");
int mres = m.run(focus, false, focus >= 0 and news == ""); // a purchase's message is enough on its own
if (mres < 0 or m.selected_item_id == "back") return;
focus = mres;
bool buy_all = m.selected_item_id == "all";
int64 amount = buy_all ? can_buy : int64(parse_int(m.selected_item_id));
int64 cost = amount * price;
if (cost > shown_coins())
{
shop_error("Error! You can't afford " + thousands_text(amount) + " " + shop_item_words(name, amount) + "!");
news = "";
continue;
}
spend_coins(cost);
if (is_player_stat(item)) add_player_stat(item, int(amount));
else give_item(item, int(amount));
shop_purchase_sounds(cost);
news = "You bought " + thousands_text(amount) + " " + shop_item_words(name, amount) + " for " + coins_text(cost) + ".";
if (buy_all or shown_coins() < price)
{
dlgmessage_return(news);
return;
}
}
}
// "health potion" for one, "health potions" for more; "attack point" and "attack points" for a stat.
string shop_item_words(const string&in name, int64 amount)
{
if (name == "attack" or name == "defence" or name == "shield defence") return name + (amount == 1 ? " point" : " points");
return amount == 1 ? name : name + "s";
}
// Not enough coins: the error sound and its dialog.
void shop_error(const string&in message)
{
temp.play_stationary(get_pack_sound(shop_sounds + "*error*"), false);
dlgmessage_return(message);
}
// A purchase: a random buy and the coin sound for what it cost, together.
void shop_purchase_sounds(int64 cost)
{
temp.play_stationary(get_pack_sound(shop_sounds + "*buy*"), false);
uint band = 0;
while (band < shop_coin_steps.length() and cost >= shop_coin_steps[band]) band += 1;
temp.play_stationary("sounds/" + shop_sounds + shop_coin_sounds[band] + ".ogg", false); // the exact file, since coin1 is also the start of coin1000
}
