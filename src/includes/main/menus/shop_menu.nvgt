/* The shop: slash or F8 during an endless, debug or free run pauses it and opens this menu, with the open and close sounds through
dlgplay(), so enter skips either one. It lists its categories, each category its things with their prices, and each
thing a pack menu: buy 1, 5, 10, 25, 50 or 100, then buy all you can afford. Its categories are tabs in one menu. An endless run spends your saved coins and a
debug or free run its own temporary ones (shown_coins()), and what you buy goes straight into your inventory, or for the character category, straight onto you. Its sounds go through temp, which keeps playing while the run is paused. */
const string shop_sounds = "main/misc/store/";

// Endless, debug and free runs have the shop; debug and free runs are the ones with no difficulty that aren't practice.
bool shop_available()
{
return stats_counting or (run_difficulty < 0 and !practice_run);
}
// The shop's tabs, in order, as shop_menu() adds them.
const string[] shop_tab_names = {"character", "items", "specials"};
/* The run_input() key: pauses the run, runs the shop until you leave it, and resumes. The shop is one tabbed menu
(form_menu's tabs): character, items and specials, each listing its things with their prices and how many you can afford.
There are no back items; escape leaves. Leaving a pack menu rebuilds the tabs, so the counts are current, and brings you
back to the same tab and line; each visit opens on the character tab. Every tab always lists what it sells, so you can see
what you're saving for, and choosing something you can't afford gives an error. */
void shop_menu()
{
pause_game();
speak("You're now entering the player shop.");
dlgplay(get_pack_sound(shop_sounds + "*open*"));
int saved_tab = 0;
int saved_pos = -1;
bool first = true;
while (true)
{
string[][] tab_ids(shop_tab_names.length());
int[][] tab_prices(shop_tab_names.length());
shop_tab_contents(tab_ids, tab_prices);
setupmenu();
m.intro_text = first ? "Welcome to the player shop. What would you like to buy?" : ""; // coming back, only the line you're on
m.tab_caption = "Category";
// Written out one by one, in order, so the language template finds the names.
int[] tabs;
tabs.insert_last(m.add_tab("character"));
tabs.insert_last(m.add_tab("items"));
tabs.insert_last(m.add_tab("specials"));
for (uint t = 0; t < tabs.length(); t++)
{
int tab = tabs[t];
for (uint i = 0; i < tab_ids[t].length(); i++)
{
m.add_item_to_tab(tab, item_display_name(tab_ids[t][i]) + ", costs " + coins_text(tab_prices[t][i]) + ". You can buy " + thousands_text(shown_coins() / tab_prices[t][i]) + ".", tab_ids[t][i]);
}
}
if (saved_tab > 0) m.set_active_tab_silent(saved_tab);
int mres = first ? m.run(-1, true, false) : m.run(saved_pos, false, saved_pos >= 0); // first, "character menu List"
first = false;
if (mres < 0) break;
saved_tab = m.selected_tab;
if (saved_tab < 0 or saved_tab >= int(tabs.length())) saved_tab = 0;
saved_pos = mres;
int at = tab_ids[saved_tab].find(m.selected_item_id);
if (at < 0) continue;
string item = tab_ids[saved_tab][at];
int price = tab_prices[saved_tab][at];
string name = item_display_name(item);
if (shown_coins() < price)
{
shop_error(shown_coins() < 1 ? "Error! You have no gold coins to buy " + shop_things(shop_tab_names[saved_tab]) + " with!" : "Error! You can't afford 1 " + shop_item_words(name, 1) + "!");
continue;
}
shop_pack_menu(item, price);
}
speak("You're now exiting the player shop.");
dlgplay(get_pack_sound(shop_sounds + "*close*"));
resume_game();
}
// Each tab's things and prices, in shop_tab_names' order; the character tab has the shield stats only while you have a shield.
void shop_tab_contents(string[][]@ ids, int[][]@ prices)
{
for (uint i = 0; i < shop_character_ids.length(); i++)
{
if (is_shield_stat(shop_character_ids[i]) and !has_a_shield()) continue;
ids[0].insert_last(shop_character_ids[i]);
prices[0].insert_last(shop_character_prices[i]);
}
ids[1] = shop_item_ids;
prices[1] = shop_item_prices;
ids[2] = shop_special_ids;
prices[2] = shop_special_prices;
}
// What a tab's things are called in its errors.
string shop_things(const string&in word)
{
return word == "character" ? "character upgrades" : word;
}
// One thing's packs, with no back item: escape returns to its tab. A purchase keeps you on its line, unless it was buy all or you can't afford another.
void shop_pack_menu(const string&in item, int price)
{
string name = item_display_name(item);
string news = ""; // the last purchase, said as the menu comes back
int focus = -1;
while (true)
{
int64 can_buy = shown_coins() / price;
setupmenu();
m.intro_text = learn_upper_first(name) + " menu. You have " + coins_text(shown_coins()) + " available to spend.";
m.first_speech = news; // a purchase is said once, and the intro stays as it is
for (uint i = 0; i < shop_pack_sizes.length(); i++)
{
int size = shop_pack_sizes[i];
m.add_item("Buy " + size + " " + shop_item_words(name, size) + " for " + coins_text(int64(size) * price), "" + size);
}
m.add_item("Buy all " + shop_item_words(name, 2) + " for " + coins_text(can_buy * price), "all");
int mres = m.run(focus, false, focus >= 0 and news == ""); // a purchase's message is enough on its own
if (mres < 0) return;
focus = mres;
bool buy_all = m.selected_item_id == "all";
int64 amount = buy_all ? can_buy : int64(parse_int(m.selected_item_id));
int64 cost = amount * price;
if (cost > shown_coins())
{
shop_error("Error! You can't afford " + thousands_text(amount) + " " + shop_item_words(name, amount) + "!");
news = "";
continue;
}
spend_coins(cost);
if (is_player_stat(item)) add_player_stat(item, int(amount));
else give_item(item, int(amount));
shop_purchase_sounds(cost);
news = "You bought " + thousands_text(amount) + " " + shop_item_words(name, amount) + " for " + coins_text(cost) + ".";
if (buy_all or shown_coins() < price)
{
dlgmessage_return(news);
return;
}
}
}
// "health potion" for one, "health potions" for more; "attack point" and "attack points" for a stat.
string shop_item_words(const string&in name, int64 amount)
{
if (name == "attack" or name == "defence" or name == "max health" or name == "max shield strength" or name == "shield defence") return name + (amount == 1 ? " point" : " points");
return amount == 1 ? name : name + "s";
}
// Not enough coins: the error sound and its dialog.
void shop_error(const string&in message)
{
temp.play_stationary(get_pack_sound(shop_sounds + "*error*"), false);
dlgmessage_return(message);
}
// A purchase: a random buy and the coin sound for what it cost, together.
void shop_purchase_sounds(int64 cost)
{
temp.play_stationary(get_pack_sound(shop_sounds + "*buy*"), false);
uint band = 0;
while (band < shop_coin_steps.length() and cost >= shop_coin_steps[band]) band += 1;
temp.play_stationary("sounds/" + shop_sounds + shop_coin_sounds[band] + ".ogg", false); // the exact file, since coin1 is also the start of coin1000
}
