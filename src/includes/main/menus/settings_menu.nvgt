/* The settings menu: one audio form window with a Category tab panel, and save settings and cancel buttons. From the main menu it has General, Game, Joystick, Keyboard,
Menu, Sound and Speech; F2 during a run shows only Game, Menu and Speech (ingame), so keys and buttons can't be rebound mid-run.

The checkboxes only take effect on save settings; cancel or escape says "canceled" and drops them. The buttons that
open something of their own (reset, the sound device, the voice, the key screens) act and save at once. Opening one
rebuilds the window afterwards, so the unsaved ticks are carried in locals across the rebuild. */
void settingsmenu(bool ingame = false)
{
bool new_ask = ask_quit_on_escape, new_wrap = menuwrap, new_letter = first_letter, new_position = speak_menu_position, new_scroll = side_scrolling, new_fade = fademode == 1, new_behind = behind_pitch, new_hrtf = hrtf, new_loop = loop_previews, new_variants = variant_descriptions, new_updates = auto_check_updates, new_death_results = show_death_results, new_death_copy = show_death_copy_export, new_practice_retry = show_practice_retry, new_vibration = joystick_vibration;
// The volume sliders, in dB from min_volume to 0, shown as 0 to 100 percent.
int new_amb_vol = ambience_volume, new_step_vol = footstep_volume, new_mus_vol = music_volume, new_heart_vol = heartbeat_volume, new_menu_vol = menumusvolume, new_master_vol = master_volume;
int new_health_fmt = health_format, new_shield_fmt = shield_format; // the readout formats (lives.nvgt's format_readout())
int tab_shown = 0; // opens on the first tab: General from the main menu, Game from F2
while (true)
{
audio_form setform;
setform.create_window("Settings", false);
int tabs = setform.create_tab_panel("Category");
if (!ingame) setform.add_list_item(tabs, "General");
setform.add_list_item(tabs, "Game");
if (!ingame) setform.add_list_item(tabs, "Joystick");
if (!ingame) setform.add_list_item(tabs, "Keyboard");
setform.add_list_item(tabs, "Menu");
if (!ingame) setform.add_list_item(tabs, "Sound");
setform.add_list_item(tabs, "Speech");
int tab_general = ingame ? -1 : 0;
int tab_game = ingame ? 0 : 1;
int tab_joystick = ingame ? -1 : 2;
int tab_keyboard = ingame ? -1 : 3;
int tab_menu = ingame ? 1 : 4;
int tab_sound = ingame ? -1 : 5;
int tab_speech = ingame ? 2 : 6;
int vibration_box = -1, joy_rebind_btn = -1, joy_view_btn = -1, reset_btn = -1, view_btn = -1, rebind_btn = -1, fade_box = -1, hrtf_box = -1, device_btn = -1, loop_box = -1, menu_vol_slider = -1, master_vol_slider = -1, updates_box = -1;
if (!ingame)
{
// The General tab: the startup update check, then reset; checkboxes always come before buttons in a tab.
updates_box = setform.create_checkbox("Enable checking for game updates at startup", new_updates);
setform.assign_to_tab(updates_box, tabs, tab_general);
reset_btn = setform.create_button("&Reset settings");
setform.assign_to_tab(reset_btn, tabs, tab_general);
}
// The Game tab: the volume sliders first (ambience, footsteps, heartbeat, music), then the checkboxes.
int amb_vol_slider = setform.create_slider("Game ambience volume,", new_amb_vol + 100, 0, 100, "percent", 1);
setform.assign_to_tab(amb_vol_slider, tabs, tab_game);
int step_vol_slider = setform.create_slider("Game footsteps volume,", new_step_vol + 100, 0, 100, "percent", 1);
setform.assign_to_tab(step_vol_slider, tabs, tab_game);
int heart_vol_slider = setform.create_slider("Game heartbeat volume,", new_heart_vol + 100, 0, 100, "percent", 1);
setform.assign_to_tab(heart_vol_slider, tabs, tab_game);
int mus_vol_slider = setform.create_slider("Game music volume,", new_mus_vol + 100, 0, 100, "percent", 1);
setform.assign_to_tab(mus_vol_slider, tabs, tab_game);
// After the sliders, the two readout format lists, each choice with an example; then the checkboxes.
int health_fmt_list = setform.create_list("Health format,", 3);
setform.add_list_item(health_fmt_list, "Percentage. Example, 70 percent.");
setform.add_list_item(health_fmt_list, "Amount. Example, 350 of 500.");
setform.add_list_item(health_fmt_list, "Percentage and amount. Example, 70 percent, 350 of 500.");
setform.set_list_position(health_fmt_list, new_health_fmt);
setform.assign_to_tab(health_fmt_list, tabs, tab_game);
int shield_fmt_list = setform.create_list("Shield format,", 3);
setform.add_list_item(shield_fmt_list, "Percentage. Example, 80 percent.");
setform.add_list_item(shield_fmt_list, "Amount. Example, 320 of 400 endurance.");
setform.add_list_item(shield_fmt_list, "Percentage and amount. Example, 80 percent, 320 of 400 endurance.");
setform.set_list_position(shield_fmt_list, new_shield_fmt);
setform.assign_to_tab(shield_fmt_list, tabs, tab_game);
// After the lists: the "Enable" checkbox first (behind pitch decrease), then the Escape question.
int behind_box = setform.create_checkbox("Enable behind pitch decrease", new_behind);
setform.assign_to_tab(behind_box, tabs, tab_game);
int ask_box = setform.create_checkbox("Ask to quit the run when pressing escape", new_ask);
setform.assign_to_tab(ask_box, tabs, tab_game);
// The three death settings after the Escape question, all on by default.
int death_results_box = setform.create_checkbox("Show session results after dying", new_death_results);
setform.assign_to_tab(death_results_box, tabs, tab_game);
int death_copy_box = setform.create_checkbox("Show copy and export options after dying", new_death_copy);
setform.assign_to_tab(death_copy_box, tabs, tab_game);
int practice_retry_box = setform.create_checkbox("Show retry options after a practice death", new_practice_retry);
setform.assign_to_tab(practice_retry_box, tabs, tab_game);
if (!ingame)
{
// The Joystick tab, before Keyboard, built the same way: rebind first, then view.
vibration_box = setform.create_checkbox("Enable joystick vibration", new_vibration); // the Joystick tab's one checkbox, before its buttons
setform.assign_to_tab(vibration_box, tabs, tab_joystick);
joy_rebind_btn = setform.create_button("Rebind &joystick buttons");
setform.assign_to_tab(joy_rebind_btn, tabs, tab_joystick);
joy_view_btn = setform.create_button("View current joystick b&indings");
setform.assign_to_tab(joy_view_btn, tabs, tab_joystick);
rebind_btn = setform.create_button("Re&bind keyboard keys");
setform.assign_to_tab(rebind_btn, tabs, tab_keyboard);
view_btn = setform.create_button("&View current keyboard bindings");
setform.assign_to_tab(view_btn, tabs, tab_keyboard);
}
int wrap_box = setform.create_checkbox("Enable wrapping in menus", new_wrap);
setform.assign_to_tab(wrap_box, tabs, tab_menu);
int letter_box = setform.create_checkbox("Enable first letter navigation in menus", new_letter);
setform.assign_to_tab(letter_box, tabs, tab_menu);
int position_box = setform.create_checkbox("Enable position information in menus", new_position);
setform.assign_to_tab(position_box, tabs, tab_menu);
int scroll_box = setform.create_checkbox("Enable side scrolling in menus", new_scroll);
setform.assign_to_tab(scroll_box, tabs, tab_menu);
// The learn sounds menu's labels, after side scrolling.
int variants_box = setform.create_checkbox("Enable variant descriptions in the learn sounds menu", new_variants);
setform.assign_to_tab(variants_box, tabs, tab_menu);
if (!ingame)
{
/* The Sound tab: the global volumes first (menu music and master, global rather than in-game, so here and not on the
Game tab), then HRTF, volume fading, the learn sounds menu's looping, and the device button last. */
menu_vol_slider = setform.create_slider("Menu music volume,", new_menu_vol + 100, 0, 100, "percent", 1);
setform.assign_to_tab(menu_vol_slider, tabs, tab_sound);
master_vol_slider = setform.create_slider("Master game volume,", new_master_vol + 100, 0, 100, "percent", 1);
setform.assign_to_tab(master_vol_slider, tabs, tab_sound);
hrtf_box = setform.create_checkbox("Enable global HRTF support", new_hrtf); // main menu only
setform.assign_to_tab(hrtf_box, tabs, tab_sound);
fade_box = setform.create_checkbox("Enable global volume fading", new_fade);
setform.assign_to_tab(fade_box, tabs, tab_sound);
loop_box = setform.create_checkbox("Enable looping of previewed sounds", new_loop);
setform.assign_to_tab(loop_box, tabs, tab_sound);
device_btn = setform.create_button("Select sound &device. Currently set to " + soundcard);
setform.assign_to_tab(device_btn, tabs, tab_sound);
}
int voice_btn = setform.create_button("&Configure voice");
setform.assign_to_tab(voice_btn, tabs, tab_speech);
int preview_btn = setform.create_button("&Preview voice");
setform.assign_to_tab(preview_btn, tabs, tab_speech);
int save_btn = setform.create_button("&Save settings", true);
int cancel_btn = setform.create_button("&Cancel", false, true);
setform.set_list_position(tabs, tab_shown);
setform.focus(tabs);
while (true)
{
wait(5);
setform.monitor();
// Keep the unsaved ticks and the open tab, so a rebuild after a sub-screen shows them as they were.
new_ask = setform.is_checked(ask_box);
new_wrap = setform.is_checked(wrap_box);
new_letter = setform.is_checked(letter_box);
new_position = setform.is_checked(position_box);
new_scroll = setform.is_checked(scroll_box);
if (fade_box != -1) new_fade = setform.is_checked(fade_box);
new_behind = setform.is_checked(behind_box);
if (hrtf_box != -1) new_hrtf = setform.is_checked(hrtf_box);
if (loop_box != -1) new_loop = setform.is_checked(loop_box);
new_variants = setform.is_checked(variants_box);
if (updates_box != -1) new_updates = setform.is_checked(updates_box);
new_death_results = setform.is_checked(death_results_box);
new_death_copy = setform.is_checked(death_copy_box);
new_practice_retry = setform.is_checked(practice_retry_box);
if (vibration_box != -1) new_vibration = setform.is_checked(vibration_box);
int health_fmt_now = setform.get_list_position(health_fmt_list);
if (health_fmt_now >= 0) new_health_fmt = health_fmt_now;
int shield_fmt_now = setform.get_list_position(shield_fmt_list);
if (shield_fmt_now >= 0) new_shield_fmt = shield_fmt_now;
new_amb_vol = int(setform.get_slider(amb_vol_slider)) - 100;
new_mus_vol = int(setform.get_slider(mus_vol_slider)) - 100;
new_heart_vol = int(setform.get_slider(heart_vol_slider)) - 100;
new_step_vol = int(setform.get_slider(step_vol_slider)) - 100;
if (menu_vol_slider != -1) new_menu_vol = int(setform.get_slider(menu_vol_slider)) - 100;
if (master_vol_slider != -1) new_master_vol = int(setform.get_slider(master_vol_slider)) - 100;
int tab_now = setform.get_list_position(tabs);
if (tab_now >= 0) tab_shown = tab_now;
if (setform.is_pressed(cancel_btn))
{
speak("canceled");
return;
}
if (setform.is_pressed(save_btn))
{
ask_quit_on_escape = new_ask;
menuwrap = new_wrap;
first_letter = new_letter;
speak_menu_position = new_position;
side_scrolling = new_scroll;
if (!ingame) fademode = new_fade ? 1 : 0;
if (!ingame) loop_previews = new_loop;
variant_descriptions = new_variants;
if (!ingame) auto_check_updates = new_updates;
show_death_results = new_death_results;
show_death_copy_export = new_death_copy;
show_practice_retry = new_practice_retry;
if (!ingame) joystick_vibration = new_vibration;
health_format = new_health_fmt;
shield_format = new_shield_fmt;
apply_volume_settings(new_amb_vol, new_mus_vol, new_heart_vol, new_menu_vol, new_master_vol, new_step_vol); // volumes change only on save
behind_pitch = new_behind;
apply_behind_pitch();
if (!ingame)
{
hrtf = new_hrtf;
sound_global_hrtf = hrtf; // takes effect for sounds from now on
}
writepreffs();
dlgmessage_return("Settings saved."); // a dialog you dismiss, like Preview voice
return;
}
if (reset_btn != -1 && setform.is_pressed(reset_btn))
{
if (confirm_reset_settings())
{
reset_settings();
new_ask = ask_quit_on_escape;
new_wrap = menuwrap;
new_letter = first_letter;
new_position = speak_menu_position;
new_scroll = side_scrolling;
new_fade = fademode == 1;
new_behind = behind_pitch;
new_hrtf = hrtf;
new_loop = loop_previews;
new_variants = variant_descriptions;
new_updates = auto_check_updates;
new_death_results = show_death_results;
new_death_copy = show_death_copy_export;
new_practice_retry = show_practice_retry;
new_vibration = joystick_vibration;
new_health_fmt = health_format;
new_shield_fmt = shield_format;
new_amb_vol = ambience_volume;
new_mus_vol = music_volume;
new_heart_vol = heartbeat_volume;
new_step_vol = footstep_volume;
new_menu_vol = menumusvolume;
new_master_vol = master_volume;
}
break;
}
if (joy_view_btn != -1 && setform.is_pressed(joy_view_btn))
{
view_joystick_bindings();
break;
}
if (joy_rebind_btn != -1 && setform.is_pressed(joy_rebind_btn))
{
rebind_joystick_action();
break;
}
if (view_btn != -1 && setform.is_pressed(view_btn))
{
view_keyboard_bindings();
break;
}
if (rebind_btn != -1 && setform.is_pressed(rebind_btn))
{
rebind_keyboard_action();
break;
}
if (device_btn != -1 && setform.is_pressed(device_btn))
{
choose_sound_device();
break;
}
if (setform.is_pressed(preview_btn))
{
dlgmessage_return("This is your current voice configuration."); // a dialog, so the form doesn't talk over it
break;
}
if (setform.is_pressed(voice_btn))
{
tts_config(tts, true);
writepreffs(); // the voice window has its own OK and cancel, so whatever it kept is saved now
break;
}
}
}
}
// Yes then No; anything but Yes says "canceled".
bool confirm_reset_settings()
{
setupmenu();
m.intro_text = "Are you sure you want to reset all settings to their defaults?";
m.add_item("Yes", "yes");
m.add_item("No", "no");
int mres = m.run();
if (mres >= 0 and m.selected_item_id == "yes") return true;
speak("canceled");
return false;
}
/* Puts every setting back to its default and saves, then restarts the game, so every default, the sound device and HRTF included, starts fresh. Key bindings are left alone: they live in keyboard.ini,
not settings.srf. Reset is only offered from the main menu, so no run is ever cut off. */
void reset_settings()
{
menumusvolume = menu_music_start_volume;
music_volume = music_start_volume;
ambience_volume = ambience_start_volume;
heartbeat_volume = 0;
footstep_volume = 0;
master_volume = 0;
sound_master_volume = master_volume;
menuwrap = false;
first_letter = false;
side_scrolling = false;
speak_menu_position = false;
fademode = 1;
ask_quit_on_escape = true;
show_death_results = true;
show_death_copy_export = true;
show_practice_retry = true;
joystick_vibration = true;
health_format = 0;
shield_format = 0;
behind_pitch = true;
apply_behind_pitch();
hrtf = true;
sound_global_hrtf = hrtf;
loop_previews = true;
variant_descriptions = true;
auto_check_updates = false; // off by default
for (uint i = 0; i < buffers.length(); i++) buffers[i].muted = false; // every buffer unmuted, saved below
use_sr = true;
tts.set_rate(0);
tts.set_pitch(0);
tts.set_volume(100);
soundcard = "Default";
sound_output_device = 1;
writepreffs();
dlgmessage_return("Settings reset.");
restart_game(); // "restarting", then a fresh copy of the game; if that fails, its alert shows and the settings stay open
}
/* The device chooser: every output device but the first entry, which isn't a real device. The choice takes
effect and is saved at once; escape steps back to the settings silently (a nested menu). */
void choose_sound_device()
{
string[]@ devices = get_sound_output_devices();
devices.remove_at(0);
setupmenu();
for (uint i = 0; i < devices.length(); i++)
{
// Each one says whether it's the device in use: "Speakers, active" or "Headphones, inactive".
m.add_item(devices[i] + (i + 1 == uint(sound_output_device) ? ", active" : ", inactive"), devices[i]);
}
m.intro_text = "Choose a sound device you'd like to use in the game.";
int mres = m.run();
if (mres < 0 or mres >= int(devices.length())) return;
soundcard = devices[mres];
sound_output_device = mres + 1;
writepreffs();
dlg("Sound device set to " + soundcard + ".");
}
/* Save settings's volumes, each in dB from min_volume to 0: the run's ambience and music, heard at once if a run is
playing them (F2 mid-run), the heartbeat from its next beat, the footsteps from the next step, the menu music, and the
master through the engine's sound_master_volume. writepreffs() after it saves them with the rest. */
void apply_volume_settings(int amb, int mus, int heart, int menu, int master, int step)
{
heartbeat_volume = heart; // the next beat plays at it
footstep_volume = step; // and the next step
ambience_volume = amb;
if (ambslot > -1) ambpool.update_sound_start_values(ambslot, 0, ambience_volume, 100);
music_volume = mus;
if (musslot > -1) muspool.update_sound_start_values(musslot, 0, music_volume, 100);
menumusvolume = menu;
if (m.music.playing) m.music.set_volume(menumusvolume);
master_volume = master;
sound_master_volume = master_volume;
}
