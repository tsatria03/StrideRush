/* The statistics menus (the statistics plan's Section 2, dev, 2026-11-05 and 2026-11-06),
as loops instead of menus calling each other. View game statistics
in the game menu opens statistics_menu(): session statistics, lifetime statistics, and (Section 5) clear game statistics,
copy all game statistics to clipboard and export all game statistics to file, always shown (dev: "I do not want these
buttons to be hidable"), then back. Each stat menu is one stat per item, then back. Pressing enter on a stat keeps you
on it; escape or back steps back one menu silently, as every nested menu does. */
void statistics_menu()
{
int focus = -1;
while (true)
{
setupmenu();
m.intro_text = "Statistics menu. You can view the stats from your last endless run, or your totals across all of them here.";
m.add_item("achievement statistics", "achievements"); // first (dev, 2026-11-06), the achievements plan's Section 3
m.add_item("session statistics", "session");
m.add_item("lifetime statistics", "lifetime");
m.add_item("clear game statistics", "clear");
m.add_item("copy all game statistics to clipboard", "copy");
m.add_item("export all game statistics to file", "export");
m.add_item("back", "back");
int mres = m.run(focus, false, focus >= 0);
if (mres < 0 or m.selected_item_id == "back") return;
focus = mres;
if (m.selected_item_id == "achievements") show_stat_lines("Achievement statistics menu. You can see your progress on every achievement here.", achievement_stat_lines());
else if (m.selected_item_id == "clear") clear_stats_menu();
else if (m.selected_item_id == "copy") copy_all_stats();
else if (m.selected_item_id == "export") export_all_stats();
else if (m.selected_item_id == "session") show_stat_lines("Session statistics menu. You can see the stats from your last endless run here.", session_stat_lines());
else show_stat_lines("Lifetime statistics menu. You can see your total stats across all of your endless runs here.", lifetime_stat_lines());
}
}
/* The pause menu's session statuses (dev, 2026-11-13): what the status keys say, as "label, value" lines like the
session results, in every kind of run. Session results are the run's statistics; these are where you stand right now. */
string[] session_status_lines()
{
string[] lines;
int percent = int(round(100.0 * player_health / player_hp, 0));
lines.insert_last(stat_line("health", percent + " percent, " + (lives == 1 ? "1 life" : lives + " lives")));
lines.insert_last(stat_line("shield", shield_worn ? int(round(100.0 * shield_hp_left / shield_hp, 0)) + " percent" : "none"));
lines.insert_last(stat_line("lane", lane_names[current_lane].lower()));
lines.insert_last(stat_line("environment", current_env.replace("_", " ", true)));
if (run_difficulty < 0 and !practice_run) lines.insert_last(stat_line("speed", current_step_time() + " milliseconds per step"));
else lines.insert_last(stat_line("speed", tenths_text(int(round(10000.0 / current_step_time(), 0))) + " steps a second"));
int steps = int(me.x);
lines.insert_last(stat_line("distance", thousands_text(steps) + (steps == 1 ? " step" : " steps")));
lines.insert_last(stat_line("time", time_phrase(runtimer.elapsed)));
lines.insert_last(stat_line("heart rate", heart_rate() + " beats per minute"));
return lines;
}
/* One stat menu: the lines and back; enter on a line reopens it on that line (with its intro),
and escape or back returns. */
void show_stat_lines(const string&in intro, string[]@ lines)
{
int focus = -1;
while (true)
{
setupmenu();
m.intro_text = intro;
for (uint i = 0; i < lines.length(); i++) m.add_item(lines[i], "");
m.add_item("back", "back");
int mres = m.run(focus, false, focus >= 0);
if (mres < 0 or m.selected_item_id == "back") return;
focus = mres;
}
}
/* The stat lines (dev, 2026-11-06: "I wish it looked something like ... total runs played, x"): each is a short label,
a comma, then the value, all lowercase like the other menus. Lifetime labels start with "total" (dev: "I like it
prepended"), except top speed and the last played date and time; session labels drop it. Copy and export reuse them. */
string stat_line(const string&in label, const string&in value)
{
return label + ", " + value;
}
/* The last endless run, or a single line before the first one (dev, 2026-11-05: "both"). With live, the run going on now
(the session results plan, 2026-11-07): steps ran, time ran and top speed read live, and no "death outcome" yet. */
string[] session_stat_lines(bool live = false)
{
string[] lines;
if (!has_session)
{
lines.insert_last("You haven't played an endless run yet.");
return lines;
}
dictionary@ stats = @session_stats;
if (live) @stats = live_session_stats();
lines.insert_last(stat_line("difficulty", last_run_difficulty));
// Right after the difficulty (dev, 2026-11-07), so a death's results say what ended the run first; last until then.
if (!live) lines.insert_last(stat_line("death outcome", end_cause_text(session_end_cause)));
add_running_lines(lines, stats, false);
add_obstacle_and_hit_lines(lines, stats, false);
return lines;
}
/* A copy of the session so far, with the three stats end_run_stats() only measures at the end filled in live, as
achievements read them. A copy, so the real session is never touched mid-run. */
dictionary@ live_session_stats()
{
dictionary@ stats = dictionary();
for (uint i = 0; i < stat_keys.length(); i++) stats.set(stat_keys[i], stat_value(session_stats, stat_keys[i]));
stats.set("steps", live_session_value("steps"));
stats.set("time_running", live_session_value("time_running"));
stats.set("top_speed", live_session_value("top_speed"));
return stats;
}
// Every endless run added up, starting with when the last one ended.
string[] lifetime_stat_lines()
{
string[] lines;
lines.insert_last(stat_line("last played date", last_played_date == "" ? "never" : last_played_date));
lines.insert_last(stat_line("last played time", last_played_time == "" ? "never" : last_played_time));
lines.insert_last(stat_line("total runs played", thousands_text(stat_value(lifetime_stats, "runs_played"))));
for (uint i = 0; i < difficulty_names.length(); i++)
{
lines.insert_last(stat_line("total " + difficulty_names[i] + " runs", thousands_text(stat_value(lifetime_stats, "runs_" + difficulty_names[i]))));
}
add_running_lines(lines, lifetime_stats, true);
add_obstacle_and_hit_lines(lines, lifetime_stats, true);
return lines;
}
// A count stat's line: "total " first in the lifetime, then the label and the count.
void add_count_line(string[]@ lines, dictionary@ stats, bool lifetime, const string&in label, const string&in key)
{
lines.insert_last(stat_line((lifetime ? "total " : "") + label, thousands_text(stat_value(stats, key))));
}
// The Running lines: steps, time, top speed (never "total", as it's the highest, not a sum) and lanes.
void add_running_lines(string[]@ lines, dictionary@ stats, bool lifetime)
{
string total = lifetime ? "total " : "";
add_count_line(lines, stats, lifetime, "steps ran", "steps");
lines.insert_last(stat_line(total + "time ran", time_phrase(stat_value(stats, "time_running"))));
lines.insert_last(stat_line("top speed", tenths_text(stat_value(stats, "top_speed")) + " steps a second"));
add_count_line(lines, stats, lifetime, "lanes changed", "lane_changes");
}
/* Section 3's Obstacles and Hits lines, for either menu: what you got past, then damage and lives, then how often each
kind of obstacle caught you, every kind even at 0, like every other stat (dev, 2026-11-06: "always show them for
consistency. Pluse i want to see what I'm working toard."; they were hidden until they happened at first). */
void add_obstacle_and_hit_lines(string[]@ lines, dictionary@ stats, bool lifetime)
{
add_count_line(lines, stats, lifetime, "hazards jumped", "hazards_jumped");
add_count_line(lines, stats, lifetime, "spikes jumped", "spikes_jumped");
add_count_line(lines, stats, lifetime, "mines jumped", "mines_jumped");
add_count_line(lines, stats, lifetime, "projectiles ducked", "projectiles_ducked");
add_count_line(lines, stats, lifetime, "force fields switched off", "force_fields_switched_off");
add_count_line(lines, stats, lifetime, "animals scared", "animals_scared");
add_count_line(lines, stats, lifetime, "barriers dodged", "barriers_dodged");
add_count_line(lines, stats, lifetime, "fake walls broken", "walls_broken");
add_count_line(lines, stats, lifetime, "real walls climbed", "real_walls_climbed"); // the ladders plan, 2026-11-12
add_count_line(lines, stats, lifetime, "ladders broken", "ladders_broken");
add_count_line(lines, stats, lifetime, "ladder falls", "ladder_falls");
add_count_line(lines, stats, lifetime, "fake doors broken", "fake_doors_broken");
add_count_line(lines, stats, lifetime, "real doors opened", "real_doors_opened");
add_count_line(lines, stats, lifetime, "floor breakers repaired", "floor_breakers_repaired"); // the floor breakers plan, 2026-11-13
add_count_line(lines, stats, lifetime, "damage taken", "damage_taken");
add_count_line(lines, stats, lifetime, "lives lost", "lives_lost");
string[] kinds = {"hazards", "spikes", "mines", "projectiles", "force_fields", "animals", "barriers", "walls", "real_walls", "doors", "floor_breakers"};
string[] label = {"times fell into hazards", "times hit by spikes", "times hit by mines", "times hit by projectiles", "times hit by force fields", "times run into by animals", "times hit by barriers", "fake walls crashed into", "real walls crashed into", "doors crashed into", "times fell into floor breakers"};
for (uint i = 0; i < kinds.length(); i++)
{
add_count_line(lines, stats, lifetime, label[i], "caught_" + kinds[i]);
}
add_item_and_weapon_lines(lines, stats, lifetime);
}
/* Section 4's Items and Weapons lines: each inventory item picked up, broken (run onto, landed on or hit) and used, then
powerups, then swings, shots and reloads. */
void add_item_and_weapon_lines(string[]@ lines, dictionary@ stats, bool lifetime)
{
string[] kinds = {"ammo_packs", "keys", "steel_shields", "life_capsules", "health_potions", "player_teleporters"};
for (uint i = 0; i < kinds.length(); i++)
{
string name = kinds[i].replace("_", " ", true);
add_count_line(lines, stats, lifetime, name + " picked up", kinds[i] + "_picked_up");
add_count_line(lines, stats, lifetime, name + " broken", kinds[i] + "_broken");
add_count_line(lines, stats, lifetime, name + " used", kinds[i] + "_used");
}
add_count_line(lines, stats, lifetime, "ground powerups collected", "ground_powerups_collected");
add_count_line(lines, stats, lifetime, "air powerups collected", "air_powerups_collected"); // the flight ones (dev, 2026-11-06)
add_count_line(lines, stats, lifetime, "melee swings", "melee_swings");
add_count_line(lines, stats, lifetime, "gunshots fired", "shots_fired"); // "gun" in both (dev, 2026-11-06)
add_count_line(lines, stats, lifetime, "gun reloads", "reloads");
}
// How the last run ended: the obstacle that killed you, or "none" for a quit or restart (dev, 2026-11-07: "death outcome, none when you didn't actually die"; "" also covers a session saved before Section 3).
string end_cause_text(const string&in cause)
{
if (cause == "hazards") return "falling into a hazard";
if (cause == "spikes") return "a spike hit";
if (cause == "mines") return "a mine going off";
if (cause == "projectiles") return "a projectile hit";
if (cause == "force_fields") return "a force field hit";
if (cause == "animals") return "an animal running into you";
if (cause == "barriers") return "a barrier hit";
if (cause == "walls") return "crashing into a fake wall";
if (cause == "real_walls") return "crashing into a real wall";
if (cause == "ladder_collapse") return "a ladder collapsing on you";
if (cause == "ladder_fall") return "falling off a ladder";
if (cause == "doors") return "crashing into a door";
if (cause == "floor_breakers") return "falling into a floor breaker";
return "none";
}
// A whole number with a comma every three digits: 4000 reads "4,000".
string thousands_text(int64 amount)
{
string digits = "" + (amount < 0 ? -amount : amount);
string result = "";
int count = 0;
for (int i = int(digits.length()) - 1; i >= 0; i--)
{
if (count > 0 and count % 3 == 0) result = "," + result;
result = digits.substr(i, 1) + result;
count += 1;
}
return amount < 0 ? "-" + result : result;
}
/* Clear game statistics (Section 5): which stats, then Yes or No. Yes clears and saves them, plays complete
and says so; No or escape on the question says "canceled"; escape or back on the choice steps back silently. Clearing
both resets everything. The difficulty unlocks are never touched. */
void clear_stats_menu()
{
while (true)
{
setupmenu();
m.intro_text = "Choose which game statistics to clear. This won't clear your achievements or change which difficulties you've unlocked.";
m.add_item("session stats", "session");
m.add_item("lifetime stats", "lifetime");
m.add_item("session and lifetime stats", "both");
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return;
string which = m.selected_item_id;
string name = which == "both" ? "session and lifetime" : which;
setupmenu();
m.intro_text = "Are you sure you want to clear your " + name + " stats? This action cannot be undone.";
m.add_item("Yes", "yes");
m.add_item("No", "no");
mres = m.run();
if (mres < 0 or m.selected_item_id == "no")
{
speak("canceled");
continue;
}
if (which != "lifetime") clear_session_stats();
if (which != "session") clear_lifetime_stats();
writegame();
m.fade_music(); // only for the dialog (dev, 2026-11-07: "It should only fade for the clear/copy/export dlg messages")
temp.play_stationary(get_pack_sound("ui/other/*complete*"), false);
dlgmessage_return("Your " + name + " stats have been cleared.");
m.play_music(); // and back again once the dialog closes (dev, 2026-11-07)
return;
}
}
/* Both lists as one text, for copy and export, built from the very lines the menus show:
"Session stats:", a dash before each line, a blank line, then "Lifetime stats:". */
string all_stats_text()
{
/* Session and lifetime stats only: achievement stats belong to the game menu's copy and export of all progress
(achievements_menu.nvgt's all_progress_text(); dev, 2026-11-07). */
string text = "Session stats:\r\n";
string[] lines = session_stat_lines();
for (uint i = 0; i < lines.length(); i++) text += "- " + lines[i] + "\r\n";
text += "\r\nLifetime stats:\r\n";
lines = lifetime_stat_lines();
for (uint i = 0; i < lines.length(); i++) text += "- " + lines[i] + "\r\n";
return text;
}
void copy_all_stats()
{
clipboard_copy_text(all_stats_text());
m.fade_music(); // only for the dialog (dev, 2026-11-07: "It should only fade for the clear/copy/export dlg messages")
temp.play_stationary(get_pack_sound("ui/other/*copied*"), false);
dlgmessage_return("All game statistics have been copied to your clipboard.");
m.play_music(); // and back again once the dialog closes (dev, 2026-11-07)
}
// Into APPDATA_DIR's stats folder as player_statistics.txt, replacing any older copy.
void export_all_stats()
{
string folder = APPDATA_DIR + "stats";
if (!directory_exists(folder)) directory_create(folder);
file f;
if (!f.open(folder + "/player_statistics.txt", "wb"))
{
m.fade_music();
dlgmessage_return("Unable to export the game statistics.");
m.play_music(); // and back again once the dialog closes (dev, 2026-11-07)
return;
}
f.write(all_stats_text());
f.close();
m.fade_music(); // only for the dialog (dev, 2026-11-07: "It should only fade for the clear/copy/export dlg messages")
temp.play_stationary(get_pack_sound("ui/other/*export*"), false);
dlgmessage_return("All game statistics have been exported to stats/player_statistics.txt.");
m.play_music(); // and back again once the dialog closes (dev, 2026-11-07)
}
