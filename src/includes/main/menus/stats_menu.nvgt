/* The statistics menus (the statistics plan's Section 2, dev, 2026-11-05 and 2026-11-06), after ToyMania's statsmenu(),
view_session_stats() and view_lifetime_stats(), as loops instead of its menus calling each other. View game statistics
in the game menu opens statistics_menu(): session statistics, lifetime statistics, back (clear, copy and export join it
in Section 5). Each stat menu is one stat per item, worded ToyMania's way, then back. Pressing enter on a stat keeps you
on it; escape or back steps back one menu silently, as every nested menu does. */
void statistics_menu()
{
int focus = -1;
while (true)
{
setupmenu();
m.intro_text = "Statistics menu. You can view the stats from your last endless run, or your totals across all of them here.";
m.add_item("session statistics", "session");
m.add_item("lifetime statistics", "lifetime");
m.add_item("back", "back");
int mres = m.run(focus, false, focus >= 0);
if (mres < 0 or m.selected_item_id == "back") return;
focus = mres;
if (m.selected_item_id == "session") show_stat_lines("Session statistics menu. You can see the stats from your last endless run here.", session_stat_lines());
else show_stat_lines("Lifetime statistics menu. You can see your total stats across all of your endless runs here.", lifetime_stat_lines());
}
}
/* One stat menu: the lines and back; enter on a line reopens it on that line (with its intro, as ToyMania's menus do),
and escape or back returns. */
void show_stat_lines(const string&in intro, string[]@ lines)
{
int focus = -1;
while (true)
{
setupmenu();
m.intro_text = intro;
for (uint i = 0; i < lines.length(); i++) m.add_item(lines[i], "");
m.add_item("back", "back");
int mres = m.run(focus, false, focus >= 0);
if (mres < 0 or m.selected_item_id == "back") return;
focus = mres;
}
}
// The last endless run, or a single line before the first one (dev, 2026-11-05: "both").
string[] session_stat_lines()
{
string[] lines;
if (!has_session)
{
lines.insert_last("You haven't played an endless run yet.");
return lines;
}
lines.insert_last("You played on " + last_run_difficulty + ".");
lines.insert_last("You have run " + count_text(stat_value(session_stats, "steps"), "step", "steps") + ".");
lines.insert_last("You have been running for " + time_phrase(stat_value(session_stats, "time_running")) + ".");
lines.insert_last("Your top speed was " + tenths_text(stat_value(session_stats, "top_speed")) + " steps a second.");
lines.insert_last("You have changed lanes " + count_text(stat_value(session_stats, "lane_changes"), "time", "times") + ".");
add_obstacle_and_hit_lines(lines, session_stats, false);
lines.insert_last(end_cause_line(session_end_cause));
return lines;
}
/* Section 3's Obstacles and Hits lines, for either menu: what you got past, then damage and lives, then how often each
kind of obstacle caught you, listing only the kinds that did, to keep the menu short. lifetime adds "a total of". */
void add_obstacle_and_hit_lines(string[]@ lines, dictionary@ stats, bool lifetime)
{
string total = lifetime ? "a total of " : "";
lines.insert_last("You have jumped over " + total + count_text(stat_value(stats, "hazards_jumped"), "hazard", "hazards") + ".");
lines.insert_last("You have jumped over " + total + count_text(stat_value(stats, "spikes_jumped"), "spike", "spikes") + ".");
lines.insert_last("You have jumped over " + total + count_text(stat_value(stats, "mines_jumped"), "mine", "mines") + ".");
lines.insert_last("You have ducked under " + total + count_text(stat_value(stats, "projectiles_ducked"), "projectile", "projectiles") + ".");
lines.insert_last("You have switched off " + total + count_text(stat_value(stats, "force_fields_switched_off"), "force field", "force fields") + ".");
lines.insert_last("You have scared away " + total + count_text(stat_value(stats, "animals_scared"), "animal", "animals") + ".");
lines.insert_last("You have dodged " + total + count_text(stat_value(stats, "barriers_dodged"), "barrier", "barriers") + ".");
lines.insert_last("You have broken " + total + count_text(stat_value(stats, "walls_broken"), "wall", "walls") + ".");
lines.insert_last("You have broken " + total + count_text(stat_value(stats, "fake_doors_broken"), "fake door", "fake doors") + ".");
lines.insert_last("You have opened " + total + count_text(stat_value(stats, "real_doors_opened"), "real door", "real doors") + ".");
lines.insert_last("You have taken " + total + thousands_text(stat_value(stats, "damage_taken")) + " damage.");
lines.insert_last("You have lost " + total + count_text(stat_value(stats, "lives_lost"), "life", "lives") + ".");
// Each kind that caught you: its subject, then what it did.
string[] kinds = {"spikes", "mines", "projectiles", "force_fields", "animals", "barriers", "walls", "doors"};
string[] lead = {"Spikes have hit you", "Mines have gone off under you", "Projectiles have hit you", "Force fields have hit you", "Animals have run into you", "Barriers have hit you", "You have crashed into walls", "You have crashed into doors"};
for (uint i = 0; i < kinds.length(); i++)
{
int64 count = stat_value(stats, "caught_" + kinds[i]);
if (count > 0) lines.insert_last(lead[i] + " " + total + count_text(count, "time", "times") + ".");
}
add_item_and_weapon_lines(lines, stats, lifetime);
}
/* Section 4's Items and Weapons lines: each inventory item picked up, broken (run onto, landed on or hit) and used, then
powerups, then swings, shots and reloads. */
void add_item_and_weapon_lines(string[]@ lines, dictionary@ stats, bool lifetime)
{
string total = lifetime ? "a total of " : "";
string[] kinds = {"ammo_packs", "keys", "steel_shields", "life_capsules", "health_potions", "player_teleporters"};
string[] one = {"ammo pack", "key", "steel shield", "life capsule", "health potion", "player teleporter"};
string[] many = {"ammo packs", "keys", "steel shields", "life capsules", "health potions", "player teleporters"};
for (uint i = 0; i < kinds.length(); i++)
{
lines.insert_last("You have picked up " + total + count_text(stat_value(stats, kinds[i] + "_picked_up"), one[i], many[i]) + ".");
lines.insert_last("You have broken " + total + count_text(stat_value(stats, kinds[i] + "_broken"), one[i], many[i]) + ".");
lines.insert_last("You have used " + total + count_text(stat_value(stats, kinds[i] + "_used"), one[i], many[i]) + ".");
}
lines.insert_last("You have collected " + total + count_text(stat_value(stats, "ground_powerups_collected"), "ground powerup", "ground powerups") + ".");
lines.insert_last("You have collected " + total + count_text(stat_value(stats, "air_powerups_collected"), "air powerup", "air powerups") + "."); // the flight ones (dev, 2026-11-06)
lines.insert_last("You have swung your melee weapons " + total + count_text(stat_value(stats, "melee_swings"), "time", "times") + ".");
lines.insert_last("You have fired " + total + count_text(stat_value(stats, "shots_fired"), "shot", "shots") + ".");
lines.insert_last("You have reloaded " + total + count_text(stat_value(stats, "reloads"), "time", "times") + ".");
}
// The last run's ending: the obstacle that ended it, or a quit or restart ("" also covers a session saved before Section 3).
string end_cause_line(const string&in cause)
{
if (cause == "hazards") return "Your run ended when you fell into a hazard.";
if (cause == "spikes") return "Your run ended when a spike hit you.";
if (cause == "mines") return "Your run ended when a mine went off under you.";
if (cause == "projectiles") return "Your run ended when a projectile hit you.";
if (cause == "force_fields") return "Your run ended when a force field hit you.";
if (cause == "animals") return "Your run ended when an animal ran into you.";
if (cause == "barriers") return "Your run ended when a barrier hit you.";
if (cause == "walls") return "Your run ended when you crashed into a wall.";
if (cause == "doors") return "Your run ended when you crashed into a door.";
return "You quit the run.";
}
// Every endless run added up, starting with when the last one ended, as ToyMania's lifetime stats do.
string[] lifetime_stat_lines()
{
string[] lines;
lines.insert_last("Last played date: " + (last_played_date == "" ? "never" : last_played_date) + ".");
lines.insert_last("Last played time: " + (last_played_time == "" ? "never" : last_played_time) + ".");
lines.insert_last("You have played a total of " + count_text(stat_value(lifetime_stats, "runs_played"), "run", "runs") + ".");
for (uint i = 0; i < difficulty_names.length(); i++)
{
lines.insert_last("You have played " + count_text(stat_value(lifetime_stats, "runs_" + difficulty_names[i]), "run", "runs") + " on " + difficulty_names[i] + ".");
}
lines.insert_last("You have run a total of " + count_text(stat_value(lifetime_stats, "steps"), "step", "steps") + ".");
lines.insert_last("You have been running for a total of " + time_phrase(stat_value(lifetime_stats, "time_running")) + ".");
lines.insert_last("Your top speed is " + tenths_text(stat_value(lifetime_stats, "top_speed")) + " steps a second.");
lines.insert_last("You have changed lanes a total of " + count_text(stat_value(lifetime_stats, "lane_changes"), "time", "times") + ".");
add_obstacle_and_hit_lines(lines, lifetime_stats, true);
return lines;
}
// "1 step" or "4,000 steps": the count with thousands commas, then the right word.
string count_text(int64 amount, const string&in one, const string&in many)
{
return thousands_text(amount) + " " + (amount == 1 ? one : many);
}
// A whole number with a comma every three digits: 4000 reads "4,000".
string thousands_text(int64 amount)
{
string digits = "" + (amount < 0 ? -amount : amount);
string result = "";
int count = 0;
for (int i = int(digits.length()) - 1; i >= 0; i--)
{
if (count > 0 and count % 3 == 0) result = "," + result;
result = digits.substr(i, 1) + result;
count += 1;
}
return amount < 0 ? "-" + result : result;
}
