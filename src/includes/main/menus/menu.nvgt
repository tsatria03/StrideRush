/* The main menu (dev, 2026-11-03, for 1.3, SimpleFighter's layout): documentation menu, game menu, settings menu (dev,
2026-11-04), change game version (SimpleFighter's), check for updates and test speakers (dev, 2026-11-05, ToyMania's
order), restart game and exit game. main()'s loop reopens it
whenever a submenu returns. */
void mainmenu()
{
setupmenu(true);
m.add_item("documentation menu", "docks");
m.add_item("game menu", "game");
m.add_item("settings menu", "settings");
m.add_item("Change game version. Currently set to " + version, "version"); // SimpleFighter's (dev, 2026-11-05)
m.add_item("check for updates", "updates"); // dev, 2026-11-05; globals/updater.nvgt
m.add_item("test speakers", "speakers");
m.add_item("restart game", "rx");
m.add_item("exit game", "ex");
m.intro_text="Main menu. Choose an option with your arrow keys, then press enter to activate one.";
int mres=m.run();
string main=mres<0?"":m.selected_item_id;
// Escape and exit game both quit right away, with no confirm.
if(mres<0 or main=="ex")
{
speak("exiting");
m.fade_music();
exit();
}
if(main=="docks") docksmenu();
else if(main=="game") gamemenu();
else if(main=="settings")
{
m.fade_music(); // from the main menu only (dev, 2026-11-07); F2 in a run finds it already faded
settingsmenu();
}
else if(main=="version") change_game_version();
else if(main=="updates")
{
m.fade_music(); // for the whole check, its menus and alerts (dev, 2026-11-07); the main menu starts it again afterwards
check_for_updates(version, update_project, true);
}
else if(main=="speakers") test_speakers();
else if(main=="rx") restart_game();
}
/* Change game version, SimpleFighter's (dev, 2026-11-05): the number the updater compares against, for this launch
only (the next launch reports the real version from version.nvgt again). Typing an older one lets you test the
updater or download the latest release again. The box won't take an empty answer; its cancel or escape says
"canceled". */
void change_game_version()
{
m.fade_music(); // dev, 2026-11-07; the main menu starts it again afterwards
/* Digits and periods only (dev, 2026-11-05). vd's filter is a member, not input_box()'s own disallowed_chars
parameter, which it never reads; true makes the list the only characters allowed. Cleared again afterwards, since vd
is shared with the speech buffer's boxes. */
vd.set_disallowed_chars("0123456789.", true, "This character is not allowed."); // input_box()'s own wording (dev, 2026-11-05)
string newver = string_trim_sides(vd.input_box("Game version", "Enter a version number to override what the game reports to the updater. Use this to force a re-download of the latest update or to test against a specific version.", version));
vd.set_disallowed_chars("");
if (newver == "")
{
speak("canceled");
return;
}
if (newver == version)
{
dlgmessage_return("Version already set to " + version + ".");
return;
}
version = newver;
dlgmessage_return("Version updated to " + version + ".");
}
/* Test speakers, after ToyMania's: the menu music fades (dev, 2026-11-07), ui/menu/speaker plays through (Enter or A fades it out early, dlgplay()'s skip keys), then
the complete sound and "Speaker test complete." in a dialog. Back in main()'s loop, the main menu opens again. */
void test_speakers()
{
m.fade_music(); // dev, 2026-11-07: "fade the music when I test my speakers"; the main menu starts it again afterwards
dlgplay(get_pack_sound("ui/menu/*speaker*"));
dlgplay(get_pack_sound("ui/other/*complete*"), false);
dlgmessage_return("Speaker test complete.");
}
/* The documentation menu, after SimpleFighter's: a loop, so closing a document comes back here and escape or back
returns to the main menu silently (a nested menu), with nothing stacking up the way ToyMania's menus call each other. */
void docksmenu()
{
while(true)
{
setupmenu(true);
m.add_item("changelog", "changelog.txt");
m.add_item("credits", "credits.txt");
m.add_item("readme", "readme.txt");
m.add_item("todo list", "todo list.txt");
m.add_item("back", "back");
m.intro_text="Documentation menu.";
int mres=m.run();
if(mres<0 or m.selected_item_id=="back") return;
string filename=m.selected_item_id;
m.fade_music();
dockread("docks/"+filename);
}
}
/* Shows one document in an audio form window: the whole file in a read-only box you can arrow through, and a close
button that escape also presses. A missing file shows an alert instead. Either way it returns to docksmenu(). */
void dockread(const string&in filename)
{
string shortname=string_replace(filename, "docks/", "", true);
if(!file_exists(filename))
{
alert("Error", "Could not find "+shortname+".");
return;
}
file dockfile;
dockfile.open(filename, "rb");
string docktext=dockfile.read();
dockfile.close();
audio_form docform;
docform.create_window("Viewing "+shortname, false, false, false);
int dockbox=docform.create_input_box(shortname, docktext, read_only:true, multiline:true);
int dockclose=docform.create_button("&close", false, true);
docform.focus(dockbox);
while(true)
{
wait(5);
docform.monitor();
if(docform.is_pressed(dockclose)) return;
}
}
/* The game menu: play game, learn sounds and back. Play game opens the mode menu and then the run; when the run ends you're back
here, so you can play again straight away. Escape or back returns to the main menu silently. */
void gamemenu()
{
while(true)
{
setupmenu(true);
m.add_item("play game", "play");
m.add_item("learn sounds", "learn"); // dev, 2026-11-05 (first "learn sounds menu"); learn_sounds_menu.nvgt
m.add_item("view game achievements", "achievements"); // before statistics (dev, 2026-11-06); achievements_menu.nvgt
m.add_item("view game statistics", "stats"); // after learn sounds (dev, 2026-11-06); stats_menu.nvgt
m.add_item("clear game progresses", "clearall"); // the three "all progress" items, always shown (achievements_menu.nvgt)
m.add_item("copy all game progresses to clipboard", "copyall");
m.add_item("export all game progresses to file", "exportall");
m.add_item("back", "back");
/* ToyMania's game menu intro (dev, 2026-11-05), with only the parts Stride Rush has: its "learn about important
sounds" from when ToyMania had a learn sounds menu, and its "check your stats" with statistics (2026-11-06), in the
menu's order, and "view achievements" with achievements (2026-11-06). */
m.intro_text="Game menu. You can start a new game session, learn about important sounds, view achievements, or check your stats here.";
int mres=m.run();
if(mres<0 or m.selected_item_id=="back") return;
if(m.selected_item_id=="learn") learn_sounds_menu();
else if(m.selected_item_id=="achievements") achievements_menu();
else if(m.selected_item_id=="stats") statistics_menu();
else if(m.selected_item_id=="clearall") clear_all_progress();
else if(m.selected_item_id=="copyall") copy_all_progress();
else if(m.selected_item_id=="exportall") export_all_progress();
else play_game();
}
}
/* Play game. It opens the mode menu (the practice plan, dev, 2026-11-06, replacing the 2026-11-03 "Do you want to play
in debug mode?" question): endless run goes on to the difficulty menu (choose_difficulty()) and plays the real game
(the level's speed and floor, everything spawning, starting_lives, and the run ends when lives run out), practice run goes on to the practice menus (choose_practice()), and debug run, from source
only, goes on to the debug options, in the dev's order: spawn (before speed since 2026-11-06), speed,
footsteps (2026-11-04), then whether lives can run out. Escape steps back one menu silently: from the mode menu to
the game menu, and from the spawn menu back to the mode menu. They're all nested menus, so nothing says "canceled". The
lives menu was removed with player health: "all" starts with starting_lives, and any single-type choice with debug_lives. */
void play_game()
{
int speed = start_step_time, can_run_out = 1, steps = 1;
string only_type = "all";
bool practicing = false;
int level = -1; // the endless run's difficulty, or -1
int stage = 0;
while (stage < 5)
{
if (stage == 0)
{
string mode = choose_game_mode();
if (mode == "") return;
practicing = false; // set again below, so backing out of practice into another mode never leaves it on
level = -1; // likewise the difficulty, which only an endless run has
if (mode == "practice")
{
// Escaping the obstacle menu stays on the mode menu (stage 0); otherwise straight to the run.
string practice_type;
int practice_speed;
if (!choose_practice(practice_type, practice_speed)) continue;
// A practice run (Section 3): its fixed speed, the one obstacle, practice_lives that can't run out.
practicing = true;
speed = practice_speed;
only_type = practice_spawn_id(practice_type);
can_run_out = 0;
steps = 1;
stage = 5;
}
else if (mode == "endless")
{
// Escaping the difficulty menu stays on the mode menu (stage 0); otherwise straight to the run at the level's speed.
level = choose_difficulty();
if (level < 0) continue;
/* The real game. Set every choice here, not just once above, since escaping back from a debug option leaves
its "escaped" value behind (a speed of -1 ran every step at once; bug found by the dev, 2026-11-04). */
speed = difficulty_start_times[level];
only_type = "all";
can_run_out = 1;
steps = 1;
stage = 5;
}
else stage = 1;
}
else if (stage == 1)
{
// The spawn choice first, then the speed (dev, 2026-11-06: "Please make the speed menu come after the obstical/item menu").
only_type = choose_spawn_types();
stage = only_type == "" ? 0 : 2;
}
else if (stage == 2)
{
speed = choose_start_speed();
stage = speed < 0 ? 1 : 3;
}
else if (stage == 3)
{
steps = choose_footsteps();
stage = steps < 0 ? 2 : 4;
}
else
{
can_run_out = choose_lives_can_end();
stage = can_run_out < 0 ? 3 : 5;
}
}
footsteps_on = steps == 1;
m.fade_music();
/* Returns when the run ends, back to the game menu. A run starts over with the same choices when restart run was picked,
when the debug No answer turned a hazard death into a restart, or when you choose replay run after a death (after_death_menu(), results_menu.nvgt)
(dev, 2026-11-03, in releases too). Quitting from the pause menu or the Escape question just returns here. */
do
{
restart_run_requested = false;
run_died = false;
/* A practice run starts with practice_lives; a single-type debug run with debug_lives (dev, 2026-11-03); "all" plays
like the real game. A practice run can't die, so it never reaches the after death menu. */
int life_count = practicing ? practice_lives : (only_type == "all" ? starting_lives : debug_lives);
start_run(speed, life_count, only_type, can_run_out == 1, practicing, level);
if (run_died and !restart_run_requested and after_death_menu()) restart_run_requested = true;
}
while (restart_run_requested);
}
/* Restart game, after SimpleFighter's restart(): starts a fresh copy of the game and closes this one. Compiled, it runs
sdr.exe, the name nvgt -c gives sdr.nvgt's build (SimpleFighter's is sf.exe); from source, the pinned engine's nvgtw.exe on
../src/sdr.nvgt, which resolves because the launcher set the cwd to sdr/. A source restart skips sdr/sdr.py, so it doesn't
sync build/version.txt or write errors.txt. */
void restart_game()
{
speak("restarting");
m.fade_music();
bool started = SCRIPT_COMPILED ? run("sdr.exe", "", false, false) : run("C:\\nvgt\\nvgtw.exe", "../src/sdr.nvgt", false, false);
if (!started)
{
alert("Error", "Unable to restart Stride Rush.");
return;
}
exit();
}
/* The mode menu (the practice plan, dev, 2026-11-06): the foundation every way to play lands on. Debug run comes first
and only from source (SCRIPT_COMPILED hides it), then endless run; each item is followed by a ToyMania-style
description; practice run follows endless run (Section 2). Returns "debug", "endless", "practice", or "" for escape or
back, which step back to the game menu silently. */
string choose_game_mode()
{
setupmenu();
m.intro_text = "Choose the game you'd like to play.";
if (!SCRIPT_COMPILED) m.add_item("Debug run. This mode lets you choose the speed, obstacles, footsteps and whether lives run out, for testing.", "debug");
// "and more obstacles join as you go" joined with the difficulty schedule (Section 5; dev, 2026-11-05).
m.add_item("Endless run. This mode lets you run for as long as you can survive. The belt gets faster and more obstacles join as you go, and the run ends when you run out of lives or fall into a hazard.", "endless");
m.add_item("Practice run. This mode lets you practice one kind of obstacle at a time, for as long as you like. You can't lose, and nothing you do here counts toward your progress.", "practice");
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return "";
return m.selected_item_id;
}
/* The difficulty menu (the game menu refactor plan's Section 4, dev, 2026-11-05), after endless run: the five levels in
difficulty order (not alphabetical; dev: "this menu will not need it"), then back. Each level reads as
difficulty_line() puts it: "Easy. Available." or, locked (Section 6), "Medium. Unlocked after completing 3 more easy
runs."; choosing a locked level says "This difficulty is unlocked after completing ..." in a dialog and stays in the menu, on that level. The pick isn't saved,
but the cursor starts on the last level picked until the game closes, and restart run and replays keep the level.
Returns the level's index in difficulty_names, or -1 for escape or back, which step back to the mode menu silently. */
int last_difficulty = -1;
int choose_difficulty()
{
int focus = last_difficulty;
while (true)
{
setupmenu();
m.intro_text = "Choose a difficulty.";
for (uint i = 0; i < difficulty_names.length(); i++)
{
m.add_item(difficulty_line(i), "" + i);
}
m.add_item("back", "back");
int mres = m.run(focus, false, focus >= 0); // the last pick is focused and spoken, as in the learn sounds menu
if (mres < 0 or m.selected_item_id == "back") return -1;
int level = int(parse_int(m.selected_item_id));
if (!difficulty_unlocked(level))
{
dlgmessage_return(difficulty_locked_message(level)); // ToyMania's way: say why, and stay in the menu
focus = level;
continue;
}
last_difficulty = level;
return level;
}
return -1;
}
/* The practice menus (the game menu refactor plan's Section 2, dev, 2026-11-05): the obstacle, then the speed. The
obstacles come in learning order, the order the difficulty schedule brings them in, not alphabetical; the speeds are
fixed for the run. Escape or back on the speed menu steps back to the obstacles, and on the obstacles back to the mode
menu, all silently. Fills practice_type and practice_speed and returns true, or returns false when backed out. */
bool choose_practice(string &out practice_type, int &out practice_speed)
{
practice_type = "";
practice_speed = start_step_time;
while (true)
{
setupmenu();
m.intro_text = "Choose an obstacle to practice.";
string[] obstacles = {"hazards", "spikes", "mines", "projectiles", "force_fields", "animals", "walls", "doors", "barriers"};
for (uint i = 0; i < obstacles.length(); i++)
{
m.add_item(obstacles[i].replace("_", " ", true), obstacles[i]);
}
m.add_item("back", "back");
int mres = m.run();
if (mres < 0 or m.selected_item_id == "back") return false;
practice_type = m.selected_item_id;
setupmenu();
m.intro_text = "Choose a speed.";
for (int t = start_step_time; t >= 100; t -= 100)
{
m.add_item(t + " ms", "" + t);
}
m.add_item("back", "back");
mres = m.run();
if (mres < 0 or m.selected_item_id == "back") continue; // back to the obstacles
practice_speed = int(parse_int(m.selected_item_id));
return true;
}
return false;
}
/* A practice choice as the spawner's spawn_only. Doors and barriers aren't plain obstacle types: doors are the practice
mix of real doors, each with its key, and fake ones (choose_next_obstacle()), and barriers use the real game's lane
rule, sometimes two side by side. */
string practice_spawn_id(const string&in practice_type)
{
if (practice_type == "doors") return "practice_doors";
if (practice_type == "barriers") return "barriers_multiple";
return practice_type;
}
/* DEBUG OPTION: pick the starting step time, from start_step_time down in 100 ms steps: 500, 400, 300, 200, 100. The
50 ms in between (450, 350, 250, 150 and 50) were dropped for door testing (dev, 2026-11-03). It only appears when
running from source; a compiled release always starts at start_step_time. Returns -1 if escaped. */
int choose_start_speed()
{
if (SCRIPT_COMPILED) return start_step_time;
setupmenu();
m.intro_text = "Choose a starting speed for debugging.";
for (int t = start_step_time; t >= 100; t -= 100)
{
m.add_item(t + " ms", "" + t);
}
int mres = m.run();
if (mres < 0) return -1; // silent: escape just steps back to the spawn menu
return int(parse_int(m.selected_item_id));
}
/* DEBUG OPTION: pick which obstacles spawn: one type from obstacle_types and item_types (and any added later), one of
the extra choices below, or all. Every choice is gathered first, then listed in alphabetical order, "all" included
(dev, 2026-11-05: "Please make the debug options in alphabetical order"). It only appears when running from source; a
compiled release always spawns all. Returns the type, "all", or "" if escaped. */
string choose_spawn_types()
{
if (SCRIPT_COMPILED) return "all";
string[] labels;
dictionary ids; // label -> spawn id
for (uint i = 0; i < obstacle_types.length(); i++)
{
if (obstacle_types[i] == "animals") continue; // listed by kind below instead (dev, 2026-11-04)
if (obstacle_types[i] == "barriers") continue; // the three barrier choices below cover it (dev, 2026-11-05)
add_spawn_choice(labels, ids, obstacle_types[i].replace("_", " ", true), obstacle_types[i]); // "force_fields" reads as "force fields"
}
// Debug options: animals of one kind only (dev, 2026-11-04); "all" still mixes every kind.
add_spawn_choice(labels, ids, "animals, birds", "animals_birds");
add_spawn_choice(labels, ids, "animals, dogs", "animals_dogs");
// Real doors aren't in the random mix (they mark speed sections), but as a debug option they can be the only thing that spawns.
add_spawn_choice(labels, ids, "real doors", "real_doors");
// Debug option: only the real doors at the 50 ms speed marks, with nothing in between (dev, 2026-11-03).
add_spawn_choice(labels, ids, "real doors, spread", "real_doors_spread");
// Debug option: only barriers, in your lane, in random lanes, or the real game's pairs (dev, 2026-11-04).
add_spawn_choice(labels, ids, "barriers", "barriers");
add_spawn_choice(labels, ids, "barriers, random lanes", "barriers_random"); // each barrier in any of the three lanes
add_spawn_choice(labels, ids, "barriers, multiple lanes", "barriers_multiple"); // the real game's rule: sometimes two side by side, never in one lane
for (uint i = 0; i < item_types.length(); i++)
{
string item_name = item_types[i].replace("_", " ", true);
add_spawn_choice(labels, ids, item_name, item_types[i]);
// The lane items get the barriers' three choices (dev, 2026-11-05): your lane, random lanes, multiple lanes.
if (item_lane_types.find(item_types[i]) < 0) continue;
add_spawn_choice(labels, ids, item_name + ", random lanes", item_types[i] + "_random");
add_spawn_choice(labels, ids, item_name + ", multiple lanes", item_types[i] + "_multiple");
}
add_spawn_choice(labels, ids, "all", "all");
add_spawn_choice(labels, ids, "nothing", "nothing"); // an empty belt, for the music and ambience (dev, 2026-11-06)
labels.sort_ascending();
setupmenu();
m.intro_text = "Choose which obstacles spawn for debugging.";
for (uint i = 0; i < labels.length(); i++)
{
string id;
ids.get(labels[i], id);
m.add_item(labels[i], id);
}
int mres = m.run();
if (mres < 0) return ""; // silent: escape just steps back to the mode menu
return m.selected_item_id;
}
// One spawn choice for choose_spawn_types(): its spoken label and the id start_run() gets.
void add_spawn_choice(string[]@ labels, dictionary@ ids, const string&in label, const string&in id)
{
labels.insert_last(label);
ids.set(label, id);
}
/* DEBUG OPTION: whether you hear your footsteps while running (dev, 2026-11-04: "extremely useful for the new
transformed belt tests"), asked before the run-ending question. No silences every footstep, so only the belt's sounds
are left; landings still play. It only appears when running from source; a compiled release always answers Yes.
Returns 1 for Yes, 0 for No, or -1 if escaped. */
int choose_footsteps()
{
if (SCRIPT_COMPILED) return 1;
setupmenu();
m.intro_text = "Do you want to hear your footsteps while running?";
m.add_item("Yes", "yes");
m.add_item("No", "no");
int mres = m.run();
if (mres < 0) return -1; // silent: escape just steps back to the speed menu
return m.selected_item_id == "yes" ? 1 : 0;
}
/* DEBUG OPTION: whether running out of lives ends the run. No means blows can never end it: lives stop at 1 and 0
health just refills; hazards still end it. It only appears when running from source; a compiled release always answers
Yes. Returns 1 for Yes, 0 for No, or -1 if escaped. */
int choose_lives_can_end()
{
if (SCRIPT_COMPILED) return 1;
setupmenu();
m.intro_text = "Do you want the run to end when you run out of lives?";
m.add_item("Yes", "yes");
m.add_item("No", "no");
int mres = m.run();
if (mres < 0) return -1; // silent: escape just steps back to the footsteps question
return m.selected_item_id == "yes" ? 1 : 0;
}
