void mainmenu()
{
setupmenu(true);
m.add_item("start game", "start");
m.add_item("exit game", "ex");
m.intro_text="Main menu. Choose an option with your arrow keys, then press enter to activate one.";
int mres=m.run();
string main=mres<0?"":m.selected_item_id;
// Escape and exit game both quit right away, with no confirm.
if(mres<0 or main=="ex")
{
speak("exiting");
m.fade_music();
exit();
}
if(main=="start")
{
/* The testing menus, in the dev's order: lives, speed, spawn, then whether lives can run out. Escape steps back one
menu silently, and escaping the lives menu silently returns to the main menu: they're all nested menus, so nothing
says "canceled". A compiled release skips all four. */
int run_lives = 0, speed = 0, can_run_out = 1;
string only_type = "";
int stage = 0;
while (stage < 4)
{
if (stage == 0)
{
run_lives = choose_start_lives();
if (run_lives < 0) return;
stage = 1;
}
else if (stage == 1)
{
speed = choose_start_speed();
stage = speed < 0 ? 0 : 2;
}
else if (stage == 2)
{
only_type = choose_spawn_types();
stage = only_type == "" ? 1 : 3;
}
else
{
can_run_out = choose_lives_can_end();
stage = can_run_out < 0 ? 2 : 4;
}
}
m.fade_music();
/* Returns when the run ends, and main()'s loop reopens this menu. With the testing No answer, a hazard death starts
the run over with the same choices instead; quitting from the pause menu still returns here. */
do
{
restart_run_requested = false;
start_run(speed, run_lives, only_type, can_run_out == 1);
}
while (restart_run_requested);
}
}
/* TESTING ONLY: pick the starting step time, from start_step_time down in 100 ms steps: 500, 400, 300, 200, 100. The
50 ms in between (450, 350, 250, 150 and 50) were dropped for door testing (dev, 2026-11-03). It only appears when
running from source; a compiled release always starts at start_step_time. Returns -1 if escaped. */
int choose_start_speed()
{
if (SCRIPT_COMPILED) return start_step_time;
setupmenu();
m.intro_text = "Choose a starting speed for testing.";
for (int t = start_step_time; t >= 100; t -= 100)
{
m.add_item(t + " ms", "" + t);
}
int mres = m.run();
if (mres < 0) return -1; // silent: escape just steps back to the lives menu
return int(parse_int(m.selected_item_id));
}
/* TESTING ONLY: pick which obstacles spawn: one type from obstacle_types (hazards, spikes, mines, and any added later),
or all, listed in that order (dev's order). It only appears when running from source; a compiled release always
spawns all. Returns the type, "all", or "" if escaped. */
string choose_spawn_types()
{
if (SCRIPT_COMPILED) return "all";
setupmenu();
m.intro_text = "Choose which obstacles spawn for testing.";
for (uint i = 0; i < obstacle_types.length(); i++)
{
m.add_item(obstacle_types[i].replace("_", " ", true), obstacle_types[i]); // "force_fields" reads as "force fields"
}
// Real doors aren't in the random mix (they mark speed sections), but for testing they can be the only thing that spawns.
m.add_item("real doors", "real_doors");
// Testing: only the real doors at the 50 ms speed marks, with nothing in between (dev, 2026-11-03).
m.add_item("real doors, spread", "real_doors_spread");
for (uint i = 0; i < item_types.length(); i++)
{
m.add_item(item_types[i].replace("_", " ", true), item_types[i]);
}
m.add_item("all", "all");
int mres = m.run();
if (mres < 0) return ""; // silent: escape just steps back to the speed menu
return m.selected_item_id;
}
/* TESTING ONLY: whether running out of lives ends the run. No means spikes, mines and force fields can never end it and
lives stop at 1; hazards still end it. It only appears when running from source; a compiled release always answers
Yes. Returns 1 for Yes, 0 for No, or -1 if escaped. */
int choose_lives_can_end()
{
if (SCRIPT_COMPILED) return 1;
setupmenu();
m.intro_text = "Do you want the run to end when you run out of lives?";
m.add_item("Yes", "yes");
m.add_item("No", "no");
int mres = m.run();
if (mres < 0) return -1; // silent: escape just steps back to the spawn menu
return m.selected_item_id == "yes" ? 1 : 0;
}
/* TESTING ONLY: pick the starting lives, listed from max_test_lives down to 1 (dev's order). It only appears when
running from source; a compiled release always starts with starting_lives. Returns -1 if escaped. */
int choose_start_lives()
{
if (SCRIPT_COMPILED) return starting_lives;
setupmenu();
m.intro_text = "Choose how many lives to start with for testing.";
for (int n = max_test_lives; n >= 1; n--)
{
m.add_item(n == 1 ? "1 life" : n + " lives", "" + n);
}
int mres = m.run();
if (mres < 0) return -1; // silent: escape just steps back to the main menu
return int(parse_int(m.selected_item_id));
}
