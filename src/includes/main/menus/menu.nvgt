/* The main menu (dev, 2026-11-03, for 1.3, SimpleFighter's layout): documentation menu, game menu, restart game and exit
game. main()'s loop reopens it whenever a submenu returns. */
void mainmenu()
{
setupmenu(true);
m.add_item("documentation menu", "docks");
m.add_item("game menu", "game");
m.add_item("restart game", "rx");
m.add_item("exit game", "ex");
m.intro_text="Main menu. Choose an option with your arrow keys, then press enter to activate one.";
int mres=m.run();
string main=mres<0?"":m.selected_item_id;
// Escape and exit game both quit right away, with no confirm.
if(mres<0 or main=="ex")
{
speak("exiting");
m.fade_music();
exit();
}
if(main=="docks") docksmenu();
else if(main=="game") gamemenu();
else if(main=="rx") restart_game();
}
/* The documentation menu, after SimpleFighter's: a loop, so closing a document comes back here and escape or back
returns to the main menu silently (a nested menu), with nothing stacking up the way ToyMania's menus call each other. */
void docksmenu()
{
while(true)
{
setupmenu(true);
m.add_item("changelog", "changelog.txt");
m.add_item("credits", "credits.txt");
m.add_item("readme", "readme.txt");
m.add_item("todo list", "todo list.txt");
m.add_item("back", "back");
m.intro_text="Documentation menu.";
int mres=m.run();
if(mres<0 or m.selected_item_id=="back") return;
string filename=m.selected_item_id;
m.fade_music();
dockread("docks/"+filename);
}
}
/* Shows one document in an audio form window: the whole file in a read-only box you can arrow through, and a close
button that escape also presses. A missing file shows an alert instead. Either way it returns to docksmenu(). */
void dockread(const string&in filename)
{
string shortname=string_replace(filename, "docks/", "", true);
if(!file_exists(filename))
{
alert("Error", "Could not find "+shortname+".");
return;
}
file dockfile;
dockfile.open(filename, "rb");
string docktext=dockfile.read();
dockfile.close();
audio_form docform;
docform.create_window("Viewing "+shortname, false, false, false);
int dockbox=docform.create_input_box(shortname, docktext, read_only:true, multiline:true);
int dockclose=docform.create_button("&close", false, true);
docform.focus(dockbox);
while(true)
{
wait(5);
docform.monitor();
if(docform.is_pressed(dockclose)) return;
}
}
/* The game menu: play game and back. Play game runs the debug options and then the run; when the run ends you're back
here, so you can play again straight away. Escape or back returns to the main menu silently. */
void gamemenu()
{
while(true)
{
setupmenu(true);
m.add_item("play game", "play");
m.add_item("back", "back");
m.intro_text="Game menu.";
int mres=m.run();
if(mres<0 or m.selected_item_id=="back") return;
play_game();
}
}
/* Play game: the debug options, in the dev's order: speed, spawn, then whether lives can run out. Escape steps back one
menu silently, and escaping the speed menu silently returns to the game menu: they're all nested menus, so nothing says
"canceled". A compiled release skips all three. The lives menu was removed with player health (dev, 2026-11-03):
"all" starts with starting_lives, and any single-type choice with testing_lives. */
void play_game()
{
int speed = 0, can_run_out = 1;
string only_type = "";
int stage = 0;
while (stage < 3)
{
if (stage == 0)
{
speed = choose_start_speed();
if (speed < 0) return;
stage = 1;
}
else if (stage == 1)
{
only_type = choose_spawn_types();
stage = only_type == "" ? 0 : 2;
}
else
{
can_run_out = choose_lives_can_end();
stage = can_run_out < 0 ? 1 : 3;
}
}
m.fade_music();
/* Returns when the run ends, back to the game menu. With the debug No answer, a hazard death starts the run over with
the same choices instead; quitting from the pause menu still returns here. */
do
{
restart_run_requested = false;
// A single-type debug run starts with testing_lives (dev, 2026-11-03); "all" plays like the real game.
start_run(speed, only_type == "all" ? starting_lives : testing_lives, only_type, can_run_out == 1);
}
while (restart_run_requested);
}
/* Restart game, after SimpleFighter's restart(): starts a fresh copy of the game and closes this one. Compiled, it runs
StrideRush.exe; from source, the pinned engine's nvgtw.exe on ../src/sr.nvgt, which resolves because the launcher set
the cwd to sr/. A source restart skips sr/sr.py, so it doesn't sync build/version.txt or write errors.txt. */
void restart_game()
{
speak("restarting");
m.fade_music();
bool started = SCRIPT_COMPILED ? run("StrideRush.exe", "", false, false) : run("C:\\nvgt\\nvgtw.exe", "../src/sr.nvgt", false, false);
if (!started)
{
alert("Error", "Unable to restart Stride Rush.");
return;
}
exit();
}
/* TESTING ONLY: pick the starting step time, from start_step_time down in 100 ms steps: 500, 400, 300, 200, 100. The
50 ms in between (450, 350, 250, 150 and 50) were dropped for door testing (dev, 2026-11-03). It only appears when
running from source; a compiled release always starts at start_step_time. Returns -1 if escaped. */
int choose_start_speed()
{
if (SCRIPT_COMPILED) return start_step_time;
setupmenu();
m.intro_text = "Choose a starting speed for testing.";
for (int t = start_step_time; t >= 100; t -= 100)
{
m.add_item(t + " ms", "" + t);
}
int mres = m.run();
if (mres < 0) return -1; // silent: escape just steps back to the game menu
return int(parse_int(m.selected_item_id));
}
/* TESTING ONLY: pick which obstacles spawn: one type from obstacle_types (hazards, spikes, mines, and any added later),
or all, listed in that order (dev's order). It only appears when running from source; a compiled release always
spawns all. Returns the type, "all", or "" if escaped. */
string choose_spawn_types()
{
if (SCRIPT_COMPILED) return "all";
setupmenu();
m.intro_text = "Choose which obstacles spawn for testing.";
for (uint i = 0; i < obstacle_types.length(); i++)
{
m.add_item(obstacle_types[i].replace("_", " ", true), obstacle_types[i]); // "force_fields" reads as "force fields"
}
// Real doors aren't in the random mix (they mark speed sections), but for testing they can be the only thing that spawns.
m.add_item("real doors", "real_doors");
// Testing: only the real doors at the 50 ms speed marks, with nothing in between (dev, 2026-11-03).
m.add_item("real doors, spread", "real_doors_spread");
for (uint i = 0; i < item_types.length(); i++)
{
m.add_item(item_types[i].replace("_", " ", true), item_types[i]);
}
m.add_item("all", "all");
int mres = m.run();
if (mres < 0) return ""; // silent: escape just steps back to the speed menu
return m.selected_item_id;
}
/* TESTING ONLY: whether running out of lives ends the run. No means blows can never end it: lives stop at 1 and 0
health just refills; hazards still end it. It only appears when running from source; a compiled release always answers
Yes. Returns 1 for Yes, 0 for No, or -1 if escaped. */
int choose_lives_can_end()
{
if (SCRIPT_COMPILED) return 1;
setupmenu();
m.intro_text = "Do you want the run to end when you run out of lives?";
m.add_item("Yes", "yes");
m.add_item("No", "no");
int mres = m.run();
if (mres < 0) return -1; // silent: escape just steps back to the spawn menu
return m.selected_item_id == "yes" ? 1 : 0;
}
