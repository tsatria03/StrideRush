/* The main menu: documentation menu, game menu, settings menu, change game version, check for updates, test speakers,
restart game and exit game. main()'s loop reopens it whenever a submenu returns. */
void mainmenu()
{
setupmenu(true);
m.add_item("documentation menu", "docks");
m.add_item("game menu", "game");
m.add_item("settings menu", "settings");
m.add_item("Change game version. Currently set to " + version, "version");
m.add_item("check for updates", "updates"); // globals/updater.nvgt
m.add_item("test speakers", "speakers");
m.add_item("restart game", "rx");
m.add_item("exit game", "ex");
m.intro_text="Main menu. Choose an option with your arrow keys, then press enter to activate one.";
int mres=m.run();
string main=mres<0?"":m.selected_item_id;
// Escape and exit game both quit right away, with no confirm.
if(mres<0 or main=="ex")
{
speak("exiting");
m.fade_music();
exit();
}
if(main=="docks") docksmenu();
else if(main=="game") gamemenu();
else if(main=="settings")
{
m.fade_music(); // from the main menu only; F2 in a run finds it already faded
settingsmenu();
}
else if(main=="version") change_game_version();
else if(main=="updates")
{
m.fade_music(); // for the whole check, its menus and alerts; the main menu starts it again afterwards
check_for_updates(version, update_project, true);
}
else if(main=="speakers") test_speakers();
else if(main=="rx") restart_game();
}
/* Change game version: the number the updater compares against, for this launch only (the next launch reports the real
version from version.nvgt again). Typing an older one lets you test the updater or download the latest release again.
The box won't take an empty answer; its cancel or escape says "canceled". */
void change_game_version()
{
m.fade_music(); // the main menu starts it again afterwards
/* Digits and periods only. vd's filter is a member, not input_box()'s own disallowed_chars parameter, which it never
reads; true makes the list the only characters allowed. Cleared again afterwards, since vd is shared with the speech
buffer's boxes. */
vd.set_disallowed_chars("0123456789.", true, "This character is not allowed."); // input_box()'s own wording
string newver = string_trim_sides(vd.input_box("Game version", "Enter a version number to override what the game reports to the updater. Use this to force a re-download of the latest update or to test against a specific version.", version));
vd.set_disallowed_chars("");
if (newver == "")
{
speak("canceled");
return;
}
if (newver == version)
{
dlgmessage_return("Version already set to " + version + ".");
return;
}
version = newver;
dlgmessage_return("Version updated to " + version + ".");
}
/* Test speakers: the menu music fades, ui/menu/speaker plays through (Enter or A fades it out early, dlgplay()'s skip
keys), then the complete sound and "Speaker test complete." in a dialog. Back in main()'s loop, the main menu opens
again. */
void test_speakers()
{
m.fade_music(); // the main menu starts it again afterwards
dlgplay(get_pack_sound("ui/menu/*speaker*"));
dlgplay(get_pack_sound("ui/other/*complete*"), false);
dlgmessage_return("Speaker test complete.");
}
/* The documentation menu: a loop, so closing a document comes back here and escape or back
returns to the main menu silently (a nested menu), with nothing stacking up. */
void docksmenu()
{
while(true)
{
setupmenu(true);
m.add_item("changelog", "changelog.txt");
m.add_item("credits", "credits.txt");
m.add_item("readme", "readme.txt");
m.add_item("todo list", "todo list.txt");
m.add_item("back", "back");
m.intro_text="Documentation menu.";
int mres=m.run();
if(mres<0 or m.selected_item_id=="back") return;
string filename=m.selected_item_id;
m.fade_music();
dockread("docks/"+filename);
}
}
/* Shows one document in an audio form window: the whole file in a read-only box you can arrow through, and a close
button that escape also presses. A missing file shows an alert instead. Either way it returns to docksmenu(). */
void dockread(const string&in filename)
{
string shortname=string_replace(filename, "docks/", "", true);
if(!file_exists(filename))
{
alert("Error", "Could not find "+shortname+".");
return;
}
file dockfile;
dockfile.open(filename, "rb");
string docktext=dockfile.read();
dockfile.close();
audio_form docform;
docform.create_window("Viewing "+shortname, false, false, false);
int dockbox=docform.create_input_box(shortname, docktext, read_only:true, multiline:true);
int dockclose=docform.create_button("&close", false, true);
docform.focus(dockbox);
while(true)
{
wait(5);
docform.monitor();
if(docform.is_pressed(dockclose)) return;
}
}
/* The game menu: play game, learn sounds, achievements, statistics, the three all-progress items, and back. Play game
opens the mode menu and then the run; when the run ends you're back here, so you can play again straight away. Escape
or back returns to the main menu silently. */
void gamemenu()
{
while(true)
{
setupmenu(true);
m.add_item("play game", "play");
m.add_item("learn sounds", "learn"); // learn_sounds_menu.nvgt
m.add_item("view game achievements", "achievements"); // achievements_menu.nvgt
m.add_item("view game statistics", "stats"); // stats_menu.nvgt
m.add_item("clear game progresses", "clearall"); // the three "all progress" items, always shown (achievements_menu.nvgt)
m.add_item("copy all game progresses to clipboard", "copyall");
m.add_item("export all game progresses to file", "exportall");
m.add_item("back", "back");
// The intro names the menu's parts in the menu's order.
m.intro_text="Game menu. You can start a new game session, learn about important sounds, view achievements, or check your stats here.";
int mres=m.run();
if(mres<0 or m.selected_item_id=="back") return;
if(m.selected_item_id=="learn") learn_sounds_menu();
else if(m.selected_item_id=="achievements") achievements_menu();
else if(m.selected_item_id=="stats") statistics_menu();
else if(m.selected_item_id=="clearall") clear_all_progress();
else if(m.selected_item_id=="copyall") copy_all_progress();
else if(m.selected_item_id=="exportall") export_all_progress();
else play_game();
}
}
/* Play game. It opens the mode menu: endless and timed runs go on to the difficulty menu (choose_difficulty()) and play
the real game (the level's speed and floor, everything spawning, starting_lives, and the run ends when lives run out);
practice run goes on to the practice menus (choose_practice()); free run to its setup (choose_free_setup()); and debug
run, from source only, goes on to the debug options in this order: the environment, spawn, speed, footsteps, then
whether lives can run out. Escape steps back one menu silently: from the mode menu to the game menu, and from each
debug option to the one before. They're all nested menus, so nothing says "canceled". A debug run of "all" starts with
starting_lives, and any single-type choice with debug_lives. */
void play_game()
{
int speed = start_step_time, can_run_out = 1, steps = 1;
string only_type = "all";
bool practicing = false;
int level = -1; // the endless or timed run's difficulty, or -1
int stage = 0;
while (stage < 6)
{
if (stage == 0)
{
string mode = choose_game_mode();
if (mode == "") return;
practicing = false; // set again below, so backing out of practice into another mode never leaves it on
timed_run = false; // likewise a timed run (timerun.nvgt)
free_run = false; // and a free run (freerun.nvgt)
level = -1; // likewise the difficulty, which only endless and timed runs have
debug_env = ""; // and the debug environment choice, which only a debug run has (environments.nvgt)
if (mode == "practice")
{
// Escaping the obstacle menu stays on the mode menu (stage 0); otherwise straight to the run.
string practice_type;
int practice_speed;
if (!choose_practice(practice_type, practice_speed)) continue;
// A practice run: its chosen speed, the one obstacle, and practice_lives that never end it (a last-life blow is a practice death).
practicing = true;
practice_choice = practice_type; // what the run's clean passes count toward (practice.nvgt)
speed = practice_speed;
only_type = practice_spawn_id(practice_type);
can_run_out = 0;
steps = 1;
stage = 6;
}
else if (mode == "free")
{
// A free run (freerun.nvgt): its setup (speed, environment), then standing on an empty belt; back out of it to the mode menu.
if (!choose_free_setup()) continue;
free_run = true;
practice_choice = ""; // so no practice choice's closing line runs in it (practice_hints.nvgt)
speed = free_start_step_time();
only_type = "free"; // only what you add from the console (freebelt.nvgt)
can_run_out = 1;
steps = 1;
stage = 6;
}
else if (mode == "endless" or mode == "timed")
{
/* Escaping the difficulty menu stays on the mode menu (stage 0); otherwise straight to the run at the level's speed. A
timed run is an endless run with its clocks, and its difficulty menu reads its own counts (timerun.nvgt). */
timed_run = mode == "timed";
level = choose_difficulty();
if (level < 0) continue;
/* The real game. Set every choice here, not just once above, since escaping back from a debug option leaves
its "escaped" value behind (a speed of -1 ran every step at once). */
speed = difficulty_start_times[level];
only_type = "all";
can_run_out = 1;
steps = 1;
stage = 6;
}
else stage = 1;
}
else if (stage == 1)
{
// The environment first, before every other debug option: one to stay in, or "random".
string env_choice = choose_debug_env();
if (env_choice == "-") stage = 0;
else
{
debug_env = env_choice;
stage = 2;
}
}
else if (stage == 2)
{
// Then the spawn choice, then the speed.
only_type = choose_spawn_types();
stage = only_type == "" ? 1 : 3;
}
else if (stage == 3)
{
speed = choose_start_speed();
stage = speed < 0 ? 2 : 4;
}
else if (stage == 4)
{
steps = choose_footsteps();
stage = steps < 0 ? 3 : 5;
}
else
{
can_run_out = choose_lives_can_end();
stage = can_run_out < 0 ? 4 : 6;
}
}
footsteps_on = steps == 1;
m.fade_music();
/* Returns when the run ends, back to the game menu. A run starts over with the same choices when restart run was picked,
when the debug No answer turned a hazard death into a restart, or when you choose replay run after a death
(after_death_menu(), results_menu.nvgt), in releases too. Quitting from the pause menu or the Escape question just
returns here. */
bool first_run = true;
do
{
// A free run's replay or restart is the same run again, with everything as it was (freerun.nvgt).
if (free_run and !first_run)
{
free_prepare_replay();
speed = free_start_step_time();
}
first_run = false;
restart_run_requested = false;
run_died = false;
/* A practice run starts with practice_lives, a free run with free_lives, a single-type debug run with debug_lives;
"all" plays like the real game. Practice deaths have their own retry menu (endrun.nvgt), so a practice run never
reaches the after death menu. */
int life_count = practicing ? practice_lives : (free_run ? free_lives : (only_type == "all" ? starting_lives : debug_lives));
start_run(speed, life_count, only_type, can_run_out == 1, practicing, level);
if (run_died and !restart_run_requested and after_death_menu()) restart_run_requested = true;
}
while (restart_run_requested);
timed_run = false; // back at the game menu, no run is timed
free_run = false; // or free
}
/* Restart game: starts a fresh copy of the game and closes this one. Compiled, it runs
sdr.exe, the name nvgt -c gives sdr.nvgt's build; from source, the pinned engine's nvgtw.exe on
../src/sdr.nvgt, which resolves because the launcher set the cwd to sdr/. A source restart skips sdr/sdr.py, so it doesn't
sync build/version.txt or write errors.txt. */
void restart_game()
{
speak("restarting");
m.fade_music();
bool started = SCRIPT_COMPILED ? run("sdr.exe", "", false, false) : run("C:\\nvgt\\nvgtw.exe", "../src/sdr.nvgt", false, false);
if (!started)
{
alert("Error", "Unable to restart Stride Rush.");
return;
}
exit();
}
/* The mode menu: the foundation every way to play lands on. Debug run comes first and only from source (SCRIPT_COMPILED
hides it), then endless run, timed run, free run and practice run, in that order, each followed by a description.
Choosing a locked mode says why in a dialog and stays in the menu, on that mode. Returns "debug", "endless", "timed",
"free", "practice", or "" for escape or back, which step back to the game menu silently. */
string choose_game_mode()
{
int focus = -1;
while (true)
{
setupmenu();
m.intro_text = "Choose the game you'd like to play.";
if (!SCRIPT_COMPILED) m.add_item("Debug run. This mode lets you choose the speed, obstacles, footsteps and whether lives run out, for testing.", "debug");
// Locked, a mode reads only its requirement; open, just its description, with no "Available.".
if (endless_unlocked()) m.add_item("Endless run. This mode lets you run for as long as you can survive. The belt gets faster and more obstacles join as you go, and the run ends when you run out of lives or fall into a hazard.", "endless");
else m.add_item("Endless run. Unlocked " + endless_lock_reason(), "endless");
// Timed run, open once medium is (timerun.nvgt).
if (timed_mode_unlocked()) m.add_item("Timed run. This mode gives you a countdown clock: clean passes add time, hits take it away, and you win by reaching the finish line before your time runs out.", "timed");
else m.add_item("Timed run. Unlocked " + timed_mode_lock_reason(), "timed");
// Free run, open once insane is (freerun.nvgt).
if (free_mode_unlocked()) m.add_item("Free run. This mode lets you set up a run however you like, choosing the obstacles, the speed and more, and change it at any time from the free run console, with no difficulty and nothing counted toward your progress.", "free");
else m.add_item("Free run. Unlocked " + free_mode_lock_reason(), "free");
// Practice run, last.
m.add_item("Practice run. This mode lets you practice one kind of obstacle at a time, for as long as you like. If you die, you try again from just past what caught you, and nothing you do here counts toward your progress, apart from unlocking the next obstacle to practice.", "practice");
m.add_item("back", "back");
int mres = m.run(focus, false, focus >= 0); // back on a locked mode, it's focused and spoken
if (mres < 0 or m.selected_item_id == "back") return "";
if (m.selected_item_id == "endless" and !endless_unlocked())
{
dlgmessage_return("This mode is unlocked " + endless_lock_reason()); // say why, and stay in the menu
focus = mres;
continue;
}
if (m.selected_item_id == "free" and !free_mode_unlocked())
{
dlgmessage_return("This mode is unlocked " + free_mode_lock_reason());
focus = mres;
continue;
}
if (m.selected_item_id == "timed" and !timed_mode_unlocked())
{
dlgmessage_return("This mode is unlocked " + timed_mode_lock_reason());
focus = mres;
continue;
}
return m.selected_item_id;
}
return "";
}
/* The difficulty menu, after endless or timed run: the five levels in difficulty order (not alphabetical), then back.
Each level reads as difficulty_line() puts it: "Easy. Available." or, locked, "Medium. Unlocked after completing 3 more
easy runs."; choosing a locked level says "This difficulty is unlocked after completing ..." in a dialog and stays in
the menu, on that level. The pick isn't saved, but the cursor starts on the last level picked until the game closes,
and restart run and replays keep the level. Returns the level's index in difficulty_names, or -1 for escape or back,
which step back to the mode menu silently. */
int last_difficulty = -1;
int choose_difficulty()
{
int focus = last_difficulty;
while (true)
{
setupmenu();
// With how many are open, as the achievements menu counts: "Choose a difficulty level. 3 of 5 unlocked."
int open_levels = 0;
for (uint i = 0; i < difficulty_names.length(); i++)
{
if (difficulty_unlocked(i)) open_levels++;
}
m.intro_text = "Choose a difficulty level. " + open_levels + " of " + difficulty_names.length() + " unlocked.";
for (uint i = 0; i < difficulty_names.length(); i++)
{
m.add_item(difficulty_line(i), "" + i);
}
m.add_item("back", "back");
int mres = m.run(focus, false, focus >= 0); // the last pick is focused and spoken, as in the learn sounds menu
if (mres < 0 or m.selected_item_id == "back") return -1;
int level = int(parse_int(m.selected_item_id));
if (!difficulty_unlocked(level))
{
dlgmessage_return(difficulty_locked_message(level)); // say why, and stay in the menu
focus = level;
continue;
}
last_difficulty = level;
return level;
}
return -1;
}
/* The practice menus: the obstacle, then the speed. The obstacles come in learning order, the order the difficulty
schedule brings them in, not alphabetical; the speed is a fixed one or rising. Escape or back on the speed menu steps
back to the obstacles, and on the obstacles back to the mode menu, all silently. Fills practice_type and practice_speed
and returns true, or returns false when backed out. */
int last_practice_choice = -1; // the last obstacle picked, focused next time until the game closes, as last_difficulty is
bool choose_practice(string &out practice_type, int &out practice_speed)
{
practice_type = "";
practice_speed = start_step_time;
int focus = last_practice_choice;
while (true)
{
setupmenu();
// With how many are open: "Choose what to practice. 6 of 16 obstacles unlocked."
int open_choices = 0;
for (uint i = 0; i < practice_choices.length(); i++)
{
if (practice_unlocked(i)) open_choices++;
}
m.intro_text = "Choose what to practice. " + open_choices + " of " + practice_choices.length() + " obstacles unlocked.";
// practice_choices (practice.nvgt); each line says whether it's open or what opens it.
for (uint i = 0; i < practice_choices.length(); i++)
{
m.add_item(practice_line(i), practice_choices[i]);
}
m.add_item("back", "back");
int mres = m.run(focus, false, focus >= 0); // back on a locked choice, it's focused and spoken
if (mres < 0 or m.selected_item_id == "back") return false;
int choice = practice_choices.find(m.selected_item_id);
if (!practice_unlocked(choice))
{
dlgmessage_return(practice_locked_message(choice)); // say why, and stay in the menu, on that choice
focus = choice;
continue;
}
focus = choice; // back from the speed menu, the cursor is still on this choice
last_practice_choice = choice;
practice_type = m.selected_item_id;
setupmenu();
m.intro_text = "Choose a speed, in steps a second."; // so the bare numbers make sense
for (int t = start_step_time; t >= 100; t -= 100)
{
m.add_item(tenths_text(int(round(10000.0 / t, 0))), "" + t); // steps a second as bare numbers, 2, 2.5, 3.3, 5, 10
}
m.add_item("rising", "rising"); // from 2 up to practice_rising_top, twice as fast as an endless run speeds up
m.add_item("back", "back");
mres = m.run();
if (mres < 0 or m.selected_item_id == "back") continue; // back to the obstacles
practice_rising = m.selected_item_id == "rising";
practice_speed = practice_rising ? start_step_time : int(parse_int(m.selected_item_id)); // rising starts at 2 steps a second
return true;
}
return false;
}
/* A practice choice as the spawner's spawn_only. Fake doors are the plain obstacle type; real doors are a key then its
real door, in turn, as the debug run's real doors spawn; mixed doors are the practice mix of real doors, each with its
key, and fake ones (practice_doors_type() in spawner.nvgt); and barriers use the real game's lane rule, sometimes two
side by side. */
string practice_spawn_id(const string&in practice_type)
{
if (practice_type == "mixed_doors") return "practice_doors";
if (practice_type == "barriers") return "barriers_multiple";
if (practice_type == "combinations") return "combinations_mixed"; // every spawn a pair, all 18 (combo.nvgt)
if (practice_type == "real_walls") return "ladders"; // every spawn a real wall with its ladder (ladder.nvgt)
if (practice_type == "mixed_walls") return "mixed_walls"; // fake and real walls, half and half
if (practice_type == "trampolines") return "practice_trampolines"; // a trampoline every other spawn, obstacles between (spawner.nvgt)
if (practice_type == "mixed_obstacles") return "practice_mixed"; // every kind at random (spawner.nvgt)
return practice_type;
}
/* DEBUG OPTION: pick the starting step time, from start_step_time down in 100 ms steps. The 50 ms steps in between were
left out to keep the list short. It only appears when running from source; a compiled release always starts at
start_step_time. Returns -1 if escaped. */
int choose_start_speed()
{
if (SCRIPT_COMPILED) return start_step_time;
setupmenu();
m.intro_text = "Choose a starting speed for debugging.";
for (int t = start_step_time; t >= 100; t -= 100)
{
m.add_item(t + " ms", "" + t);
}
int mres = m.run();
if (mres < 0) return -1; // silent: escape just steps back to the spawn menu
return int(parse_int(m.selected_item_id));
}
/* DEBUG OPTION: pick which obstacles spawn: one type from obstacle_types and item_types (and any added later), one of
the extra choices below, or all. Every choice is gathered first, then listed in alphabetical order, "all" included. It
only appears when running from source; a compiled release always spawns all. Returns the type, "all", or "" if
escaped. */
string choose_spawn_types()
{
if (SCRIPT_COMPILED) return "all";
string[] labels;
dictionary ids; // label -> spawn id
for (uint i = 0; i < obstacle_types.length(); i++)
{
if (obstacle_types[i] == "animals") continue; // listed by kind below instead
if (obstacle_types[i] == "barriers") continue; // the three barrier choices below cover it
add_spawn_choice(labels, ids, obstacle_types[i] == "ladders" ? "real walls" : learn_type_name(obstacle_types[i]), obstacle_types[i]); // "force_fields" reads as "force fields", "walls" as "fake walls", "ladders" as "real walls"
}
// Fake and real walls at random, half and half.
add_spawn_choice(labels, ids, "mixed walls", "mixed_walls");
// Animals of one kind only; "all" still mixes every kind.
add_spawn_choice(labels, ids, "animals, birds", "animals_birds");
add_spawn_choice(labels, ids, "animals, dogs", "animals_dogs");
// Real doors aren't in the random mix (they mark speed sections), but as a debug option they can be the only thing that spawns.
add_spawn_choice(labels, ids, "real doors", "real_doors");
// Only the real doors at the speed marks, with nothing in between.
add_spawn_choice(labels, ids, "real doors, spread", "real_doors_spread");
// Only barriers: in your lane, in random lanes, or the real game's pairs.
add_spawn_choice(labels, ids, "barriers", "barriers");
add_spawn_choice(labels, ids, "barriers, random lanes", "barriers_random"); // each barrier in any of the three lanes
add_spawn_choice(labels, ids, "barriers, multiple lanes", "barriers_multiple"); // the real game's rule: sometimes two side by side, never in one lane
for (uint i = 0; i < item_types.length(); i++)
{
string item_name = item_types[i].replace("_", " ", true);
add_spawn_choice(labels, ids, item_name, item_types[i]);
// The lane items get the barriers' three choices: your lane, random lanes, multiple lanes.
if (item_lane_types.find(item_types[i]) < 0) continue;
add_spawn_choice(labels, ids, item_name + ", random lanes", item_types[i] + "_random");
add_spawn_choice(labels, ids, item_name + ", multiple lanes", item_types[i] + "_multiple");
}
// Every spawn a pair: first-order pairs, reversed ones, or both mixed.
add_spawn_choice(labels, ids, "combinations", "combinations");
add_spawn_choice(labels, ids, "combinations, reversed", "combinations_reverse");
add_spawn_choice(labels, ids, "combinations, mixed", "combinations_mixed");
// The full game with a slide about every other spawn.
add_spawn_choice(labels, ids, "slides", "slides");
// The full game with a trampoline about every other spawn.
add_spawn_choice(labels, ids, "trampolines", "trampolines");
add_spawn_choice(labels, ids, "all", "all");
add_spawn_choice(labels, ids, "nothing", "nothing"); // an empty belt, for the music and ambience
labels.sort_ascending();
setupmenu();
m.intro_text = "Choose which obstacles spawn for debugging.";
for (uint i = 0; i < labels.length(); i++)
{
string id;
ids.get(labels[i], id);
m.add_item(labels[i], id);
}
int mres = m.run();
if (mres < 0) return ""; // silent: escape just steps back to the environment menu
return m.selected_item_id;
}
// One spawn choice for choose_spawn_types(): its spoken label and the id start_run() gets.
void add_spawn_choice(string[]@ labels, dictionary@ ids, const string&in label, const string&in id)
{
labels.insert_last(label);
ids.set(label, id);
}
/* DEBUG OPTION: whether you hear your footsteps while running, asked before the run-ending question. No silences every
footstep, so only the belt's sounds are left; landings still play. It only appears when running from source; a
compiled release always answers Yes. Returns 1 for Yes, 0 for No, or -1 if escaped. */
int choose_footsteps()
{
if (SCRIPT_COMPILED) return 1;
setupmenu();
m.intro_text = "Do you want to hear your footsteps while running?";
m.add_item("Yes", "yes");
m.add_item("No", "no");
int mres = m.run();
if (mres < 0) return -1; // silent: escape just steps back to the speed menu
return m.selected_item_id == "yes" ? 1 : 0;
}
/* DEBUG OPTION: the environment, the first debug option, before the spawn menu: each environment to stay in for the
whole run, to test one environment's sounds directly, then "random" last, the normal random pick, which also lets the
run switch between environments. Returns "" for random, the environment's name, or "-" if escaped. A compiled release
always answers random. */
string choose_debug_env()
{
if (SCRIPT_COMPILED) return "";
setupmenu();
m.intro_text = "Which environment do you want to run in?";
string[] names = env_names();
for (uint i = 0; i < names.length(); i++) m.add_item(names[i].replace("_", " ", true), names[i]);
m.add_item("random", "random"); // last
int mres = m.run();
if (mres < 0) return "-"; // silent: escape just steps back to the mode menu
return m.selected_item_id == "random" ? "" : m.selected_item_id;
}
/* DEBUG OPTION: whether running out of lives ends the run. No means blows can never end it: lives stop at 1 and 0
health just refills; hazards still end it. It only appears when running from source; a compiled release always answers
Yes. Returns 1 for Yes, 0 for No, or -1 if escaped. */
int choose_lives_can_end()
{
if (SCRIPT_COMPILED) return 1;
setupmenu();
m.intro_text = "Do you want the run to end when you run out of lives?";
m.add_item("Yes", "yes");
m.add_item("No", "no");
int mres = m.run();
if (mres < 0) return -1; // silent: escape just steps back to the footsteps question
return m.selected_item_id == "yes" ? 1 : 0;
}
