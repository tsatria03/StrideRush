void mainmenu()
{
setupmenu(true);
m.add_item("start game", "start");
m.add_item("exit game", "ex");
m.intro_text="Main menu. Choose an option with your arrow keys, then press enter to activate one.";
int mres=m.run();
string main=mres<0?"":m.selected_item_id;
// Escape and exit game both quit right away, with no confirm.
if(mres<0 or main=="ex")
{
speak("exiting");
m.fade_music();
exit();
}
if(main=="start")
{
int speed = choose_start_speed();
if (speed < 0) return; // escaped the speed menu: back to the main menu
m.fade_music();
start_run(speed); // returns when the run ends, and main()'s loop reopens this menu
}
}
/* TESTING ONLY: pick the starting step time, from start_step_time down to min_step_time in 50 ms steps. It only
appears when running from source; a compiled release always starts at start_step_time. Returns -1 if escaped. */
int choose_start_speed()
{
if (SCRIPT_COMPILED) return start_step_time;
setupmenu();
m.intro_text = "Choose a starting speed for testing.";
for (int t = start_step_time; t >= min_step_time; t -= 50)
{
m.add_item(t + " ms", "" + t);
}
int mres = m.run();
if (mres < 0)
{
speak("canceled");
return -1;
}
return int(parse_int(m.selected_item_id));
}
