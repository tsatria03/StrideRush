/* The pause menu (dev, 2026-11-03, for 1.3): "resume run", "restart run" and "quit run", all about the run, while the
main menu's restart game and exit game are about the program. Pausing freezes the run's timers and every game pool.
Restart run and quit run each ask Yes/No first; on Yes, restart starts the run straight over with the same choices
(restart_run_requested, read by play_game()) and quit ends it so start_run() returns to the game menu. P opens this
menu; Escape during a run asks the quit question directly (quit_run_prompt()). The confirm reads its OWN menu result
(ToyMania's pause menu read the outer menu's result, so answering No still quit). */
void pause_game()
{
pause_timers();
pause_pools();
}
void resume_game()
{
resume_pools();
resume_timers();
}
// The run's timers alone. The quit run question uses these on their own, so the run's sounds keep playing (dev).
void pause_timers()
{
steptimer.pause();
speeduptimer.pause();
runtimer.pause();
jumptimer.pause();
ducktimer.pause();
duckcooldowntimer.pause();
firetimer.pause();
reloadtimer.pause();
}
void resume_timers()
{
steptimer.resume();
speeduptimer.resume();
runtimer.resume();
jumptimer.resume();
ducktimer.resume();
duckcooldowntimer.resume();
firetimer.resume();
reloadtimer.resume();
}
void pause_menu()
{
pause_game();
temp.play_stationary(get_pack_sound("misc/game/*pause*"), false);
/* It remembers your place (dev, 2026-11-08): P opens it on resume run, and backing out of anything inside it comes back
on the item you came from; the item focused is always spoken after the intro (dev: "I want it to say it if it focuses on it"). */
int focus = 0;
while (true)
{
setupmenu();
m.intro_text = "Pause menu.";
m.add_item("resume run", "resume");
m.add_item("restart run", "restart"); // right after resume run (dev, 2026-11-07)
// Session results, in an endless run only (the session results plan, 2026-11-07); practice and debug runs count nothing.
if (stats_counting)
{
m.add_item("view session results", "view");
m.add_item("copy session results to clipboard", "copy");
m.add_item("export session results to file", "export");
}
m.add_item("quit run", "quit");
int mres = m.run(focus, false, true);
focus = mres;
string choice = mres < 0 ? "" : m.selected_item_id;
// The results items come back to the pause menu on the item chosen, still paused.
if (choice == "view" or choice == "copy" or choice == "export")
{
if (choice == "view") view_session_results();
else if (choice == "copy") copy_session_results(true);
else export_session_results(true);
continue;
}
// Escape resumes, the same as choosing resume run.
if (mres < 0 or choice == "resume")
{
temp.play_stationary(get_pack_sound("misc/game/*resume*"), false);
resume_game();
return;
}
if (choice == "restart" and confirm_leave_run("Are you sure you want to restart this run? You will lose all progress for this current session."))
{
leave_paused_run(true);
return;
}
if (choice == "quit" and confirm_leave_run(quit_run_question))
{
leave_paused_run(false);
return;
}
}
}
const string quit_run_question = "Are you sure you want to quit this run? You will lose all progress for this current session.";
/* Escape during a run (dev, 2026-11-03): the quit run question straight away. The timers and every sound but the ambience
pause while it's asked (dev, 2026-11-08, replacing 2026-11-03's "the timers should pause, but not the sounds"), with no
pause or resume cue. Yes ends the run back to the game menu; No or escape says "canceled" and the run carries on. With the Game
tab's ask setting off (ask_quit_on_escape), Escape leaves at once without the question (dev, 2026-11-04). */
void quit_run_prompt()
{
if (!ask_quit_on_escape)
{
leave_run(false);
return;
}
pause_game(); // the timers and every sound but the ambience (dev, 2026-11-08), no longer the timers alone
if (confirm_leave_run(quit_run_question))
{
leave_paused_run(false);
return;
}
resume_game();
}
/* Ends the run from the pause menu. The timers are unpaused first, silently, so nothing carries a paused timer into the
next run. With restart, play_game() starts it over. */
void leave_paused_run(bool restart)
{
resume_game();
leave_run(restart);
}
/* Every way of choosing to leave a run ends here: the run's sounds fade out the way fademode says (SimpleFighter's
fade, dev, 2026-11-04), then the run stops. A death never comes through here, so it keeps its own ending sounds. */
void leave_run(bool restart)
{
fade_multi_pool(fademode);
restart_run_requested = restart;
running = false;
}
// The Yes/No for restart run and quit run, with the dev's wording (dev, 2026-11-03). Anything but Yes says "canceled".
bool confirm_leave_run(string question)
{
setupmenu();
m.intro_text = question;
m.add_item("Yes", "yes");
m.add_item("No", "no");
int confirmres = m.run();
string confirm = confirmres < 0 ? "" : m.selected_item_id;
if (confirm == "yes") return true;
speak("canceled");
return false;
}
