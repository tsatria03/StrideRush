/* The key bindings screens (dev, 2026-11-04, for 1.3). F1 during a run and
the settings menu's Keyboard tab both open the read-only view; rebinding is only reachable from the settings menu
outside a run, since keys are never rebound mid-run. */

/* A read-only window of keyboard.ini as it is now: section headers and comments kept, and each action line rewritten
from the live bindings as "action = keys", with "(unbound)" for an action that has none. Close or escape returns. */
void view_keyboard_bindings()
{
string body = "";
file f;
if (f.open(keyboard_ini_path, "rb"))
{
string content = f.read();
f.close();
content = string_replace(content, "\r\n", "\n", true);
string[] lines = content.split("\n", true);
for (uint i = 0; i < lines.length(); i++)
{
string line = lines[i];
string trimmed = line.trim_whitespace();
if (trimmed.length() == 0 || trimmed.substr(0, 1) == ";" || trimmed.substr(0, 1) == "#" || trimmed.substr(0, 1) == "[")
{
body += line + "\r\n";
continue;
}
int eq = trimmed.find_first("=");
string act = eq < 0 ? "" : trimmed.substr(0, eq).trim_whitespace();
if (act != "" && controls.has_action(act))
{
string s = controls.get_keyboard_action_string(act);
body += act + " = " + (s == "" ? "(unbound)" : s) + "\r\n";
}
else body += line + "\r\n";
}
}
else body = "Could not read " + keyboard_ini_path + ".";
audio_form bindform;
bindform.create_window("Current keyboard bindings", false, false, false);
int view = bindform.create_input_box("Bindings", body, read_only:true, multiline:true);
int close_btn = bindform.create_button("&close", false, true);
bindform.focus(view);
while (true)
{
wait(5);
bindform.monitor();
if (bindform.is_pressed(close_btn))
{
if (key_down(KEY_ESCAPE)) speak("canceled"); // escape, not the close button, says so (dev, 2026-11-09)
return;
}
}
}
/* The rebind list: every action with its keys, and add, edit and remove buttons. Each change is written straight to
keyboard.ini, keeping its sections and comments. Close or escape returns to the settings menu silently. The list is
rebuilt after each change so it always shows the new keys. */
void rebind_keyboard_action()
{
while (true)
{
string[]@ actions = keyboard_actions_in_order();
if (actions.length() == 0)
{
dlg("There are no actions to rebind.");
return;
}
audio_form rebindform;
rebindform.create_window("Rebind keyboard controls", false);
int list = rebindform.create_list("Current bindings");
for (uint i = 0; i < actions.length(); i++)
{
string s = controls.get_keyboard_action_string(actions[i]);
rebindform.add_list_item(list, actions[i] + ": " + (s == "" ? "(unbound)" : s), actions[i]);
}
int add_btn = rebindform.create_button("&Add binding");
int edit_btn = rebindform.create_button("&Edit binding");
int remove_btn = rebindform.create_button("&Remove binding");
int close_btn = rebindform.create_button("&Close", false, true);
rebindform.focus(list);
while (true)
{
wait(5);
rebindform.monitor();
if (rebindform.is_pressed(close_btn)) return;
int pos = rebindform.get_list_position(list);
if (rebindform.is_pressed(add_btn) && pos >= 0 && pos < int(actions.length()))
{
rebind_add_binding(rebindform, actions[pos]);
break;
}
if (rebindform.is_pressed(edit_btn) && pos >= 0 && pos < int(actions.length()))
{
rebind_edit_binding(rebindform, actions[pos]);
break;
}
if (rebindform.is_pressed(remove_btn) && pos >= 0 && pos < int(actions.length()))
{
rebind_remove_binding(actions[pos]);
break;
}
}
}
}
/* Adds one more key to the action selected in the list, keeping its others, like edit and remove (dev, 2026-11-09: no
separate menu of every action, which only repeated the list). */
void rebind_add_binding(audio_form@ rebindform, const string&in action)
{
string combo = kc_capture_combo(rebindform, "Press the key combo to bind to " + action + ", or escape to cancel.");
if (combo == "")
{
speak("canceled");
return;
}
if (!rebind_replace_question(action, combo)) return;
int trig = rebind_trigger_question();
if (trig < 0) return;
rebind_take_over(action, combo);
controls.bind_key(action, combo, kc_trigger(trig));
save_bindings("Added " + combo + " to " + action + ".");
}
// Replaces all of an action's keys with one new combo.
void rebind_edit_binding(audio_form@ rebindform, const string&in action)
{
string combo = kc_capture_combo(rebindform, "Press the new key combo for " + action + ", or escape to cancel.");
if (combo == "")
{
speak("canceled");
return;
}
if (!rebind_replace_question(action, combo)) return;
int trig = rebind_trigger_question();
if (trig < 0) return;
rebind_take_over(action, combo);
controls.clear_keyboard_action(action);
controls.bind_key(action, combo, kc_trigger(trig));
save_bindings(action + " is now bound to " + combo + ".");
}
// Clears every key from an action, after a Yes then No question.
void rebind_remove_binding(const string&in action)
{
setupmenu();
m.intro_text = "Do you want to remove all bindings for " + action + "?";
m.add_item("Yes", "yes");
m.add_item("No", "no");
int mres = m.run();
if (mres < 0 or m.selected_item_id != "yes")
{
speak("canceled");
return;
}
controls.clear_keyboard_action(action);
save_bindings(action + " bindings cleared.");
}
/* The replace question (the rebinding plan, dev, 2026-11-09: "It should ask you if you want to replace that key."): when
the combo already belongs to other actions, Yes then No, naming them, and saying when one would be left with no key.
True to go on (no other action has it, or Yes); No or escape says "canceled". Nothing is changed until the binding is
made (rebind_take_over()), so canceling the trigger question afterwards leaves every action as it was. */
bool rebind_replace_question(const string&in action, const string&in combo)
{
string[]@ owners = controls.actions_using(combo, action);
if (owners.length() == 0) return true;
string question;
if (owners.length() == 1 and controls.overlap_count(owners[0], combo) >= controls.keyboard_binding_count(owners[0]))
question = combo + " is the only key for " + owners[0] + ", so " + owners[0] + " will have no key. Would you like to replace it?";
else
{
string names = owners[0];
for (uint i = 1; i < owners.length(); i++) names += (i == owners.length() - 1 ? " and " : ", ") + owners[i];
question = combo + " is already bound to " + names + ". Would you like to replace it?";
}
setupmenu();
m.intro_text = question;
m.add_item("Yes", "yes");
m.add_item("No", "no");
int mres = m.run();
if (mres >= 0 and m.selected_item_id == "yes") return true;
speak("canceled");
return false;
}
// Takes the combo off every other action that has it, once the binding is going ahead (they keep their other keys).
void rebind_take_over(const string&in action, const string&in combo)
{
string[]@ owners = controls.actions_using(combo, action);
for (uint i = 0; i < owners.length(); i++) controls.unbind_combo(owners[i], combo);
}
/* The trigger question (dev, 2026-11-09: "it should ask them if they want to change the default key trigger"): Yes then
No; No keeps a press, Yes opens the trigger menu, escape says "canceled" and cancels the binding. Returns the trigger,
or -1 for canceled. */
int rebind_trigger_question()
{
setupmenu();
m.intro_text = "Would you like to change the trigger for this key? It's set to press by default.";
m.add_item("Yes", "yes");
m.add_item("No", "no");
int mres = m.run();
if (mres < 0)
{
speak("canceled");
return -1;
}
if (m.selected_item_id == "no") return int(KC_PRESS);
return int(kc_choose_trigger());
}
// Writes the bindings back to keyboard.ini and confirms, or says the change only lasts for this session.
void save_bindings(const string&in done_message)
{
if (!kc_save_preserving(controls, keyboard_ini_path)) dlgmessage_return("The change works for now, but it could not be saved to keyboard.ini.");
else dlgmessage_return(done_message); // dev, 2026-11-09
}
